---
// MailerLite embedded-form subscribe endpoint (public client-side embed id, not a secret).
const MAILERLITE_ACTION = 'https://assets.mailerlite.com/jsonp/2504656/forms/192763576695392191/subscribe';

// DELIBERATELY NO DOWNLOAD URL IN THIS FILE (Adrian, 2026-07-20). The installer URL lives
// ONLY in the MailerLite delivery email. Putting it in the markup would let anyone read it
// out of view-source and skip the gate entirely, which makes the email toll theatre.
// Confirmed opt-in is the verification, so a fake address receives nothing. No codes, no
// accounts, no backend: see workspace/2026-07-18_licensing-decision/DISTRIBUTION.md.
// The unlisted R2 path is unguessable, not secret; source stays ungated on GitHub by design.
//
// !! COUPLED TO THE REPO PUBLIC FLIP (t16). This dialog renders on EVERY page, so its
// "the entire source is on GitHub" link is a site-wide dead link while the repo is private.
// Same rule the Footer documents. Do not deploy this component ahead of the squash-publish;
// if the site must ship first, delete the .dl-gate__alt line in the form body and restore it
// at launch. The claim is load-bearing: it is what makes the email gate defensible.
---
<dialog id="download-gate" class="dl-gate" aria-labelledby="dl-gate-title">
  <div class="dl-gate__inner">
    <button type="button" class="dl-gate__close" data-dl-close aria-label="Close">✕</button>
    <p class="dl-gate__label">FREE DOWNLOAD</p>
    <h2 id="dl-gate-title" class="dl-gate__title">Get FabricatorStudio</h2>
    <div class="dl-gate__body" id="dl-gate-body">
      <p class="dl-gate__sub">Drag &amp; drop Maya installer. It costs an email. We send the download link straight to your inbox. No spam, unsubscribe anytime.</p>
      <p class="dl-gate__alt">Allergic to email? The entire source is on <a href="https://github.com/adrianmelian/FabricatorStudio" target="_blank" rel="noopener">GitHub</a>.</p>
      <form class="dl-gate__form" id="dl-gate-form" novalidate>
        <label class="dl-gate__sronly" for="dl-gate-email">Email address</label>
        <input class="dl-gate__input" id="dl-gate-email" type="email" name="fields[email]" inputmode="email" autocomplete="email" placeholder="you@studio.com" required />
        <input class="dl-gate__hp" type="text" name="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button class="dl-gate__submit" type="submit">Send me the installer</button>
        <p class="dl-gate__error" id="dl-gate-error" hidden>Please enter a valid email.</p>
      </form>
    </div>
    <div class="dl-gate__done" id="dl-gate-done" hidden>
      <p class="dl-gate__sub">Check your inbox. Confirm the subscription and the download link is on its way. If it isn't there in a few minutes, look in spam.</p>
      <p class="dl-gate__alt">Wrong address, or nothing arrives? Write to <a href="mailto:contact@fabricator.studio">contact@fabricator.studio</a> and we'll send it over.</p>
    </div>
  </div>
</dialog>
<script define:vars={{ action: MAILERLITE_ACTION }}>
  (function () {
    var dlg = document.getElementById('download-gate');
    if (!dlg) return;
    var form = document.getElementById('dl-gate-form');
    var email = document.getElementById('dl-gate-email');
    var error = document.getElementById('dl-gate-error');
    var body = document.getElementById('dl-gate-body');
    var done = document.getElementById('dl-gate-done');

    function showDone() { if (body) body.hidden = true; if (done) done.hidden = false; }
    function showForm() { if (body) body.hidden = false; if (done) done.hidden = true; if (error) error.hidden = true; }

    // Always open on the form. Delivery is by email now, so a returning visitor whose link
    // never arrived must be able to ask again; a remembered "done" state would strand them.
    function openGate() {
      showForm();
      if (dlg.showModal) dlg.showModal();
    }

    // Delegated so it catches every Download trigger on the page, wherever it renders.
    document.addEventListener('click', function (e) {
      var trigger = e.target.closest && e.target.closest('[data-download-open]');
      if (trigger) { e.preventDefault(); openGate(); }
    });
    dlg.querySelectorAll('[data-dl-close]').forEach(function (b) {
      b.addEventListener('click', function () { dlg.close(); });
    });
    dlg.addEventListener('click', function (e) { if (e.target === dlg) dlg.close(); });

    if (form) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var val = (email.value || '').trim();
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val)) { if (error) error.hidden = false; email.focus(); return; }
        var hp = form.querySelector('.dl-gate__hp');
        var isBot = hp && hp.value;
        showDone();
        if (action && !isBot) {
          fetch(action, {
            method: 'POST',
            mode: 'no-cors',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'fields[email]=' + encodeURIComponent(val) + '&ml-submit=1&anticsrf=true',
          });
        }
      });
    }
  })();
</script>
<style>
  .dl-gate {
    margin: auto;
    max-width: 30rem;
    width: calc(100vw - 3rem);
    border: 1px solid var(--iron-3);
    border-radius: var(--radius);
    background: var(--carbon);
    color: var(--bone);
    padding: 0;
  }
  .dl-gate::backdrop { background: rgba(0, 0, 0, 0.7); }
  .dl-gate__inner { position: relative; padding: 2rem; }
  .dl-gate__close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background: none;
    border: none;
    color: var(--bone-dim);
    font-size: 1rem;
    cursor: pointer;
    line-height: 1;
  }
  .dl-gate__close:hover { color: var(--bone); }
  .dl-gate__label {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--ember);
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    margin: 0 0 0.5rem;
  }
  .dl-gate__title {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 0.5rem;
    color: var(--bone);
  }
  .dl-gate__sub { color: var(--bone-dim); font-size: 0.9rem; line-height: 1.5; margin: 0 0 1.25rem; }
  .dl-gate__done .dl-gate__sub { margin: 0 0 1rem; }
  .dl-gate__alt { color: var(--bone-faint); font-size: 0.8rem; line-height: 1.5; margin: 0 0 1.25rem; }
  .dl-gate__done .dl-gate__alt { margin: 1rem 0 0; }
  .dl-gate__alt a { color: var(--bone-dim); text-decoration: underline; }
  .dl-gate__alt a:hover { color: var(--plasma); }
  .dl-gate__link { display: block; text-align: center; text-decoration: none; }
  .dl-gate__form { display: flex; flex-direction: column; gap: 0.75rem; }
  .dl-gate__input {
    width: 100%;
    box-sizing: border-box;
    background: var(--iron);
    border: 1px solid var(--iron-3);
    border-radius: var(--radius);
    color: var(--bone);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    padding: 0.7rem 0.8rem;
  }
  .dl-gate__input::placeholder { color: var(--bone-faint); }
  .dl-gate__input:focus { outline: none; border-color: var(--plasma-dim); }
  .dl-gate__hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .dl-gate__submit {
    font-family: var(--font-mono);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--carbon);
    background: var(--plasma);
    border: 1px solid var(--plasma);
    border-radius: var(--radius);
    padding: 0.7rem 1rem;
    cursor: pointer;
  }
  .dl-gate__submit:hover { background: var(--plasma-dim); border-color: var(--plasma-dim); }
  .dl-gate__error { color: var(--ember); font-size: 0.8rem; margin: 0; font-family: var(--font-mono); }
  .dl-gate__sronly { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
</style>
