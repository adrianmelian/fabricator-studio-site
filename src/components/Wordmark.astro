---
// THE SIGNATURE: the FabricatorStudio wordmark.
//
// NOW THE ARTWORK, NOT LIVE TYPE. Ruled by Adrian 2026-09-04: "throughout the website use
// this logo as the full text FabricatorStudio text", pointing at
// brand/fabricatorstudio/Fabricator_Studio_Fullname_Banner_SingleColor.png. It is the same
// mark both of his design drops opened with.
//
// What it replaced: JetBrains Mono Bold set letter by letter, each <i> coloured by CSS,
// with a carbon stroke. That was chosen so the mark stayed crisp at any size and followed
// the palette, and it is a genuinely different drawing: the artwork carries the pencil f
// with its ember tip and the two plasma squares on the S, none of which type can produce.
// The old `.wordmark` rules in base.css are now unused by this component and are left in
// place rather than swept, because they are global and this file cannot see every consumer.
//
// The `text` prop is gone. It existed so the mark could spell another name; it was never
// passed, and artwork cannot honour it. Anything needing different words needs a different
// asset, which is his to draw.
//
// ACCESSIBILITY: the alt carries the studio name once. At `decorative` the image is hidden
// from the a11y tree entirely, for the places where the name is already announced by the
// link or heading around it.
import { Image } from 'astro:assets';
import wordmark from '../assets/fabricatorstudio-wordmark.png';

// HEIGHT COMES IN AS AN INLINE VARIABLE, not from the consumer's stylesheet. A scoped
// rule in the parent cannot reach this element: Astro stamps THIS component's id on it,
// not the parent's, so a `.navbar__mark { --wordmark-h: ... }` written next door silently
// does nothing and the mark renders at its default. Measured: the nav brand came out at
// 316x46 in a 52px bar before this.
interface Props { class?: string; decorative?: boolean; height?: string }
const { class: cls = '', decorative = false, height } = Astro.props;
---
<Image
  class={`fs-wordmark ${cls}`.trim()}
  style={height ? `--wordmark-h: ${height}` : undefined}
  src={wordmark}
  alt={decorative ? '' : 'FabricatorStudio'}
  widths={[440, 880]}
  sizes="(max-width: 700px) 260px, 440px"
  loading="eager"
/>

<style>
  /* Height-driven: every consumer sets a height and the width follows the artwork's own
     2214x320 ratio, so the mark can never be stretched by a container. */
  .fs-wordmark {
    display: block;
    height: var(--wordmark-h, 2.875rem);
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }
</style>
