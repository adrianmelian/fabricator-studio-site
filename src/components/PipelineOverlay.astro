---
// THE PIPELINE BEAT (Adrian, 2026-08-19 second pass, from his sketch): this REPLACES the
// tool carousel as the whole tools story. In the room, an x-ray pipe with four flanged
// sections carries a particle stream across the screen -- raw scatter drawn in at the left,
// a production-ready character condensing out at the right. The pipe and stream live in
// PointCloudHero's canvas; THIS layer is the words: the title, the four section labels
// under the pipe, and one info card at the bottom for whichever section the cursor is on.
//
// The bands are DOM anchors, not 3D picking: the loop projects the pipe's section bounds
// to screen fractions every frame (--pipe-x0..x4, --pipe-yt, --pipe-yb) and the bands wear
// them, so the labels stay glued to the pipe at any aspect. The JOURNEY drives everything:
// the loop writes data-hover with the section under the packet (mouse hover was retired,
// Adrian 2026-08-19 -- the scroll owns the ride), which lights that label and its card.
//
// DRAFT COPY: the four bodies below are placeholders for Adrian's pass; the four section
// titles are his ruled names.
const SECTIONS = [
  {
    label: 'Workflow Automation',
    body: 'The chores leave the pipeline: batch exports, naming, scene hygiene and publish steps run themselves, so artists never babysit a process.',
  },
  {
    label: 'Project Integration',
    body: 'The tools bend to your project, not the other way around: naming conventions, folder structure and engine targets are read and respected.',
  },
  {
    label: 'Rigging & Animation',
    body: 'Fabricator and Armature carry a model from mesh to animation-ready: generative skeletons, machine-learned skinning, artist-grade controls.',
  },
  {
    label: 'Unhindered Iteration',
    body: 'Change the design at any point and rebuild in minutes. Nothing is locked and nothing is precious: iteration is the whole point.',
  },
];
const bandStyle = (i: number) =>
  `left: calc(var(--pipe-x${i}, ${0.16 + i * 0.16}) * 100%);` +
  `width: calc((var(--pipe-x${i + 1}, ${0.32 + i * 0.16}) - var(--pipe-x${i}, ${0.16 + i * 0.16})) * 100%);`;
---

<div class="pl" data-pipeline-overlay>
  <div class="pl__head">
    <p class="pl__title">Studio Pipeline Tools</p>
    <p class="pl__sub">For Artists<span class="pl__pivot">,</span> By Artists</p>
  </div>

  {/* The four bands, riding the projected pipe. Labels sit under their sections like the
      sketch's brackets; the packet's position picks the lit one. */}
  {SECTIONS.map((s, i) => (
    <div class="pl__band" data-band={i} style={bandStyle(i)}>
      <p class="pl__label">{s.label}</p>
    </div>
  ))}

  {/* One card at the bottom for the section the packet is passing through. */}
  <div class="pl__cards">
    {SECTIONS.map((s, i) => (
      <div class="pl__card" data-card={i}>
        <p class="pl__card-title">{s.label}</p>
        <p class="pl__card-body">{s.body}</p>
      </div>
    ))}
  </div>
</div>

<style>
  /* Fixed layer over the room, same grammar as the other beats; everything fades on
     --pipe from the loop. */
  .pl {
    position: fixed;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    visibility: hidden;
    opacity: var(--pipe, 0);
  }
  .pl[data-active] { visibility: visible; }

  .pl__head {
    position: absolute;
    left: 50%;
    top: 7%;
    transform: translateX(-50%);
    text-align: center;
    white-space: nowrap;
  }
  /* THE HOUSE HEADER (Adrian, 2026-08-20): the homepage opening's shape is the title style
     everywhere now. Display serif in BONE, one small connector glyph in plasma, and a light
     sans line under it in bone. This title was ember over dim mono uppercase, which said
     something different in two different registers on the same page.

     "Studio Pipeline Tools" has no connector to carry the green, so it falls to the pivot of
     the mirrored pair beneath it. That is my read of the rule rather than Adrian's word: the
     glyph is his to move. */
  .pl__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(3rem, 5.6vw, 5.4rem);
    line-height: 1.02;
    letter-spacing: -0.005em;
    color: var(--bone);
  }
  .pl__sub {
    margin-top: 0.35rem;
    font-weight: 300;
    font-size: clamp(1.3rem, 2.3vw, 2.05rem);
    line-height: 1.22;
    color: var(--bone);
  }
  .pl__pivot { color: var(--plasma); }

  /* The bands: invisible strips glued to the projected pipe; their labels are the visible
     part, hanging under each section. */
  .pl__band {
    position: absolute;
    top: calc(var(--pipe-yt, 0.26) * 100%);
    height: calc((var(--pipe-yb, 0.52) - var(--pipe-yt, 0.26)) * 100%);
  }
  .pl__label {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    margin-top: 0.9rem;
    font-family: var(--font-mono);
    font-size: clamp(0.7rem, 0.85vw, 0.85rem);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--bone-dim);
    transition: color var(--t-fast) var(--ease-out);
  }
  /* The packet's section carries its label lit, in step with the hot pipe segment. */
  .pl[data-hover='0'] [data-band='0'] .pl__label,
  .pl[data-hover='1'] [data-band='1'] .pl__label,
  .pl[data-hover='2'] [data-band='2'] .pl__label,
  .pl[data-hover='3'] [data-band='3'] .pl__label { color: var(--plasma); }

  /* One cell, crossfading cards; the hint holds the cell while nothing is hovered. */
  .pl__cards {
    position: absolute;
    left: 50%;
    bottom: 6%;
    transform: translateX(-50%);
    width: min(46rem, 80vw);
    display: grid;
    text-align: center;
    text-shadow: 0 1px 3px rgba(11, 14, 16, 0.65);
  }
  .pl__cards > * {
    grid-area: 1 / 1;
    align-self: end;
    opacity: 0;
    transition: opacity 0.25s var(--ease-out);
  }
  .pl[data-hover='0'] [data-card='0'],
  .pl[data-hover='1'] [data-card='1'],
  .pl[data-hover='2'] [data-card='2'],
  .pl[data-hover='3'] [data-card='3'] { opacity: 1; }

  .pl__card-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.6rem, 2.4vw, 2.3rem);
    color: var(--bone);
  }
  .pl__card-body {
    margin-top: 0.7rem;
    font-weight: 300;
    font-size: clamp(1.05rem, 1.4vw, 1.3rem);
    line-height: 1.45;
    color: var(--bone);
  }

  /* BURGER WIDTH: everything on the centre line (Adrian, 2026-08-20), the same call he made
     for the opening. This layer used to be display:none here, on the reasoning that "the
     cinematic never runs under 900px" -- true when it was written, false since the stage was
     opened up on 2026-08-20, which is why the whole beat arrived on a phone with no words on
     it. Nothing hides it for the static fallback either: .pl is visibility:hidden until the
     loop sets [data-active], and on the fallback path the loop never runs.

     The head and the card already sit on the centre line and only needed room. The LABELS are
     the actual problem: they are glued to the pipe's projected section bounds, and at this
     aspect the pipe runs far past both edges, so the four of them scatter -- measured at 390,
     one label sat at x -1561 and another at x 1379, with stretches where none was on screen
     at all. */
  @media (max-width: 900px) {
    /* The title is 87% of a 390 screen at its desktop size, and it is nowrap, so it clips
       outright a little narrower. Sized off the viewport here and allowed to wrap. */
    /* Anchored BELOW the header, not at a percentage of the viewport: 7% of a short phone is
       inside the 52px nav, and the title showed through the translucent bar. */
    .pl__head {
      top: calc(var(--header-h) + 2.5svh);
      width: min(92vw, 30rem);
      white-space: normal;
    }
    .pl__title { font-size: clamp(2.2rem, 10.5vw, 3.2rem); }

    /* The band stops carrying horizontal position and spans the screen, so its label centres.
       !important is the point rather than a shortcut: `left` and `width` are per-section
       inline styles wearing the projected pipe bounds, and this width deliberately abandons
       that anchoring model. Vertical stays projected, so the label still hangs off the real
       pipe as it moves. */
    .pl__band {
      left: 0 !important;
      width: 100% !important;
    }
    /* Only the lit one shows. All four centre on the same point now, so the three dim ones
       would otherwise print on top of each other and on top of it. */
    .pl__label {
      opacity: 0;
      transition: opacity var(--t-fast) var(--ease-out), color var(--t-fast) var(--ease-out);
    }
    .pl[data-hover='0'] [data-band='0'] .pl__label,
    .pl[data-hover='1'] [data-band='1'] .pl__label,
    .pl[data-hover='2'] [data-band='2'] .pl__label,
    .pl[data-hover='3'] [data-band='3'] .pl__label { opacity: 1; }

    .pl__cards { width: calc(100% - var(--container-px, 20px) * 2); }
  }
</style>
