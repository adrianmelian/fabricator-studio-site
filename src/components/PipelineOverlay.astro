---
// THE PIPELINE BEAT (Adrian, 2026-08-19 second pass, from his sketch): this REPLACES the
// tool carousel as the whole tools story. In the room, an x-ray pipe with four flanged
// sections carries a particle stream across the screen -- raw scatter drawn in at the left,
// a production-ready character condensing out at the right. The pipe and stream live in
// PointCloudHero's canvas; THIS layer is the words: the title, the four section labels
// under the pipe, and one info card at the bottom for whichever section the cursor is on.
//
// The bands are DOM anchors, not 3D picking: the loop projects the pipe's section bounds
// to screen fractions every frame (--pipe-x0..x4, --pipe-yt, --pipe-yb) and the bands wear
// them, so the labels stay glued to the pipe at any aspect. The JOURNEY drives everything:
// the loop writes data-hover with the section under the packet (mouse hover was retired,
// Adrian 2026-08-19 -- the scroll owns the ride), which lights that label and its card.
//
// THE LABELS ARE DRAWN IN THE SCENE above 900px (Adrian, 2026-08-29): "I wanted the text in
// 3D space". PointCloudHero bakes each name to a texture and stands it on a quad in world
// space above the pipe, so it skews and scales with the camera like everything else in the
// room. The DOM labels below survive for PHONES ONLY, where the pipe runs far past both edges
// and a world-anchored label would sit off screen; there they keep centring as before.
//
// THE BODY COPY STAYED IN 2D. It went into the scene the same way for one round and came
// straight back out: at narrow widths the world-space paragraph was barely legible, and
// stacked over this DOM card it read as closed captions. Four short names survive the
// perspective; three lines of prose do not.
import { PIPELINE_SECTIONS as SECTIONS } from '../data/pipeline';
const bandStyle = (i: number) =>
  `left: calc(var(--pipe-x${i}, ${0.16 + i * 0.16}) * 100%);` +
  `width: calc((var(--pipe-x${i + 1}, ${0.32 + i * 0.16}) - var(--pipe-x${i}, ${0.16 + i * 0.16})) * 100%);`;
---

<div class="pl" data-pipeline-overlay>
  <div class="pl__head">
    <p class="pl__title">Studio <span class="pl__accent">Pipeline</span> Tools</p>
    <p class="pl__sub">For Artists, By Artists</p>
  </div>

  {/* The four bands, riding the projected pipe. The labels sit ABOVE their sections
      (Adrian, 2026-08-29): they used to hang underneath and the card below repeated them in
      display serif, so the same four words were on screen twice. The label is now the only
      place a section is named, which is why it is bigger, and the card below it is pure
      body copy. The packet's position picks the lit one. */}
  {SECTIONS.map((s, i) => (
    <div class="pl__band" data-band={i} style={bandStyle(i)}>
      <p class="pl__label">{s.label}</p>
    </div>
  ))}

  {/* One card at the bottom for the section the packet is passing through. */}
  <div class="pl__cards">
    {SECTIONS.map((s, i) => (
      <div class="pl__card" data-card={i}>
        <p class="pl__card-body">{s.body}</p>
      </div>
    ))}
  </div>
</div>

<style>
  /* Fixed layer over the room, same grammar as the other beats; everything fades on
     --pipe from the loop. */
  .pl {
    position: fixed;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    visibility: hidden;
    opacity: var(--pipe, 0);
  }
  .pl[data-active] { visibility: visible; }

  /* Clears out for the ride: the labels ride above the pipe now and climb into this band.
     Written per frame by the loop, so it needs no transition of its own. */
  .pl__head {
    opacity: var(--pipe-head, 1);
    position: absolute;
    left: 50%;
    top: 7%;
    transform: translateX(-50%);
    text-align: center;
    white-space: nowrap;
  }
  /* THE HOUSE HEADER (Adrian, 2026-08-20): the homepage opening's shape is the title style
     everywhere now. Display serif in BONE, one small connector glyph in plasma, and a light
     sans line under it in bone. This title was ember over dim mono uppercase, which said
     something different in two different registers on the same page.

     The green sits on PIPELINE (Adrian, 2026-08-20). It had been on the comma pivoting the
     mirrored pair beneath, on my reading that the accent belongs to a connector; he moved it
     onto the word. One accent per title, so the comma goes back to bone with the rest. */
  .pl__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(3rem, 5.6vw, 5.4rem);
    line-height: 1.02;
    letter-spacing: -0.005em;
    color: var(--bone);
  }
  .pl__sub {
    margin-top: 0.35rem;
    font-weight: 300;
    font-size: clamp(1.3rem, 2.3vw, 2.05rem);
    line-height: 1.22;
    color: var(--bone);
  }
  .pl__accent { color: var(--bone); }

  /* The bands: invisible strips glued to the projected pipe; their labels are the visible
     part, hanging under each section. */
  .pl__band {
    position: absolute;
    top: calc(var(--pipe-yt, 0.26) * 100%);
    height: calc((var(--pipe-yb, 0.52) - var(--pipe-yt, 0.26)) * 100%);
  }
  /* ANCHORED IN 3D (Adrian, 2026-08-29, "can the headers be in 3D so they sit above the
     pipe"). The label no longer hangs off the pipe's projected screen edge: the loop
     projects a THIRD world point, PIPE_LABEL_LIFT above the pipe's surface, into
     `--pipe-ylab`, and the label wears that. So it rides with the camera exactly as the pipe
     does, keeping its clear air through the whole beat instead of only at one aspect.
     The arithmetic converts an absolute screen fraction into a band-relative one, because a
     percentage `top` resolves against the BAND's height rather than the screen's. All three
     custom properties are unitless numbers, so this is a number divided by a number, which
     is the one division calc() permits.
     The header gets out of the way rather than the label ducking under it; that fade is
     driven from the same loop, on `--pipe-head`. */
  /* Above 900px the scene draws these instead; see PointCloudHero's label pass. Keeping the
     DOM copy visible as well would print every name twice, offset by the perspective. */
  @media (min-width: 901px) { .pl__label { display: none; } }
  .pl__label {
    position: absolute;
    top: calc((var(--pipe-ylab, 0.14) - var(--pipe-yt, 0.26)) / (var(--pipe-yb, 0.52) - var(--pipe-yt, 0.26)) * 100%);
    left: 50%;
    /* -100% on Y so the label's BOTTOM edge lands on the projected point rather than its
       top. The world lift then IS the clear air above the pipe, which makes the constant in
       PointCloudHero mean what it says and scale honestly with the perspective. */
    transform: translate(-50%, -100%);
    font-family: var(--font-mono);
    /* Bigger, because it is now the section's only name: the card below stopped repeating
       it. Mono uppercase is kept deliberately -- the display serif belongs to the beat's own
       header, and two serif titles in one frame read as two headings. */
    font-size: clamp(0.95rem, 1.35vw, 1.4rem);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--bone-dim);
    transition: color var(--t-fast) var(--ease-out);
  }
  /* The packet's section carries its label lit, in step with the hot pipe segment. */
  .pl[data-hover='0'] [data-band='0'] .pl__label,
  .pl[data-hover='1'] [data-band='1'] .pl__label,
  .pl[data-hover='2'] [data-band='2'] .pl__label,
  .pl[data-hover='3'] [data-band='3'] .pl__label { color: var(--bone); }

  /* One cell, crossfading cards; the hint holds the cell while nothing is hovered.
     UNDER THE PIPE, not at the foot of the screen (Adrian, 2026-08-29). It used to sit at
     bottom 6%, which left the room's whole lower half between the pipe and the words that
     explain it. It now hangs off the pipe's own projected underside, `--pipe-yb`, so it
     rides with it and reads as part of the section rather than as a caption. */
  .pl__cards {
    position: absolute;
    left: 50%;
    top: calc(var(--pipe-yb, 0.52) * 100% + 2.25rem);
    transform: translateX(-50%);
    /* Narrower than the old 46rem (Adrian, 2026-08-29): with the title gone the paragraph
       is the whole card, and a shorter measure reads faster over moving footage. */
    width: min(34rem, 84vw);
    display: grid;
    text-align: center;
    text-shadow: 0 1px 3px rgba(11, 14, 16, 0.65);
  }
  .pl__cards > * {
    grid-area: 1 / 1;
    /* Top-aligned now that the cell hangs from the pipe rather than standing on the floor. */
    align-self: start;
    opacity: 0;
    transition: opacity 0.25s var(--ease-out);
  }
  .pl[data-hover='0'] [data-card='0'],
  .pl[data-hover='1'] [data-card='1'],
  .pl[data-hover='2'] [data-card='2'],
  .pl[data-hover='3'] [data-card='3'] { opacity: 1; }


  /* .pl__card-title is gone with the markup that carried it (2026-08-29). */
  .pl__card-body {
    font-weight: 300;
    font-size: clamp(1.2rem, 1.75vw, 1.6rem);
    line-height: 1.45;
    color: var(--bone);
  }

  /* BURGER WIDTH: everything on the centre line (Adrian, 2026-08-20), the same call he made
     for the opening. This layer used to be display:none here, on the reasoning that "the
     cinematic never runs under 900px" -- true when it was written, false since the stage was
     opened up on 2026-08-20, which is why the whole beat arrived on a phone with no words on
     it. Nothing hides it for the static fallback either: .pl is visibility:hidden until the
     loop sets [data-active], and on the fallback path the loop never runs.

     The head and the card already sit on the centre line and only needed room. The LABELS are
     the actual problem: they are glued to the pipe's projected section bounds, and at this
     aspect the pipe runs far past both edges, so the four of them scatter -- measured at 390,
     one label sat at x -1561 and another at x 1379, with stretches where none was on screen
     at all. */
  @media (max-width: 900px) {
    /* The title is 87% of a 390 screen at its desktop size, and it is nowrap, so it clips
       outright a little narrower. Sized off the viewport here and allowed to wrap. */
    /* Anchored BELOW the header, not at a percentage of the viewport: 7% of a short phone is
       inside the 52px nav, and the title showed through the translucent bar. */
    .pl__head {
      top: calc(var(--header-h) + 2.5svh);
      width: min(92vw, 30rem);
      white-space: normal;
    }
    .pl__title { font-size: clamp(2.2rem, 10.5vw, 3.2rem); }

    /* The band stops carrying horizontal position and spans the screen, so its label centres.
       !important is the point rather than a shortcut: `left` and `width` are per-section
       inline styles wearing the projected pipe bounds, and this width deliberately abandons
       that anchoring model. Vertical stays projected, so the label still hangs off the real
       pipe as it moves. */
    .pl__band {
      left: 0 !important;
      width: 100% !important;
    }
    /* Only the lit one shows. All four centre on the same point now, so the three dim ones
       would otherwise print on top of each other and on top of it. */
    .pl__label {
      opacity: 0;
      transition: opacity var(--t-fast) var(--ease-out), color var(--t-fast) var(--ease-out);
    }
    .pl[data-hover='0'] [data-band='0'] .pl__label,
    .pl[data-hover='1'] [data-band='1'] .pl__label,
    .pl[data-hover='2'] [data-band='2'] .pl__label,
    .pl[data-hover='3'] [data-band='3'] .pl__label { opacity: 1; }

    .pl__cards { width: calc(100% - var(--container-px, 20px) * 2); }
  }
</style>
