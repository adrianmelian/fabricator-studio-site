---
// CTA button. Mindmeld 2.0: a soft PILL, not `[ BRACKETED CAPS ]` (DNA principles 5 + 8),
// with sanctioned depth (principle 6) and a springy settle on press (section 4, "alive").
// Label renders in natural case now; shouty caps were a 1.0 console motif.
//
// Renders an <a> by default, a modal-trigger <button> when `dialogTarget` is set (the
// flagship cards' Learn More popovers), or a direct link to the installer zip when
// `installer` is set (the email gate is retired, Adrian 2026-07-23; the URL is the stable
// R2 key in links.ts, so the button never changes at a release cut).
//
// The component name is 1.0 baggage; it is renamed in the P2 sweep.
// `event` tags the button for GoatCounter's click tracking (data-goatcounter-click). The
// site has had pageview analytics since launch but no EVENT analytics, so which door a
// visitor takes has never been measurable. The two-door homepage makes that gap matter:
// without it there is no way to tell whether moving the tool cards to /tools/ cost
// downloads. Named events, not paths, so the funnel reads the same from any page.
import { LINKS } from '../data/links';
interface Props { href?: string; label: string; kind?: 'hard' | 'soft' | 'plasma-outline'; dialogTarget?: string; installer?: boolean; event?: string }
const { href, label, kind = 'soft', dialogTarget, installer, event } = Astro.props;
---
{installer ? (
  <a class={`btn cta-${kind}`} href={LINKS.installer} data-installer data-goatcounter-click={event}>{label}</a>
) : dialogTarget ? (
  <button type="button" class={`btn cta-${kind}`} data-dialog-open={dialogTarget} data-goatcounter-click={event}>{label}</button>
) : (
  <a class={`btn cta-${kind}`} href={href} data-goatcounter-click={event}>{label}</a>
)}
<style>
  .btn {
    display: inline-block;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: inherit;
    line-height: normal;
    /* em, not rem: in-graphic CTAs live inside scaled stages and set their own font size on
       the wrapper; em padding keeps the button's shape at any register. At the site default
       16px this is byte-identical to the old 0.75rem/1.5rem. */
    padding: 0.75em 1.5em;
    border: 1px solid;
    border-radius: var(--radius-pill);
    text-decoration: none;
    cursor: pointer;
    transition: transform var(--t-fast) var(--ease-spring),
                background var(--t-fast) var(--ease-out),
                border-color var(--t-fast) var(--ease-out);
  }
  .btn:active { transform: scale(0.97); }

  /* plasma = go / action (principle 2). Filled plasma is the primary; the 1.0 "no filled
     plasma anywhere" ruling belonged to the flat console look and is retired with it. */
  .cta-hard {
    color: var(--carbon);
    background: var(--plasma);
    border-color: var(--plasma);
    box-shadow: var(--shadow-md);
  }
  .cta-hard:hover { background: var(--plasma-dim); border-color: var(--plasma-dim); color: var(--carbon); }

  .cta-soft { color: var(--bone); background: var(--iron); border-color: var(--iron-3); box-shadow: var(--shadow-sm); }
  .cta-soft:hover { color: var(--bone); border-color: var(--bone-faint); }

  .cta-plasma-outline { color: var(--bone); background: var(--plasma-glow); border-color: var(--plasma); }
  .cta-plasma-outline:hover { color: var(--carbon); background: var(--plasma); }
</style>
