---
// Renders an <a> link by default, a modal-trigger <button> when `dialogTarget`
// is set (flagship cards' Learn More popovers), or the email download-gate trigger
// when `downloadGate` is set.
interface Props { href?: string; label: string; kind?: 'hard' | 'soft' | 'plasma-outline'; dialogTarget?: string; downloadGate?: boolean }
const { href, label, kind = 'soft', dialogTarget, downloadGate } = Astro.props;
---
{downloadGate ? (
  <button type="button" class={`btn cta-${kind}`} data-download-open>[ {label.toUpperCase()} ]</button>
) : dialogTarget ? (
  <button type="button" class={`btn cta-${kind}`} data-dialog-open={dialogTarget}>[ {label.toUpperCase()} ]</button>
) : (
  <a class={`btn cta-${kind}`} href={href}>[ {label.toUpperCase()} ]</a>
)}
<style>
  .btn {
    display: inline-block;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: inherit;
    line-height: normal;
    padding: 0.75rem 1.25rem;
    border: 1px solid;
    border-radius: var(--radius);
    text-decoration: none;
    cursor: pointer;
  }
  .cta-hard { color: var(--carbon); background: var(--plasma); border-color: var(--plasma); }
  .cta-hard:hover { background: var(--plasma-dim); border-color: var(--plasma-dim); color: var(--carbon); }
  .cta-soft { color: var(--bone); background: transparent; border-color: var(--bone-faint); }
  .cta-soft:hover { color: var(--bone); border-color: var(--bone); }
  .cta-plasma-outline { color: var(--plasma); background: transparent; border-color: var(--plasma); }
  .cta-plasma-outline:hover { color: var(--plasma-dim); border-color: var(--plasma-dim); }
</style>
