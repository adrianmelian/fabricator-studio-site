---
// THE ARMATURE LANDING SHOT (Adrian's ruling, 2026-08-19, made on the homepage build:
// "The armature shot with height man... This is the opening scene on the Armature page").
// The room from the homepage cinematic -- star shell, floor grid, five-mip bloom -- with
// the height man standing SOLID in the x-ray fresnel, the state he holds after the scan.
// Click-drag peeks around him on the same elastic orbit the homepage taught.
//
// This is a BACKDROP, not a page: it fills the hero header behind the ruled copy, and on
// success it sets data-stage-live on the header, which hides the static art and its scrim
// (they stay in the DOM as the fallback for no-WebGL2, reduced motion, and under 900px).
// The shaders and constants are the homepage's (PointCloudHero.astro), trimmed to this
// shot; if the two drift, the homepage is the source of truth. CAM here = CAM_C there,
// still Adrian's to dial.
---

<canvas class="ast-canvas" data-armature-stage aria-hidden="true"></canvas>

<style>
  .ast-canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 500ms ease-out;
  }
  .ast-canvas[data-ready] { opacity: 1; }
  @media (max-width: 900px) {
    .ast-canvas { display: none; }
  }
</style>

<script>
  const canvas = document.querySelector('[data-armature-stage]') as HTMLCanvasElement | null;

  function lerp(a: number, b: number, t: number) { return a + (b - a) * t; }
  function mulberry32(a: number) {
    return function () {
      a |= 0; a = (a + 0x6D2B79F5) | 0;
      let t = Math.imul(a ^ (a >>> 15), 1 | a);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }
  function perspective(fovDeg: number, aspect: number, near: number, far: number) {
    const f = 1 / Math.tan((fovDeg * Math.PI) / 360), out = new Float32Array(16);
    out[0] = f / aspect; out[5] = f; out[10] = (far + near) / (near - far); out[11] = -1;
    out[14] = (2 * far * near) / (near - far);
    return out;
  }
  function lookAt(eye: number[], target: number[], up: number[]) {
    const z = norm(sub(eye, target)), x = norm(cross(up, z)), y = cross(z, x);
    return new Float32Array([
      x[0], y[0], z[0], 0, x[1], y[1], z[1], 0, x[2], y[2], z[2], 0,
      -dot(x, eye), -dot(y, eye), -dot(z, eye), 1]);
  }
  const sub = (a: number[], b: number[]) => [a[0] - b[0], a[1] - b[1], a[2] - b[2]];
  const cross = (a: number[], b: number[]) => [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]];
  const dot = (a: number[], b: number[]) => a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
  const norm = (a: number[]) => { const l = Math.hypot(a[0], a[1], a[2]) || 1; return [a[0] / l, a[1] / l, a[2] / l]; };

  async function run(canvas: HTMLCanvasElement, gl: WebGL2RenderingContext) {
    const HDR = gl.getExtension('EXT_color_buffer_float') ? gl.RGBA16F : gl.RGBA8;
    gl.getExtension('OES_texture_float_linear');

    const sh = (type: number, src: string) => {
      const s = gl.createShader(type)!; gl.shaderSource(s, src); gl.compileShader(s);
      if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(s) || 'shader');
      return s;
    };
    const prog = (vs: string, fs: string) => {
      const p = gl.createProgram()!;
      gl.attachShader(p, sh(gl.VERTEX_SHADER, vs)); gl.attachShader(p, sh(gl.FRAGMENT_SHADER, fs));
      gl.linkProgram(p);
      if (!gl.getProgramParameter(p, gl.LINK_STATUS)) throw new Error(gl.getProgramInfoLog(p) || 'link');
      const u: Record<string, WebGLUniformLocation | null> = {};
      const n = gl.getProgramParameter(p, gl.ACTIVE_UNIFORMS);
      for (let i = 0; i < n; i++) {
        const nm = gl.getActiveUniform(p, i)!.name.replace('[0]', '');
        u[nm] = gl.getUniformLocation(p, nm);
      }
      return { p, u };
    };
    const target = (w: number, h: number, fmt: number) => {
      const t = gl.createTexture()!;
      gl.bindTexture(gl.TEXTURE_2D, t);
      gl.texImage2D(gl.TEXTURE_2D, 0, fmt, w, h, 0, gl.RGBA, fmt === gl.RGBA16F ? gl.HALF_FLOAT : gl.UNSIGNED_BYTE, null);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
      const f = gl.createFramebuffer()!;
      gl.bindFramebuffer(gl.FRAMEBUFFER, f);
      gl.framebufferTexture2D(gl.FRAMEBUFFER, gl.COLOR_ATTACHMENT0, gl.TEXTURE_2D, t, 0);
      gl.bindFramebuffer(gl.FRAMEBUFFER, null);
      return { f, t, w, h };
    };

    const XRAY_VS = `#version 300 es
in vec3 aPos; in vec3 aNor;
uniform mat4 uProj, uView;
out vec3 vN; out vec3 vV;
void main() {
  vec4 mv = uView * vec4(aPos, 1.0);
  gl_Position = uProj * mv;
  vN = mat3(uView) * aNor;
  vV = -mv.xyz;
}`;
    const XRAY_FS = `#version 300 es
precision highp float;
uniform vec3 uPlasma, uBone;
uniform float uAlpha;
in vec3 vN; in vec3 vV;
out vec4 frag;
void main() {
  float rim = pow(1.0 - abs(dot(normalize(vN), normalize(vV))), 3.0);
  vec3 c = mix(uBone * 0.04, mix(uBone, uPlasma, 0.55), rim * 0.55);
  frag = vec4(c * uAlpha, 1.0);
}`;
    const STAR_VS = `#version 300 es
in vec3 aPos; in vec3 aSeed;
uniform mat4 uProj, uView; uniform float uTime, uSpeed;
out float vB;
void main() {
  float a = uTime * uSpeed;
  float c = cos(a), s = sin(a);
  vec3 p = vec3(aPos.x * c - aPos.z * s, aPos.y, aPos.x * s + aPos.z * c);
  vec4 mv = uView * vec4(p, 1.0);
  gl_Position = uProj * mv;
  gl_PointSize = max(aSeed.z * (300.0 / -mv.z), 1.0);
  vB = aSeed.y * (0.75 + 0.25 * sin(uTime * 0.6 + aSeed.x));
}`;
    const STAR_FS = `#version 300 es
precision highp float;
uniform vec3 uBone; uniform float uBright;
in float vB; out vec4 frag;
void main() {
  vec2 d = gl_PointCoord - vec2(0.5);
  float r = dot(d, d);
  if (r > 0.25) discard;
  frag = vec4(uBone * vB * uBright, smoothstep(0.25, 0.0, r));
}`;
    const GRID_VS = `#version 300 es
in vec3 aPos; uniform mat4 uProj, uView; out float vDist;
void main() { vec4 mv = uView * vec4(aPos, 1.0); vDist = -mv.z; gl_Position = uProj * mv; }`;
    const GRID_FS = `#version 300 es
precision highp float;
uniform vec3 uColor, uFogColor; uniform float uOpacity, uFogNear, uFogFar;
in float vDist; out vec4 frag;
void main() {
  float f = clamp((uFogFar - vDist) / (uFogFar - uFogNear), 0.0, 1.0);
  frag = vec4(mix(uFogColor, uColor, f), uOpacity * f);
}`;
    const QUAD_VS = `#version 300 es
in vec2 aPos; out vec2 vUv;
void main() { vUv = aPos * 0.5 + 0.5; gl_Position = vec4(aPos, 0.0, 1.0); }`;
    const BRIGHT_FS = `#version 300 es
precision highp float;
uniform sampler2D uTex; uniform float uThreshold, uKnee;
in vec2 vUv; out vec4 frag;
void main() {
  vec3 c = texture(uTex, vUv).rgb;
  float l = dot(c, vec3(0.2126, 0.7152, 0.0722));
  frag = vec4(c * smoothstep(uThreshold, uThreshold + uKnee, l), 1.0);
}`;
    const BLUR_FS = `#version 300 es
precision highp float;
uniform sampler2D uTex; uniform vec2 uDir, uTexel;
in vec2 vUv; out vec4 frag;
void main() {
  vec3 c = texture(uTex, vUv).rgb * 0.2270270270;
  vec2 o = uDir * uTexel;
  c += (texture(uTex, vUv + o).rgb + texture(uTex, vUv - o).rgb) * 0.1945945946;
  c += (texture(uTex, vUv + o * 2.0).rgb + texture(uTex, vUv - o * 2.0).rgb) * 0.1216216216;
  c += (texture(uTex, vUv + o * 3.0).rgb + texture(uTex, vUv - o * 3.0).rgb) * 0.0540540541;
  c += (texture(uTex, vUv + o * 4.0).rgb + texture(uTex, vUv - o * 4.0).rgb) * 0.0162162162;
  frag = vec4(c, 1.0);
}`;
    const COMP_FS = `#version 300 es
precision highp float;
uniform sampler2D uScene, uM0, uM1, uM2, uM3, uM4;
uniform float uStrength, uRadius;
in vec2 vUv; out vec4 frag;
float lf(float f, float r) { return mix(f, 1.2 - f, r); }
void main() {
  vec3 b = lf(1.0, uRadius) * texture(uM0, vUv).rgb
         + lf(0.8, uRadius) * texture(uM1, vUv).rgb
         + lf(0.6, uRadius) * texture(uM2, vUv).rgb
         + lf(0.4, uRadius) * texture(uM3, vUv).rgb
         + lf(0.2, uRadius) * texture(uM4, vUv).rgb;
  frag = vec4(texture(uScene, vUv).rgb + b * uStrength, 1.0);
}`;

    const P_XRAY = prog(XRAY_VS, XRAY_FS);
    const P_STAR = prog(STAR_VS, STAR_FS);
    const P_GRID = prog(GRID_VS, GRID_FS);
    const P_BRIGHT = prog(QUAD_VS, BRIGHT_FS);
    const P_BLUR = prog(QUAD_VS, BLUR_FS);
    const P_COMP = prog(QUAD_VS, COMP_FS);

    const quadVao = gl.createVertexArray()!;
    gl.bindVertexArray(quadVao);
    const qb = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, qb);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    gl.enableVertexAttribArray(0);
    gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);

    function makeGrid(size: number, divs: number) {
      const half = size / 2, step = size / divs, v: number[] = [];
      for (let i = 0; i <= divs; i++) {
        const q = -half + i * step;
        v.push(-half, 0, q, half, 0, q, q, 0, -half, q, 0, half);
      }
      const vao = gl.createVertexArray()!;
      gl.bindVertexArray(vao);
      const b = gl.createBuffer();
      gl.bindBuffer(gl.ARRAY_BUFFER, b);
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array(v), gl.STATIC_DRAW);
      gl.enableVertexAttribArray(0);
      gl.vertexAttribPointer(0, 3, gl.FLOAT, false, 0, 0);
      return { vao, count: v.length / 3 };
    }
    const gridFine = makeGrid(20, 200);
    const gridSect = makeGrid(20, 20);

    // The same sky as the homepage: same seed, same shell.
    const STAR_N = 2600;
    const starVao = gl.createVertexArray()!;
    {
      const rs = mulberry32(1 ^ 0xBADC0DE);
      const sp = new Float32Array(STAR_N * 3), ss = new Float32Array(STAR_N * 3);
      for (let i = 0; i < STAR_N; i++) {
        const az = rs() * Math.PI * 2;
        const rad = 4 + rs() * 9;
        const h = rs();
        sp[i * 3] = Math.cos(az) * rad;
        sp[i * 3 + 1] = 0.2 + 12.8 * h;
        sp[i * 3 + 2] = Math.sin(az) * rad;
        ss[i * 3] = rs() * Math.PI * 2;
        ss[i * 3 + 1] = 0.55 + rs() * 0.45;
        ss[i * 3 + 2] = 0.02 + (0.35 - 0.02) * rs();
      }
      gl.bindVertexArray(starVao);
      const sattr = (name: string, data: Float32Array, sz: number) => {
        const loc = gl.getAttribLocation(P_STAR.p, name);
        if (loc < 0) return;
        const b = gl.createBuffer();
        gl.bindBuffer(gl.ARRAY_BUFFER, b);
        gl.bufferData(gl.ARRAY_BUFFER, data, gl.STATIC_DRAW);
        gl.enableVertexAttribArray(loc);
        gl.vertexAttribPointer(loc, sz, gl.FLOAT, false, 0, 0);
      };
      sattr('aPos', sp, 3);
      sattr('aSeed', ss, 3);
    }

    // The man: FSMH parsed and normalised exactly as the homepage does it (largest
    // dimension 2.1, stood on y=0), indexed, drawn as the fresnel shell only.
    const buf = await (await fetch('/mesh/height_man.mesh')).arrayBuffer();
    const dv = new DataView(buf);
    if (String.fromCharCode(dv.getUint8(0), dv.getUint8(1), dv.getUint8(2), dv.getUint8(3)) !== 'FSMH')
      throw new Error('bad mesh');
    const nv = dv.getUint32(4, true), ni = dv.getUint32(8, true);
    let off = 12;
    const rawPos = new Float32Array(buf.slice(off, off + nv * 12)); off += nv * 12;
    const rawNor = new Float32Array(buf.slice(off, off + nv * 12)); off += nv * 12;
    const idx = new Uint16Array(buf.slice(off, off + ni * 2));
    const mn = [Infinity, Infinity, Infinity], mx = [-Infinity, -Infinity, -Infinity];
    for (let i = 0; i < rawPos.length; i += 3)
      for (let k = 0; k < 3; k++) {
        if (rawPos[i + k] < mn[k]) mn[k] = rawPos[i + k];
        if (rawPos[i + k] > mx[k]) mx[k] = rawPos[i + k];
      }
    const size = [mx[0] - mn[0], mx[1] - mn[1], mx[2] - mn[2]];
    const sc = 2.1 / Math.max(size[0], size[1], size[2], 1e-6);
    const ctr = [(mn[0] + mx[0]) / 2, (mn[1] + mx[1]) / 2, (mn[2] + mx[2]) / 2];
    const pos = new Float32Array(rawPos.length);
    for (let i = 0; i < pos.length; i += 3) {
      pos[i] = (rawPos[i] - ctr[0]) * sc;
      pos[i + 1] = (rawPos[i + 1] - ctr[1]) * sc + (size[1] * sc) / 2;
      pos[i + 2] = (rawPos[i + 2] - ctr[2]) * sc;
    }
    const manVao = gl.createVertexArray()!;
    gl.bindVertexArray(manVao);
    const battr = (name: string, data: Float32Array, sz: number) => {
      const loc = gl.getAttribLocation(P_XRAY.p, name);
      if (loc < 0) return;
      const b = gl.createBuffer();
      gl.bindBuffer(gl.ARRAY_BUFFER, b);
      gl.bufferData(gl.ARRAY_BUFFER, data, gl.STATIC_DRAW);
      gl.enableVertexAttribArray(loc);
      gl.vertexAttribPointer(loc, sz, gl.FLOAT, false, 0, 0);
    };
    battr('aPos', pos, 3);
    battr('aNor', rawNor, 3);
    const ib = gl.createBuffer();
    gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, ib);
    gl.bufferData(gl.ELEMENT_ARRAY_BUFFER, idx, gl.STATIC_DRAW);

    const hex = (h: string) => new Float32Array([
      parseInt(h.slice(1, 3), 16) / 255, parseInt(h.slice(3, 5), 16) / 255, parseInt(h.slice(5, 7), 16) / 255]);
    const CARBON = hex('#0B0E10'), IRON2 = hex('#262C33'), IRON3 = hex('#353D45');
    const PLASMA = hex('#7CFFB2'), BONE = hex('#E8E0D0');

    // CAM_C from the homepage, still Adrian's to dial.
    const CAM = { yaw: 0, pitch: -0.02, dist: 3.7, tx: 0, ty: 1.02, tz: 0, fov: 42 };

    let T: any = null;
    const DPR = Math.min(devicePixelRatio || 1, 2);
    function resize() {
      const w = Math.max(1, Math.round(canvas.clientWidth * DPR));
      const h = Math.max(1, Math.round(canvas.clientHeight * DPR));
      if (canvas.width === w && canvas.height === h && T) return;
      canvas.width = w; canvas.height = h;
      if (T) for (const t of [T.scene, T.bright, ...T.mips, ...T.ping]) { gl.deleteTexture(t.t); gl.deleteFramebuffer(t.f); }
      T = { scene: target(w, h, HDR), bright: target(w >> 1, h >> 1, HDR), mips: [] as any[], ping: [] as any[] };
      let mw = w, mh = h;
      for (let i = 0; i < 5; i++) {
        mw = Math.max(1, mw >> 1); mh = Math.max(1, mh >> 1);
        T.mips.push(target(mw, mh, HDR)); T.ping.push(target(mw, mh, HDR));
      }
    }
    const quad = (pr: any, setup: (u: any) => void) => {
      gl.useProgram(pr.p); gl.bindVertexArray(quadVao); setup(pr.u); gl.drawArrays(gl.TRIANGLES, 0, 3);
    };
    const bindTex = (loc: any, tex: any, unit: number) => {
      gl.activeTexture(gl.TEXTURE0 + unit); gl.bindTexture(gl.TEXTURE_2D, tex); gl.uniform1i(loc, unit);
    };

    // The homepage's elastic orbit, scoped to the hero: drag anywhere on the header that
    // is not a link, button, or the reel.
    let orbY = 0, orbP = 0, orbVY = 0, orbVP = 0, orbDrag = false, orbLast: number[] | null = null;
    const ORB_LIM_Y = 0.24, ORB_LIM_P = 0.13;
    const hero = canvas.closest('.hero--art') as HTMLElement | null;
    hero?.addEventListener('pointerdown', (e) => {
      if (e.button !== 0 || e.pointerType !== 'mouse') return;
      const t = e.target as HTMLElement;
      if (t.closest('a, button, video, figure, input')) return;
      orbDrag = true;
      orbLast = [e.clientX, e.clientY];
      e.preventDefault();
    });
    document.addEventListener('pointermove', (e) => {
      if (!orbDrag || !orbLast) return;
      orbY -= (e.clientX - orbLast[0]) * 0.004;
      orbP += (e.clientY - orbLast[1]) * 0.003;
      orbVY = 0; orbVP = 0;
      orbLast = [e.clientX, e.clientY];
    });
    addEventListener('pointerup', () => { orbDrag = false; });

    let time = 0, prev = 0, ready = false;
    function frame(now: number) {
      requestAnimationFrame(frame);
      // Nothing draws while the hero is off screen; the loop idles at a rect check.
      const r = canvas.getBoundingClientRect();
      if (r.bottom < 0 || r.top > innerHeight) return;
      const dt = Math.min(0.05, (now - prev) / 1000 || 0);
      prev = now;
      resize();
      time += dt;

      if (!orbDrag) {
        orbVY += (-60 * orbY - 10 * orbVY) * dt; orbY += orbVY * dt;
        orbVP += (-60 * orbP - 10 * orbVP) * dt; orbP += orbVP * dt;
      }
      const oy = Math.tanh(orbY / ORB_LIM_Y) * ORB_LIM_Y;
      const op = Math.tanh(orbP / ORB_LIM_P) * ORB_LIM_P;

      const tgt = [CAM.tx, CAM.ty, CAM.tz];
      const yaw = CAM.yaw + oy, pitch = CAM.pitch + op;
      const eye = [
        tgt[0] + CAM.dist * Math.cos(pitch) * Math.sin(yaw),
        tgt[1] + CAM.dist * Math.sin(pitch),
        tgt[2] + CAM.dist * Math.cos(pitch) * Math.cos(yaw)];
      const view = lookAt(eye, tgt, [0, 1, 0]);
      const proj = perspective(CAM.fov, canvas.width / canvas.height, 0.01, 100);

      gl.bindFramebuffer(gl.FRAMEBUFFER, T.scene.f);
      gl.viewport(0, 0, canvas.width, canvas.height);
      gl.clearColor(CARBON[0], CARBON[1], CARBON[2], 1);
      gl.clear(gl.COLOR_BUFFER_BIT);
      gl.disable(gl.DEPTH_TEST);
      gl.enable(gl.BLEND);

      gl.blendFunc(gl.SRC_ALPHA, gl.ONE);
      gl.useProgram(P_STAR.p);
      gl.uniformMatrix4fv(P_STAR.u.uProj, false, proj);
      gl.uniformMatrix4fv(P_STAR.u.uView, false, view);
      gl.uniform1f(P_STAR.u.uTime, time);
      gl.uniform1f(P_STAR.u.uSpeed, 0.015);
      gl.uniform1f(P_STAR.u.uBright, 1.0);
      gl.uniform3fv(P_STAR.u.uBone, BONE);
      gl.bindVertexArray(starVao);
      gl.drawArrays(gl.POINTS, 0, STAR_N);

      gl.blendFunc(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA);
      gl.useProgram(P_GRID.p);
      gl.uniformMatrix4fv(P_GRID.u.uProj, false, proj);
      gl.uniformMatrix4fv(P_GRID.u.uView, false, view);
      gl.uniform3fv(P_GRID.u.uFogColor, CARBON);
      gl.uniform1f(P_GRID.u.uFogNear, 2.0);
      gl.uniform1f(P_GRID.u.uFogFar, 14.0);
      for (const [g, col, opq] of [[gridFine, IRON2, 0.55], [gridSect, IRON3, 1.0]] as const) {
        gl.uniform3fv(P_GRID.u.uColor, col);
        gl.uniform1f(P_GRID.u.uOpacity, opq);
        gl.bindVertexArray(g.vao);
        gl.drawArrays(gl.LINES, 0, g.count);
      }

      gl.blendFunc(gl.SRC_ALPHA, gl.ONE);
      gl.useProgram(P_XRAY.p);
      gl.uniformMatrix4fv(P_XRAY.u.uProj, false, proj);
      gl.uniformMatrix4fv(P_XRAY.u.uView, false, view);
      gl.uniform3fv(P_XRAY.u.uPlasma, PLASMA);
      gl.uniform3fv(P_XRAY.u.uBone, BONE);
      gl.uniform1f(P_XRAY.u.uAlpha, 0.5);
      gl.bindVertexArray(manVao);
      gl.drawElements(gl.TRIANGLES, ni, gl.UNSIGNED_SHORT, 0);
      gl.disable(gl.BLEND);

      gl.bindFramebuffer(gl.FRAMEBUFFER, T.bright.f);
      gl.viewport(0, 0, T.bright.w, T.bright.h);
      quad(P_BRIGHT, (u2) => {
        bindTex(u2.uTex, T.scene.t, 0);
        gl.uniform1f(u2.uThreshold, 0.3);
        gl.uniform1f(u2.uKnee, 0.15);
      });
      let src = T.bright;
      for (let i = 0; i < 5; i++) {
        const mip = T.mips[i], png = T.ping[i];
        gl.bindFramebuffer(gl.FRAMEBUFFER, png.f);
        gl.viewport(0, 0, png.w, png.h);
        quad(P_BLUR, (u2) => {
          bindTex(u2.uTex, src.t, 0);
          gl.uniform2f(u2.uDir, 1, 0);
          gl.uniform2f(u2.uTexel, 1 / png.w, 1 / png.h);
        });
        gl.bindFramebuffer(gl.FRAMEBUFFER, mip.f);
        gl.viewport(0, 0, mip.w, mip.h);
        quad(P_BLUR, (u2) => {
          bindTex(u2.uTex, png.t, 0);
          gl.uniform2f(u2.uDir, 0, 1);
          gl.uniform2f(u2.uTexel, 1 / mip.w, 1 / mip.h);
        });
        src = mip;
      }
      gl.bindFramebuffer(gl.FRAMEBUFFER, null);
      gl.viewport(0, 0, canvas.width, canvas.height);
      quad(P_COMP, (u2) => {
        bindTex(u2.uScene, T.scene.t, 0);
        for (let i = 0; i < 5; i++) bindTex(u2['uM' + i], T.mips[i].t, i + 1);
        gl.uniform1f(u2.uStrength, 2.4);
        gl.uniform1f(u2.uRadius, 0.34);
      });

      if (!ready) {
        ready = true;
        canvas.setAttribute('data-ready', '');
        hero?.setAttribute('data-stage-live', '');
      }
    }
    resize();
    requestAnimationFrame(frame);
  }

  if (
    canvas &&
    matchMedia('(min-width: 901px)').matches &&
    !matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    const gl = canvas.getContext('webgl2', { antialias: false });
    if (gl) {
      run(canvas, gl).catch((err) => {
        // The static art never left the DOM; a failed stage simply never hides it.
        console.error('[armature-stage]', err);
      });
    }
  }
</script>
