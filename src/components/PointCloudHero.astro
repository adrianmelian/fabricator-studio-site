        const h = rs();
        sp[i * 3] = Math.cos(az) * rad;
        sp[i * 3 + 1] = 0.2 + 12.8 * h;
        sp[i * 3 + 2] = Math.sin(az) * rad;
        ss[i * 3] = rs() * Math.PI * 2;
        ss[i * 3 + 1] = 0.55 + rs() * 0.45;
        // linear spread: enough mid-size stars that the field reads as present, with the
        // extremes still carrying a few heroes and a dust of faint ones
        ss[i * 3 + 2] = P.starSizeMin + (P.starSizeMax - P.starSizeMin) * rs();
