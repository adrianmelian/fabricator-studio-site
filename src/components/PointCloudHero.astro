    // the wordmark is, so the offset is simply the gap between them. Measured with the offset
    // cleared, so repeat calls never compound.
    // document, not host: the copy moved to its own fixed layer BESIDE the stage so the
    // buttons could sit above the video's z1, so these are no longer the host's descendants.
    const wmEl = document.querySelector('[data-pc-wordmark]') as HTMLElement;
    const ctaEl = document.querySelector('[data-pc-cta]') as HTMLElement;
    let ctaRest: DOMRect | null = null;
