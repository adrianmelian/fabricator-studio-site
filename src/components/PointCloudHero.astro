    // The hero video is promoted from an in-flow section to a fixed layer at z1, between the
    // scene (z0) and the copy (z2). It does not scroll up; it FADES IN in place over the
    // scene as the cloud explodes (Adrian, 2026-08-19). [data-cine] carries the promotion so
    // the fallback paths, which never set it, keep the section's normal in-flow life.
    const heroSec = document.getElementById('hero');
    heroSec?.setAttribute('data-cine', '');

    function frame(now: number) {
      requestAnimationFrame(frame);
      const dt = Math.min(0.05, (now - prev) / 1000 || 0);
      prev = now;
      if (resize()) relayout();

      // The opening's beats are ruled against 1.6 screens of scroll, HARDCODED so growing
      // the runway for later beats can never retime what Adrian already approved. The
      // toolset beat takes the next 1.2 screens.
      const p = clamp01(scrollY / Math.max(1, innerHeight * 1.6));
      const pt = clamp01((scrollY - innerHeight * 1.6) / Math.max(1, innerHeight * 1.2));

      const tCam = smooth(clamp01(p / 0.45));
      const explode = clamp01((p - 0.62) / 0.38);
      // documentElement, not host: the text lives on the sibling copy layer now, and a custom
      // property set on the stage does not cascade sideways.
      document.documentElement.style.setProperty('--pc-out', String(clamp01(p / 0.28)));

      // The video fades in through the explosion: it starts becoming visible as the points
      // scatter and owns the screen by the end of the runway.
      if (heroSec) heroSec.style.opacity = smooth(clamp01((p - 0.66) / 0.32)).toFixed(3);

      // The philosophy is STEPPED (Adrian, 2026-08-19): the studio line arrives with the
      // camera at beat B and stands until the video begins, then hands off to the refinement
      // line, which fades in with the footage and stays.
      const phil1 = smooth(clamp01((p - 0.30) / 0.15)) * (1 - smooth(clamp01((p - 0.64) / 0.12)));
      // ...and hands off again to the toolset beat: the refinement line clears before the
      // glass arrives, so the stage never says two things at once.
      const phil2 = smooth(clamp01((p - 0.70) / 0.15)) * (1 - smooth(clamp01(pt / 0.2)));
      document.documentElement.style.setProperty('--phil1', phil1.toFixed(3));
      document.documentElement.style.setProperty('--phil2', phil2.toFixed(3));

      // THE TOOLSET BEAT (Adrian, 2026-08-19): glass blurs over the settled video, then the
      // four tool interfaces float in over it. The layer itself is ToolsOverlay.astro.
      document.documentElement.style.setProperty('--glass', smooth(clamp01((pt - 0.1) / 0.3)).toFixed(3));
      document.documentElement.style.setProperty('--tools',
        (smooth(clamp01((pt - 0.35) / 0.4)) * (1 - smooth(clamp01((scrollY - innerHeight * 4.8) / (innerHeight * 0.3))))).toFixed(3));
      const tools = document.querySelector('[data-tools-overlay]') as HTMLElement | null;
      if (tools) {
        if (pt > 0.01) tools.setAttribute('data-active', '');
        else tools.removeAttribute('data-active');
        // THE CAROUSEL STEPS ON SCROLL (Adrian, 2026-08-19). Selection is a pure function
        // of scrollY: the entry ends at 2.5 screens with tool 0 standing, then every 0.4
        // screens of scroll snaps the next tool. Scrolling up steps back the same stairs.
        // The All Tools tile is a link, not a step. Pure-function-of-scroll also means a
        // reload mid-carousel lands on the right tool for free.
        const sel = Math.max(0, Math.min(5, Math.floor((scrollY - innerHeight * 2.5) / (innerHeight * 0.4)) + 1));
        if (tools.dataset.sel !== String(sel)) tools.dataset.sel = String(sel);
      }

      // THE ARMATURE BEAT (Adrian, 2026-08-19): the carousel clears and Armature rises on
      // the same glass. toolsOut multiplies the carousel's entry var, so its exit needs no
      // second opacity channel, and the carousel loses its clicks as soon as it starts to go.
      const toolsOut = smooth(clamp01((scrollY - innerHeight * 4.8) / (innerHeight * 0.3)));
      const arm = smooth(clamp01((scrollY - innerHeight * 5.0) / (innerHeight * 0.4)));
      document.documentElement.style.setProperty('--arm', arm.toFixed(3));
      const armEl = document.querySelector('[data-armature-overlay]');
      if (armEl) {
        if (arm > 0.01) armEl.setAttribute('data-active', '');
        else armEl.removeAttribute('data-active');
      }
      // The glass RIDES the carousel's layer, so that layer stays visible through Armature;
      // only its clicks leave. data-passive kills the pointer without killing the frost.
      if (tools) tools.toggleAttribute('data-passive', toolsOut > 0.5);

      // The buttons travel to centre-bottom on the camera's easing and stand above the
      // video, then FADE OUT as the toolset beat arrives (Adrian, 2026-08-19: the carousel
      // is that beat's own set of doors, and its strip lives where the buttons stood).
      if (ctaRest) {
        const rect = canvas.getBoundingClientRect();
        const dx = (rect.left + rect.width / 2) - (ctaRest.left + ctaRest.width / 2);
        const dy = (rect.top + rect.height - rect.height * P.ctaBottom - ctaRest.height) - ctaRest.top;
        ctaEl.style.transform = `translate(${(dx * tCam).toFixed(1)}px, ${(dy * tCam).toFixed(1)}px)`;
        const o = 1 - smooth(clamp01(pt / 0.16));
        ctaEl.style.opacity = o.toFixed(3);
        // visibility, NOT pointer-events: the anchors inside carry their own explicit
        // pointer-events auto (the layer is click-through), and none on the parent does not
        // beat an explicit value on a child, so invisible buttons stayed clickable.
        ctaEl.style.visibility = o < 0.05 ? 'hidden' : '';
      }

      time += dt;
      // The pluck does not run at the top of the page: the amplitude sits at rest so the
      // first thing anyone sees is the logo rather than a performance. wakeBlend CHASES the
      // scroll-derived target on a time constant instead of tracking it raw: scrolling back
      // to the top used to snap the wave to rest in a frame, which read as a pop (Adrian,
      // 2026-08-19). Now it settles. The phase is reset only once the blend has actually
      // arrived at rest, so the attack still fires from the start of its cycle every time
      // the mark wakes, never from mid-swing.
      const wakeTarget = P.wakeAt > 0 ? clamp01(p / P.wakeAt) : 1;
      wakeBlend += (wakeTarget - wakeBlend) * Math.min(1, dt * 4);
      if (wakeBlend > 0.005) oscPhase += dt * P.oscSpeed * Math.PI * 2;
      else { wakeBlend = 0; oscPhase = 0; }
      const u = (oscPhase / (Math.PI * 2)) % 1;
      const tAmp = u < P.oscAttack
        ? u / P.oscAttack
        : Math.pow(1 - (u - P.oscAttack) / (1 - P.oscAttack), P.oscShape);
      const amp = lerp(P.restAmp, P.oscLow + (P.oscHigh - P.oscLow) * tAmp, wakeBlend) * lerp(1, 1.45, clamp01(p / 0.45));

      // Elastic orbit: spring the raw offset home when released (underdamped on purpose,
      // the slight overshoot is the elasticity), then apply it through tanh so the limit
      // resists harder the further out the drag goes.
      if (!orbDrag) {
        orbVY += (-60 * orbY - 10 * orbVY) * dt; orbY += orbVY * dt;
        orbVP += (-60 * orbP - 10 * orbVP) * dt; orbP += orbVP * dt;
      }
      const oy = Math.tanh(orbY / ORB_LIM_Y) * ORB_LIM_Y;
      const op = Math.tanh(orbP / ORB_LIM_P) * ORB_LIM_P;

      const c = {
        yaw: lerp(CAM_A.yaw, CAM_B.yaw, tCam) + oy, pitch: lerp(CAM_A.pitch, CAM_B.pitch, tCam) + op,
        dist: lerp(CAM_A.dist, CAM_B.dist, tCam), fov: lerp(CAM_A.fov, CAM_B.fov, tCam),
        tx: lerp(CAM_A.tx, CAM_B.tx, tCam), ty: lerp(CAM_A.ty, CAM_B.ty, tCam), tz: lerp(CAM_A.tz, CAM_B.tz, tCam),
      };
      const tgt = [c.tx, c.ty, c.tz];
      const eye = [
        tgt[0] + c.dist * Math.cos(c.pitch) * Math.sin(c.yaw),
        tgt[1] + c.dist * Math.sin(c.pitch),
        tgt[2] + c.dist * Math.cos(c.pitch) * Math.cos(c.yaw)];
      const view = lookAt(eye, tgt, [0, 1, 0]);
      const proj = perspective(c.fov, canvas.width / canvas.height, 0.01, 100);
      const camDir = new Float32Array(norm(sub(tgt, eye)));

      gl.bindFramebuffer(gl.FRAMEBUFFER, T.scene.f);
      gl.viewport(0, 0, canvas.width, canvas.height);
      gl.clearColor(CARBON[0], CARBON[1], CARBON[2], 1);
      gl.clear(gl.COLOR_BUFFER_BIT);
      gl.disable(gl.DEPTH_TEST);
      gl.enable(gl.BLEND);

      // Stars first, additive, so the grid's alpha lines read over them and the room keeps
      // its floor. They ignore every beat: the sky does not care about the explosion.
      gl.blendFunc(gl.SRC_ALPHA, gl.ONE);
      gl.useProgram(P_STAR.p);
      gl.uniformMatrix4fv(P_STAR.u.uProj, false, proj);
      gl.uniformMatrix4fv(P_STAR.u.uView, false, view);
      gl.uniform1f(P_STAR.u.uTime, time);
      gl.uniform1f(P_STAR.u.uSpeed, P.starSpeed);
      gl.uniform1f(P_STAR.u.uBright, P.starBright);
      gl.uniform3fv(P_STAR.u.uBone, BONE);
      gl.bindVertexArray(starVao);
      gl.drawArrays(gl.POINTS, 0, P.starCount);

      // grid on normal alpha, then the cloud additive over it
      gl.blendFunc(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA);
      gl.useProgram(P_GRID.p);
      gl.uniformMatrix4fv(P_GRID.u.uProj, false, proj);
      gl.uniformMatrix4fv(P_GRID.u.uView, false, view);
      gl.uniform3fv(P_GRID.u.uFogColor, CARBON);
      gl.uniform1f(P_GRID.u.uFogNear, P.fogNear);
      gl.uniform1f(P_GRID.u.uFogFar, P.fogFar);
      for (const [g, col, op] of [[gridFine, IRON2, 0.55], [gridSect, IRON3, 1.0]] as const) {
        gl.uniform3fv(P_GRID.u.uColor, col);
        gl.uniform1f(P_GRID.u.uOpacity, op * P.gridOpacity);
        gl.bindVertexArray(g.vao);
        gl.drawArrays(gl.LINES, 0, g.count);
      }

      gl.blendFunc(gl.SRC_ALPHA, gl.ONE);
      gl.useProgram(P_POINT.p);
      const U = P_POINT.u;
      gl.uniformMatrix4fv(U.uProj, false, proj);
      gl.uniformMatrix4fv(U.uView, false, view);
      gl.uniform1f(U.uTime, time);
      gl.uniform1f(U.uAmp, amp);
      gl.uniform1f(U.uFreq, P.freq); gl.uniform1f(U.uRip, P.rip);
      gl.uniform1f(U.uFreq2, P.freq2); gl.uniform1f(U.uRip2, P.rip2); gl.uniform1f(U.uMix2, P.mix2);
      gl.uniform1f(U.uSize, P.size);
      gl.uniform1f(U.uCFreq, P.cFreq); gl.uniform1f(U.uCSpread, P.cSpread);
      gl.uniform1f(U.uFadeDepth, P.fadeDepth);
      gl.uniform1f(U.uExplode, explode);
      gl.uniform1f(U.uExDist, P.exDist); gl.uniform1f(U.uExCurl, P.exCurl); gl.uniform1f(U.uExCam, P.exCam);
      gl.uniform3fv(U.uCamDir, camDir);
      gl.uniform3fv(U.uPlasma, PLASMA); gl.uniform3fv(U.uEmber, EMBER); gl.uniform3fv(U.uBone, BONE);
      gl.bindVertexArray(cloudVao);
      gl.drawArrays(gl.POINTS, 0, N);
      gl.disable(gl.BLEND);

      gl.bindFramebuffer(gl.FRAMEBUFFER, T.bright.f);
      gl.viewport(0, 0, T.bright.w, T.bright.h);
      quad(P_BRIGHT, (u2) => {
        bindTex(u2.uTex, T.scene.t, 0);
        gl.uniform1f(u2.uThreshold, P.bloomThreshold);
        gl.uniform1f(u2.uKnee, P.bloomKnee);
      });
      let src = T.bright;
      for (let i = 0; i < 5; i++) {
        const mip = T.mips[i], png = T.ping[i];
        gl.bindFramebuffer(gl.FRAMEBUFFER, png.f);
        gl.viewport(0, 0, png.w, png.h);
        quad(P_BLUR, (u2) => {
          bindTex(u2.uTex, src.t, 0);
          gl.uniform2f(u2.uDir, 1, 0);
          gl.uniform2f(u2.uTexel, 1 / png.w, 1 / png.h);
        });
        gl.bindFramebuffer(gl.FRAMEBUFFER, mip.f);
        gl.viewport(0, 0, mip.w, mip.h);
        quad(P_BLUR, (u2) => {
          bindTex(u2.uTex, png.t, 0);
          gl.uniform2f(u2.uDir, 0, 1);
          gl.uniform2f(u2.uTexel, 1 / mip.w, 1 / mip.h);
        });
        src = mip;
      }

      gl.bindFramebuffer(gl.FRAMEBUFFER, null);
      gl.viewport(0, 0, canvas.width, canvas.height);
      quad(P_COMP, (u2) => {
        bindTex(u2.uScene, T.scene.t, 0);
        for (let i = 0; i < 5; i++) bindTex(u2['uM' + i], T.mips[i].t, i + 1);
        gl.uniform1f(u2.uStrength, P.bloomStrength);
        gl.uniform1f(u2.uRadius, P.bloomRadius);
      });

      if (!ready) { ready = true; canvas.setAttribute('data-ready', ''); }
    }

    resize();
    relayout();
    addEventListener('resize', relayout);
    requestAnimationFrame(frame);
  }
</script>
