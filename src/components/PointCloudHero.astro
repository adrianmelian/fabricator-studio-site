    const gridSect = makeGrid(20, 20);

    // The star shell: seeded like the cloud, so every visitor sees the same sky. Radius 7-18
    // around the origin, height biased toward the horizon like a real sky, and never below
    // the floor: a star under the grid reads as a hole in the room, not a star.
    const starVao = gl.createVertexArray()!;
    {
      const rs = mulberry32(P.seed ^ 0xBADC0DE);
      const n = P.starCount;
      const sp = new Float32Array(n * 3), ss = new Float32Array(n * 3);
      for (let i = 0; i < n; i++) {
