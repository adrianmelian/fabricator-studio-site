precision highp float;
uniform sampler2D uTex; uniform vec2 uDir, uTexel;
in vec2 vUv; out vec4 frag;
void main() {
  vec3 c = texture(uTex, vUv).rgb * 0.2270270270;
  vec2 o = uDir * uTexel;
  c += (texture(uTex, vUv + o).rgb + texture(uTex, vUv - o).rgb) * 0.1945945946;
  c += (texture(uTex, vUv + o * 2.0).rgb + texture(uTex, vUv - o * 2.0).rgb) * 0.1216216216;
  c += (texture(uTex, vUv + o * 3.0).rgb + texture(uTex, vUv - o * 3.0).rgb) * 0.0540540541;
  c += (texture(uTex, vUv + o * 4.0).rgb + texture(uTex, vUv - o * 4.0).rgb) * 0.0162162162;
  frag = vec4(c, 1.0);
}`;

    // UnrealBloomPass's own factor curve, so `radius` behaves as it did on the dial.
    const COMP_FS = `#version 300 es
precision highp float;
uniform sampler2D uScene, uM0, uM1, uM2, uM3, uM4;
uniform float uStrength, uRadius;
in vec2 vUv; out vec4 frag;
float lf(float f, float r) { return mix(f, 1.2 - f, r); }
void main() {
  vec3 b = lf(1.0, uRadius) * texture(uM0, vUv).rgb
         + lf(0.8, uRadius) * texture(uM1, vUv).rgb
         + lf(0.6, uRadius) * texture(uM2, vUv).rgb
         + lf(0.4, uRadius) * texture(uM3, vUv).rgb
