        const b = gl.createBuffer();
        gl.bindBuffer(gl.ARRAY_BUFFER, b);
        gl.bufferData(gl.ARRAY_BUFFER, data, gl.STATIC_DRAW);
        gl.enableVertexAttribArray(loc);
        gl.vertexAttribPointer(loc, sz, gl.FLOAT, false, 0, 0);
      };
      sattr('aPos', sp, 3);
      sattr('aSeed', ss, 3);
    }

    // ---- mesh, baked at build time so no GLB container is parsed in the browser
    const buf = await (await fetch('/mesh/fs_logo.mesh')).arrayBuffer();
    const dv = new DataView(buf);
    if (String.fromCharCode(dv.getUint8(0), dv.getUint8(1), dv.getUint8(2), dv.getUint8(3)) !== 'FSMH')
      throw new Error('bad mesh');
    const nv = dv.getUint32(4, true), ni = dv.getUint32(8, true);
    let off = 12;
    const rawPos = new Float32Array(buf.slice(off, off + nv * 12)); off += nv * 12;
    const rawNor = new Float32Array(buf.slice(off, off + nv * 12)); off += nv * 12;
    const idx = new Uint16Array(buf.slice(off, off + ni * 2));

    // Normalise: largest dimension to 2.1, then STAND IT ON the grid rather than centring the
    // box, which would bury half the mark under y=0. A rigid shift moves every phase by one
    // constant, so the wave pattern is identical and the ruled preset reads as saved.
    const mn = [Infinity, Infinity, Infinity], mx = [-Infinity, -Infinity, -Infinity];
    for (let i = 0; i < rawPos.length; i += 3)
      for (let k = 0; k < 3; k++) {
        if (rawPos[i + k] < mn[k]) mn[k] = rawPos[i + k];
        if (rawPos[i + k] > mx[k]) mx[k] = rawPos[i + k];
      }
    const size = [mx[0] - mn[0], mx[1] - mn[1], mx[2] - mn[2]];
    const sc = 2.1 / Math.max(size[0], size[1], size[2], 1e-6);
    const ctr = [(mn[0] + mx[0]) / 2, (mn[1] + mx[1]) / 2, (mn[2] + mx[2]) / 2];
    const pos = new Float32Array(rawPos.length);
    for (let i = 0; i < pos.length; i += 3) {
      pos[i] = (rawPos[i] - ctr[0]) * sc;
      pos[i + 1] = (rawPos[i + 1] - ctr[1]) * sc + (size[1] * sc) / 2;
      pos[i + 2] = (rawPos[i + 2] - ctr[2]) * sc;
    }

    // ---- even surface sampling, area-weighted: density ignores tessellation
    const tri = idx.length / 3;
    const cum = new Float32Array(tri);
    let totalArea = 0;
    for (let t = 0; t < tri; t++) {
      const a = idx[t * 3] * 3, b = idx[t * 3 + 1] * 3, c = idx[t * 3 + 2] * 3;
      const ux = pos[b] - pos[a], uy = pos[b + 1] - pos[a + 1], uz = pos[b + 2] - pos[a + 2];
      const vx = pos[c] - pos[a], vy = pos[c + 1] - pos[a + 1], vz = pos[c + 2] - pos[a + 2];
      totalArea += 0.5 * Math.hypot(uy * vz - uz * vy, uz * vx - ux * vz, ux * vy - uy * vx);
      cum[t] = totalArea;
    }
    const rnd = mulberry32(P.seed);
    const N = P.count;
    const aPos = new Float32Array(N * 3), aNor = new Float32Array(N * 3);
    const aPhase = new Float32Array(N), aPhase2 = new Float32Array(N), aRand = new Float32Array(N * 3);
    const bmn = [Infinity, Infinity, Infinity], bmx = [-Infinity, -Infinity, -Infinity];
    for (let i = 0; i < N; i++) {
      const r = rnd() * totalArea;
      let lo = 0, hi = tri - 1;
      while (lo < hi) { const m = (lo + hi) >> 1; if (cum[m] < r) lo = m + 1; else hi = m; }
      const a = idx[lo * 3] * 3, b = idx[lo * 3 + 1] * 3, c = idx[lo * 3 + 2] * 3;
      let u = rnd(), v = rnd();
      if (u + v > 1) { u = 1 - u; v = 1 - v; }
      const w = 1 - u - v;
      for (let k = 0; k < 3; k++) {
        const pv = pos[a + k] * w + pos[b + k] * u + pos[c + k] * v;
        aPos[i * 3 + k] = pv;
        aNor[i * 3 + k] = rawNor[a + k] * w + rawNor[b + k] * u + rawNor[c + k] * v;
