    // ---- the loop. Progress is read in rAF, not from a scroll listener: touch momentum
    // stalls listeners and there is nothing to throttle when the loop is running anyway.
    const runwayEl = document.querySelector('[data-pc-runway]') as HTMLElement | null;
    let time = 0, oscPhase = 0, prev = 0, ready = false, wakeBlend = 0;

    // ---- ELASTIC ORBIT (Adrian, 2026-08-19). Click-drag peeks around the mark. The offset
    // feeds through tanh, so the bound is not a wall: displacement costs more the further
    // out it goes and the limit is only ever approached. Release springs back to the
    // composed framing, slightly underdamped so the return has the elasticity he asked
    // for. It must return to zero: the crossbar alignment and the whole composition are
