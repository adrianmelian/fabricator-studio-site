---
// Page-top watch card for docs pages whose tool has a published Quick Start video:
// the tutorials-rail card language (real thumbnail, play badge) as a horizontal banner.
// Promoted to shared furniture 2026-07-18 after the Armature trial. MAGMA universally
// (Adrian's 2026-07-18 test): YouTube's red, so every video card reads as YouTube.
import type { Tutorial } from '../data/tutorials';

interface Props {
  video: Tutorial;
  name?: string;
  sub?: string;
  tag?: string;
  eyebrow?: string;
}
const {
  video,
  name = video.name ?? video.title,
  sub = video.sub,
  tag = 'QUICK START',
  eyebrow = 'WATCH THE VIDEO',
} = Astro.props;
---
<a class="dw" href={video.href} target="_blank" rel="noopener" aria-label={`Watch ${video.title} on YouTube`}>
  <span class="dw__media">
    {video.thumb && <img class="dw__thumb" src={video.thumb} alt="" loading="lazy" />}
    <span class="dw__tag">{tag}</span>
    <span class="dw__play" aria-hidden="true"><span class="dw__triangle"></span></span>
  </span>
  <span class="dw__body">
    <span class="dw__eyebrow">{eyebrow}</span>
    <span class="dw__name">{name}</span>
    {sub && <span class="dw__sub">{sub}</span>}
  </span>
</a>

<style>
  .dw {
    display: grid;
    grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
    align-items: center;
    gap: 1.5rem;
    background: var(--carbon);
    border: 1px solid rgba(255, 59, 59, 0.35);
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none;
    box-shadow: var(--shadow-md), 0 0 40px -16px rgba(255, 59, 59, 0.25);
    transition: border-color var(--t-fast) var(--ease-out), box-shadow var(--t-fast) var(--ease-out);
  }
  .dw:hover { border-color: rgba(255, 59, 59, 0.6); box-shadow: var(--shadow-md), 0 0 48px -12px rgba(255, 59, 59, 0.4); }

  .dw__media { position: relative; aspect-ratio: 16 / 9; background: radial-gradient(120% 120% at 50% 40%, var(--iron), var(--carbon)); }
  .dw__thumb { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .dw__tag {
    position: absolute;
    left: 0.75rem;
    top: 0.6rem;
    z-index: 1;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    background: rgba(11, 14, 16, 0.75);
    color: var(--magma);
  }
  .dw__play { position: absolute; inset: 0; z-index: 1; display: flex; align-items: center; justify-content: center; background: rgba(11, 14, 16, 0.25); transition: background var(--t-fast) var(--ease-out); }
  .dw:hover .dw__play { background: rgba(11, 14, 16, 0.4); }
  .dw__play::before { content: ''; position: absolute; width: 3.25rem; height: 3.25rem; border-radius: 50%; background: rgba(255, 59, 59, 0.16); border: 2px solid rgba(255, 59, 59, 0.6); }
  .dw__triangle { position: relative; width: 0; height: 0; border-top: 0.7rem solid transparent; border-bottom: 0.7rem solid transparent; border-left: 1.15rem solid var(--magma); margin-left: 0.3rem; }

  .dw__body { display: flex; flex-direction: column; gap: 0.35rem; padding: 1.25rem 1.5rem 1.25rem 0; }
  .dw__eyebrow { font-family: var(--font-mono); font-weight: 700; font-size: 0.6875rem; letter-spacing: 0.2em; color: var(--magma); }
  .dw__name { font-family: var(--font-mono); font-weight: 800; font-size: 1.125rem; color: var(--bone); }
  .dw__sub { font-size: 0.9375rem; line-height: 1.5; color: var(--bone-dim); }

  @media (max-width: 700px) {
    .dw { grid-template-columns: 1fr; gap: 0; }
    .dw__body { padding: 1.125rem 1.25rem; }
  }
</style>
