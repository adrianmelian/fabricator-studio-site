---
import { getCollection } from 'astro:content';
import { DOCS_NAV, DOC_NAV_LABELS } from '../data/docs';

const all = await getCollection('docs');
const byId = new Map(all.map((d) => [d.id, d]));
const current = Astro.url.pathname.replace(/\/+$/, '');
const href = (id: string) => `/docs/${id}/`;
const title = (id: string) => DOC_NAV_LABELS[id] ?? byId.get(id)?.data.title ?? id;
const isActive = (id: string) => current === `/docs/${id}`;
---
<aside class="docs-nav" aria-label="Documentation">
  <div class="docs-nav__search">
    <input id="docs-filter" type="search" placeholder="// SEARCH DOCS" autocomplete="off" spellcheck="false" aria-label="Filter docs" />
  </div>
  <nav class="docs-nav__tree" id="docs-tree">
    {DOCS_NAV.map((group) => (
      <details class="docs-nav__group" open>
        <summary class="docs-nav__grouplabel">{`// ${group.label.toUpperCase()}`}</summary>
        <ul class="docs-nav__list">
          {group.ids.map((id) => byId.has(id) && (
            <li class="docs-nav__item">
              <a class={`docs-nav__link${isActive(id) ? ' is-active' : ''}`} href={href(id)} aria-current={isActive(id) ? 'page' : undefined}>{title(id)}</a>
            </li>
          ))}
          {group.subgroups?.map((sub) => (
            <li class="docs-nav__item docs-nav__item--sub">
              <details class="docs-nav__subdetails" open>
                <summary class="docs-nav__sublabel">{sub.label}</summary>
                <ul class="docs-nav__list">
                  {sub.ids.map((id) => byId.has(id) && (
                    <li class="docs-nav__item">
                      <a class={`docs-nav__link${isActive(id) ? ' is-active' : ''}`} href={href(id)} aria-current={isActive(id) ? 'page' : undefined}>{title(id)}</a>
                    </li>
                  ))}
                </ul>
              </details>
            </li>
          ))}
        </ul>
      </details>
    ))}
    <p class="docs-nav__empty" id="docs-filter-empty" hidden>No docs match.</p>
  </nav>
</aside>
<script is:inline>
  (function () {
    var input = document.getElementById('docs-filter');
    if (!input) return;
    var tree = document.getElementById('docs-tree');
    var links = Array.prototype.slice.call(tree.querySelectorAll('.docs-nav__link'));
    var details = Array.prototype.slice.call(tree.querySelectorAll('details'));
    var empty = document.getElementById('docs-filter-empty');
    input.addEventListener('input', function () {
      var q = input.value.trim().toLowerCase();
      var any = false;
      links.forEach(function (a) {
        var li = a.closest('.docs-nav__item');
        var match = a.textContent.toLowerCase().indexOf(q) !== -1;
        if (li) li.style.display = match ? '' : 'none';
        if (match) any = true;
      });
      if (q) details.forEach(function (d) { d.open = true; });
      if (empty) empty.hidden = any;
    });
  })();
</script>
<style>
  .docs-nav { font-family: var(--font-mono); font-size: 0.875rem; }
  .docs-nav__search input {
    width: 100%;
    box-sizing: border-box;
    background: var(--iron);
    border: 1px solid var(--iron-2);
    border-radius: var(--radius);
    color: var(--bone);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    padding: 0.5rem 0.625rem;
    margin-bottom: 1.25rem;
  }
  .docs-nav__search input::placeholder { color: var(--bone-dim); }
  .docs-nav__search input:focus { outline: none; border-color: var(--plasma-dim); }

  .docs-nav__group { margin-bottom: 1.25rem; }
  .docs-nav__grouplabel,
  .docs-nav__sublabel {
    cursor: pointer;
    list-style: none;
    user-select: none;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .docs-nav__grouplabel::-webkit-details-marker,
  .docs-nav__sublabel::-webkit-details-marker { display: none; }
  .docs-nav__grouplabel::before,
  .docs-nav__sublabel::before {
    content: '▾';
    font-size: 0.7em;
    color: var(--bone-faint);
    transition: transform 0.12s ease;
  }
  details:not([open]) > .docs-nav__grouplabel::before,
  details:not([open]) > .docs-nav__sublabel::before { transform: rotate(-90deg); }
  .docs-nav__grouplabel {
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--ember);
    padding: 0.25rem 0;
  }
  .docs-nav__sublabel {
    color: var(--bone-dim);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    padding: 0.35rem 0 0.35rem 0.625rem;
    margin-top: 0.25rem;
  }

  .docs-nav__list { list-style: none; padding: 0.35rem 0 0; margin: 0; display: flex; flex-direction: column; }
  .docs-nav__subdetails .docs-nav__list { padding-left: 0.75rem; }
  .docs-nav__link {
    display: block;
    padding: 0.3rem 0.625rem;
    color: var(--bone-dim);
    text-decoration: none;
    border-left: 2px solid transparent;
    line-height: 1.35;
  }
  .docs-nav__link:hover { color: var(--plasma); }
  .docs-nav__link.is-active {
    color: var(--ember);
    border-left-color: var(--ember);
    background: var(--iron);
  }
  .docs-nav__empty { color: var(--bone-dim); padding: 0.5rem 0.625rem; }
</style>
