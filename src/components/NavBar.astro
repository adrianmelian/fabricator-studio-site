---
// The bar carries five entries: Toolset, Help, Pricing, My Account, Services. Two of them are
// dropdown groups. /store/ lost its Downloads tab 2026-09-03 when Pricing took the slot; it
// is still the hub for everything the studio ships (Adrian, 2026-08-19: one download page)
// and is reached from the footer, the hero button and the scan overlay.
// import NewsletterPop from './NewsletterPop.astro';  // unmounted, see below
import CoffeeButton from './CoffeeButton.astro';
import { Image } from 'astro:assets';
import fsLogo from '../assets/fs-logo.png';

// The current page's tab reads plasma (Adrian, 2026-08-19). Prefix match, so a docs
// subpage lights Docs and /armature/eula/ lights Armature; the homepage lights none.
const path = Astro.url.pathname;
const active = (href: string) => (path.startsWith(href) ? ' navbar__tab--active' : '');
// A group entry lights when any page inside it is the current one.
const groupActive = ['/armature/', '/tools/', '/control-rig/'].some((h) => path.startsWith(h)) ? ' navbar__tab--active' : '';
// Help holds the two reading surfaces (Adrian, 2026-09-03).
const helpActive = ['/docs/', '/tutorials/'].some((h) => path.startsWith(h)) ? ' navbar__tab--active' : '';
---
<nav class="navbar">
  {/* THE BRAND IS THE fS MONOGRAM (Adrian, 2026-09-04: "wordmark on top left, replace with
      just the FS logo"). It carried the name set in the body face beside a flat bone
      silhouette, then the full wordmark for an hour. This is brand/fabricatorstudio's own
      fs_logo.png: the same drawing as the wordmark's leading glyphs, outlined, with the
      ember pencil tip and the two plasma squares the old silhouette had lost.
      The full wordmark still opens every page masthead. */}
  <a class="navbar__brand" href="/" aria-label="FabricatorStudio, home">
    <Image class="navbar__mark" src={fsLogo} alt="" width={56} height={56} loading="eager" />
  </a>
  <button class="navbar__burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="nav-menu">
    <span></span><span></span><span></span>
  </button>
  {/* One row of tabs, no side doors (Adrian, 2026-08-19): the Download and Services
      buttons retired -- Downloads (the /store/ hub) and Services are tabs like everything
      else, and the page's own beats carry the loud doors now. */}
  <div class="navbar__menu" id="nav-menu">
    {/* Centred as a group on the bar (Adrian, 2026-08-19): the five tabs hold the middle,
        the two doors hold the right. On narrower desktops the group falls back into the
        row, and on mobile the wrapper dissolves into the dropdown. */}
    <div class="navbar__tabs">
      {/* ONE TOOLSET ENTRY WITH A DROPDOWN (Adrian, 2026-09-03: "its super crowded now up
          there! Can we make a Toolset entry, which has a drop down to choose Armature, Maya
          Pipeline, Unreal Control Rig?"). It replaced three product tabs in a row: Armature had
          led the row since 2026-08-19, and the Pipeline and Control Rig tabs landed earlier the
          same day and crowded the bar. The three product pages are the 2026-08-31 split in
          product-state.md; the dropdown is how they share one tab.
          CLOSED UNTIL PRESSED, AT EVERY WIDTH (Adrian, 2026-09-03, after the first cut left the
          three pages sitting open under the heading in the narrow menu: "they're not behind a
          menu. It's not really a drop down"). Desktop: hover or click opens the panel, Escape
          and an outside click close it. Narrow: pressing Toolset unfolds the three pages
          indented beneath it inside the burger menu; nothing shows until it is pressed. */}
      <div class={'navbar__group' + groupActive}>
        <button class={'navbar__tab navbar__tab--group' + groupActive} type="button" aria-haspopup="true" aria-expanded="false" aria-controls="nav-toolset">
          Toolset<span class="navbar__caret" aria-hidden="true"></span>
        </button>
        <div class="navbar__drop" id="nav-toolset">
          <a class={'navbar__tab navbar__drop__item' + active('/armature/')} href="/armature/">Armature</a>
          <a class={'navbar__tab navbar__drop__item' + active('/tools/')} href="/tools/">Maya Pipeline</a>
          <a class={'navbar__tab navbar__drop__item' + active('/control-rig/')} href="/control-rig/">Unreal Control Rig</a>
        </div>
      </div>
      {/* HELP: DOCUMENTATION AND TUTORIALS BEHIND ONE ENTRY (Adrian, 2026-09-03): "rename
          Docs to Documentation and put Documentation and Tutorials inside a dropdown like
          Toolset, called Help". Same machinery as Toolset, which the script and the narrow
          rules were already written for; the panel is closed until pressed at every width. */}
      <div class={'navbar__group' + helpActive}>
        <button class={'navbar__tab navbar__tab--group' + helpActive} type="button" aria-haspopup="true" aria-expanded="false" aria-controls="nav-help">
          Help<span class="navbar__caret" aria-hidden="true"></span>
        </button>
        <div class="navbar__drop" id="nav-help">
          <a class={'navbar__tab navbar__drop__item' + active('/docs/')} href="/docs/">Documentation</a>
          <a class={'navbar__tab navbar__drop__item' + active('/tutorials/')} href="/tutorials/">Tutorials</a>
        </div>
      </div>
      {/* PRICING REPLACED DOWNLOADS HERE (Adrian, 2026-09-03): "let's call it Pricing,
          and replace downloads with it on the top bar". /store/ keeps its page and is
          still reached from the footer, the hero button and the scan overlay. */}
      <a class={'navbar__tab' + active('/pricing/')} href="/pricing/">Pricing</a>
      <a class={'navbar__tab' + active('/account/')} href="/account/">My Account</a>
      <a class={'navbar__tab navbar__tab--bold' + active('/services/')} href="/services/">Services</a>
    </div>
    {/* The coffee door, far right (Adrian, 2026-08-29). A DELIBERATE exception to the
        2026-08-19 "no side doors" ruling, taken with that ruling in front of him: the tip
        jar is the one ask that has no page of its own to live on.
        It wears Buy Me a Coffee's own yellow button, self-hosted, and opens their widget
        in a panel on the page rather than sending anyone away. The reasoning for both, and
        the two third-party routes that were rejected, is in CoffeeButton.astro. */}
    <div class="navbar__coffee">
      <CoffeeButton />
    </div>
  </div>
</nav>
{/* UNMOUNTED 2026-09-02, at the 2.0 switch. Two reasons, and the first one alone is
    enough: this popup only ever fired on a [data-installer] click, and the free download
    that produced those is gone from every page, so it can no longer be triggered at all.
    The second is why it could not just be left sitting there: its markup ships on EVERY
    page and says "The toolset is free", which after the switch is a false price claim on
    all 54 of them.

    THE COMPONENT FILE IS DELIBERATELY NOT DELETED. Adrian: "We'll make a freebie after we
    ship the paid version." When that exists this is one line to put back, and his copy is
    untouched inside it rather than rewritten by me. */}
{/* <NewsletterPop /> */}
<script is:inline>
  (function () {
    var burger = document.querySelector('.navbar__burger');
    var menu = document.getElementById('nav-menu');
    if (!burger || !menu) return;
    function setOpen(open) {
      menu.classList.toggle('is-open', open);
      burger.classList.toggle('is-open', open);
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
    burger.addEventListener('click', function () { setOpen(!menu.classList.contains('is-open')); });
    // Tapping a link (or Download) closes the menu so navigation feels right.
    menu.addEventListener('click', function (e) {
      if (e.target.closest && e.target.closest('a, .nav-download')) setOpen(false);
    });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') setOpen(false); });

    // The Toolset dropdown. Hover opens it on desktop through CSS alone; the click path is
    // for touch and keyboard, and for pinning it open. One group today, written for any.
    var groups = document.querySelectorAll('.navbar__group');
    function setGroup(group, open) {
      group.classList.toggle('is-open', open);
      var btn = group.querySelector('.navbar__tab--group');
      if (btn) btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
    Array.prototype.forEach.call(groups, function (group) {
      var btn = group.querySelector('.navbar__tab--group');
      if (!btn) return;
      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        var open = !group.classList.contains('is-open');
        // ONE PANEL AT A TIME. With a second group (Help, 2026-09-03) the button's
        // stopPropagation kept the outside-click handler from ever firing, so pressing
        // Toolset left Help hanging open behind it. Close the others first.
        Array.prototype.forEach.call(groups, function (g) { if (g !== group) setGroup(g, false); });
        setGroup(group, open);
      });
    });
    document.addEventListener('click', function (e) {
      Array.prototype.forEach.call(groups, function (group) {
        if (!group.contains(e.target)) setGroup(group, false);
      });
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') Array.prototype.forEach.call(groups, function (g) { setGroup(g, false); });
    });
  })();
</script>
<style>
  .navbar {
    font-family: var(--font-mono);
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 1.5rem;
    /* Glass, not solid (Adrian, 2026-08-19). The bar is unchanged in every other respect; it
       just stops being a lid on the 3D scene it now floats over.
       Unprefixed ONLY: hand-writing the -webkit- twin makes lightningcss drop the standard
       property and Firefox loses the blur silently. */
    background: rgba(11, 14, 16, 0.55);
    backdrop-filter: blur(14px) saturate(140%);
    border-bottom: 1px solid rgba(232, 224, 208, 0.08);
  }
  /* Tests the STANDARD property only: ORing in the -webkit- alias reads true on an older
     Safari that supports the alias while the build emits none, leaving a see-through bar. */
  @supports not (backdrop-filter: blur(1px)) {
    .navbar { background: rgba(11, 14, 16, 0.92); }
  }
  .navbar__mark { display: block; height: 1.75rem; width: auto; }
  .navbar__brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--bone);
    font-weight: 700;
    white-space: nowrap;
  }
  .navbar__menu {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  /* Centred against the BAR, not the menu: the group is lifted out of the flex flow so its
     midpoint is the viewport's, whatever the brand and the doors weigh. The fixed navbar is
     the containing block. */
  .navbar__tabs {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  /* Below this the centred group starts crowding the brand and the doors: fall back into
     the row on the right, as it laid out before the centring. */
  @media (max-width: 1100px) {
    .navbar__tabs { position: static; transform: none; }
  }
  .navbar__tab {
    text-decoration: none;
    text-transform: uppercase;
    color: var(--bone-dim);
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    cursor: pointer;
    list-style: none;
  }
  .navbar__tab:hover { color: var(--bone); }
  /* Services BOLD (Adrian, 2026-08-19, after trying the serif): the hire door stands apart
     from the product tabs by weight, in the same voice. */
  .navbar__tab--bold { font-weight: 700; color: var(--bone); }
  /* The page you are on. */
  .navbar__tab--active { color: var(--bone); }
  .navbar__tab--active:hover { color: var(--bone); }

  .navbar__coffee { display: flex; align-items: center; }

  /* The Toolset dropdown. The button is a tab in every respect (same type, same colours) so
     the row reads as one voice; the caret is the only tell that it opens. */
  .navbar__group { position: relative; display: flex; align-items: center; }
  .navbar__tab--group {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0;
    background: none;
    border: none;
    font: inherit;
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
  }
  .navbar__caret {
    width: 0.4rem;
    height: 0.4rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
    transition: transform 0.15s ease;
  }
  .navbar__group.is-open .navbar__caret,
  .navbar__group:hover .navbar__caret { transform: translateY(1px) rotate(225deg); }
  .navbar__drop {
    display: none;
    position: absolute;
    top: calc(100% + 0.9rem);
    left: 50%;
    transform: translateX(-50%);
    min-width: 13.5rem;
    padding: 0.5rem 0;
    flex-direction: column;
    /* SOLID, not the bar's glass. The panel floats over page content rather than over the
       scene the bar sits on, and at 0.92 the outlined section heading read straight through
       the three links. A menu you can see the page through is not a menu. */
    background: var(--carbon);
    border: 1px solid var(--iron-2);
    border-radius: 12px;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
  }
  /* A hover gap between the tab and the panel would close it on the way down: the
     pseudo-element bridges the 0.9rem the panel floats below the bar. */
  .navbar__drop::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -1rem;
    height: 1rem;
  }
  .navbar__group:hover .navbar__drop,
  .navbar__group.is-open .navbar__drop { display: flex; }
  .navbar__drop__item {
    display: block;
    padding: 0.6rem 1.25rem;
    white-space: nowrap;
  }
  .navbar__drop__item:hover { background: rgba(232, 224, 208, 0.06); }

  /* Hamburger: hidden on desktop, shown on narrow screens. */
  .navbar__burger { display: none; }

  /* THE BURGER COMES IN AT 980px, not the site's usual 720px (Adrian, 2026-08-29). This is
     a deliberate exception to that convention and the only one in the nav.
     Measured: below about 940px the six tabs are already at their minimum width and stop
     shrinking, so the 160px coffee button hung off the right edge, 39px off screen at 900px
     and 209px at 730px. The bar had been at its own limit since the sixth tab landed; the
     button is what made it visible. Everything moves into the dropdown here instead, where
     width is free, so the coffee door stays reachable at every width. */
  @media (max-width: 979px) {
    .navbar__burger {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 40px;
      height: 40px;
      padding: 8px;
      background: none;
      border: none;
      cursor: pointer;
      z-index: 2;
    }
    .navbar__burger span {
      display: block;
      width: 100%;
      height: 2px;
      background: var(--bone);
      transition: transform 0.2s ease, opacity 0.2s ease;
    }
    .navbar__burger.is-open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .navbar__burger.is-open span:nth-child(2) { opacity: 0; }
    .navbar__burger.is-open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    .navbar__menu {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: var(--carbon);
      border-bottom: 1px solid var(--iron-2);
      padding: 0.25rem 1.5rem 1rem;
    }
    .navbar__menu.is-open { display: flex; }
    .navbar__tabs { display: contents; }
    .navbar__menu .navbar__tab { padding: 0.85rem 0; border-bottom: 1px solid var(--iron); }
    /* In the burger menu the dropdown is a collapsible row: Toolset with its caret, and the
       three pages unfold indented beneath it ONLY when it is pressed. Hover does not open
       it here, because on a touch screen a tap is also a hover and the list would never
       close. Same specificity as the hover rule, so order decides: is-open is written last. */
    .navbar__group { display: contents; }
    .navbar__menu .navbar__tab--group { width: 100%; justify-content: space-between; }
    .navbar__menu .navbar__drop {
      position: static;
      transform: none;
      min-width: 0;
      padding: 0;
      background: none;
      backdrop-filter: none;
      border: none;
      border-radius: 0;
      box-shadow: none;
    }
    .navbar__menu .navbar__drop::before { display: none; }
    .navbar__menu .navbar__group:hover .navbar__drop { display: none; }
    .navbar__menu .navbar__group.is-open .navbar__drop { display: flex; }
    .navbar__menu .navbar__drop__item { padding-left: 1.25rem; }
    .navbar__menu .navbar__drop__item:hover { background: none; }
    /* In the dropdown the button is a row like the tabs, left aligned rather than stretched. */
    .navbar__menu .navbar__coffee { padding: 0.85rem 0; justify-content: flex-start; }
  }
</style>
