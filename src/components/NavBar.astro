---
// Download opens /store/, the hub for everything the studio ships (Adrian, 2026-08-19:
// one download page). NewsletterPop still rides here because the nav is on every page, so
// the post-download ask exists wherever installer links do (the store's own download
// buttons carry data-installer).
import NewsletterPop from './NewsletterPop.astro';
---
<nav class="navbar">
  <a class="navbar__brand" href="/">
    <img src="/nav-mark.png" width="28" height="28" alt="" />
    <span>FabricatorStudio</span>
  </a>
  <button class="navbar__burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="nav-menu">
    <span></span><span></span><span></span>
  </button>
  {/* Two doors at the top of every page, one per direction, which is the two-layer system
      expressed in navigation instead of prose. Services is the hire door and carries the
      outlined weight; Download is the toolset door and stays the loudest thing up here,
      because most arrivals today are coming for the toolset.

      Community moved to the footer in the same pass: it was a dropdown holding two social
      links, and the nav needed the slot for Toolset and Store. Swap, not addition. */}
  <div class="navbar__menu" id="nav-menu">
    {/* Centred as a group on the bar (Adrian, 2026-08-19): the five tabs hold the middle,
        the two doors hold the right. On narrower desktops the group falls back into the
        row, and on mobile the wrapper dissolves into the dropdown. */}
    <div class="navbar__tabs">
      <a class="navbar__tab" href="/tools/">Toolset</a>
      {/* Sits next to Toolset because they are the two products, and after it because the
          free Maya suite is still what most arrivals come for. */}
      <a class="navbar__tab" href="/armature/">Armature</a>
      <a class="navbar__tab" href="/store/">Store</a>
      <a class="navbar__tab" href="/docs/">Docs</a>
      <a class="navbar__tab" href="/tutorials/">Tutorials</a>
    </div>
    <a class="nav-services" href="/services/" data-goatcounter-click="nav-services">Services</a>
    <a class="nav-download" href="/store/" data-goatcounter-click="nav-download">Download</a>
  </div>
</nav>
<NewsletterPop />
<script is:inline>
  (function () {
    var burger = document.querySelector('.navbar__burger');
    var menu = document.getElementById('nav-menu');
    if (!burger || !menu) return;
    function setOpen(open) {
      menu.classList.toggle('is-open', open);
      burger.classList.toggle('is-open', open);
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
    burger.addEventListener('click', function () { setOpen(!menu.classList.contains('is-open')); });
    // Tapping a link (or Download) closes the menu so navigation feels right.
    menu.addEventListener('click', function (e) {
      if (e.target.closest && e.target.closest('a, .nav-download')) setOpen(false);
    });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') setOpen(false); });
  })();
</script>
<style>
  .navbar {
    font-family: var(--font-mono);
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 1.5rem;
    /* Glass, not solid (Adrian, 2026-08-19). The bar is unchanged in every other respect; it
       just stops being a lid on the 3D scene it now floats over.
       Unprefixed ONLY: hand-writing the -webkit- twin makes lightningcss drop the standard
       property and Firefox loses the blur silently. */
    background: rgba(11, 14, 16, 0.55);
    backdrop-filter: blur(14px) saturate(140%);
    border-bottom: 1px solid rgba(232, 224, 208, 0.08);
  }
  /* Tests the STANDARD property only: ORing in the -webkit- alias reads true on an older
     Safari that supports the alias while the build emits none, leaving a see-through bar. */
  @supports not (backdrop-filter: blur(1px)) {
    .navbar { background: rgba(11, 14, 16, 0.92); }
  }
  .navbar__brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--bone);
    font-weight: 700;
    white-space: nowrap;
  }
  .navbar__brand img { display: block; }
  .navbar__menu {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  /* Centred against the BAR, not the menu: the group is lifted out of the flex flow so its
     midpoint is the viewport's, whatever the brand and the doors weigh. The fixed navbar is
     the containing block. */
  .navbar__tabs {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  /* Below this the centred group starts crowding the brand and the doors: fall back into
     the row on the right, as it laid out before the centring. */
  @media (max-width: 1100px) {
    .navbar__tabs { position: static; transform: none; }
  }
  .navbar__tab {
    text-decoration: none;
    text-transform: uppercase;
    color: var(--bone-dim);
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    cursor: pointer;
    list-style: none;
  }
  .navbar__tab:hover { color: var(--bone); }

  /* The two doors, weighted the same way the hero weights them: the toolset door is filled,
     the hire door is outlined. Same shape so they read as a pair, different weight so they
     do not compete. */
  .nav-services,
  .nav-download {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: var(--radius-pill);
    padding: 0.45rem 1.05rem;
    cursor: pointer;
    white-space: nowrap;
    transition: background var(--t-fast) var(--ease-out), color var(--t-fast) var(--ease-out), border-color var(--t-fast) var(--ease-out);
  }
  .nav-services { color: var(--bone); background: none; border: 1px solid rgba(232, 224, 208, 0.3); }
  .nav-services:hover { color: var(--bone); border-color: var(--bone); }
  .nav-download { color: var(--carbon); background: var(--plasma); border: 1px solid var(--plasma); }
  .nav-download:hover { background: var(--plasma-dim); border-color: var(--plasma-dim); color: var(--carbon); }

  /* Hamburger: hidden on desktop, shown on narrow screens. */
  .navbar__burger { display: none; }

  @media (max-width: 720px) {
    .navbar__burger {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 40px;
      height: 40px;
      padding: 8px;
      background: none;
      border: none;
      cursor: pointer;
      z-index: 2;
    }
    .navbar__burger span {
      display: block;
      width: 100%;
      height: 2px;
      background: var(--bone);
      transition: transform 0.2s ease, opacity 0.2s ease;
    }
    .navbar__burger.is-open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .navbar__burger.is-open span:nth-child(2) { opacity: 0; }
    .navbar__burger.is-open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    .navbar__menu {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: var(--carbon);
      border-bottom: 1px solid var(--iron-2);
      padding: 0.25rem 1.5rem 1rem;
    }
    .navbar__menu.is-open { display: flex; }
    .navbar__tabs { display: contents; }
    .navbar__menu .navbar__tab { padding: 0.85rem 0; border-bottom: 1px solid var(--iron); }
    .nav-services,
    .nav-download { align-self: flex-start; margin-top: 1rem; }
  }
</style>
