---
// The two licensing tier cards (the ORGANIZATION axis: who owes money, by revenue).
//
// Extracted out of the homepage 2026-07-22 (website overhaul) and relocated to /tools/, next
// to the thing it prices. The homepage keeps a one-line summary and a link.
//
// COPY TRAP, do not blur it (workspace/2026-07-18_licensing-decision/DECISION.md): this block
// is the organization axis, and it covers the WHOLE toolset above a revenue threshold. The
// Advanced Ribbon Modules are the FEATURE axis and are paid for everyone at any studio size.
// A reader must never conclude the ribbon modules are locked behind a corporate license, so
// on /tools/ this block sits below the modules block and each one says what the other is not.
---
<section id="licensing">
  <div class="lcb-head">
    <div class="lcb-eyebrow">LICENSING</div>
  </div>
  <div class="lcb-tiers">
    <div class="lcb-tier lcb-tier--plasma">
      <div class="lcb-tier__top">
        <span class="lcb-pill lcb-pill--plasma"><span class="lcb-pill__dot" aria-hidden="true"></span>UNDER $2M / YEAR</span>
        <span class="lcb-price lcb-price--plasma">Free</span>
      </div>
      <p class="lcb-tier__body">If your studio makes under <b>$2 million a year</b>, everything here is yours. Use it in production, ship your game, use it on client work, and keep it forever.</p>
      <div class="lcb-tier__rule lcb-tier__rule--plasma" aria-hidden="true"></div>
      <ul class="lcb-checks">
        {/* Chips scoped 2026-07-28: 'No seats' and 'No phoning home' were true of the toolset
            but read as company-wide promises, and Armature ships with seats and activation.
            Replacements are equally true of the toolset and survive that launch. */}
        {['Yours forever', 'No trial', 'No feature gates', 'Source available'].map((c) => (
          <li class="lcb-check">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 10l3.5 3.5L15 6" stroke="#7CFFB2" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
            {c}
          </li>
        ))}
      </ul>
    </div>
    <div class="lcb-tier lcb-tier--ember">
      <div class="lcb-tier__top">
        <span class="lcb-pill lcb-pill--ember"><span class="lcb-pill__dot" aria-hidden="true"></span>ABOVE $2M / YEAR</span>
        <span class="lcb-price lcb-price--ember">One license</span>
      </div>
      <p class="lcb-tier__body">Above $2 million, <b>one flat license covers your whole studio</b>, and it scales with your revenue, so it stays small when you're small.</p>
      <div class="lcb-tier__rule lcb-tier__rule--ember" aria-hidden="true"></div>
      <div class="lcb-star">
        <svg width="26" height="26" viewBox="0 0 26 26" fill="none" aria-hidden="true"><path d="M13 3l3 6 6 1-4.5 4.3 1 6.2L13 20l-5.5 3 1-6.2L4 12.5 10 11z" stroke="#FF7A3D" stroke-width="2" stroke-linejoin="round" /></svg>
        <p>One flat fee for the whole studio, no per-seat math.</p>
      </div>
    </div>
  </div>
  <div class="lcb-ctas">
    <a class="lcb-cta lcb-cta--solid" href="/licensing/#pricing">See pricing &rarr;</a>
    <a class="lcb-cta lcb-cta--ghost" href="/licensing/#license">Read the license</a>
  </div>
</section>
<style>
  #licensing { display: flex; flex-direction: column; gap: 1.75rem; }
  .lcb-head { display: flex; flex-direction: column; gap: 0.75rem; }
  .lcb-eyebrow { font-family: var(--font-mono); font-weight: 700; font-size: 0.8125rem; letter-spacing: 0.45em; color: var(--ember); }

  .lcb-tiers { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
  .lcb-tier {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    border-radius: 22px;
    padding: 2rem 2.125rem 2.25rem;
    box-shadow: var(--shadow-lg);
  }
  /* The free tier: iron falling into a plasma-tinted dark, per the drop. */
  .lcb-tier--plasma {
    background: linear-gradient(180deg, rgba(124, 255, 178, 0) 30%, rgba(124, 255, 178, 0.07)), linear-gradient(180deg, var(--iron), var(--carbon));
    border: 1px solid rgba(124, 255, 178, 0.4);
    box-shadow: var(--shadow-lg), 0 0 40px -24px rgba(124, 255, 178, 0.3);
  }
  .lcb-tier--ember {
    background: linear-gradient(180deg, var(--iron), var(--carbon));
    border: 1px solid rgba(255, 122, 61, 0.35);
  }
  .lcb-tier__top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .lcb-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0.9rem;
    border-radius: 9px;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
  }
  .lcb-pill--plasma { background: rgba(124, 255, 178, 0.13); border: 1px solid rgba(124, 255, 178, 0.45); color: var(--plasma); }
  .lcb-pill--ember { background: rgba(255, 122, 61, 0.13); border: 1px solid rgba(255, 122, 61, 0.45); color: var(--ember); }
  .lcb-pill__dot { width: 0.55rem; height: 0.55rem; border-radius: 50%; }
  .lcb-pill--plasma .lcb-pill__dot { background: var(--plasma); box-shadow: 0 0 10px rgba(124, 255, 178, 0.7); }
  .lcb-pill--ember .lcb-pill__dot { background: var(--ember); box-shadow: 0 0 10px rgba(255, 122, 61, 0.7); }
  .lcb-price { font-family: var(--font-mono); font-weight: 800; font-size: clamp(1.375rem, 2.6vw, 1.75rem); letter-spacing: -0.02em; }
  .lcb-price--plasma { color: var(--plasma); }
  .lcb-price--ember { color: var(--ember); }
  .lcb-tier__body { margin: 0; font-size: 0.9375rem; line-height: 1.65; color: var(--bone-dim); text-wrap: pretty; }
  .lcb-tier__body b { color: var(--bone); }
  .lcb-tier__rule { height: 1px; }
  .lcb-tier__rule--plasma { background: linear-gradient(90deg, rgba(124, 255, 178, 0.3), rgba(124, 255, 178, 0)); }
  .lcb-tier__rule--ember { background: linear-gradient(90deg, rgba(255, 122, 61, 0.3), rgba(255, 122, 61, 0)); }
  .lcb-checks { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.6rem 1.25rem; }
  .lcb-check { display: flex; align-items: center; gap: 0.7rem; font-size: 0.9375rem; color: var(--bone-dim); }
  .lcb-check svg { flex: none; }
  .lcb-star { display: flex; align-items: center; gap: 0.85rem; font-size: 0.9375rem; color: var(--bone-dim); line-height: 1.5; }
  .lcb-star svg { flex: none; }
  .lcb-star p { margin: 0; }

  .lcb-ctas { display: flex; gap: 1rem; flex-wrap: wrap; }
  .lcb-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1rem 2.125rem;
    border-radius: 12px;
    font-family: var(--font-mono);
    font-weight: 800;
    font-size: 1.0625rem;
    letter-spacing: 0.03em;
    text-decoration: none;
    transition: background var(--t-fast) var(--ease-out), color var(--t-fast) var(--ease-out), border-color var(--t-fast) var(--ease-out);
  }
  .lcb-cta--solid { background: var(--plasma); color: #06120B; box-shadow: 0 0 32px -12px rgba(124, 255, 178, 0.7); }
  .lcb-cta--solid:hover { background: var(--plasma-dim); }
  .lcb-cta--ghost { font-weight: 700; background: rgba(232, 224, 208, 0); border: 1px solid rgba(232, 224, 208, 0.3); color: var(--bone); }
  .lcb-cta--ghost:hover { border-color: var(--bone); }

  @media (max-width: 800px) {
    .lcb-tiers { grid-template-columns: 1fr; }
  }
</style>
