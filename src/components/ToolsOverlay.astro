---
// THE TOOLSET BEAT (Adrian, 2026-08-19). After the video has owned the screen, glass blurs
// over it and the CURRENT toolset windows float in over it, each on the ShimmerWindow
// treatment (real screenshot, 3D sweep, specular glint) that was ruled good on the
// Fabricator card.
//
// Reworked same day from the four old flagship components: Adrian delivered current
// captures, and the AnimStudio/Reggie/Bridge graphics were showing OLD versions of the UI.
// Six windows now, all screenshots through one component, staggered so they never rock in
// unison.
//
// NO COPY YET, deliberately: info lines, names and links wait for Adrian's copy pass rather
// than being guessed at. Hover still trades focus. (The old flagship components keep their
// card lives on /tools/ and the docs untouched.)
import ShimmerWindow from './ShimmerWindow.astro';
import fabricator from '../assets/docs/fabricator-gui.png';
import animstudio from '../assets/windows/AnimStudio.png';
import reggie from '../assets/windows/reggie.png';
import mindmeld from '../assets/windows/mindmeld.png';
import exporter from '../assets/windows/exporter.png';
import autoskin from '../assets/windows/autoskin.png';

// Layout intent: the two big authoring windows anchor the top corners, the tall Reggie
// panel owns the centre, the utility windows fill around it. Delays stagger the sweeps.
const WINDOWS = [
  { src: fabricator, delay: 0 },
  { src: animstudio, delay: -2.6 },
  { src: mindmeld, delay: -5.1 },
  { src: reggie, delay: -1.3 },
  { src: exporter, delay: -3.9 },
  { src: autoskin, delay: -6.4 },
];
---

<div class="tf" data-tools-overlay>
  <div class="tf__grid">
    {WINDOWS.map((w, i) => (
      <div class="tf__item" data-tf-item data-idx={i}>
        <ShimmerWindow src={w.src} delay={w.delay} />
      </div>
    ))}
  </div>
</div>

<style>
  /* Fixed layer between the video (z1) and the copy/buttons (z3). The glass is this layer's
     own backdrop-filter, so it blurs the live video underneath, not a still of it. The blur
     radius rides --glass directly: opacity on a backdrop-filtered element does not fade the
     filter, so the variable drives the radius and the tint together. */
  .tf {
    position: fixed;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    visibility: hidden;
    background: rgba(11, 14, 16, calc(var(--glass, 0) * 0.45));
    /* Unprefixed ONLY: hand-writing the -webkit- twin makes lightningcss drop the standard
       property and Firefox loses the blur silently. */
    backdrop-filter: blur(calc(var(--glass, 0) * 16px)) saturate(calc(1 + var(--glass, 0) * 0.25));
  }
  .tf[data-active] { visibility: visible; }

  /* Three columns, two rows, every window placed by hand. Windows are sized by HEIGHT: the
     row height is definite, each window takes 100% of it and derives its width from its own
     aspect ratio. Sizing by width was circular (centre-justified cells shrink to content,
     content sized to cell, resolves to zero) and let tall images overflow their rows. */
  .tf__grid {
    position: absolute;
    left: 50%;
    top: 9%;
    transform: translate(-50%, calc((1 - var(--tools, 0)) * 28px));
    width: min(84vw, 1640px);
    height: 72%;
    display: grid;
    grid-template-columns: 1fr 0.7fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 4vh 2vw;
    opacity: var(--tools, 0);
  }

  .tf__item {
    min-width: 0;
    min-height: 0;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--t-base) var(--ease-spring), opacity var(--t-fast) var(--ease-out);
    will-change: transform;
  }
  /*   fabricator | reggie   | animstudio
       mindmeld   | autoskin | exporter   */
  .tf__item[data-idx='0'] { grid-area: 1 / 1; }
  .tf__item[data-idx='3'] { grid-area: 1 / 2; }
  .tf__item[data-idx='1'] { grid-area: 1 / 3; }
  .tf__item[data-idx='2'] { grid-area: 2 / 1; }
  .tf__item[data-idx='5'] { grid-area: 2 / 2; }
  .tf__item[data-idx='4'] { grid-area: 2 / 3; }
  .tf__item :global(.sw) { height: 100%; width: auto; max-width: 100%; }

  .tf[data-active] .tf__item { pointer-events: auto; }

  /* The hover trade: the focused one grows, the rest step back. */
  .tf__grid:hover .tf__item { transform: scale(0.94); opacity: 0.55; }
  .tf__grid .tf__item:hover { transform: scale(1.06); opacity: 1; }

  /* The cinematic never runs under 900px or in the static fallback, so this layer must
     never exist there. */
  @media (max-width: 900px) {
    .tf { display: none; }
  }
</style>
