---
// THE TOOLSET BEAT: a carousel (Adrian, 2026-08-19, superseding his own hover concept the
// same day -- a hover that MOVES the hovered window to the far side confuses the pointer,
// so the moving-layout idea died and the "hover layout" became the ONLY layout).
//
//   "Maya Toolset" in ember display type, top.
//   ONE selected window, large on the left, on the shimmer treatment.
//   Its name, paragraph and More info link on the right.
//   ALL the options in a FIXED strip along the bottom: six tool windows plus a MORE
//   TOOLS... tile that goes straight to the toolset docs. Click a thumb to select it; the
//   strip itself never moves, which is the whole point.
//
// The download buttons that rode the whole opening fade out as this beat arrives (his
// ruling; PointCloudHero's loop owns that fade).
//
// PARAGRAPHS ARE PLACEHOLDER LOREM, as in his concept, until his copy pass. Names are the
// tools' own window titles; only Fabricator carries the fuller name the concept wrote.
import { Image } from 'astro:assets';
import ShimmerWindow from './ShimmerWindow.astro';
import fabricator from '../assets/docs/fabricator-gui.png';
import animstudio from '../assets/windows/AnimStudio.png';
import reggie from '../assets/windows/reggie.png';
import mindmeld from '../assets/windows/mindmeld.png';
import exporter from '../assets/windows/exporter.png';
import autoskin from '../assets/windows/autoskin.png';

const LOREM =
  'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Quis ipsum suspendisse ultrices gravida.';

const TOOLS = [
  { src: fabricator, name: 'Fabricator: Control Rig Builder', para: LOREM, href: '/docs/tools/fabricator/', delay: 0 },
  { src: reggie, name: 'Reggie', para: LOREM, href: '/docs/tools/your-ai-ta/', delay: -1.3 },
  { src: animstudio, name: 'AnimStudio', para: LOREM, href: '/docs/tools/pose-anim-studio/', delay: -2.6 },
  { src: mindmeld, name: 'MindMeld', para: LOREM, href: '/docs/tools/project-setup/', delay: -3.9 },
  { src: autoskin, name: 'AutoSkin', para: LOREM, href: '/docs/tools/autoskin/', delay: -5.1 },
  { src: exporter, name: 'Export', para: LOREM, href: '/docs/tools/exporter/', delay: -6.4 },
];
---

<div class="tf" data-tools-overlay>
  <p class="tf__title">Maya Toolset</p>

  {/* The stage: every window pre-rendered in the same slot, the selected one visible.
      Clicking the big window goes where its More info goes. */}
  <div class="tf__stage">
    {TOOLS.map((t, i) => (
      <a class="tf__big" data-tf-big data-idx={i} href={t.href} aria-label={t.name} style={`aspect-ratio: ${t.src.width} / ${t.src.height}`}>
        <ShimmerWindow src={t.src} delay={t.delay} />
      </a>
    ))}
  </div>

  <div class="tf__info">
    {TOOLS.map((t, i) => (
      <div class="tf__card" data-idx={i}>
        <p class="tf__name">{t.name}</p>
        <p class="tf__para">{t.para}</p>
        <a class="tf__link" href={t.href}>More info</a>
      </div>
    ))}
  </div>

  {/* The strip: all seven options, positions FIXED. Selection highlights, never reflows. */}
  <div class="tf__strip">
    {TOOLS.map((t, i) => (
      <button class="tf__thumb" type="button" data-tf-thumb data-idx={i} aria-label={t.name} style={`aspect-ratio: ${t.src.width} / ${t.src.height}`}>
        <Image src={t.src} alt="" widths={[Math.min(t.src.width, 480)]} />
      </button>
    ))}
    <a class="tf__more" href="/docs/maya/">More Tools...</a>
  </div>
</div>

<style>
  /* Fixed layer between the video (z1) and the copy layer (z3). The glass is this layer's
     own backdrop-filter, so it blurs the live video underneath, not a still of it; the
     radius rides --glass directly because element opacity does not fade a backdrop filter. */
  .tf {
    position: fixed;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    visibility: hidden;
    background: rgba(11, 14, 16, calc(var(--glass, 0) * 0.45));
    /* Unprefixed ONLY: hand-writing the -webkit- twin makes lightningcss drop the standard
       property and Firefox loses the blur silently. */
    backdrop-filter: blur(calc(var(--glass, 0) * 16px)) saturate(calc(1 + var(--glass, 0) * 0.25));
  }
  .tf[data-active] { visibility: visible; }
  .tf[data-active] :is(.tf__big, .tf__thumb, .tf__more, .tf__link) { pointer-events: auto; }

  /* Ember display title, per the concept. */
  .tf__title {
    position: absolute;
    left: 50%;
    top: 8%;
    transform: translateX(-50%);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(3rem, 5.6vw, 5.4rem);
    line-height: 1;
    color: var(--ember);
    opacity: var(--tools, 0);
    white-space: nowrap;
  }

  /* The big slot, left. All six live here stacked; selection crossfades. */
  .tf__stage {
    position: absolute;
    left: 10.5%;
    top: 17%;
    width: 29%;
    height: 52%;
    display: grid;
    align-items: center;
    justify-items: start;
    opacity: var(--tools, 0);
  }
  .tf__big {
    grid-area: 1 / 1;
    display: block;
    /* height from the stage, width from the aspect ratio: sizing from width is circular
       (the window fills the anchor, the anchor shrinks to the window, resolves to zero). */
    height: 100%;
    max-width: 100%;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 320ms var(--ease-out), transform 320ms var(--ease-out);
    pointer-events: none !important;
  }
  .tf__big :global(.sw) { width: 100%; height: 100%; }
  .tf[data-sel='0'] .tf__big[data-idx='0'],
  .tf[data-sel='1'] .tf__big[data-idx='1'],
  .tf[data-sel='2'] .tf__big[data-idx='2'],
  .tf[data-sel='3'] .tf__big[data-idx='3'],
  .tf[data-sel='4'] .tf__big[data-idx='4'],
  .tf[data-sel='5'] .tf__big[data-idx='5'] { opacity: 1; transform: none; }
  .tf[data-active][data-sel='0'] .tf__big[data-idx='0'],
  .tf[data-active][data-sel='1'] .tf__big[data-idx='1'],
  .tf[data-active][data-sel='2'] .tf__big[data-idx='2'],
  .tf[data-active][data-sel='3'] .tf__big[data-idx='3'],
  .tf[data-active][data-sel='4'] .tf__big[data-idx='4'],
  .tf[data-active][data-sel='5'] .tf__big[data-idx='5'] { pointer-events: auto !important; }

  /* The detail, right: display name, paragraph, plasma link, crossfading with selection. */
  .tf__info {
    position: absolute;
    left: 43%;
    right: 8%;
    top: 22%;
    display: grid;
    opacity: var(--tools, 0);
  }
  .tf__card {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 300ms var(--ease-out), transform 300ms var(--ease-out);
    pointer-events: none;
  }
  .tf[data-sel='0'] .tf__card[data-idx='0'],
  .tf[data-sel='1'] .tf__card[data-idx='1'],
  .tf[data-sel='2'] .tf__card[data-idx='2'],
  .tf[data-sel='3'] .tf__card[data-idx='3'],
  .tf[data-sel='4'] .tf__card[data-idx='4'],
  .tf[data-sel='5'] .tf__card[data-idx='5'] { opacity: 1; transform: none; }
  .tf__name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.2rem, 3.4vw, 3.6rem);
    line-height: 1.05;
    color: var(--bone);
  }
  .tf__para {
    margin-top: 0.9rem;
    font-weight: 300;
    font-size: clamp(1.25rem, 2vw, 1.9rem);
    line-height: 1.35;
    color: var(--bone);
    max-width: 34ch;
  }
  .tf__link {
    display: inline-block;
    margin-top: 0.7rem;
    font-weight: 300;
    font-size: clamp(1.25rem, 2vw, 1.9rem);
    color: var(--plasma);
    text-decoration: none;
  }
  .tf__link:hover { color: var(--plasma-dim); }

  /* The strip: seven fixed slots along the bottom. Thumbs share one height; each keeps its
     own aspect. The selected one holds full strength and a plasma edge. */
  .tf__strip {
    position: absolute;
    left: 50%;
    bottom: 5%;
    transform: translateX(-50%);
    height: 13%;
    display: flex;
    align-items: center;
    gap: 1.2vw;
    opacity: var(--tools, 0);
  }
  .tf__thumb {
    height: 100%;
    padding: 0;
    background: var(--carbon);
    border: 1px solid var(--iron-3);
    border-radius: 6px;
    overflow: hidden;
    cursor: pointer;
    opacity: 0.55;
    transition: opacity var(--t-fast) var(--ease-out), border-color var(--t-fast) var(--ease-out),
                transform var(--t-fast) var(--ease-spring);
  }
  .tf__thumb :global(img) { display: block; width: 100%; height: 100%; object-fit: fill; }
  .tf__thumb:hover { opacity: 0.85; transform: translateY(-3px); }
  .tf[data-sel='0'] .tf__thumb[data-idx='0'],
  .tf[data-sel='1'] .tf__thumb[data-idx='1'],
  .tf[data-sel='2'] .tf__thumb[data-idx='2'],
  .tf[data-sel='3'] .tf__thumb[data-idx='3'],
  .tf[data-sel='4'] .tf__thumb[data-idx='4'],
  .tf[data-sel='5'] .tf__thumb[data-idx='5'] { opacity: 1; border-color: var(--plasma); }

  .tf__more {
    height: 62%;
    display: flex;
    align-items: center;
    padding: 0 1.4vw;
    border: 1px solid var(--bone);
    border-radius: var(--radius);
    color: var(--bone);
    text-decoration: none;
    font-weight: 700;
    font-size: clamp(0.95rem, 1.15vw, 1.15rem);
    letter-spacing: 0.04em;
    white-space: nowrap;
    transition: color var(--t-fast) var(--ease-out), border-color var(--t-fast) var(--ease-out);
  }
  .tf__more:hover { color: var(--plasma); border-color: var(--plasma); }

  /* The cinematic never runs under 900px or in the static fallback. */
  @media (max-width: 900px) {
    .tf { display: none; }
  }
</style>

<script>
  // A carousel's whole job is stability: the strip never moves, selection is a click, and
  // the only things that change are the big slot and the info card.
  const tf = document.querySelector('[data-tools-overlay]') as HTMLElement | null;
  if (tf) {
    tf.dataset.sel = '0';
    for (const b of tf.querySelectorAll('[data-tf-thumb]')) {
      b.addEventListener('click', () => { tf.dataset.sel = (b as HTMLElement).dataset.idx!; });
    }
  }
</script>
