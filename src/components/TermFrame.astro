---
interface Props { title: string; meta?: string }
const { title, meta = '' } = Astro.props;
---
<figure class="term-frame">
  <div class="term-frame__bar">
    <span class="term-frame__lights" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="term-frame__title">{'// '}{title.toUpperCase()}</span>
    <span class="term-frame__meta">{meta}</span>
  </div>
  <div class="term-frame__body"><slot /></div>
</figure>
<style>
  .term-frame { font-family: var(--font-mono); border: 1px solid var(--iron-3); border-radius: var(--radius); background: var(--iron); }
  .term-frame__bar { display: flex; align-items: center; gap: 0.75rem; padding: 0.5rem 0.75rem; border-bottom: 1px solid var(--iron-3); font-size: 0.8125rem; }
  .term-frame__lights { display: inline-flex; gap: 0.375rem; }
  .term-frame__lights i { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--bone-faint); }
  .term-frame__title { color: var(--ember); font-weight: 700; letter-spacing: 0.06em; }
  .term-frame__meta { margin-left: auto; color: var(--bone-faint); }
  .term-frame__body { padding: 0; }
  .term-frame__body :global(img), .term-frame__body :global(video) { display: block; width: 100%; }
</style>
