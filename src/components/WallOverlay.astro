---
// THE DOWNLOAD BEAT: the scan (Adrian, 2026-08-19). The tool wall -- every FS window
// receding to the horizon -- stands fullscreen BEHIND the room, hidden. As the visitor
// scrolls, a horizontal band climbs the screen like a scanner: above it the room carries
// on, below it the wall is revealed, and the wall itself never moves. The download button
// rides in the middle of the band.
//
// The band's trailing (bottom) edge is the scan line, plasma, glowing: it is the edge that
// unveils. The room was built floor-to-head; the scan retires it the same way.
import { Image } from 'astro:assets';
import BracketButton from './BracketButton.astro';
import wall from '../assets/wall/FS_Tool_Wall.png';
---

<div class="wl" data-wall-overlay>
  {/* The wall: static, fullscreen, clipped to below the band's trailing edge. */}
  <div class="wl__wall">
    <Image src={wall} alt="" widths={[1600, 2560, 3162]} sizes="100vw" loading="lazy" />
  </div>

  {/* The scanner: an opaque band that climbs with the scroll, the download riding it. */}
  <div class="wl__band">
    <BracketButton kind="hard" installer label="Download Toolset" event="scan-download" />
  </div>
</div>

<style>
  /* Fixed layer over the room (canvas z0) and the dead video (z1); under the copy layer
     (z3) and nav. Driven entirely by --scan (0..1) from the loop. */
  .wl {
    position: fixed;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    visibility: hidden;
    /* The band spans 16svh; its top runs from just past the bottom of the screen (108%)
       to fully above the top (-18%). One variable places everything. */
    --band-h: 16svh;
    --band-top: calc((1.08 - 1.26 * var(--scan, 0)) * 100%);
  }
  .wl[data-active] { visibility: visible; }
  .wl[data-active] :is(a, button) { pointer-events: auto; }

  .wl__wall {
    position: absolute;
    inset: 0;
    /* Revealed from the band's trailing edge down: everything above it is clipped away,
       and since the image never moves, the band reads as scanning the wall into view. */
    clip-path: inset(calc(var(--band-top) + var(--band-h)) 0 0 0);
  }
  .wl__wall :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .wl__band {
    position: absolute;
    left: 0;
    right: 0;
    top: var(--band-top);
    height: var(--band-h);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--carbon);
    border-top: 1px solid rgba(232, 224, 208, 0.10);
    /* The trailing edge is the scan line. Plasma, and the only glow in the piece. */
    border-bottom: 2px solid var(--plasma);
    box-shadow: 0 6px 24px rgba(124, 255, 178, 0.22);
    font-size: 1rem;
  }

  /* The cinematic never runs under 900px or in the static fallback. */
  @media (max-width: 900px) {
    .wl { display: none; }
  }
</style>
