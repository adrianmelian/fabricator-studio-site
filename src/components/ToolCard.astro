---
// Flagship tool card (RESTYLE-RULING.md ruling 2 + 3). No plasma at card scale;
// Learn More always renders BracketButton kind="soft".
//
// CP-D restyle (Adrian 2026-07-02): the card is now a full-width banner, image
// as the entire card with copy over it, same language as the hero. `align`
// picks which side the copy sits on ('left' | 'right'); the page alternates
// this per card down the flagshipTools order.
import { Image } from 'astro:assets';
import BracketButton from './BracketButton.astro';

interface Props { name: string; paras: string[]; href: string; image?: ImageMetadata; alt?: string; align?: 'left' | 'right'; dialogId?: string; textInUi?: boolean }
const { name, paras, href, image, alt, align = 'left', dialogId, textInUi = false } = Astro.props;

// A card only splits into two columns when a `ui` slot is actually passed. Cards without one
// keep the original single-column plate, so this stays additive rather than a rewrite.
const hasUi = Astro.slots.has('ui');

// Ruling 2: the scrim is only ever emitted when real media exists beneath it.
// Kept inline (not a static CSS rule) so a card with no image ships with zero
// gradient anywhere in the output, per guardrail 2d. Horizontal axis carbon
// scrim, direction follows the copy side so the art stays legible under the
// text and open on the far side (gate 13: carbon stops only, see
// scripts/check-brand-gates.mjs G13 which already accepts to left/to right).
const scrimStyle = align === 'right'
  ? 'background: linear-gradient(to left, rgba(11, 14, 16, 0.92) 0%, rgba(11, 14, 16, 0.55) 45%, rgba(11, 14, 16, 0) 75%);'
  : 'background: linear-gradient(to right, rgba(11, 14, 16, 0.92) 0%, rgba(11, 14, 16, 0.55) 45%, rgba(11, 14, 16, 0) 75%);';
---
<div class={`tool-banner tool-banner--${align}${textInUi ? ' tool-banner--uitext' : ''}`} data-parallax-window>
  {image ? (
    <div class="tool-banner__media">
      <Image class="tool-banner__image" src={image} alt={alt ?? ''} widths={[1024, 2048]} sizes="100vw" data-parallax />
      <div class="tool-banner__scrim" aria-hidden="true" style={scrimStyle}></div>
    </div>
  ) : null}
  <div class={`tool-banner__copy${hasUi && !textInUi ? ' tool-banner__copy--split' : ''}${textInUi ? ' tool-banner__copy--uitext' : ''}`}>
    {textInUi ? (
      /* Text-in-graphic cards: the graphic's own title block is the card's copy on desktop,
         so this column exists for PHONES ONLY (the graphic's cqw-sized type lands at ~5px on
         a 390px screen; the graphics hide their copy at <=720px and this takes over). It is
         display:none on desktop, which also keeps screen readers hearing exactly one copy of
         the text at any width. */
      <div class="tool-banner__text tool-banner__text--phone">
        <h3 class="tool-banner__name">{name}</h3>
        {paras.map((p) => <p class="tool-banner__para prose">{p}</p>)}
      </div>
    ) : (
      <div class="tool-banner__text">
        <h3 class="tool-banner__name">{name}</h3>
        {paras.map((p) => <p class="tool-banner__para prose">{p}</p>)}
        <div class="tool-banner__footer">
          <BracketButton kind="soft" href={href} label="Learn More" dialogTarget={dialogId} />
        </div>
      </div>
    )}
    {hasUi && (
      <div class="tool-banner__ui">
        <slot name="ui" />
      </div>
    )}
    {textInUi && (
      <div class="tool-banner__footer tool-banner__footer--uitext">
        <BracketButton kind="soft" href={href} label="Learn More" dialogTarget={dialogId} />
      </div>
    )}
  </div>
</div>
<style>
  .tool-banner {
    /* CP-D: border/radius removed, band sits full-bleed edge to edge with no
       frame (see index.astro #tools 100vw breakout). */
    position: relative;
    overflow: hidden;
    background: var(--iron);
    min-height: clamp(280px, 32vw, 400px);
    display: flex;
    align-items: center;
    /* the image is this much taller than the card; it drifts through on scroll */
    --card-travel: clamp(160px, 24vw, 380px);
  }
  .tool-banner--left { justify-content: flex-start; }
  .tool-banner--right { justify-content: flex-end; }
  .tool-banner__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .tool-banner__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: calc(100% + var(--card-travel));
    object-fit: cover;
    /* rest position is centered; the scroll-driven animation (or JS fallback) drives it */
    --parallax-travel: var(--card-travel);
    transform: translateY(calc(var(--card-travel) / -2));
    will-change: transform;
  }
  .tool-banner__scrim {
    position: absolute;
    inset: 0;
  }
  /* A real panel, not just a scrim (Adrian 2026-07-14). The gradient alone only TINTS the
     art, so a bright patch behind the copy still washed the text out. This puts an opaque-
     enough carbon plate under it, so legibility no longer depends on what the art is doing
     underneath. The scrim stays: it blends the plate's edge into the band. */
  .tool-banner__copy {
    position: relative;
    z-index: 1;
    max-width: 34rem;
    margin: 1.75rem;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    text-align: left;
    background: rgba(11, 14, 16, 0.31);
    /* Unprefixed ONLY. Hand-writing -webkit-backdrop-filter alongside it makes lightningcss
       treat the pair as duplicates and keep just the webkit one, which Firefox does not
       support: it would silently ship a plate with no blur there. The minifier adds whatever
       prefixes the targets need on its own. Verified against the BUILT css, not dev. */
    backdrop-filter: blur(6px) saturate(115%);
    border: 1px solid rgba(232, 224, 208, 0.1);
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
    text-shadow: 0 1px 2px rgba(11, 14, 16, 0.55);
  }
  /* Tests the STANDARD property only. ORing in the -webkit- alias would make this false on
     older Safari (which supports the alias) while the build emits no alias declaration, so
     Safari would land on a see-through plate with no blur and no fallback. Testing the
     standard property alone means anything without it gets the opaque plate instead. */
  @supports not (backdrop-filter: blur(1px)) {
    .tool-banner__copy { background: rgba(11, 14, 16, 0.55); }
  }
  /* Solid plasma, bold (Adrian 2026-07-13). The outlined tri-color treatment is deliberately
     kept EXCLUSIVE to the hero wordmark: running it on four cards as well diluted the
     signature. Plasma on a heading is not a color-law issue, principle 2 governs functional
     color (CTAs, error states), and principle 7's tri-color rule covers the tool BANNER
     assets, not a web heading. */
  /* Split plate: the animated GUI rides INSIDE the frosted plate, opposite the copy (Adrian
     2026-07-14). The GUI always lands on the side facing the middle of the band, so a
     left-aligned card reads text-then-GUI and a right-aligned one reads GUI-then-text. */
  .tool-banner__copy--split {
    max-width: min(74rem, 100%);
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 1.75rem;
    align-items: center;
  }
  /* Text-in-graphic cards: no copy column, so the plate is a single stack. The graphic runs
     the full width of the plate and the Learn More button sits under it. */
  /* The card stays 600px (Adrian 2026-07-14). Letting the graphic drive the height blew the
     card past it: the graphic is 16:9 and width:100%, so a plate filling a 1900px band made it
     ~1040px tall on its own. The height is pinned here and the GRAPHIC scales to fit inside it
     instead, which inverts the dependency: the card no longer grows to serve the graphic.
     The vars feed the graphic's calc() below, so card height, plate inset, and graphic height
     stay one equation: change a var and everything follows. Plate padding is slimmer than the
     stock 1.75rem plate (Adrian 2026-07-14): the graphic composition carries its own inner
     spacing, so a thick pad just ate height the graphic could use. */
  .tool-banner--uitext {
    --uitext-card-h: 600px;
    --uitext-plate-margin: 1.75rem;
    --uitext-plate-pad: 0.5rem;
    height: var(--uitext-card-h);
    min-height: var(--uitext-card-h);
  }

  .tool-banner__copy--uitext {
    /* Fills the band. flex:1 with max-width:none, because .tool-banner is a flex row and the
       plate is its only item: capping the width just left it floating in a gutter. The margin
       stays, so it fills the card with an inset rather than bleeding to the edges. */
    flex: 1;
    max-width: none;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: var(--uitext-plate-margin);
    padding: var(--uitext-plate-pad);
    /* Fills the card's HEIGHT too. .tool-banner centers its items on the cross axis, so the
       plate was content-sized and the graphic's height:100% chain had nothing to fill: the
       graphic rendered short inside the 600px card. Stretch overrides the centering for this
       plate only; the margins stay subtracted, so it fills 600px minus the inset. */
    align-self: stretch;
  }
  /* The graphic takes whatever height is left once the button has its share, and centres. */
  .tool-banner__copy--uitext .tool-banner__ui {
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  /* Height-driven, not width-driven: the graphic is aspect-ratio 16/9, so fixing its height
     and leaving width:auto makes the ASPECT RATIO compute the width. The height is the card
     equation solved outright (card minus plate margins and padding) rather than a height:100%
     percentage chain, which proved able to over-resolve and push the composition past the
     card. :global because slotted content carries its own component's scope, not this one's,
     so a plain descendant selector would never match it. */
  .tool-banner__copy--uitext .tool-banner__ui > :global(*) {
    width: auto;
    height: calc(var(--uitext-card-h) - 2 * var(--uitext-plate-margin) - 2 * var(--uitext-plate-pad));
    max-width: 100%;
  }
  /* Hidden on desktop: the graphic's title block carries the CTA there (Adrian 2026-07-14).
     This footer twin exists for phones, where the stage scales too far down for an in-graphic
     button to stay readable or tappable; the mobile block below turns it back on. */
  .tool-banner__footer--uitext { display: none; margin-top: 0; }

  .tool-banner__text {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
  }
  /* Desktop: the in-graphic copy carries the card; see the <=720px block. */
  .tool-banner__text--phone { display: none; }
  /* min-width:0 matters: a grid item defaults to min-content width, and the GUIs are wide,
     so without it the column refuses to shrink and blows the plate past the band. */
  .tool-banner__ui { min-width: 0; }
  /* Copy sits right => GUI takes the left column, facing the band's centre. */
  .tool-banner--right .tool-banner__ui { order: -1; }

  /* The card's copy IS the graphic's text block now (Adrian 2026-07-14). The graphics are
     frameless on the plate, so the region where their brand stack used to sit is just plate,
     and the tool's own name and pitch take it over. Scaled into that register: display type
     at brand-stack size, letter-spaced, not body copy parked beside a picture.
     Plasma, per the 2026-07-13 ruling on card titles. */
  .tool-banner__name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.9rem, 3.6vw, 3rem);
    letter-spacing: 0.03em;
    line-height: 1.05;
    color: var(--plasma);
    /* The rule inside the plate, dividing title from body (Adrian 2026-07-14). It spans the
       plate's full inner width because the heading is a block in a column flex. */
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(232, 224, 208, 0.14);
  }
  .tool-banner__para {
    /* Bone, not bone-dim: over photographic art the dimmer token loses too much contrast even
       under the carbon scrim. Sized up with the heading so the block reads as the card's
       headline copy rather than a caption. */
    color: var(--bone);
    font-size: clamp(1rem, 1.15vw, 1.1875rem);
    line-height: 1.6;
  }
  .tool-banner__footer {
    margin-top: 0.5rem;
  }
  @media (max-width: 720px) {
    .tool-banner {
      align-items: flex-end;
    }
    /* flex:1 with a margin, NOT width:100%: the plate now has margins, and 100% width plus
       margins overflows the band. This fills the band minus the gutter instead. */
    .tool-banner__copy {
      max-width: none;
      flex: 1;
      margin: 1rem;
      padding: 1.25rem;
    }
    /* The 600px pin is desktop-only: on a phone the plate is narrow, so a fixed 600px would
       leave the graphic stranded in a tall empty box. Back to content-sized height. */
    .tool-banner--uitext { height: auto; min-height: clamp(280px, 32vw, 400px); }
    .tool-banner__copy--uitext .tool-banner__ui > :global(*) { width: 100%; height: auto; }
    /* The phone-sized CTA: the in-graphic one hides at this width (see ReggieHero). */
    .tool-banner__footer--uitext { display: block; }
    /* The phone-sized copy: the in-graphic text hides at this width too (each hero's own
       <=720px rule), and this column is what makes the card readable at all on a phone. */
    .tool-banner__text--phone { display: flex; }

    /* Stack on phones. The order:-1 flip MUST be reset, or right-aligned cards would put the
       GUI above the heading while left-aligned ones put it below, and the four cards would
       disagree with each other down the page. Text first, GUI under it, every card. */
    .tool-banner__copy--split {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }
    .tool-banner--right .tool-banner__ui { order: 0; }
    /* Mobile: bottom-anchored to-top scrim (same shape as the pre-restyle
       card) reads cleaner at narrow widths than a horizontal scrim stretched
       to cover a full-width copy block. !important overrides the inline
       left/right gradient set above. */
    .tool-banner__scrim {
      background: linear-gradient(to top, rgba(11, 14, 16, 0.92) 0%, rgba(11, 14, 16, 0.55) 40%, rgba(11, 14, 16, 0) 65%) !important;
    }
  }
</style>
