---
// THE CLOSING BEAT (Adrian, 2026-08-19): About Me and Available for engagements,
// consolidated into one fullscreen layout over the room -- the page's last screen. The
// welcome video (his spoken introduction, click-to-play, no third-party script until
// pressed) stands left; the ask stands right with both of its doors. Copy is carried over
// VERBATIM from the two sections it consolidates (branch commit d9e73c5); nothing here is
// new prose.
import BracketButton from './BracketButton.astro';
import WelcomeVideo from './WelcomeVideo.astro';
---

<div class="cl" data-close-overlay>
  <p class="cl__title"><span class="cl__accent">About</span> Me</p>

  <div class="cl__media">
    <WelcomeVideo />
  </div>

  <div class="cl__copy">
    <p class="cl__head">Available for engagements.</p>
    <p class="cl__line">Rig and export setup, custom Maya tools, fractional TA and retainers. Delivered by the technical artist who built Fabricator, documented, and yours to keep.</p>
    <div class="cl__ctas">
      <BracketButton kind="hard" href="/services/" label="Learn More" event="home-services" />
      <a class="cl__mail" href="mailto:adrian@fabricator.studio">adrian@fabricator.studio</a>
    </div>
  </div>
</div>

<style>
  /* Fixed layer over the room, the page's last beat; same grammar as Armature's. */
  .cl {
    position: fixed;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    visibility: hidden;
  }
  .cl[data-active] { visibility: visible; }
  .cl[data-active] :global(a),
  .cl[data-active] :global(button) { pointer-events: auto; }

  .cl__title {
    position: absolute;
    left: 50%;
    top: 8%;
    transform: translateX(-50%);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(3rem, 5.6vw, 5.4rem);
    line-height: 1;
    /* Bone with the first word in plasma (Adrian, 2026-08-20: titles are green and white).
       Two words, so it takes the first-word shape the beat titles use rather than going
       green entire. */
    color: var(--bone);
    opacity: var(--close, 0);
    white-space: nowrap;
  }

  .cl__media {
    position: absolute;
    left: 10.5%;
    top: 24%;
    width: 38%;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    opacity: var(--close, 0);
    transform: translateY(calc((1 - var(--close, 0)) * 22px));
  }
  /* The component brings its own section paddings for the in-flow page; the overlay wants
     just the stage. */
  .cl__media :global(section) { padding: 0; max-width: none; }

  .cl__copy {
    position: absolute;
    left: 55%;
    right: 8%;
    top: 32%;
    opacity: var(--close, 0);
    transform: translateY(calc((1 - var(--close, 0)) * 22px));
  }
  .cl__head {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.6rem, 4.4vw, 4.6rem);
    line-height: 1.02;
    color: var(--bone);
  }
  .cl__line {
    margin-top: 1.4rem;
    font-weight: 300;
    font-size: clamp(1.2rem, 1.8vw, 1.6rem);
    line-height: 1.45;
    color: var(--bone);
    max-width: 44ch;
  }
  .cl__ctas {
    margin-top: 2.2rem;
    display: flex;
    align-items: center;
    gap: 1.6rem;
    flex-wrap: wrap;
    font-size: 0.95rem;
  }
  .cl__mail {
    font-weight: 300;
    font-size: 1.15rem;
    color: var(--bone);
    text-decoration: none;
  }
  .cl__mail:hover { color: var(--bone-dim); }

  .cl__accent { color: var(--bone); }

  /* BURGER WIDTH (Adrian, 2026-08-20: "the about doesn't pop up in mobile mode"). This was
     display:none here on the reasoning that "the cinematic never runs under 900px", true
     when written and false since the stage was opened up on 2026-08-20 -- so the phone
     scrolled through the closing beat and arrived at the footer having never been offered
     the introduction or the ask. Third layer to be found with the same stale gate, after
     the pipeline and the tool wall.

     The desktop layout is two columns, video left and the ask right. There is no second
     column here, so the whole beat becomes one centred stack in the flow of the fixed
     layer: title, the introduction, then the ask under it. */
  @media (max-width: 900px) {
    .cl {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 1.1rem;
      padding: var(--header-h) var(--container-px, 20px) 2svh;
      text-align: center;
    }
    .cl__title,
    .cl__media,
    .cl__copy {
      position: static;
      left: auto;
      right: auto;
      top: auto;
      transform: none;
      width: 100%;
      max-width: none;
    }
    .cl__title { font-size: clamp(2.2rem, 10.5vw, 3.2rem); }
    .cl__head { font-size: clamp(1.9rem, 7.6vw, 2.6rem); }
    /* 44ch is a desktop measure and it is wider than the column, so it does nothing here
       but has to be cleared for the centring to hold. */
    .cl__line {
      margin-top: 0.9rem;
      font-size: clamp(1.05rem, 4.2vw, 1.25rem);
      max-width: none;
    }
    .cl__ctas {
      margin-top: 1.4rem;
      justify-content: center;
      gap: 1.1rem;
    }
  }
</style>
