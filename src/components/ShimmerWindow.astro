---
// One app window on the FabricatorHero treatment: the real UI screenshot on a 3D panel with
// a slow rotateY sweep and a specular glint riding over it. Extracted as its own component
// on 2026-08-19 when Adrian delivered current captures of five more tool windows; the
// treatment was ruled good on the Fabricator card, so it is now the house style for showing
// a window.
//
// `delay` staggers the sweep so a wall of these never rocks in unison. `alt` empty +
// aria-hidden by default: on the toolset beat these are scenery with the info text carried
// elsewhere; pass a real alt when one stands alone.
import { Image } from 'astro:assets';
interface Props { src: ImageMetadata; alt?: string; delay?: number }
const { src, alt = '', delay = 0 } = Astro.props;
---

<div class="sw" style={`--sw-delay: ${delay}s; aspect-ratio: ${src.width} / ${src.height}`} aria-hidden={alt ? undefined : 'true'}>
  <div class="sw__panel">
    <Image src={src} alt={alt} draggable="false" widths={[src.width]} />
    <div class="sw__spec" aria-hidden="true"></div>
  </div>
</div>

<style>
  .sw {
    container-type: inline-size;
    perspective: 190cqw;
  }
  .sw__panel {
    width: 100%;
    height: 100%;
    transform-origin: 50% 50%;
    transform-style: preserve-3d;
    transform: rotateY(-6deg);
    border: 1px solid var(--iron-2);
    border-radius: var(--radius);
    background: #0b0e10;
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    animation: sw-rotate 8s ease-in-out infinite;
    animation-delay: var(--sw-delay, 0s);
  }
  /* :global because the Image component's rendered img doesn't carry this scope. */
  .sw__panel :global(img) { display: block; width: 100%; height: 100%; object-fit: fill; }

  /* Specular glint: a blurred bone bar sweeping across (no gradient, gate G13). */
  .sw__spec { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  .sw__spec::before {
    content: '';
    position: absolute;
    top: -20%;
    left: 0;
    width: 8.6cqw;
    height: 140%;
    background: rgba(232, 224, 208, 0.07);
    filter: blur(1.8cqw);
    transform: rotate(8deg);
    animation: sw-sweep 8s ease-in-out infinite;
    animation-delay: var(--sw-delay, 0s);
  }

  @keyframes sw-rotate {
    0%, 100% { transform: rotateY(-6deg); }
    50% { transform: rotateY(6deg); }
  }
  @keyframes sw-sweep {
    0%, 100% { transform: translateX(-40%) rotate(8deg); }
    50% { transform: translateX(560%) rotate(8deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .sw__panel, .sw__spec::before { animation: none; }
  }
</style>
