---
// THE PAGE MASTHEAD: one word, in the display face, tracked out and underlined.
//
// Built 2026-09-03 as a component rather than a class, because it is wanted on two pages
// that do not share a stylesheet: /pricing/ pulls in designed-doc.css and /account/ does
// not. One copy of the treatment, no duplicated CSS, and no new global.
//
// IT GROWS OUT OF THE PRICING PAGE. His design drop opened that page with a small
// letterspaced eyebrow over a serif headline; he then cut the headline and the standfirst,
// which left the eyebrow labelling nothing, so the eyebrow became the title: display face,
// bigger, underlined. Sized between the label it was and the headline scale it briefly
// reached, on his instruction ("a little smaller, inbetween what it was and is").
//
// IT IS THE PAGE'S H1. A page with no h1 is a page a screen reader and a search result
// cannot name, and on both of these pages this word is the only thing that names it.
// ONE WORD, NO SUBTITLE. A `sub` prop existed for about an hour on 2026-09-03, when the
// Services page carried "Custom Pipelines and Software" under the rule; he cut it the same
// evening ("it's the same thing below basically") because WHAT I BUILD sits directly
// beneath and says it in three cards. Removed rather than left unused: no page passes it,
// and putting it back is this comment plus a paragraph.
// THE WORDMARK SITS ABOVE THE TITLE (Adrian, 2026-09-04), which is how both of his design
// drops opened. It is decorative here: the page title beneath it names the page, and the
// navigation bar already carries the studio name as a link, so announcing it a third time
// is noise to a screen reader.
import Wordmark from './Wordmark.astro';

// `promise` is the display-serif line under the rule. It began as page-local CSS on the
// Maya Pipeline page; when the Unreal page asked for the same header on 2026-09-04 it
// moved in here rather than being copied, so the two cannot drift.
interface Props { title: string; promise?: string }
const { title, promise } = Astro.props;
---
<header class="mh">
  <Wordmark class="mh__mark" decorative height="clamp(2rem, 4.4vw, 2.875rem)" />
  {/* The inner span carries the rule. Letter-spacing leaves a trailing space after the
      final letter: it is inside the border box, so an underline drawn on the element runs
      0.34em past the last glyph. The negative margin re-centres the word and the rule is
      an absolutely positioned pseudo-element inset by that same trailing space, so it
      stops under the last letter instead of overhanging it. */}
  <h1 class="mh__title"><span>{title}</span></h1>
  {promise && <p class="mh__promise">{promise}</p>}
</header>

<style>
  /* THE MASTHEAD OWNS ITS OWN VERTICAL SPACE, on his instruction 2026-09-03: "make it
     standardized and unified between them". It did not, and the three pages disagreed.
     /account/ wraps its content in a <section>, which base.css pads 2.5rem, so its
     masthead started 40px lower than the other two; and <section> has no flex gap, so the
     underline finished 0px above the sign-in panel and touched it. /pricing/ and
     /services/ sit in .dd, a flex column whose 2.75rem gap was doing the work instead.

     So the spacing is set here and the two host containers' contributions are cancelled
     below. Measured on all three afterwards, not assumed. */
  .mh {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    /* Halved on his instruction 2026-09-04: measured 48px to the bar, now 24. */
    padding-top: 1.5rem;
    margin-bottom: 2.5rem;
  }
  /* .dd's flex gap lands after this block; take it back off. */
  /* A FLEX HOST'S OWN GAP GOVERNS, and the masthead adds nothing to it. Subtracting a
     fixed number here assumed one gap value and there are three: .dd is 2.75rem, .lc
     overrides it to 3.5rem on Pricing, and a bare <section> has none. That guess is what
     put Pricing's first gap at 52px while every other gap on that page was 56, which is
     the "all over the place" he saw. Now each page's rhythm is its own and even. */
  :global(.dd) > .mh { margin-bottom: 0; }
  /* base.css: `section { padding: 2.5rem 1.5rem }`. Cancel the top half only. */
  :global(section) > .mh { margin-top: -2.5rem; }
  /* Targeted through :global BECAUSE THE CLASS DOES NOT REACH IT. Astro stamps the child
     component's own id on its root element, not this one's, so a bare `.mh__mark` rule
     here matches nothing and the mark sat flush against the title: measured gap 0px. The
     parent selector keeps the escape hatch scoped to this masthead. */
  /* Doubled on his instruction: measured 20px to the title, now 40. */
  .mh > :global(.fs-wordmark) { margin-bottom: 2.5rem; }
  .mh__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    /* SMALLER AGAIN (Adrian, 2026-09-04), now that the wordmark sits above it. At 38px the
       title was within a few pixels of the 46px mark and the two read as one stack
       competing for the same job. It sits clearly under the mark at 28px. */
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    text-transform: uppercase;
    color: var(--bone-dim);
    line-height: 1;
  }
  .mh__title span {
    position: relative;
    display: inline-block;
    letter-spacing: 0.34em;
    margin-right: -0.34em;
    /* THE RULE MUST OCCUPY HEIGHT. It is an absolutely positioned pseudo-element, so it
       is out of flow and contributes nothing to the h1's box; hung below the box it then
       overlapped the subtitle, whose margin was measured from the text rather than from
       the rule. This padding puts the rule inside the box, so everything below it is
       spaced from the line the reader actually sees. */
    padding-bottom: 0.26em;
  }
  /* Sits the same 40px under the title that the wordmark sits above it, so the masthead
     steps evenly from mark to title to promise. */
  .mh__promise {
    margin: 2.5rem auto 0;
    max-width: 24ch;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.875rem, 4.4vw, 3.25rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--bone);
    text-wrap: pretty;
  }
  .mh__title span::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0.34em; /* inset by the trailing letter-space so it stops at the last glyph */
    bottom: 0;
    height: 2px;
    background: currentColor;
  }
</style>
