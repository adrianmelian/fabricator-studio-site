---
// The full-bleed download banner with its parallax window.
//
// Extracted out of the homepage 2026-07-22 (website overhaul) so both the homepage and
// /tools/ can carry the same door without the markup being duplicated. Unchanged otherwise.
// The parallax timeline is NAMED (see base.css): this window is overflow:hidden, so a plain
// view() would resolve against the clipped box and never animate.
import { Image } from 'astro:assets';
import BracketButton from './BracketButton.astro';
import downloadBanner from '../assets/download/download_card.png';
---
<section id="download" class="download-v2" data-parallax-window>
  <Image class="download-media" src={downloadBanner} alt="" aria-hidden="true" width={2048} loading="lazy" data-parallax />
  <div class="download-scrim" aria-hidden="true"></div>
  <div class="download-copy">
    <BracketButton kind="plasma-outline" downloadGate label="Free Download" />
  </div>
</section>
<style>
  .download-v2 {
    position: relative;
    overflow: hidden;
    width: 100vw;
    max-width: 100vw;
    margin: 0 0 0 calc(50% - 50vw);
    padding: 1.5rem;
    height: clamp(340px, 34vw, 560px);
    display: flex;
    align-items: center;
    justify-content: center;
    /* the image is this much taller than the window; it travels through it on scroll */
    --dl-travel: clamp(160px, 24vw, 380px);
  }
  .download-media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: calc(100% + var(--dl-travel));
    object-fit: cover;
    z-index: 0;
    /* rest position is centered; the scroll-driven animation (or JS fallback) drives it */
    --parallax-travel: var(--dl-travel);
    transform: translateY(calc(var(--dl-travel) / -2));
    will-change: transform;
  }
  .download-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to bottom, rgba(11, 14, 16, 0) 0%, rgba(11, 14, 16, 0.72) 45%, rgba(11, 14, 16, 0) 100%);
  }
  .download-copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
  }
</style>
