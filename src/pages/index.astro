---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import FieldLabel from '../components/FieldLabel.astro';
import BracketButton from '../components/BracketButton.astro';
import ToolCard from '../components/ToolCard.astro';
import FabricatorHero from '../components/FabricatorHero.astro';
import BridgeHero from '../components/BridgeHero.astro';
import AnimStudioHero from '../components/AnimStudioHero.astro';
import ReggieHero from '../components/ReggieHero.astro';
import downloadBanner from '../assets/download/download_card.png';
import Footer from '../components/Footer.astro';
import NavBar from '../components/NavBar.astro';
import { flagshipTools } from '../data/tools';
import { features } from '../data/features';
import { TUTORIALS, CHANNEL } from '../data/tutorials';
import wordmark from '../assets/hero/fabricatorstudio_wordmark.png';

const aboutPhoto = Object.values(import.meta.glob('../assets/about/*.{jpg,jpeg,png,webp}', { eager: true }))[0];
---
<BaseLayout
  title="FabricatorStudio | The Artist-Friendly Game Dev Pipeline"
  description="Free Maya rigging toolset built by a 14-year AAA technical artist. Download Fabricator, and hire the TA who built it when you need him."
>
  <NavBar />
  <section id="hero" class="hero-v2">
    <video class="hero-media" autoplay muted loop playsinline
      poster="/demo/fs_hero_poster.jpg"
      src="/demo/fs_hero.mp4"
      aria-hidden="true">
    </video>
    <img class="hero-media hero-poster" src="/demo/fs_hero_poster.jpg" alt="" aria-hidden="true" />
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="hero-copy">
      <h1 class="hero-wordmark">
        <Image src={wordmark} alt="FabricatorStudio" width={620} densities={[1, 2]} loading="eager" fetchpriority="high" />
      </h1>
      <p class="hero-tagline">\\ FOR ARTISTS, BY ARTISTS \\</p>
      <p class="hero-sub">Built for solo developers and small teams. Free, open source, Maya-to-Unreal full pipeline tools. Rigging, skinning, animation, and export, and an AI Technical Artist built in. The kit is made for the asset generation era. Generated or hand-built, these tools help you put the final touch on your art and get it in engine fast. Ready for all the next-gen features, like Control Rig and MetaHuman.</p>
      <p class="hero-strip">Concept • Modeling • Texturing • Rigging • Animation • Unreal</p>
      <div class="hero-ctas">
        <BracketButton kind="plasma-outline" downloadGate label="Download" />
      </div>
    </div>
  </section>

  <section id="tools">
    <div class="tools__stack">
      {flagshipTools.map((t, i) => (
        <ToolCard name={t.name} paras={t.paras} href={t.href} image={t.image} alt={t.alt} align={i % 2 === 0 ? 'left' : 'right'} dialogId={t.dialogId} />
      ))}
    </div>
  </section>

  <dialog id="pop-fabricator" class="product-pop">
    <div class="product-pop__inner">
      <button type="button" class="product-pop__close" data-dialog-close aria-label="Close">✕</button>
      <FabricatorHero />
      <div class="product-pop__body">
        <h2 class="product-pop__headline">Rigging, the fast part of your pipeline.</h2>
        <p>Fabricator is a template-driven, network-based rigging system for solo devs and small teams. Drag components onto your skeleton, build the whole rig in one pass, and never lose work to a rebuild.</p>
        <ul>
          <li>Non-destructive and non-linear. Unbuild, restructure, and rebuild, even while animation is already in production.</li>
          <li>Rename anything. Rig state lives in your scene as network connections, not name strings, so nothing breaks.</li>
          <li>Animator-ready out of the box: IK/FK matching that holds the pose, space switching, smart pole vectors, and a marking menu on every control.</li>
          <li>Save a rig as a template and reuse it across your whole cast, even at different proportions.</li>
        </ul>
        <p class="product-pop__free">Free and open source. Pure Python, nothing to compile, nothing hidden.</p>
        <a class="product-pop__docs" href="/docs/tools/fabricator/">Read the full docs →</a>
      </div>
    </div>
  </dialog>

  <dialog id="pop-studio" class="product-pop">
    <div class="product-pop__inner">
      <button type="button" class="product-pop__close" data-dialog-close aria-label="Close">✕</button>
      <AnimStudioHero />
      <div class="product-pop__body">
        <h2 class="product-pop__headline">Animate once. Reuse everywhere.</h2>
        <p>Animation Studio saves poses and clips to a library that travels across every rig built with Fabricator. Capture a hero pose or a walk cycle once, then drop it onto the next character, even one built at different proportions.</p>
        <ul>
          <li>Poses and clips address controls by component identity, not node names, so they resolve onto any Fabricator rig.</li>
          <li>Place, insert, or replace clips on the timeline, with start and end anchors and root-motion control.</li>
          <li>Selection sets mask a pose down to just the parts you want.</li>
          <li>Thumbnails and hover previews keep a big library scannable.</li>
        </ul>
        <p class="product-pop__free">Build your library once, and every new character starts ahead.</p>
        <a class="product-pop__docs" href="/docs/tools/pose-anim-studio/">Read the full docs →</a>
      </div>
    </div>
  </dialog>

  <dialog id="pop-bridge" class="product-pop">
    <div class="product-pop__inner">
      <button type="button" class="product-pop__close" data-dialog-close aria-label="Close">✕</button>
      <BridgeHero />
      <div class="product-pop__body">
        <h2 class="product-pop__headline">Your whole toolset, two clicks away.</h2>
        <p>Bridge puts the entire FabricatorStudio toolbox into one compact, dockable toolbar inside Maya. Launch the big tools, fire the everyday utilities, and stop hunting through shelves and menus.</p>
        <ul>
          <li>Every tool two clicks away, in a single dockable strip.</li>
          <li>Popover launchers keep it compact, no shelf sprawl, no menu digging.</li>
          <li>Versioned builds, so "what version are you on" always has an answer.</li>
          <li>Connect your own AI right from the strip: start the read-only bridge and copy the setup snippet for your client.</li>
        </ul>
        <p class="product-pop__free">Built for the way technical artists actually work.</p>
        <a class="product-pop__docs" href="/docs/tools/bridge/">Read the full docs →</a>
      </div>
    </div>
  </dialog>

  <dialog id="pop-reggie" class="product-pop">
    <div class="product-pop__inner">
      <button type="button" class="product-pop__close" data-dialog-close aria-label="Close">✕</button>
      <ReggieHero />
      <div class="product-pop__body">
        <h2 class="product-pop__headline">A senior TA on call, inside Maya.</h2>
        <p>Reggie is an AI technical artist that reads your actual scene and your Fabricator rig, then helps you fix what broke. Ask why a build failed, where a rig went wrong, or how a tool works, and get answers grounded in what is really in your file.</p>
        <ul>
          <li>Connect your own AI: Claude Code, Claude Desktop, Cursor, any MCP client. Your model, your key, your machine.</li>
          <li>Read-only, enforced in code. Reggie can see everything and change nothing. When something needs fixing, it hands you the script to run.</li>
          <li>Trained on the FabricatorStudio pipeline: it troubleshoots from the docs, proposes the documented fix, and files a clean bug report only when a real bug remains.</li>
        </ul>
        <p class="product-pop__free">Like having a senior TA on call, minus the coffee runs.</p>
        <a class="product-pop__docs" href="/docs/tools/your-ai-ta/">Read the full docs →</a>
      </div>
    </div>
  </dialog>
  <script is:inline>
    (function () {
      document.querySelectorAll('[data-dialog-open]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var d = document.getElementById(btn.getAttribute('data-dialog-open'));
          if (d && d.showModal) d.showModal();
        });
      });
      document.querySelectorAll('dialog.product-pop').forEach(function (d) {
        d.querySelectorAll('[data-dialog-close]').forEach(function (b) {
          b.addEventListener('click', function () { d.close(); });
        });
        d.addEventListener('click', function (e) { if (e.target === d) d.close(); });
      });
    })();
  </script>

  <section id="features">
    <FieldLabel text="Key Features" />
    <div class="features__grid">
      {features.map((f) => (
        <div class="feature-tile">
          <h3 class="feature-tile__name">{f.name}</h3>
          <p class="feature-tile__line">{f.line}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="download" class="download-v2" data-parallax-window>
    <Image class="download-media" src={downloadBanner} alt="" aria-hidden="true" width={2048} loading="lazy" data-parallax />
    <div class="download-scrim" aria-hidden="true"></div>
    <div class="download-copy">
      <BracketButton kind="plasma-outline" downloadGate label="Download" />
    </div>
  </section>

  {TUTORIALS.length > 0 && (
    <section id="tutorials">
      <FieldLabel text="Tutorials" />
      <h2 class="subhead">Learn the kit.</h2>
      <div class="tutorials__grid">
        {TUTORIALS.map((t) => (
          <a class="tutorial-card" href={t.href}>
            {t.thumb && <img class="tutorial-card__thumb" src={t.thumb} alt="" />}
            <span class="tutorial-card__title">{t.title}</span>
          </a>
        ))}
      </div>
      <BracketButton kind="soft" href={CHANNEL} label="All Tutorials" />
    </section>
  )}

  <section id="about">
    <FieldLabel text="About Me" />
    <div class={`about__grid${aboutPhoto ? ' about__grid--photo' : ''}`}>
      {aboutPhoto && (
        <Image class="about__photo" src={(aboutPhoto as any).default} alt="Adrian Melian" width={480} densities={[1, 2]} />
      )}
      <div class="prose about__body">
        <p>Hi, I'm Adrian Melian. I've spent 14 years as a Technical Artist in AAA games, most recently leading the Tech Art team at Sledgehammer Games. Along the way I've worked with Double Fine, Ubisoft, Camouflaj, and Meta, on games like Broken Age, Modern Warfare III, and South Park: The Fractured But Whole.</p>
        <p>Game dev is changing fast, and a new era of generative AI is here. Avoiding generic slop still takes good tools, ones that put the layers of polish where you want them. So I'm sharing my toolbox. FabricatorStudio is the rigging, skinning, animation, and export kit I built for indie teams and small studios, to the standard I held on AAA productions. The tools are free and open source.</p>
      </div>
    </div>
  </section>

  <Footer />

  <script is:inline>
    (function () {
      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var pairs = [].slice.call(document.querySelectorAll('[data-parallax]'))
        .map(function (img) { return { img: img, win: img.closest('[data-parallax-window]') }; })
        .filter(function (pr) { return pr.win; });
      if (!pairs.length) return;
      var ticking = false;
      function update() {
        ticking = false;
        var vh = window.innerHeight || document.documentElement.clientHeight;
        for (var i = 0; i < pairs.length; i++) {
          var img = pairs[i].img, win = pairs[i].win;
          var overflow = img.offsetHeight - win.offsetHeight;
          if (overflow <= 0) { img.style.transform = ''; continue; }
          var rect = win.getBoundingClientRect();
          var p = (vh - rect.top) / (vh + rect.height);
          p = p < 0 ? 0 : p > 1 ? 1 : p;
          img.style.transform = 'translateY(' + (-overflow * (1 - p)).toFixed(1) + 'px)';
        }
      }
      function onScroll() { if (!ticking) { ticking = true; requestAnimationFrame(update); } }
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      update();
    })();
  </script>
</BaseLayout>
<style>
  .hero-v2 {
    position: relative;
    overflow: hidden;
    width: 100vw;
    max-width: 100vw;
    margin: 0 0 0 calc(50% - 50vw);
    padding: 0 1.5rem 3.5rem;
    min-height: 78vh;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-direction: column;
  }
  .hero-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .hero-v2 video.hero-media { display: block; }
  .hero-v2 img.hero-poster { display: none; }
  @media (prefers-reduced-motion: reduce) {
    .hero-v2 video.hero-media { display: none; }
    .hero-v2 img.hero-poster { display: block; }
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to top, rgba(11, 14, 16, 0.92) 0%, rgba(11, 14, 16, 0.55) 40%, rgba(11, 14, 16, 0) 65%);
  }
  .hero-copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-align: center;
    max-width: 44rem;
    text-shadow: 0 1px 2px rgba(11, 14, 16, 0.9), 0 2px 12px rgba(11, 14, 16, 0.55);
  }
  .hero-wordmark { display: block; max-width: min(90vw, 40rem); margin: 0 auto; }
  .hero-wordmark img { display: block; width: 100%; height: auto; filter: drop-shadow(0 2px 12px rgba(11, 14, 16, 0.55)); }
  /* ember per Adrian 2026-07-02; ruling-5c delta (advised bone/plasma) recorded in workspace */
  .hero-tagline { font-family: var(--font-mono); font-weight: 700; font-size: 1.5rem; color: var(--ember); }
  .hero-sub { font-family: var(--font-body); font-size: 1.0625rem; color: var(--bone); }
  .hero-strip { font-family: var(--font-mono); font-size: 0.9375rem; color: var(--bone-dim); letter-spacing: 0.06em; }
  .hero-ctas { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; margin-top: 0.75rem; }

  /* CP-D: full-bleed band stack, edge to edge below the hero,
     no gap between cards. Same 100vw breakout technique as .hero-v2. */
  #tools {
    position: relative;
    width: 100vw;
    max-width: 100vw;
    margin: 0 0 0 calc(50% - 50vw);
    padding: 0;
  }
  .tools__stack { display: flex; flex-direction: column; gap: 0; text-align: left; }

  /* Product popover (flagship Learn More) */
  .product-pop {
    margin: auto; /* restore the centering a global margin reset strips off the modal */
    padding: 0;
    border: 1px solid var(--iron-3);
    border-radius: var(--radius);
    background: #0B0E10;
    color: var(--bone);
    width: min(900px, 92vw);
    max-width: 92vw;
    max-height: 90vh;
    overflow: hidden auto;
  }
  .product-pop::backdrop { background: rgba(11, 14, 16, 0.82); }
  .product-pop__inner { position: relative; }
  .product-pop__img { display: block; width: 100%; height: auto; }
  .product-pop__close {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    z-index: 10;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1;
    color: var(--bone);
    background: rgba(11, 14, 16, 0.6);
    border: 1px solid var(--iron-3);
    border-radius: var(--radius);
    padding: 0.35rem 0.55rem;
    cursor: pointer;
  }
  .product-pop__close:hover { color: var(--ember); border-color: var(--ember); }
  .product-pop__body { padding: 1.75rem 2rem 2rem; text-align: left; }
  .product-pop__headline { font-family: var(--font-mono); font-weight: 700; font-size: 1.375rem; color: var(--bone); }
  .product-pop__body p { color: var(--bone-dim); font-size: 0.9375rem; line-height: 1.6; margin-top: 0.75rem; }
  .product-pop__body ul { margin: 1rem 0 0; padding-left: 1.1rem; display: flex; flex-direction: column; gap: 0.4rem; }
  .product-pop__body li { color: var(--bone-dim); font-size: 0.9375rem; line-height: 1.5; }
  .product-pop__free { color: var(--bone); }
  .product-pop__docs {
    display: inline-block;
    margin-top: 1.25rem;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--plasma);
    text-decoration: none;
  }
  .product-pop__docs:hover { color: var(--plasma-dim); }

  #features { text-align: center; }
  #features .subhead { margin-inline: auto; }
  .features__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; margin: 2rem 0; text-align: left; }
  @media (max-width: 900px) { .features__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .features__grid { grid-template-columns: 1fr; } }
  .feature-tile { border: 1px solid var(--iron-2); border-radius: var(--radius); background: var(--iron); padding: 1.25rem; display: flex; flex-direction: column; gap: 0.5rem; }
  .feature-tile__name { font-family: var(--font-mono); font-weight: 700; font-size: 1.125rem; line-height: 1.1; color: var(--bone); }
  .feature-tile__line { color: var(--bone-dim); font-size: 0.9375rem; }

  .download-v2 {
    position: relative;
    overflow: hidden;
    width: 100vw;
    max-width: 100vw;
    margin: 0 0 0 calc(50% - 50vw);
    padding: 1.5rem;
    height: clamp(340px, 34vw, 560px);
    display: flex;
    align-items: center;
    justify-content: center;
    /* the image is this much taller than the window; it travels through it on scroll */
    --dl-travel: clamp(90px, 14vw, 220px);
  }
  .download-media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: calc(100% + var(--dl-travel));
    object-fit: cover;
    z-index: 0;
    /* rest position is centered; the parallax script drives it from here */
    transform: translateY(calc(var(--dl-travel) / -2));
    will-change: transform;
  }
  .download-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to bottom, rgba(11, 14, 16, 0) 0%, rgba(11, 14, 16, 0.72) 45%, rgba(11, 14, 16, 0) 100%);
  }
  .download-copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
  }
  .download-line { font-family: var(--font-mono); font-weight: 700; font-size: 1.5rem; color: var(--bone); }


  #tutorials { text-align: center; }
  #tutorials .subhead { margin-inline: auto; }
  .tutorials__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 0.75rem; margin: 2rem 0; text-align: left; }
  .tutorial-card { display: flex; flex-direction: column; border: 1px solid var(--iron-2); border-radius: var(--radius); background: var(--iron); overflow: hidden; text-decoration: none; color: inherit; }
  .tutorial-card__thumb { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .tutorial-card__title { font-family: var(--font-mono); font-weight: 700; font-size: 1rem; color: var(--bone); padding: 1.25rem; }

  #rigs { text-align: center; }
  #rigs .prose { margin-inline: auto; }
  .rigs__ctas { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; margin-top: 1.5rem; }

  #about { text-align: center; }
  #about .about__grid {
    margin-inline: auto;
    max-width: 56rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    text-align: left;
  }
  #about .about__grid--photo { grid-template-columns: 240px 1fr; align-items: start; }
  #about .about__photo {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--iron-3);
    border-radius: var(--radius);
  }
  #about .about__body { display: flex; flex-direction: column; gap: 1rem; }
  @media (max-width: 720px) {
    #about .about__grid--photo { grid-template-columns: 1fr; }
  }
</style>
