---
import BaseLayout from '../layouts/BaseLayout.astro';
import FieldLabel from '../components/FieldLabel.astro';
import BracketButton from '../components/BracketButton.astro';
import TermFrame from '../components/TermFrame.astro';
import ModuleRow from '../components/ModuleRow.astro';
import { Image } from 'astro:assets';
import lockup from '../assets/fabricatorstudio-lockup.png';
import { tools } from '../data/tools';

const demoStills = Object.values(import.meta.glob('../assets/demo/*.{png,jpg,webp}', { eager: true }));
const DOWNLOAD_URL = 'https://github.com/adrianmelian/KinematicSolutions/releases/latest';
---
<BaseLayout
  title="FabricatorStudio | The Artist-Friendly Toolset"
  description="Free Maya rigging toolset built by a 14-year AAA technical artist. Download Fabricator, and hire the TA who built it when you need him."
>
  <section class="hero">
    <Image src={lockup} alt="FabricatorStudio" width={420} densities={[1, 2]} loading="eager" fetchpriority="high" />
    <FieldLabel text="The Artist-Friendly Toolset" />
    <h1 class="vt">AAA character pipeline, free on your desk.</h1>
    <p class="subhead prose">The TA who built it, on call.</p>
    <div class="hero__ctas">
      <BracketButton kind="hard" href={DOWNLOAD_URL} label="Download Fabricator" />
      <BracketButton kind="soft" href="#services" label="Services" />
    </div>
    {demoStills.length > 0 && (
      <TermFrame title="Fabricator" meta="persp | Fabricator">
        <img src={(demoStills[0] as any).default.src} alt="Fabricator building a character rig in Maya" />
      </TermFrame>
    )}
  </section>

  <section id="toolset">
    <FieldLabel text="Toolset" />
    <h2 class="subhead">Every tool in the kit. Free, no tiers, no license keys.</h2>
    <div class="toolset__rows">
      {tools.map((t) => <ModuleRow name={t.name} line={t.line} pill={t.pill} pillTone={t.pillTone} />)}
    </div>
    <BracketButton kind="hard" href={DOWNLOAD_URL} label="Download the toolset" />
  </section>

  <section id="services">
    <FieldLabel text="Services" />
    <h2 class="subhead">The toolset is free. The TA behind it is for hire.</h2>
    <p class="prose">Fixed-scope packages, priced up front. Every engagement is delivered by the person who built the tools, not a team you have never met.</p>
    <div class="services__grid">
      <div class="service">
        <h3>Pipeline Health Audit</h3>
        <p>One week. Rigs, skinning, export path, naming, versioning. You get a findings doc, a prioritized fix list, and a quote. The fee credits 100% toward the first fix package signed within 30 days.</p>
        <p class="service__price">from $1,500</p>
      </div>
      <div class="service">
        <h3>Export Contract Fix</h3>
        <p>Two to three days. One named character exporting clean into Unreal, end to end.</p>
        <p class="service__price">from $1,500</p>
      </div>
      <div class="service">
        <h3>Character Rig and Export Setup</h3>
        <p>Hero characters rigged with Fabricator and wired into your Maya-to-Unreal export contract. Scoped by roster size.</p>
        <p class="service__price">from $2,500</p>
      </div>
      <div class="service">
        <h3>Custom Tool Sprint</h3>
        <p>One scoped Maya tool built to spec in two to three weeks, docs included.</p>
        <p class="service__price">from $5,000</p>
      </div>
    </div>
    <p class="prose">Ongoing support runs as a monthly retainer, from $2,500 a month. Embedded contract work and advisory are quoted per engagement.</p>
    <BracketButton kind="soft" href="mailto:adrianmelian123@gmail.com?subject=FabricatorStudio%20discovery%20call" label="Book a discovery call" />
  </section>

  <section id="who">
    <FieldLabel text="Who Built This" />
    <h2 class="subhead">Adrian Melian. 14 years of AAA character pipelines.</h2>
    <div class="prose who__body">
      <p>I led the Character Tech Art team at Sledgehammer Games across three Call of Duty titles, including Vanguard and Modern Warfare III, and shipped work at Meta, Double Fine, and Ubisoft along the way. Rigs, skinning, export contracts, and the tools artists ship through have been my whole career.</p>
      <p>Fabricator and this toolset are independent rebuilds, written from scratch for indie teams. No employer code, no legacy baggage. The same pipeline thinking, sized for a team that does not have a TA on staff.</p>
      <p><a href="https://adrianmelian.com">Portfolio and full history at adrianmelian.com</a></p>
    </div>
  </section>
</BaseLayout>
<style>
  .hero { display: flex; flex-direction: column; gap: 1.25rem; align-items: center; text-align: center; padding-top: 6rem; }
  .hero__ctas { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; margin: 0.5rem 0 1.5rem; }
  .hero .subhead { margin-inline: auto; }

  #toolset { text-align: center; }
  #toolset .subhead { margin-inline: auto; }
  .toolset__rows { display: flex; flex-direction: column; gap: 0.5rem; margin: 1.5rem 0 2rem; text-align: left; }

  #services { text-align: center; }
  #services .prose { margin-inline: auto; }
  .services__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 0.75rem; margin: 1.5rem 0; text-align: left; }
  .service { border: 1px solid var(--iron-2); border-radius: var(--radius); background: var(--iron); padding: 1.25rem; display: flex; flex-direction: column; gap: 0.625rem; }
  .service h3 { font-size: 1rem; }
  .service p { color: var(--bone-dim); font-size: 0.9375rem; }
  .service__price { margin-top: auto; color: var(--bone); font-weight: 700; }

  #who { text-align: center; }
  #who .who__body { margin-inline: auto; text-align: left; display: flex; flex-direction: column; gap: 1rem; }
</style>
