---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import FieldLabel from '../components/FieldLabel.astro';
import BracketButton from '../components/BracketButton.astro';
import ToolCard from '../components/ToolCard.astro';
import Footer from '../components/Footer.astro';
import NavBar from '../components/NavBar.astro';
import { LINKS } from '../data/links';
import Pill from '../components/Pill.astro';
import { flagshipTools } from '../data/tools';
import { features } from '../data/features';
import { toolFeatureBlocks } from '../data/toolFeatures';
import { TUTORIALS, CHANNEL } from '../data/tutorials';
import wordmark from '../assets/hero/fabricatorstudio_wordmark.png';

const aboutPhoto = Object.values(import.meta.glob('../assets/about/*.{jpg,jpeg,png,webp}', { eager: true }))[0];
---
<BaseLayout
  title="FabricatorStudio | The Artist-Friendly Game Dev Pipeline"
  description="Free Maya rigging toolset built by a 14-year AAA technical artist. Download Fabricator, and hire the TA who built it when you need him."
>
  <NavBar />
  <section id="hero" class="hero-v2">
    <video class="hero-media" autoplay muted loop playsinline
      poster="/demo/fs_hero_poster.jpg"
      src="/demo/fs_hero.mp4"
      aria-hidden="true">
    </video>
    <img class="hero-media hero-poster" src="/demo/fs_hero_poster.jpg" alt="" aria-hidden="true" />
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="hero-copy">
      <h1 class="hero-wordmark">
        <Image src={wordmark} alt="FabricatorStudio" width={620} densities={[1, 2]} loading="eager" fetchpriority="high" />
      </h1>
      <p class="hero-tagline">\\ FOR ARTISTS, BY ARTISTS \\</p>
      <p class="hero-sub">Free, Artist-Friendly Game Developer Pipeline. Tools that support asset creation at every step, from concept to in-engine.</p>
      <p class="hero-strip">Concept • Modeling • Texturing • Rigging • Animation • Unreal</p>
      <div class="hero-ctas">
        <BracketButton kind="plasma-outline" href={LINKS.download} label="Download" />
        <BracketButton kind="soft" href="#rigs" label="Free Rigs" />
      </div>
    </div>
  </section>

  <section id="mission">
    <p class="mission__copy">Built for solo developers and small teams. Free, open source, Maya-to-Unreal rigging, skinning, animation, and export tools. Production-grade tools allow for much faster development. The kit is made for the asset generation era. These tools help you put the final touch on your art and get it in engine fast.</p>
    <p class="mission__copy">Connect your own AI to the toolset and it becomes the Technical Artist on call, integrated directly into the tools. Your AI TA proposes the fix and walks you through it. It can also report bugs directly to FabricatorStudio, pre-filled and ready to submit. All of it is read-only, enforced in code: your AI can see your scene, never touch it. Your model, your key, your machine.</p>
  </section>

  <section id="tools">
    <div class="tools__stack">
      {flagshipTools.map((t, i) => (
        <ToolCard name={t.name} paras={t.paras} href={t.href} image={t.image} alt={t.alt} align={i % 2 === 0 ? 'left' : 'right'} />
      ))}
    </div>
  </section>

  <section id="features">
    <FieldLabel text="Key Features" />
    <div class="features__grid">
      {features.map((f) => (
        <div class="feature-tile">
          <h3 class="feature-tile__name">{f.name}</h3>
          <p class="feature-tile__line">{f.line}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="download" class="download-v2">
    <!-- Interim background: reusing the hero poster until Adrian delivers dedicated media for this banner. -->
    <img class="download-media" src="/demo/fs_hero_poster.jpg" alt="" aria-hidden="true" />
    <div class="download-scrim" aria-hidden="true"></div>
    <div class="download-copy">
      <BracketButton kind="plasma-outline" href={LINKS.download} label="Download" />
    </div>
  </section>

  <section id="toolbox">
    <FieldLabel text="The Toolbox" />
    <h2 class="subhead">Every tool in the kit.</h2>
    <div class="toolbox__grid">
      {toolFeatureBlocks.map((t) => (
        <div class="toolbox-block">
          <div class="toolbox-block__head">
            <h3 class="toolbox-block__name">{t.name}</h3>
            {t.coming && <Pill text="Coming" tone="ember" />}
          </div>
          <p class="toolbox-block__blurb">{t.blurb}</p>
          <ul class="toolbox-block__list">
            {t.features.map((f) => <li>{f}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  {TUTORIALS.length > 0 && (
    <section id="tutorials">
      <FieldLabel text="Tutorials" />
      <h2 class="subhead">Learn the kit.</h2>
      <div class="tutorials__grid">
        {TUTORIALS.map((t) => (
          <a class="tutorial-card" href={t.href}>
            {t.thumb && <img class="tutorial-card__thumb" src={t.thumb} alt="" />}
            <span class="tutorial-card__title">{t.title}</span>
          </a>
        ))}
      </div>
      <BracketButton kind="soft" href={CHANNEL} label="All Tutorials" />
    </section>
  )}

  <section id="rigs">
    <FieldLabel text="Free Rigs" />
    <h2 class="subhead">Free rigs, built with Fabricator.</h2>
    <p class="prose">Production-quality rigs for animators, students, and demo reels, free to download and animate. The first rig is in production now. Follow the devlog or watch the GitHub releases to catch it the day it lands.</p>
    <div class="rigs__ctas">
      <BracketButton kind="soft" href="/blog/" label="Devlog" />
      <BracketButton kind="soft" href={LINKS.download} label="Releases" />
    </div>
  </section>

  <section id="about">
    <FieldLabel text="About Me" />
    <div class={`about__grid${aboutPhoto ? ' about__grid--photo' : ''}`}>
      {aboutPhoto && (
        <img class="about__photo" src={(aboutPhoto as any).default.src} alt="Adrian Melian" />
      )}
      <div class="prose about__body">
        <p>Hello, my name is Adrian Melian and I've been in AAA Game Development for over 15 years. As a Technical Artist, I've worked on games like Call of Duty: MW3, South Park: Fractured but Whole, Broken Age and others, with great studios like Double Fine, Ubisoft, Sledgehammer, Camouflaj, Meta, and more.</p>
        <p>With a quickly changing game dev environment I thought I would share my toolbox, so other developers in the community can build faster and at a higher quality. The pipeline is built for easy AI integration and to speed up the parts in between. At FabricatorStudio we know AI is the future and are embracing it, but a human touch is what brings the extra layer of personalization to your art. FabricatorStudio tools are easy to use, artist-friendly, and built to the standard I held on AAA productions. And it's free. I can't wait to see what the community can build with a professional toolset.</p>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
<style>
  .hero-v2 {
    position: relative;
    overflow: hidden;
    width: 100vw;
    max-width: 100vw;
    margin: 0 0 0 calc(50% - 50vw);
    padding: 0 1.5rem 3.5rem;
    min-height: 78vh;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-direction: column;
  }
  .hero-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .hero-v2 video.hero-media { display: block; }
  .hero-v2 img.hero-poster { display: none; }
  @media (prefers-reduced-motion: reduce) {
    .hero-v2 video.hero-media { display: none; }
    .hero-v2 img.hero-poster { display: block; }
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to top, rgba(11, 14, 16, 0.92) 0%, rgba(11, 14, 16, 0.55) 40%, rgba(11, 14, 16, 0) 65%);
  }
  .hero-copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-align: center;
    max-width: 44rem;
    text-shadow: 0 1px 2px rgba(11, 14, 16, 0.9), 0 2px 12px rgba(11, 14, 16, 0.55);
  }
  .hero-wordmark { display: block; max-width: min(90vw, 40rem); margin: 0 auto; }
  .hero-wordmark img { display: block; width: 100%; height: auto; filter: drop-shadow(0 2px 12px rgba(11, 14, 16, 0.55)); }
  /* ember per Adrian 2026-07-02; ruling-5c delta (advised bone/plasma) recorded in workspace */
  .hero-tagline { font-family: var(--font-mono); font-weight: 700; font-size: 1.5rem; color: var(--ember); }
  .hero-sub { font-family: var(--font-body); font-size: 1.0625rem; color: var(--bone); }
  .hero-strip { font-family: var(--font-mono); font-size: 0.9375rem; color: var(--bone-dim); letter-spacing: 0.06em; }
  .hero-ctas { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; margin-top: 0.75rem; }

  #mission { text-align: center; }
  .mission__copy {
    max-width: 46rem;
    margin-inline: auto;
    font-family: var(--font-body);
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--bone);
  }
  .mission__copy + .mission__copy { margin-top: 1.25rem; }

  /* CP-D: full-bleed band stack, edge to edge below the mission band,
     no gap between cards. Same 100vw breakout technique as .hero-v2. */
  #tools {
    position: relative;
    width: 100vw;
    max-width: 100vw;
    margin: 0 0 0 calc(50% - 50vw);
    padding: 0;
  }
  .tools__stack { display: flex; flex-direction: column; gap: 0; text-align: left; }

  #features { text-align: center; }
  #features .subhead { margin-inline: auto; }
  .features__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; margin: 2rem 0; text-align: left; }
  @media (max-width: 900px) { .features__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .features__grid { grid-template-columns: 1fr; } }
  .feature-tile { border: 1px solid var(--iron-2); border-radius: var(--radius); background: var(--iron); padding: 1.25rem; display: flex; flex-direction: column; gap: 0.5rem; }
  .feature-tile__name { font-family: var(--font-mono); font-weight: 700; font-size: 1.125rem; line-height: 1.1; color: var(--bone); }
  .feature-tile__line { color: var(--bone-dim); font-size: 0.9375rem; }

  .download-v2 {
    position: relative;
    overflow: hidden;
    width: 100vw;
    max-width: 100vw;
    margin: 0 0 0 calc(50% - 50vw);
    padding: 1.5rem;
    min-height: 40vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .download-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .download-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to bottom, rgba(11, 14, 16, 0) 0%, rgba(11, 14, 16, 0.72) 45%, rgba(11, 14, 16, 0) 100%);
  }
  .download-copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
  }
  .download-line { font-family: var(--font-mono); font-weight: 700; font-size: 1.5rem; color: var(--bone); }

  #toolbox { text-align: center; }
  #toolbox .subhead { margin-inline: auto; }
  .toolbox__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.75rem; margin: 2rem 0; text-align: left; }
  @media (max-width: 800px) { .toolbox__grid { grid-template-columns: 1fr; } }
  .toolbox-block { border: 1px solid var(--iron-2); border-radius: var(--radius); background: var(--iron); padding: 1.25rem; display: flex; flex-direction: column; gap: 0.5rem; }
  .toolbox-block__head { display: flex; align-items: baseline; justify-content: space-between; gap: 0.75rem; }
  .toolbox-block__name { font-family: var(--font-mono); font-weight: 700; font-size: 1.125rem; line-height: 1.1; color: var(--bone); }
  .toolbox-block__blurb { color: var(--bone); font-size: 0.9375rem; }
  .toolbox-block__list { margin: 0; padding-left: 1.1rem; display: flex; flex-direction: column; gap: 0.35rem; }
  .toolbox-block__list li { color: var(--bone-dim); font-size: 0.9rem; line-height: 1.55; }

  #tutorials { text-align: center; }
  #tutorials .subhead { margin-inline: auto; }
  .tutorials__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 0.75rem; margin: 2rem 0; text-align: left; }
  .tutorial-card { display: flex; flex-direction: column; border: 1px solid var(--iron-2); border-radius: var(--radius); background: var(--iron); overflow: hidden; text-decoration: none; color: inherit; }
  .tutorial-card__thumb { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .tutorial-card__title { font-family: var(--font-mono); font-weight: 700; font-size: 1rem; color: var(--bone); padding: 1.25rem; }

  #rigs { text-align: center; }
  #rigs .prose { margin-inline: auto; }
  .rigs__ctas { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; margin-top: 1.5rem; }

  #about { text-align: center; }
  #about .about__grid {
    margin-inline: auto;
    max-width: 56rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    text-align: left;
  }
  #about .about__grid--photo { grid-template-columns: 240px 1fr; align-items: start; }
  #about .about__photo {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--iron-3);
    border-radius: var(--radius);
  }
  #about .about__body { display: flex; flex-direction: column; gap: 1rem; }
  @media (max-width: 720px) {
    #about .about__grid--photo { grid-template-columns: 1fr; }
  }
</style>
