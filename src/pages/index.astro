---
// The homepage. Rebuilt 2026-07-22 (website overhaul, two-door architecture).
//
// What changed and why, so nobody re-litigates it from the diff:
//
// The page used to be a product page wearing a studio's name. Its first four screens offered
// one action, nothing said a person was for hire until a visitor found the Services tab, and
// it ended on the bio with no ask at all. It also argued twice: six adjective cards sat
// directly under four blocks that DEMONSTRATED the same claims, and a tutorials grid spent a
// whole section saying that a nav item exists.
//
// The governing rule of the pass was a FIXED SECTION BUDGET: every addition names the element
// it replaces, and the page may end shorter but never longer. It ended shorter.
//
//   key features (6 adjective cards)  ->  BUILT WITH IT (the proof section)
//   tutorials grid                    ->  WORK WITH ME (the closing ask, the page had none)
//   hero sub 2 ("Generative AI era")  ->  the studio line, and it now leads the hero
//   the 4th repeat of the free line   ->  the shipped record, credited to the person
//   the four tool cards + popups      ->  relocated INTACT to /tools/, which can grow
//   the licensing tiers               ->  relocated to /tools/, next to what they price
//
// Deliberately untouched: the hero video, the wordmark, the download gate and its
// MailerLite/R2 path, the welcome video's position, the WHY quote (Adrian's verbatim story),
// and Mindmeld 2.0 styling everywhere.
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import BracketButton from '../components/BracketButton.astro';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import WelcomeVideo from '../components/WelcomeVideo.astro';
import SectionHead from '../components/SectionHead.astro';
import DownloadBand from '../components/DownloadBand.astro';
import FabricatorHero from '../components/FabricatorHero.astro';
import { WHY_PARAS } from '../data/licensing';

import aboutPortrait from '../assets/about/adrian.png';
import heroWordmark from '../assets/hero/wordmark-banner.png';

// BUILT WITH IT. Three entries, not four: Archangel is held back until Adrian clears the
// game's art direction for public view, and a filler fourth would weaken the three that
// carry real weight. Every claim here is verifiable today, which is the entire point of the
// section: we out-prove the field, we were just never showing it.
//
// `pill` is plasma for shipped/live states (DNA principle 2: plasma = success/correct).
// Ember stays reserved for IN DEVELOPMENT, which nothing on this page currently carries.
//
// Media: a poster still that carries the card on its own, and a six-second silent loop that
// plays on hover or keyboard focus. NOT autoplay. The hero already autoplays a video, three
// more loops firing on load would cost real weight and battery for motion most visitors
// never look at, and the still is what has to read at thumbnail size regardless. On touch,
// under reduced-motion, and with JS off, the poster simply stands on its own.
//
// Both clips are 4:3, which is why the media box is no longer 16:10: both subjects are
// standing figures, and a wide box spent most of its area on floor and empty background.
//
// `shot` names the asset an entry is still waiting on (MrMiata:
// workspace/2026-07-22_website-overhaul/SHOT-LIST.md). An entry with no media renders a
// visibly unfinished plate rather than silently collapsing.
const PROOF = [
  {
    name: 'Reggie',
    pill: 'LIVE',
    claim: 'Rigged, skinned, and exported to Unreal entirely through the pipeline.',
    detail:
      'Built in Maya with Fabricator, skinned with AutoSkin, exported through the FBX skeletal exporter, and imported into Unreal against the same rig-binding contract every character in the pipeline uses. No hand-off, no cleanup pass, no separate export rig.',
    video: '/proof/proof-reggie.mp4',
    poster: '/proof/proof-reggie.jpg',
    alt: 'Reggie, a rabbit character in a suit, animating in the Unreal viewport.',
  },
  {
    name: 'QS_BipedRig',
    pill: 'SHIPPED',
    claim: 'The blueprint anyone downloads, built and validated on a vanilla Maya install.',
    detail:
      'The blueprint that ships with the toolset. It builds on a clean Maya install with nothing else present, which is the only test that matters for a rig anyone can download.',
    video: '/proof/proof-qsbiped.mp4',
    poster: '/proof/proof-qsbiped.jpg',
    alt: 'The QS_BipedRig in the Maya viewport, animation controls visible on the character.',
  },
];
---
<BaseLayout
  title="FabricatorStudio | The Artist-Friendly Game Dev Pipeline"
  description="A one-person technical art studio. The free Maya to Unreal character pipeline, and the 14-year AAA technical artist who built it, available for hire."
>
  <NavBar />

  <section id="hero" class="hero-v2">
    <video class="hero-media" autoplay muted loop playsinline
      poster="/demo/fs_hero_poster.jpg"
      src="/demo/fs_hero.mp4"
      aria-hidden="true">
    </video>
    <img class="hero-media hero-poster" src="/demo/fs_hero_poster.jpg" alt="" aria-hidden="true" />
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="hero-copy">
      <h1 class="hero-wordmark">
        <Image src={heroWordmark} alt="FabricatorStudio" widths={[1180, 2205]} sizes="(max-width: 820px) 92vw, 1180px" loading="eager" />
      </h1>
      <p class="hero-tagline">HUMAN+AI STUDIO TOOLSET</p>
      <div class="hero-divider" aria-hidden="true">
        <span class="hero-divider__bar"></span>
        <span class="hero-divider__gem"></span>
        <span class="hero-divider__bar"></span>
      </div>
      {/* The studio line LEADS now. This is the whole posture fix in one sentence swap: the
          page declares what it is in the first six seconds, instead of a visitor having to
          find the Services tab to learn a person is behind it. */}
      <p class="hero-sub hero-sub--studio"><b>FabricatorStudio is a one-person technical art studio.</b> The pipeline is <b class="hero-sub__hl">free</b>. The technical artist who built it is <b class="hero-sub__ember">available for hire</b>.</p>
      <p class="hero-sub"><b>Next-gen Maya Studio Pipeline.</b> FabricatorStudio allows you to focus on <b class="hero-sub__hl">what matters most</b>, and <b class="hero-sub__ember">automates the rest</b>. Automated <b class="hero-sub__hl">high-end, animator-friendly rigs</b>, <b class="hero-sub__ember">autoskinning</b>, and <b class="hero-sub__hl">direct to engine delivery</b>.</p>
      {/* Two doors, unequal on purpose. Most arrivals today come for the toolset, so the free
          download keeps the visual weight it has always had and the paid door sits beside it
          rather than competing with it. Hiring is NOT in the hero: it is a different audience
          and it converts better after the proof, in the closing band. */}
      <div class="hero-ctas">
        <BracketButton kind="hard" downloadGate label="Get the free toolset" event="hero-download" />
        <BracketButton kind="soft" href="/store/" label="Advanced Modules →" event="hero-store" />
      </div>
    </div>
  </section>

  {/* The spoken introduction, before any UI. A cold visitor gets a human voice first. */}
  <section id="welcome">
    <WelcomeVideo />
  </section>

  {/* WAS: six key-feature cards. They claimed "Easy to use", "Studio-grade tools", and
      "Non-destructive workflow" immediately after four blocks that demonstrated exactly
      those things with real UI. Claims placed after proof are worse than useless; they
      weaken the proof. This section shows what the pipeline has MADE instead. */}
  <section id="proof">
    <SectionHead
      eyebrow="FABRICATORSTUDIO"
      title="BUILT WITH IT"
      sub="Not screenshots of the tools. The characters and the work that came out of them."
    />
    <div class="pf-grid">
      {PROOF.map((p) => (
        <article class="pf-card">
          <div class="pf-media">
            {p.video ? (
              <>
                <video class="pf-vid" src={p.video} poster={p.poster} muted loop playsinline preload="none" aria-label={p.alt}></video>
                <span class="pf-play" aria-hidden="true"></span>
              </>
            ) : (
              <div class="pf-pending" role="img" aria-label={`${p.name}: media pending`}>
                <span class="pf-shot">ASSET PENDING</span>
              </div>
            )}
          </div>
          <div class="pf-body">
            <div class="pf-top">
              <h3 class="pf-name">{p.name}</h3>
              <span class="pf-pill">{p.pill}</span>
            </div>
            <p class="pf-claim">{p.claim}</p>
            <details class="pf-more">
              <summary class="pf-more__q">How</summary>
              <p class="pf-more__a">{p.detail}</p>
            </details>
          </div>
        </article>
      ))}

      {/* The third entry's evidence is textual rather than photographic, so it is set as
          type instead of faked as a screenshot. Every line below is checkable by clicking
          it, which is a stronger argument than a picture of a repo page would have been. */}
      <article class="pf-card">
        <div class="pf-media pf-media--type">
          <span class="pf-v">v1</span>
          <span class="pf-v__lic">BUSL-1.1, source available</span>
          <div class="pf-v__links">
            <a href="/docs/">Docs</a>
            <a href="/changelog/">Changelog</a>
            <a href="/known-issues/">Known issues</a>
            <a href="https://github.com/adrianmelian/FabricatorStudio" target="_blank" rel="noopener">Source</a>
          </div>
        </div>
        <div class="pf-body">
          <div class="pf-top">
            <h3 class="pf-name">FabricatorStudio v1</h3>
            <span class="pf-pill">SHIPPED</span>
          </div>
          <p class="pf-claim">Public source, full docs, a public issue tracker, and outside users.</p>
          <details class="pf-more">
            <summary class="pf-more__q">How</summary>
            <p class="pf-more__a">Shipped 2026-07-20 under BUSL-1.1, with documentation, a public issue tracker, a changelog, and a known-issues page. Every version becomes fully open source four years after it ships, automatically.</p>
          </details>
        </div>
      </article>
    </div>
  </section>

  {/* WAS: four full-bleed tool cards. They were the strongest thing on the site and they are
      not lost: they moved to /tools/ intact, popups and all, where the toolset can grow
      without making this page longer every time a tool ships. What stays here is one block
      that names the box and gets out of the way, carrying the Fabricator graphic so the
      homepage keeps a real visual anchor for the product. */}
  <section id="toolset">
    <SectionHead eyebrow="FABRICATORSTUDIO" title="THE TOOLSET" />
    <div class="tk-grid">
      <div class="tk-ui"><FabricatorHero /></div>
      <div class="tk-body">
        <p class="tk-lead">Modular rigging, automatic skinning, a cross-rig pose and animation library, and FBX exporters with an engine-ready contract.</p>
        <p class="tk-line">Pure Python, source available, nothing to compile, nothing hidden.</p>
        <p class="tk-lic">Free for studios under $2 million a year. <a href="/licensing/">See licensing</a>.</p>
        <div class="tk-ctas">
          <BracketButton kind="hard" href="/tools/" label="See the toolset" event="home-toolset" />
        </div>
      </div>
    </div>
  </section>

  <DownloadBand />

  {/* WAS: the tutorials grid. It spent a full section telling a visitor that a page in the
      nav exists, using YouTube's thumbnails, which made it the least on-brand block on the
      page. Tutorials keep their nav item, their page, and a footer link. In its place, the
      thing the homepage never had: an ask. */}
  <section id="hire">
    <div class="hb-card">
      <h2 class="hb-head">Available for engagements.</h2>
      <p class="hb-line">Rig and export setup, custom Maya tools, fractional TA and retainers. Delivered by the technical artist who built Fabricator, documented, and yours to keep.</p>
      <div class="hb-ctas">
        <BracketButton kind="hard" href="/services/" label="See services" event="home-services" />
        <a class="hb-mail" href="mailto:adrian@fabricator.studio">adrian@fabricator.studio</a>
      </div>
    </div>
  </section>

  <section id="about">
    <SectionHead eyebrow="FABRICATORSTUDIO" title="ABOUT ME" />
    <div class="am-grid">
      <div class="am-portrait">
        <div class="am-portrait__frame">
          <div class="am-portrait__edge" aria-hidden="true"></div>
          <Image src={aboutPortrait} alt="Adrian Melian" widths={[660, 1320]} sizes="(max-width: 820px) 92vw, 560px" />
        </div>
        <div class="am-portrait__cap">
          <span class="am-portrait__tick" aria-hidden="true"></span>
          <span class="am-portrait__line">Technical Artist &nbsp;&middot;&nbsp; 14 years in AAA</span>
        </div>
      </div>
      <div class="am-bio">
        <h3 class="am-bio__name">Hi, I'm Adrian Melian.</h3>
        {/* CREDENTIAL CORRECTION (approved). The live line said "most recently leading the
            Tech Art team at Sledgehammer Games", which was wrong twice over: most recent was
            Camouflaj, and compressing 14 years across six studios into a Sledgehammer lead
            line breaks the credential-honesty rule. Two shipped Call of Duty titles, never
            three. */}
        <p class="am-bio__para">I've spent <b>14 years as a Technical Artist</b> in AAA games, at <b class="am-plasma-b">Sledgehammer Games</b>, Camouflaj, Meta, Double Fine, Ubisoft, and NCSoft. I led the Character and Weapons Tech Art teams at Sledgehammer and shipped two Call of Duty titles. Along the way: Broken Age, South Park: The Fractured But Whole, Horizon Worlds.</p>
        <p class="am-bio__para">Game dev is changing fast, and a new era of generative AI is here. Avoiding generic slop still takes <b>good tools</b>, ones that put the layers of polish where you want them. So I'm sharing my toolbox. <b class="am-ember-b">FabricatorStudio</b> is the rigging, skinning, animation, and export kit I built for indie teams and small studios, to the standard I held on AAA productions.</p>
        <figure class="lcb-why">
          <span class="lcb-why__mark lcb-why__mark--open" aria-hidden="true">“</span>
          <span class="lcb-why__mark lcb-why__mark--close" aria-hidden="true">”</span>
          <blockquote class="lcb-why__quote">
            {WHY_PARAS.map((p) => <p class="lcb-why__para" set:html={p} />)}
          </blockquote>
          <figcaption class="lcb-why__cite"><span class="lcb-why__rule" aria-hidden="true"></span>Adrian</figcaption>
        </figure>
        {/* WAS: "The tools are free for solo developers, indies, and small teams." By this
            point the page had already said that in the hero, the toolset block, and the WHY
            story. A fourth repetition of the price, sitting next to the bio, diluted the
            credential it was standing on. This is the evidence that paragraph was missing.
            Titles only, no aggregate count: every one below shipped, and a list is both
            stronger and unarguable where "13 titles" keeps drifting. */}
        <div class="am-record">
          <div class="am-record__head">
            <span class="am-record__tick" aria-hidden="true"></span>
            <span class="am-record__label">14 YEARS &nbsp;&middot;&nbsp; SHIPPED</span>
          </div>
          <p class="am-record__list">Call of Duty: Vanguard &middot; Call of Duty: Modern Warfare III &middot; Broken Age &middot; Costume Quest 2 &middot; South Park: The Fractured But Whole &middot; Horizon Worlds &middot; Arizona Sunshine: Contagion Z &middot; Massive Chalice</p>
        </div>
      </div>
    </div>
  </section>

  <Footer />

  {/* Proof cards: poster by default, loop on hover or keyboard focus.
      Bails entirely on touch (no hover pointer) and under reduced-motion, where the poster
      is the whole experience and preload="none" means the clip is never even fetched. */}
  <script is:inline>
    (function () {
      var mm = window.matchMedia;
      if (!mm) return;
      if (mm('(prefers-reduced-motion: reduce)').matches) return;
      if (!mm('(hover: hover)').matches) return;
      document.querySelectorAll('.pf-card').forEach(function (card) {
        var v = card.querySelector('.pf-vid');
        if (!v) return;
        function play() {
          card.classList.add('is-playing');
          var p = v.play();
          // Autoplay policy can still reject a programmatic play(); swallow it rather than
          // throwing an unhandled rejection into the console on every hover.
          if (p && p.catch) p.catch(function () { card.classList.remove('is-playing'); });
        }
        function stop() {
          v.pause();
          card.classList.remove('is-playing');
        }
        card.addEventListener('pointerenter', play);
        card.addEventListener('pointerleave', stop);
        card.addEventListener('focusin', play);
        card.addEventListener('focusout', stop);
      });
    })();
  </script>

  <script is:inline>
    (function () {
      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      // Modern browsers (incl. mobile) get smooth compositor parallax from CSS (base.css).
      // This JS only runs as a fallback where scroll-driven animations are unsupported.
      if (window.CSS && CSS.supports && CSS.supports('animation-timeline: view()')) return;
      var pairs = [].slice.call(document.querySelectorAll('[data-parallax]'))
        .map(function (img) { return { img: img, win: img.closest('[data-parallax-window]') }; })
        .filter(function (pr) { return pr.win; });
      if (!pairs.length) return;
      var ticking = false;
      function update() {
        ticking = false;
        var vh = window.innerHeight || document.documentElement.clientHeight;
        for (var i = 0; i < pairs.length; i++) {
          var img = pairs[i].img, win = pairs[i].win;
          var overflow = img.offsetHeight - win.offsetHeight;
          if (overflow <= 0) { img.style.transform = ''; continue; }
          var rect = win.getBoundingClientRect();
          var p = (vh - rect.top) / (vh + rect.height);
          p = p < 0 ? 0 : p > 1 ? 1 : p;
          img.style.transform = 'translateY(' + (-overflow * (1 - p)).toFixed(1) + 'px)';
        }
      }
      function onScroll() { if (!ticking) { ticking = true; requestAnimationFrame(update); } }
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      update();
    })();
  </script>
</BaseLayout>

<style>
  .hero-v2 {
    position: relative;
    overflow: hidden;
    width: 100vw;
    max-width: 100vw;
    margin: 0 0 0 calc(50% - 50vw);
    padding: 0;
    /* svh, not vh: on mobile vh measures the viewport with the toolbars RETRACTED, so a
       100vh hero is taller than what you can see and the next section peeks on load.
       min-height, not height: .hero-v2 clips its overflow and a fixed height would
       guillotine the CTAs on short screens. */
    min-height: calc(100vh - var(--header-h));
    min-height: calc(100svh - var(--header-h));
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-direction: column;
  }
  .hero-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .hero-v2 video.hero-media { display: block; }
  .hero-v2 img.hero-poster { display: none; }
  @media (prefers-reduced-motion: reduce) {
    .hero-v2 video.hero-media { display: none; }
    .hero-v2 img.hero-poster { display: block; }
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to top, rgba(11, 14, 16, 0.92) 0%, rgba(11, 14, 16, 0.55) 40%, rgba(11, 14, 16, 0) 65%);
  }
  /* A full-bleed BAND, not a floating plate. The video is the worst offender for legibility:
     it MOVES, so a scrim that reads fine on one frame washes the copy out on the next. A
     plate makes legibility independent of whatever frame is playing behind it. */
  .hero-copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    text-align: center;
    align-self: stretch;
    min-height: calc(0.6 * (100vh - var(--header-h)));
    min-height: calc(0.6 * (100svh - var(--header-h)));
    padding: 1.75rem 2rem;
    background: rgba(11, 14, 16, 0.31);
    /* Unprefixed ONLY: hand-writing the -webkit- twin makes lightningcss drop the standard
       property and Firefox loses the blur silently. */
    backdrop-filter: blur(6px) saturate(115%);
    border: 0;
    border-top: 1px solid rgba(232, 224, 208, 0.1);
    border-bottom: 1px solid rgba(232, 224, 208, 0.1);
    box-shadow: var(--shadow-lg);
    text-shadow: 0 1px 2px rgba(11, 14, 16, 0.55);
  }
  /* Tests the STANDARD property only. ORing in the -webkit- alias would make this false on
     older Safari (which supports the alias) while the build emits no alias declaration, so
     Safari would land on a see-through plate with no blur and no fallback. */
  @supports not (backdrop-filter: blur(1px)) {
    .hero-copy { background: rgba(11, 14, 16, 0.55); }
  }
  .hero-wordmark { margin: 0; width: min(73.75rem, 100%); }
  .hero-wordmark :global(img) {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 18px 40px rgba(11, 14, 16, 0.55));
  }
  .hero-tagline { margin: 0; font-family: var(--font-mono); font-weight: 700; font-size: clamp(1rem, 2vw, 1.5rem); letter-spacing: 0.28em; color: var(--ember); }
  .hero-divider { display: flex; align-items: center; gap: 0.75rem; }
  .hero-divider__bar { width: 3rem; height: 3px; background: var(--plasma); border-radius: var(--radius-pill); }
  .hero-divider__gem { width: 0.55rem; height: 0.55rem; background: var(--plasma); transform: rotate(45deg); }
  .hero-sub { font-family: var(--font-body); font-size: 1.0625rem; line-height: 1.7; color: var(--bone); max-width: 52rem; }
  /* The posture line reads a step up from the description under it: mono, slightly larger,
     so the first thing a visitor parses is what this place IS. */
  .hero-sub--studio { font-family: var(--font-mono); font-size: clamp(1.0625rem, 1.6vw, 1.1875rem); }
  .hero-sub b { color: var(--bone); }
  .hero-sub .hero-sub__hl { color: var(--plasma); }
  .hero-sub .hero-sub__ember { color: var(--ember); }
  .hero-ctas { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; margin-top: 0.75rem; }

  /* BUILT WITH IT. Reuses the card furniture the key-features grid used, so this cost
     styling work rather than design work, and the section it replaces is not missed. */
  #proof { text-align: left; }
  .pf-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.125rem; }
  @media (max-width: 900px) { .pf-grid { grid-template-columns: 1fr; } }
  .pf-card {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    background: linear-gradient(180deg, var(--iron), var(--carbon));
    border: 1px solid rgba(124, 255, 178, 0.14);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }
  /* 4:3, not 16:10. Both proof subjects are standing figures, and a wide box spent most of
     its area on floor and empty background. */
  .pf-media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-bottom: 1px solid rgba(124, 255, 178, 0.18);
    background: radial-gradient(120% 120% at 50% 38%, var(--iron-2), var(--carbon));
  }
  .pf-vid { display: block; width: 100%; height: 100%; object-fit: cover; }
  /* The affordance, and the only thing that says the still is also a clip. It fades out
     once playback starts, so a playing card is not wearing a play button. */
  .pf-play {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 2.75rem;
    height: 2.75rem;
    margin: -1.375rem 0 0 -1.375rem;
    border-radius: 50%;
    background: rgba(11, 14, 16, 0.55);
    border: 1px solid rgba(124, 255, 178, 0.5);
    pointer-events: none;
    transition: opacity var(--t-base) var(--ease-out);
  }
  .pf-play::after {
    content: '';
    position: absolute;
    left: 55%;
    top: 50%;
    transform: translate(-50%, -50%);
    border-top: 0.45rem solid transparent;
    border-bottom: 0.45rem solid transparent;
    border-left: 0.75rem solid var(--plasma);
  }
  .pf-card.is-playing .pf-play { opacity: 0; }
  /* No hover pointer means no hover affordance to advertise. */
  @media (hover: none) {
    .pf-play { display: none; }
  }

  .pf-pending {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1.25rem;
    text-align: center;
  }
  .pf-shot {
    font-family: var(--font-mono);
    font-weight: 800;
    font-size: 0.6875rem;
    letter-spacing: 0.22em;
    color: var(--ember);
