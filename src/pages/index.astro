---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import BracketButton from '../components/BracketButton.astro';
import ToolCard from '../components/ToolCard.astro';
import FabricatorHero from '../components/FabricatorHero.astro';
import BridgeHero from '../components/BridgeHero.astro';
import AnimStudioHero from '../components/AnimStudioHero.astro';
import ReggieHero from '../components/ReggieHero.astro';
import downloadBanner from '../assets/download/download_card.png';
import Footer from '../components/Footer.astro';
import NavBar from '../components/NavBar.astro';
import { flagshipTools } from '../data/tools';
import { TUTORIALS } from '../data/tutorials';
import { WHY_PARAS } from '../data/licensing';
import WelcomeVideo from '../components/WelcomeVideo.astro';

// Key Features section heading in the outlined tri-color treatment (Adrian x Claude
// Design, 2026-07-17). Same glyph cycle as the designed docs pages: letters only,
// continuing across word gaps.
const KF_TITLE = 'KEY FEATURES';
const KF_TRI = ['kf-bone', 'kf-plasma', 'kf-ember'];
let kfi = 0;
const kfGlyphs = KF_TITLE.split('').map((ch) => ({ ch, cls: ch === ' ' ? 'kf-gap' : KF_TRI[kfi++ % 3] }));

import aboutPortrait from '../assets/about/adrian.png';
import heroWordmark from '../assets/hero/wordmark-banner.png';

// About Me section heading, same tri-color treatment as Key Features (Adrian x Claude
// Design, 2026-07-17).
const AM_TITLE = 'ABOUT ME';
const AM_TRI = ['am-bone', 'am-plasma', 'am-ember'];
let ami = 0;
const amGlyphs = AM_TITLE.split('').map((ch) => ({ ch, cls: ch === ' ' ? 'am-gap' : AM_TRI[ami++ % 3] }));

// The hero pipeline strip carries a colour per word (Adrian 2026-07-19), tuned by hand
// rather than cycled: accents alternate against beige so the strip reads in beats.
// "Engine" rather than "Unreal": Unity and Godot ship too (untested) and the export path
// is engine-agnostic, so naming one engine misleads.
const PIPELINE: Array<[string, string]> = [
  ['Concept', 'bone'],
  ['Modeling', 'ember'],
  ['Texturing', 'bone'],
  ['Rigging', 'plasma'],
  ['Animation', 'bone'],
  ['Engine', 'cobalt'],
];

// Tutorials block heading, same treatment (Adrian x Claude Design, 2026-07-17; source
// drop: MrMiata inbox/Docs/"Tutorials Block Docs.html"). The drop predates the uploads;
// the cards carry the REAL thumbnails and links from the tutorials data.
const TB_TITLE = 'TUTORIALS';
const TB_TRI = ['tb-bone', 'tb-plasma', 'tb-ember'];
let tbi = 0;
const tbGlyphs = TB_TITLE.split('').map((ch) => ({ ch, cls: ch === ' ' ? 'tb-gap' : TB_TRI[tbi++ % 3] }));

// The animated GUI that rides inside each tool card, keyed by the tool's dialog. These are
// the same components the Learn More popovers use, so a card and its popover always show the
// same graphic. Each one scopes its own script to its own root (currentScript), so rendering
// a second instance here is safe: the card's copy and the dialog's copy animate independently.
const TOOL_UI: Record<string, any> = {
  'pop-fabricator': FabricatorHero,
  'pop-studio': AnimStudioHero,
  'pop-bridge': BridgeHero,
  'pop-reggie': ReggieHero,
};
---
<BaseLayout
  title="FabricatorStudio | The Artist-Friendly Game Dev Pipeline"
  description="Free Maya rigging toolset built by a 14-year AAA technical artist. Download Fabricator, and hire the TA who built it when you need him."
>
  <NavBar />
  <section id="hero" class="hero-v2">
    <video class="hero-media" autoplay muted loop playsinline
      poster="/demo/fs_hero_poster.jpg"
      src="/demo/fs_hero.mp4"
      aria-hidden="true">
    </video>
    <img class="hero-media hero-poster" src="/demo/fs_hero_poster.jpg" alt="" aria-hidden="true" />
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="hero-copy">
      <h1 class="hero-wordmark">
        <Image src={heroWordmark} alt="FabricatorStudio" widths={[1180, 2205]} sizes="(max-width: 820px) 92vw, 1180px" loading="eager" />
      </h1>
      <p class="hero-tagline">HUMAN+AI STUDIO TOOLSET</p>
      <div class="hero-divider" aria-hidden="true">
        <span class="hero-divider__bar"></span>
        <span class="hero-divider__gem"></span>
        <span class="hero-divider__bar"></span>
      </div>
      <p class="hero-sub"><b>Fully Python driven, modular 3D pipeline.</b> Meant to be <b class="hero-sub__ember">customized</b> and <b class="hero-sub__ember">extended</b> for your project's needs. Built for <b class="hero-sub__cobalt">solo developers</b> and <b class="hero-sub__cobalt">small teams</b>. With an <b class="hero-sub__hl">AI Technical Artist</b> built in. The tools are made for the <b class="hero-sub__hl">generative AI</b> era. Keep your project standardized and organized and ready to deal with large asset libraries, just like a <b class="hero-sub__hl">professional</b> team.</p>
      <p class="hero-sub hero-sub--free">Free for solo developers, indies, and small teams.</p>
      <p class="hero-strip">
        {PIPELINE.map(([step, tone], i) => (
          <>
            {i > 0 && <span class="hero-strip__sep" aria-hidden="true">&bull;</span>}
            <span class={`hero-strip__${tone}`}>{step}</span>
          </>
        ))}
      </p>
      <div class="hero-ctas">
        <BracketButton kind="plasma-outline" downloadGate label="Download" />
      </div>
    </div>
  </section>

  <!-- WELCOME VIDEO (Adrian x Claude Design, 2026-07-19). Sits between the hero and the
       WHY story: the spoken introduction, then the written one. -->
  <section id="welcome">
    <WelcomeVideo />
  </section>

  <section id="tools">
    <div class="tools__stack">
      {flagshipTools.map((t, i) => {
        const Ui = t.dialogId ? TOOL_UI[t.dialogId] : undefined;
        // Every card's GRAPHIC carries the copy now (Adrian 2026-07-14): rollout complete, all
        // four graphics render their own heading/paras/CTA. A future card without a graphic
        // still gets the classic copy column automatically.
        const textInUi = Boolean(Ui);
        return (
          <ToolCard name={t.name} paras={t.paras} href={t.href} image={t.image} alt={t.alt} align={i % 2 === 0 ? 'left' : 'right'} dialogId={t.dialogId} textInUi={textInUi}>
            {/* The graphic's own text block carries the tool's real name and pitch, and the
                Learn More CTA under it. Components that do not accept these yet simply ignore
                them, so this rolls out per graphic. */}
            {Ui && <Ui slot="ui" bare heading={t.name} paras={t.paras} ctaHref={t.href} ctaDialog={t.dialogId} />}
          </ToolCard>
        );
      })}
    </div>
  </section>

  <dialog id="pop-fabricator" class="product-pop">
    <div class="product-pop__inner">
      <button type="button" class="product-pop__close" data-dialog-close aria-label="Close">✕</button>
      <FabricatorHero />
      <div class="product-pop__body">
        <h2 class="product-pop__headline">Animator Friendly Rigs. AutoSkinning. Non-linear workflow.</h2>
        <p>Fabricator is a template-driven, network-based rigging system. Drag components onto your skeleton, build the whole rig in one pass, and never lose work to a rebuild.</p>
        <ul>
          <li>Non-destructive and non-linear. Unbuild, restructure, and rebuild, even while animation is already in production.</li>
          <li>Rename anything. Rig state lives in your scene as network connections, not name strings, so nothing breaks.</li>
          <li>Animator-friendly out of the box: IK/FK matching, space switching, smart pole vectors, and a marking menu on every control.</li>
          <li>Save your perfect rig as a template and reuse it across your whole cast, even at different proportions.</li>
        </ul>
        <p class="product-pop__free">Free for solo developers, indies, and small teams. Pure Python, source available, nothing to compile, nothing hidden.</p>
        <a class="product-pop__docs" href="/docs/tools/fabricator/">Read the full docs →</a>
      </div>
    </div>
  </dialog>

  <dialog id="pop-studio" class="product-pop">
    <div class="product-pop__inner">
      <button type="button" class="product-pop__close" data-dialog-close aria-label="Close">✕</button>
      <AnimStudioHero />
      <div class="product-pop__body">
        <h2 class="product-pop__headline">Manage Animations &amp; Poses in one Library.</h2>
        <p>Animation Studio saves poses and clips to a library that travels across every rig built with Fabricator. Capture a hero pose or a walk cycle, then drop it onto any character.</p>
        <ul>
          <li>Poses and clips apply by component identity, not node names, so they work on any Fabricator rig.</li>
          <li>Place, insert, or replace clips on the timeline, with start and end anchors and root-motion control.</li>
          <li>Selection sets mask a pose down to just the parts you want.</li>
          <li>Thumbnails and hover previews keep a big library scannable.</li>
        </ul>
        <p class="product-pop__free">Build your library, and every new character starts ahead.</p>
        <a class="product-pop__docs" href="/docs/tools/pose-anim-studio/">Read the full docs →</a>
      </div>
    </div>
  </dialog>

  <dialog id="pop-bridge" class="product-pop">
    <div class="product-pop__inner">
      <button type="button" class="product-pop__close" data-dialog-close aria-label="Close">✕</button>
      <BridgeHero />
      <div class="product-pop__body">
        <h2 class="product-pop__headline">An entire pipeline, one click away.</h2>
        <p>Bridge puts the entire FabricatorStudio toolbox into one compact, dockable toolbar inside Maya. Launch the big tools, fire the everyday utilities, and stop hunting through shelves and menus.</p>
        <ul>
          <li>Every tool a click away, in a single dockable strip.</li>
          <li>Popover launchers keep it compact, no shelf sprawl, no menu digging.</li>
          <li>Versioned builds, so "what version are you on" always has an answer.</li>
          <li>Connect your own AI right from the strip: start the read-only bridge and copy the setup snippet for your client.</li>
        </ul>
        <p class="product-pop__free">Built for the way artists actually work.</p>
        <a class="product-pop__docs" href="/docs/tools/bridge/">Read the full docs →</a>
      </div>
    </div>
  </dialog>

  <dialog id="pop-reggie" class="product-pop">
    <div class="product-pop__inner">
      <button type="button" class="product-pop__close" data-dialog-close aria-label="Close">✕</button>
      <ReggieHero />
      <div class="product-pop__body">
        <h2 class="product-pop__headline">AI Tech Art, on call, inside Maya.</h2>
        <p>Reggie is an AI Technical Artist that is an expert on the FabricatorStudio toolset. It reads your actual scene, then helps you fix what broke. Ask why a build failed, where a rig went wrong, or how a tool works, and get answers immediately. No more waiting on a human TA.</p>
        <ul>
          <li>Connect your own AI: Claude Code, Claude Desktop, Cursor, any MCP client. Your model, your key, your machine.</li>
          <li>Read-only, enforced in code. Reggie can see everything and change nothing. When something needs fixing, it hands you the script to run.</li>
          <li>Trained on the FabricatorStudio pipeline: it troubleshoots from the docs, proposes the documented fix, and files a clean bug report only when a real bug remains.</li>
        </ul>
        <p class="product-pop__free">You have a TA sitting next to you, ready to help, always.</p>
        <a class="product-pop__docs" href="/docs/tools/your-ai-ta/">Read the full docs →</a>
      </div>
    </div>
  </dialog>
  <script is:inline>
    (function () {
      document.querySelectorAll('[data-dialog-open]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var d = document.getElementById(btn.getAttribute('data-dialog-open'));
          if (d && d.showModal) d.showModal();
        });
      });
      document.querySelectorAll('dialog.product-pop').forEach(function (d) {
        d.querySelectorAll('[data-dialog-close]').forEach(function (b) {
          b.addEventListener('click', function () { d.close(); });
        });
        d.addEventListener('click', function (e) { if (e.target === d) d.close(); });
      });
    })();
  </script>

  <!-- WHY (Adrian x Claude Design, 2026-07-18): his own story, its own section. Adrian moved it
       2026-07-19 to sit between the tool cards and Key Features: see the tools first,
       then why they exist, then what makes them good. Copy is shared verbatim with /licensing (src/data/licensing.ts). -->
  <section id="why">
    <h2 class="lcb-title">Free for solo developers, indies, and small teams.</h2>
    <div class="lcb-why">
      <div class="lcb-why__label">WHY THIS EXISTS</div>
      {WHY_PARAS.map((p) => <p class="lcb-why__para" set:html={p} />)}
    </div>
  </section>

  <section id="features">
    <div class="kf-head">
      <div class="kf-eyebrow">FABRICATORSTUDIO</div>
      <h2 class="kf-title" aria-label={KF_TITLE}>
        {kfGlyphs.map((g) =>
          g.cls === 'kf-gap' ? <span class="kf-gap"></span> : <span aria-hidden="true" class={g.cls}>{g.ch}</span>
        )}
      </h2>
    </div>
    <div class="kf-grid">
      <div class="kf-card kf-card--plasma">
        <div class="kf-card__top">
          <div class="kf-icon kf-icon--plasma">
            <svg width="30" height="30" viewBox="0 0 30 30" fill="none" aria-hidden="true"><path d="M8 15l5 5 9-11" stroke="#7CFFB2" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </div>
          <span class="kf-num" aria-hidden="true">01</span>
        </div>
        <h3 class="kf-card__name">Easy to use</h3>
        <p class="kf-card__line">Elegant by design. Where most tools are button-and-option nightmares, these are <b>drag-and-drop and guided</b>. Light-weight, portable, and made for artists by an artist.</p>
      </div>
      <div class="kf-card kf-card--ember">
        <div class="kf-card__top">
          <div class="kf-icon kf-icon--ember">
            <svg width="34" height="30" viewBox="0 0 34 30" fill="none" aria-hidden="true"><circle cx="6" cy="15" r="4" stroke="#FF7A3D" stroke-width="2.6" /><circle cx="28" cy="15" r="4" stroke="#FF7A3D" stroke-width="2.6" /><path d="M10 15h14" stroke="#FF7A3D" stroke-width="2.6" stroke-linecap="round" stroke-dasharray="1 5" /></svg>
          </div>
          <span class="kf-num" aria-hidden="true">02</span>
        </div>
        <h3 class="kf-card__name">End to end pipeline</h3>
        <p class="kf-card__line">From <b>concept to animating in engine</b>, one kit helps carry your assets the whole way. Portable across projects, extendable when you need your own workflows, professional in design.</p>
      </div>
      <div class="kf-card kf-card--plasma">
        <div class="kf-card__top">
          <div class="kf-icon kf-icon--plasma">
            <svg width="30" height="30" viewBox="0 0 30 30" fill="none" aria-hidden="true"><ellipse cx="15" cy="15" rx="13" ry="8" stroke="#7CFFB2" stroke-width="2.4" /><circle cx="15" cy="15" r="3.4" fill="#7CFFB2" /></svg>
          </div>
          <span class="kf-num" aria-hidden="true">03</span>
        </div>
        <h3 class="kf-card__name">AI integration</h3>
        <p class="kf-card__line">Connect your own AI and it becomes <b>Reggie</b>, the AI TA trained on the FabricatorStudio pipeline. Troubleshoots, proposes fixes, files bugs. <b class="kf-hl">Read-only, enforced in code</b>. Automation-ready APIs cover the rest.</p>
      </div>
      <div class="kf-card kf-card--plasma">
        <div class="kf-card__top">
          <div class="kf-icon kf-icon--plasma">
            <svg width="30" height="30" viewBox="0 0 30 30" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="3.2" stroke="#7CFFB2" stroke-width="2.4" /><circle cx="22" cy="22" r="3.2" stroke="#7CFFB2" stroke-width="2.4" /><path d="M10.3 10.3l9.4 9.4" stroke="#7CFFB2" stroke-width="2.4" stroke-linecap="round" /></svg>
          </div>
          <span class="kf-num" aria-hidden="true">04</span>
        </div>
        <h3 class="kf-card__name">Animator-friendly rig modules</h3>
        <p class="kf-card__line">Clean controls, space matching, and IK/FK matching that <b>holds the pose through the switch</b>. Rigs animators actually enjoy using. Networked rigs that never break on a name change.</p>
      </div>
      <div class="kf-card kf-card--ember">
        <div class="kf-card__top">
          <div class="kf-icon kf-icon--ember">
            <svg width="30" height="30" viewBox="0 0 30 30" fill="none" aria-hidden="true"><path d="M24 8a10 10 0 10 1.5 9" stroke="#FF7A3D" stroke-width="2.6" stroke-linecap="round" /><path d="M24 3v6h-6" stroke="#FF7A3D" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </div>
          <span class="kf-num" aria-hidden="true">05</span>
        </div>
        <h3 class="kf-card__name">Non-destructive workflow</h3>
        <p class="kf-card__line">Non-destructive and non-linear: <b>tear down and rebuild at any stage</b>. Model and rig edits can run while animation is already in production.</p>
      </div>
      <div class="kf-card kf-card--plasma">
        <div class="kf-card__top">
          <div class="kf-icon kf-icon--plasma">
            <svg width="30" height="30" viewBox="0 0 30 30" fill="none" aria-hidden="true"><path d="M15 3l10 5v7c0 6-4.3 10-10 12-5.7-2-10-6-10-12V8l10-5z" stroke="#7CFFB2" stroke-width="2.4" stroke-linejoin="round" /><path d="M11 15l3 3 5-6" stroke="#7CFFB2" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </div>
          <span class="kf-num" aria-hidden="true">06</span>
        </div>
        <h3 class="kf-card__name">Studio-grade tools</h3>
        <p class="kf-card__line">Network-based rigging that survives renames, rig versioning, and <b>export contracts that hold up</b> on a large production. Source available, transparent, verifiable: pure Python, nothing to compile, nothing hidden.</p>
      </div>
    </div>
  </section>

  <section id="download" class="download-v2" data-parallax-window>
    <Image class="download-media" src={downloadBanner} alt="" aria-hidden="true" width={2048} loading="lazy" data-parallax />
    <div class="download-scrim" aria-hidden="true"></div>
    <div class="download-copy">
      <BracketButton kind="plasma-outline" downloadGate label="Download" />
    </div>
  </section>

  <!-- LICENSING (Adrian x Claude Design drop, 2026-07-18; source:
       MrMiata inbox/Docs/"Licensing Block Docs.html"). Copy is the approved
       COMMERCIAL-PAGE.md language, em-dash-free. Adrian's flow ruling 2026-07-18:
       the deal sits AFTER download; the WHY story it used to carry now opens the
       page as its own #why section. -->
  <section id="licensing">
    <div class="lcb-head">
      <div class="lcb-eyebrow">LICENSING</div>
    </div>
    <div class="lcb-tiers">
      <div class="lcb-tier lcb-tier--plasma">
        <div class="lcb-tier__top">
          <span class="lcb-pill lcb-pill--plasma"><span class="lcb-pill__dot" aria-hidden="true"></span>UNDER $2M / YEAR</span>
          <span class="lcb-price lcb-price--plasma">Free</span>
        </div>
        <p class="lcb-tier__body">If your studio makes under <b>$2 million a year</b>, everything here is yours. Use it in production, ship your game, use it on client work, and keep it forever.</p>
        <div class="lcb-tier__rule lcb-tier__rule--plasma" aria-hidden="true"></div>
        <ul class="lcb-checks">
          {['No seats', 'No trial', 'No feature gates', 'No phoning home'].map((c) => (
            <li class="lcb-check">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 10l3.5 3.5L15 6" stroke="#7CFFB2" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
              {c}
            </li>
          ))}
        </ul>
      </div>
      <div class="lcb-tier lcb-tier--ember">
        <div class="lcb-tier__top">
          <span class="lcb-pill lcb-pill--ember"><span class="lcb-pill__dot" aria-hidden="true"></span>ABOVE $2M / YEAR</span>
          <span class="lcb-price lcb-price--ember">One license</span>
        </div>
        <p class="lcb-tier__body">Above $2 million, <b>one flat license covers your whole studio</b>, and it scales with your revenue, so it stays small when you're small.</p>
        <div class="lcb-tier__rule lcb-tier__rule--ember" aria-hidden="true"></div>
        <div class="lcb-star">
          <svg width="26" height="26" viewBox="0 0 26 26" fill="none" aria-hidden="true"><path d="M13 3l3 6 6 1-4.5 4.3 1 6.2L13 20l-5.5 3 1-6.2L4 12.5 10 11z" stroke="#FF7A3D" stroke-width="2" stroke-linejoin="round" /></svg>
          <p>One flat fee for the whole studio, no per-seat math.</p>
        </div>
      </div>
    </div>
    <div class="lcb-ctas">
      <a class="lcb-cta lcb-cta--solid" href="/licensing/#pricing">See pricing &rarr;</a>
      <a class="lcb-cta lcb-cta--ghost" href="/licensing/#license">Read the license</a>
    </div>
  </section>

  {TUTORIALS.length > 0 && (
    <section id="tutorials">
      <div class="tb-head">
        <div class="tb-eyebrow">FABRICATORSTUDIO</div>
        <h2 class="tb-title" aria-label={TB_TITLE}>
          {tbGlyphs.map((g) =>
            g.cls === 'tb-gap' ? <span class="tb-gap"></span> : <span aria-hidden="true" class={g.cls}>{g.ch}</span>
          )}
        </h2>
        <p class="tb-sub">Learn the kit.</p>
      </div>
      <div class="tb-grid">
        {TUTORIALS.map((t) => (
          <a class={`tb-card tb-card--${t.tone ?? 'plasma'}`} href={t.href} target="_blank" rel="noopener" aria-label={`Watch ${t.title} on YouTube`}>
            <div class="tb-card__media">
              {t.thumb && <img class="tb-card__thumb" src={t.thumb} alt="" loading="lazy" />}
              <div class="tb-card__scrim" aria-hidden="true"></div>
              {t.tag && <span class={`tb-card__tag tb-card__tag--${t.tone ?? 'plasma'}`}>{t.tag}</span>}
              <span class={`tb-card__play tb-card__play--${t.tone ?? 'plasma'}`} aria-hidden="true"><span class="tb-card__tri"></span></span>
            </div>
            <div class="tb-card__body">
              <span class={`tb-card__name tb-card__name--${t.tone ?? 'plasma'}`}>{t.name ?? t.title}</span>
              {t.sub && <span class="tb-card__line">{t.sub}</span>}
            </div>
          </a>
        ))}
      </div>
      <a class="tb-all" href="/tutorials/">All Tutorials &rarr;</a>
    </section>
  )}

  <section id="about">
    <div class="am-head">
      <div class="am-eyebrow">FABRICATORSTUDIO</div>
      <h2 class="am-title" aria-label={AM_TITLE}>
        {amGlyphs.map((g) =>
          g.cls === 'am-gap' ? <span class="am-gap"></span> : <span aria-hidden="true" class={g.cls}>{g.ch}</span>
        )}
      </h2>
    </div>
    <div class="am-grid">
      <div class="am-portrait">
        <div class="am-portrait__frame">
          <div class="am-portrait__edge" aria-hidden="true"></div>
          <Image src={aboutPortrait} alt="Adrian Melian" widths={[660, 1320]} sizes="(max-width: 820px) 92vw, 560px" />
        </div>
        <div class="am-portrait__cap">
          <span class="am-portrait__tick" aria-hidden="true"></span>
          <span class="am-portrait__line">Technical Artist &nbsp;&middot;&nbsp; 14 years in AAA</span>
        </div>
      </div>
      <div class="am-bio">
        <h3 class="am-bio__name">Hi, I'm Adrian Melian.</h3>
