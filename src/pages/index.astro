---
// The homepage. Rebuilt 2026-07-22 (website overhaul, two-door architecture).
//
// What changed and why, so nobody re-litigates it from the diff:
//
// The page used to be a product page wearing a studio's name. Its first four screens offered
// one action, nothing said a person was for hire until a visitor found the Services tab, and
// it ended on the bio with no ask at all. It also argued twice: six adjective cards sat
// directly under four blocks that DEMONSTRATED the same claims, and a tutorials grid spent a
// whole section saying that a nav item exists.
//
// The governing rule of the pass was a FIXED SECTION BUDGET: every addition names the element
// it replaces, and the page may end shorter but never longer. It ended shorter.
//
//   key features (6 adjective cards)  ->  BUILT WITH IT (the proof section)
//   tutorials grid                    ->  WORK WITH ME (the closing ask, the page had none)
//   hero sub 2 ("Generative AI era")  ->  the studio line, and it now leads the hero
//   the 4th repeat of the free line   ->  the shipped record, credited to the person
//   the four tool cards + popups      ->  relocated INTACT to /tools/, which can grow
//   the licensing tiers               ->  relocated to /tools/, next to what they price
//
// Deliberately untouched: the hero video, the wordmark, the download gate and its
// MailerLite/R2 path, the welcome video's position, the WHY quote (Adrian's verbatim story),
// and Mindmeld 2.0 styling everywhere.
import BaseLayout from '../layouts/BaseLayout.astro';
import BracketButton from '../components/BracketButton.astro';
import NavBar from '../components/NavBar.astro';
import ScrollHint from '../components/ScrollHint.astro';
import Footer from '../components/Footer.astro';
import WelcomeVideo from '../components/WelcomeVideo.astro';
import SectionHead from '../components/SectionHead.astro';
import Pill from '../components/Pill.astro';
import YouTubeFacade from '../components/YouTubeFacade.astro';
import DownloadBand from '../components/DownloadBand.astro';
import ToolsSection from '../components/ToolsSection.astro';
import PointCloudHero from '../components/PointCloudHero.astro';
import PipelineOverlay from '../components/PipelineOverlay.astro';
import ArmatureOverlay from '../components/ArmatureOverlay.astro';
import WallOverlay from '../components/WallOverlay.astro';
import CloseOverlay from '../components/CloseOverlay.astro';
import ArmatureAct from '../components/ArmatureAct.astro';
import ScrollDots from '../components/ScrollDots.astro';

// The product card art rather than a trailer frame (Adrian, 2026-08-04): it carries the
// lockup and the tagline baked in, so the thumbnail says what the video is before a click.
import trailerPoster from '../assets/armature/armature-card-poster.jpg';
// One flag governs every control-rig claim on the site (R25, R27). See src/data/armature.ts.
import { ARMATURE, MAYA_CONTROL_RIG } from '../data/armature';

// BUILT WITH IT. Three entries, not four: Archangel is held back until Adrian clears the
// game's art direction for public view, and a filler fourth would weaken the three that
// carry real weight. Every claim here is verifiable today, which is the entire point of the
// section: we out-prove the field, we were just never showing it.
//
// `pill` is plasma for shipped/live states (DNA principle 2: plasma = success/correct).
// Ember stays reserved for IN DEVELOPMENT, which nothing on this page currently carries.
//
// Media: a poster still that carries the card on its own, and a six-second silent loop that
// plays on hover or keyboard focus. NOT autoplay. The hero already autoplays a video, three
// more loops firing on load would cost real weight and battery for motion most visitors
// never look at, and the still is what has to read at thumbnail size regardless. On touch,
// under reduced-motion, and with JS off, the poster simply stands on its own.
//
// Both clips are 4:3, which is why the media box is no longer 16:10: both subjects are
// standing figures, and a wide box spent most of its area on floor and empty background.
//
// `shot` names the asset an entry is still waiting on (MrMiata:
// workspace/2026-07-22_website-overhaul/SHOT-LIST.md). An entry with no media renders a
// visibly unfinished plate rather than silently collapsing.
const PROOF = [
  {
    // Replaced the Reggie card 2026-07-29 (Adrian). Three characters carry more weight than
    // one, and these are the ones the pipeline is being built on now. Reggie's clip and poster
    // are still in public/proof/ if this needs reverting.
    // The clip shows three characters. Saying so in the title, again in the claim, is telling a
    // reader what they can already see. The copy carries the part the picture cannot: that all
    // of them took the same route to get there.
    name: 'Armature characters',
    pill: 'IN UNREAL',
    claim: 'Rigged, skinned, and animating in engine, all through the same route.',
    detail:
      'Joints placed by hand, skin weights solved on the machine, and one USD file carrying the mesh, skeleton, orientations and weights into Unreal, where the Fabricator Control Rig is built procedurally from that same export data.',
    video: '/proof/proof-unreal-montage.mp4',
    poster: '/proof/proof-unreal-montage.jpg',
    alt: 'A samurai, a ninja and a lumberjack character animating in the Unreal viewport.',
  },
  {
    // Replaced the QS_BipedRig card 2026-07-29 (Adrian). Its clip and poster stay in
    // public/proof/, so restoring it is a data change and nothing else.
    //
    // The clip shows Maya and Unreal, and it says so itself with both logos in frame. What it
    // cannot show is that neither rig was authored: both are generated from the same export.
    name: 'The Fabricator Control Rig',
    pill: 'MAYA + UNREAL',
    claim: 'Built procedurally in both, from one export.',
    // R27 item 3: this card had the same shipped-versus-demonstrated gap /armature's VERIFIED
    // panel got corrected for under R25. Reading the SAME flag rather than hardcoding a
    // sentence means the homepage and /armature cannot describe the toolset differently, which
    // is the actual risk when one claim lives in two places.
    detail:
      'The USD export carries control rig build data alongside the mesh, skeleton and weights. Both rigs are generated from it, so the controls, their shapes and their hierarchy match without anyone rebuilding them on the far side. ' +
      (MAYA_CONTROL_RIG
        ? 'The Maya builder ships free in the toolset today; the Unreal builder is what we are working on next.'
        : 'Both builders are what we are working on next.'),
    video: '/proof/proof-controlrig.mp4',
    poster: '/proof/proof-controlrig.jpg',
    // Poster is the crossfade frame at t=3.5, where both logos and both rigs are on screen at
    // once. It makes the point before anyone presses play.
    alt: 'The same character and control rig shown in Maya and then in Unreal.',
  },
];
---
<BaseLayout
  title="FabricatorStudio | The Artist-Friendly Game Dev Pipeline"
  description="A one-person technical art studio. The free Maya to Unreal character pipeline, and the 14-year AAA technical artist who built it, available for hire."
>
  <NavBar />
  <ScrollHint />
  {/* How far in you are, and how much is still there. 21.8 screens do not announce
      themselves. Reads the beats' own variables; carries no timings. */}
  <ScrollDots />

  {/* THE OPENING (Adrian, 2026-08-19). The FS mark as 5,000 points over the app's own grid,
      scroll-driven through a centring push-in and then an explosion that hands the page to
      the hero video below. It carries the identity and the two free doors, which is why the
      video hero no longer repeats them. Progressive enhancement: reduced motion, no WebGL2
      and every width under 900px get the same copy standing on carbon, and the scroll runway
      collapses with it. */}
  <PointCloudHero />

  <section id="hero" class="hero-v2" data-panel>
    {/* New Armature cut, 2026-08-03. Dated filenames rather than overwriting: public/ assets
        are served unhashed, so reusing the old names would leave the previous cut in browser
        and CDN caches for days. 2560x1440 (was 2560x1080), which crops less at desktop widths
        under object-fit: cover. */}
    <video class="hero-media" autoplay muted loop playsinline
      poster="/demo/fs_hero_poster_2026-08.jpg"
      src="/demo/fs_hero_2026-08.mp4"
      aria-hidden="true">
    </video>
    <img class="hero-media hero-poster" src="/demo/fs_hero_poster_2026-08.jpg" alt="" aria-hidden="true" />
    {/* NO SCRIM AND NO COPY (Adrian, 2026-08-19). This panel is the video and nothing else.
        The scrim existed to make text legible over it; with the text gone it was only
        dimming the footage. The identity moved into the opening, and the philosophy copy
        that used to sit here moved out with it rather than being restated over a video
        nobody is reading. */}
  </section>

  {/* THE PIPELINE BEAT (Adrian, 2026-08-19 second pass): the x-ray pipe in the room --
      chaos drawn in at the left, four hoverable sections, a character condensing out at the
      right. Replaced the tool carousel. Choreography and the 3D scene live in
      PointCloudHero; this layer is the title, the labels and the hover cards. */}
  <PipelineOverlay />

  {/* THE ARMATURE BEAT (Adrian, 2026-08-19): after the carousel's last step the toolset
      clears and Armature rises on the same glass. Choreography in PointCloudHero's loop. */}
  <ArmatureOverlay />

  {/* THE DOWNLOAD BEAT (Adrian, 2026-08-19): the tool wall scanned into view by a climbing
      band with the download riding it. Choreography in PointCloudHero's loop. */}
  <WallOverlay />

  {/* THE ARMATURE ACT (Adrian, 2026-08-22): after the tool wall wipe the page goes straight
      into the Armature story rather than sending the reader to another URL. Same component
      /armature/ mounts, so there is one implementation and the product keeps its own page.

      The raise is not optional. .hero-v2[data-cine] is position:fixed at z-index 1 for the
      length of the opening runway, so anything after it that is not lifted gets the video
      printed over it -- which is exactly why .site-footer-raise below exists. */}
  <div class="armature-act-raise">
    <ArmatureAct variant="inline" />
  </div>

  {/* THE CLOSING BEAT (Adrian, 2026-08-19; moved here 2026-08-22). About Me and the
      engagements ask, one fullscreen layout over the room. It used to sit between the wall
      wipe and here, which put the hire-me ask in the MIDDLE of the page and left the page
      ending on Armature's pricing. It closes now, which is also what stops the act's opaque
      edge guillotining it mid-sentence.

      It needs a runway because .cl is position:fixed and carries no scroll of its own; the
      hero's runway used to provide it. Empty and aria-hidden: it is scroll, not content. */}
  <div class="close-runway" data-close-runway aria-hidden="true"></div>
  <CloseOverlay />

  {/* STILL STRIPPED (Adrian, 2026-08-19): one transition at a time. Armature, proof,
      DownloadBand, hire and about return from git (this branch, commit d9e73c5) as each
      transition lands. */}

  {/* Raised above the fixed video layer (z1), or scrolling past the runway would slide the
      footer invisibly underneath it. */}
  <div class="site-footer-raise">
    <Footer />
  </div>

  {/* Proof cards: poster by default, loop on hover or keyboard focus.
      Bails entirely on touch (no hover pointer) and under reduced-motion, where the poster
      is the whole experience and preload="none" means the clip is never even fetched. */}
  <script is:inline>
    (function () {
      var mm = window.matchMedia;
      if (!mm) return;
      if (mm('(prefers-reduced-motion: reduce)').matches) return;
      if (!mm('(hover: hover)').matches) return;
      document.querySelectorAll('.pf-card').forEach(function (card) {
        var v = card.querySelector('.pf-vid');
        if (!v) return;
        function play() {
          card.classList.add('is-playing');
          var p = v.play();
          // Autoplay policy can still reject a programmatic play(); swallow it rather than
          // throwing an unhandled rejection into the console on every hover.
          if (p && p.catch) p.catch(function () { card.classList.remove('is-playing'); });
        }
        function stop() {
          v.pause();
          card.classList.remove('is-playing');
        }
        card.addEventListener('pointerenter', play);
        card.addEventListener('pointerleave', stop);
        card.addEventListener('focusin', play);
        card.addEventListener('focusout', stop);
      });
    })();
  </script>

  <script is:inline>
    (function () {
      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      // Modern browsers (incl. mobile) get smooth compositor parallax from CSS (base.css).
      // This JS only runs as a fallback where scroll-driven animations are unsupported.
      if (window.CSS && CSS.supports && CSS.supports('animation-timeline: view()')) return;
      var pairs = [].slice.call(document.querySelectorAll('[data-parallax]'))
        .map(function (img) { return { img: img, win: img.closest('[data-parallax-window]') }; })
        .filter(function (pr) { return pr.win; });
      if (!pairs.length) return;
      var ticking = false;
      function update() {
        ticking = false;
        var vh = window.innerHeight || document.documentElement.clientHeight;
        for (var i = 0; i < pairs.length; i++) {
          var img = pairs[i].img, win = pairs[i].win;
          var overflow = img.offsetHeight - win.offsetHeight;
          if (overflow <= 0) { img.style.transform = ''; continue; }
          var rect = win.getBoundingClientRect();
          var p = (vh - rect.top) / (vh + rect.height);
          p = p < 0 ? 0 : p > 1 ? 1 : p;
          img.style.transform = 'translateY(' + (-overflow * (1 - p)).toFixed(1) + 'px)';
        }
      }
      function onScroll() { if (!ticking) { ticking = true; requestAnimationFrame(update); } }
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      update();
    })();
  </script>
</BaseLayout>

<style>
  .site-footer-raise { position: relative; z-index: 3; background: var(--carbon); }
  /* NO BACKGROUND (Adrian, 2026-08-22). An opaque block here is what made the act read as a
     second 3D scene: it cut a hard edge across the room and guillotined whatever was under
     it. The act's own canvas is opaque, so it covers the room by rendering it, not by
     hiding it -- which is what lets the two scenes cross into one continuous shot. */
  .armature-act-raise { position: relative; z-index: 3; }
  /* Transparent on purpose: the close beat plays OVER the room, so the point cloud canvas
     behind it has to show through. No z-index either -- .cl (z2) paints over this, and the
     footer (z3) curtains over .cl, which is how the beat has always exited. */
  .close-runway { height: 150svh; }

  .hero-v2 {
    position: relative;
    overflow: hidden;
    width: 100vw;
    max-width: 100vw;
    margin: 0 0 0 calc(50% - 50vw);
    padding: 0;
    /* svh, not vh: on mobile vh measures the viewport with the toolbars RETRACTED, so a
       100vh hero is taller than what you can see and the next section peeks on load.
       min-height, not height: .hero-v2 clips its overflow and a fixed height would
       guillotine the CTAs on short screens. */
    min-height: calc(100vh - var(--header-h));
    min-height: calc(100svh - var(--header-h));
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-direction: column;
  }

  /* THE CINEMATIC PROMOTION (Adrian, 2026-08-19). When the point-cloud opening is running it
     sets [data-cine], and this section stops being an in-flow panel and becomes a fixed layer
     at z1: above the 3D scene (z0), below the copy and its download buttons (z2). It does not
     scroll up; it FADES IN in place as the cloud explodes, opacity driven per frame by the
     opening's own loop. The fallback paths never set the attribute, so reduced-motion,
     no-WebGL and mobile keep the normal in-flow section. */
  .hero-v2[data-cine] {
    position: fixed;
    inset: 0;
    z-index: 1;
    width: auto;
    max-width: none;
    margin: 0;
    min-height: 0;
    opacity: 0;
    /* The video is pure backdrop while the buttons above it take the clicks. */
    pointer-events: none;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .hero-v2 video.hero-media { display: block; }
  .hero-v2 img.hero-poster { display: none; }
  @media (prefers-reduced-motion: reduce) {
    .hero-v2 video.hero-media { display: none; }
    .hero-v2 img.hero-poster { display: block; }
  }

  /* BUILT WITH IT. Reuses the card furniture the key-features grid used, so this cost
     styling work rather than design work, and the section it replaces is not missed. */
  #proof { text-align: left; }
  .pf-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.125rem; }
  @media (max-width: 900px) { .pf-grid { grid-template-columns: 1fr; } }
  .pf-card {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    background: linear-gradient(180deg, var(--iron), var(--carbon));
    border: 1px solid rgba(124, 255, 178, 0.14);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }
  /* 4:3, not 16:10. Both proof subjects are standing figures, and a wide box spent most of
     its area on floor and empty background. */
  .pf-media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-bottom: 1px solid rgba(124, 255, 178, 0.18);
    background: radial-gradient(120% 120% at 50% 38%, var(--iron-2), var(--carbon));
  }
  .pf-vid { display: block; width: 100%; height: 100%; object-fit: cover; }
  /* The affordance, and the only thing that says the still is also a clip. It fades out
     once playback starts, so a playing card is not wearing a play button. */
  .pf-play {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 2.75rem;
    height: 2.75rem;
    margin: -1.375rem 0 0 -1.375rem;
    border-radius: 50%;
    background: rgba(11, 14, 16, 0.55);
    border: 1px solid rgba(124, 255, 178, 0.5);
    pointer-events: none;
    transition: opacity var(--t-base) var(--ease-out);
  }
  .pf-play::after {
    content: '';
    position: absolute;
    left: 55%;
    top: 50%;
    transform: translate(-50%, -50%);
    border-top: 0.45rem solid transparent;
    border-bottom: 0.45rem solid transparent;
    border-left: 0.75rem solid var(--plasma);
  }
  .pf-card.is-playing .pf-play { opacity: 0; }
  /* No hover pointer means no hover affordance to advertise. */
  @media (hover: none) {
    .pf-play { display: none; }
  }

  .pf-pending {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1.25rem;
    text-align: center;
  }
  .pf-shot {
    font-family: var(--font-mono);
    font-weight: 800;
    font-size: 0.6875rem;
    letter-spacing: 0.22em;
    color: var(--ember);
    border: 1px solid rgba(255, 122, 61, 0.45);
    background: rgba(255, 122, 61, 0.13);
    border-radius: 8px;
    padding: 0.3rem 0.7rem;
  }
  /* The v1 entry: its evidence is textual, so it is set as type rather than faked. */
  .pf-media--type {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1.25rem;
    text-align: center;
  }
  .pf-v { font-family: var(--font-display); font-weight: 400; font-size: clamp(2.5rem, 6vw, 3.5rem); line-height: 1; color: var(--plasma); }
  .pf-v__lic { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.14em; color: var(--bone-dim); }
  .pf-v__links { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem 1rem; margin-top: 0.5rem; }
  .pf-v__links a { font-family: var(--font-mono); font-size: 0.8125rem; color: var(--bone); text-decoration: none; border-bottom: 1px solid rgba(124, 255, 178, 0.4); }
  .pf-v__links a:hover { color: var(--plasma); }

  .pf-body { display: flex; flex-direction: column; gap: 0.75rem; padding: 1.5rem 1.5rem 1.625rem; }
  .pf-top { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; flex-wrap: wrap; }
  .pf-name { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: 1.1875rem; line-height: 1.1; color: var(--bone); }
  /* plasma = success / correct (principle 2). Ember stays reserved for IN DEVELOPMENT. */
  .pf-pill {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    color: var(--plasma);
    background: rgba(124, 255, 178, 0.13);
    border: 1px solid rgba(124, 255, 178, 0.45);
    border-radius: 8px;
    padding: 0.25rem 0.6rem;
    white-space: nowrap;
  }
  .pf-claim { margin: 0; font-size: 0.9375rem; line-height: 1.6; color: var(--bone); text-wrap: pretty; }
  /* Scan on the surface, deep on demand, both work: the same promise the tool cards make,
     without a second modal system to maintain for one paragraph of detail. */
  .pf-more { margin-top: auto; }
  .pf-more__q {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    color: var(--plasma);
    cursor: pointer;
    list-style: none;
  }
  .pf-more__q::-webkit-details-marker { display: none; }
  .pf-more__q::after { content: ' +'; }
  .pf-more[open] .pf-more__q::after { content: ' \2212'; }
  .pf-more__a { margin: 0.75rem 0 0; font-size: 0.875rem; line-height: 1.6; color: var(--bone-dim); text-wrap: pretty; }

  /* THE TOOLSET: one compact block where four full-bleed cards used to be. */
  #toolset { text-align: left; }
  .tk-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 2.5rem; align-items: center; }
  @media (max-width: 900px) { .tk-grid { grid-template-columns: 1fr; gap: 1.75rem; } }
  .tk-ui { border-radius: 16px; overflow: hidden; border: 1px solid var(--iron-3); box-shadow: var(--shadow-lg); }
  .tk-body { display: flex; flex-direction: column; gap: 1rem; }
  .tk-lead { margin: 0; font-size: 1.0625rem; line-height: 1.65; color: var(--bone); text-wrap: pretty; }
  .tk-line { margin: 0; font-size: 0.9375rem; line-height: 1.6; color: var(--bone-dim); }
  .tk-line a { color: var(--plasma); text-decoration: none; border-bottom: 1px solid transparent; }
  .tk-line a:hover { border-bottom-color: var(--plasma); }
  .tk-lic { margin: 0; font-family: var(--font-mono); font-size: 0.875rem; color: var(--bone-faint); }
  .tk-ctas { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 0.25rem; }

  /* ARMATURE: the 86-second trailer carries this block, so the media leads and takes the wider
     column. It is 16:9 now (the block used to be built portrait-first around the vertical
     teaser cut). The frame itself is the YouTubeFacade component's. */
  #armature { text-align: left; }
  .arm-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 2.75rem; align-items: center; }
  @media (max-width: 900px) { .arm-grid { grid-template-columns: 1fr; gap: 1.75rem; } }

  .arm-body { display: flex; flex-direction: column; align-items: flex-start; gap: 1rem; }
  .arm-head { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: clamp(1.6rem, 3.4vw, 2.4rem); line-height: 1.05; letter-spacing: -0.02em; color: var(--bone); }
  /* The headline and this sentence are one sentence across two sizes, exactly as on the
     landing page, so the gap between them stays tight. */
  .arm-lead { margin: -0.35rem 0 0; font-size: 1.0625rem; line-height: 1.6; color: var(--bone); max-width: 40rem; text-wrap: pretty; }
  .arm-note { margin: 0; font-size: 0.875rem; line-height: 1.6; color: var(--bone-faint); max-width: 40rem; text-wrap: pretty; }
  .arm-ctas { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 0.25rem; }

  /* WORK WITH ME: the page's only ask. It had none. */
  .hb-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    padding: 2.5rem 2.75rem;
    border-radius: 20px;
    background: linear-gradient(120deg, rgba(255, 122, 61, 0.1), rgba(255, 122, 61, 0)), var(--carbon);
    border: 1px solid rgba(255, 122, 61, 0.35);
    border-left: 3px solid var(--ember);
    box-shadow: var(--shadow-lg);
  }
