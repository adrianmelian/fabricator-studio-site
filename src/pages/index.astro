---
import BaseLayout from '../layouts/BaseLayout.astro';
import FieldLabel from '../components/FieldLabel.astro';
import BracketButton from '../components/BracketButton.astro';
import ModuleRow from '../components/ModuleRow.astro';
import ToolCard from '../components/ToolCard.astro';
import Footer from '../components/Footer.astro';
import NavBar from '../components/NavBar.astro';
import { LINKS } from '../data/links';
import { flagshipTools, kitModules } from '../data/tools';
import { features } from '../data/features';
import { TUTORIALS, CHANNEL } from '../data/tutorials';
import { getCollection } from 'astro:content';

const latest = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const aboutPhoto = Object.values(import.meta.glob('../assets/about/*.{jpg,jpeg,png,webp}', { eager: true }))[0];
---
<BaseLayout
  title="FabricatorStudio | The Artist-Friendly Toolset"
  description="Free Maya rigging toolset built by a 14-year AAA technical artist. Download Fabricator, and hire the TA who built it when you need him."
>
  <NavBar />
  <section id="hero" class="hero-v2">
    <video class="hero-media" autoplay muted loop playsinline
      poster="/demo/fs_hero_poster.jpg"
      src="/demo/fs_hero.mp4"
      aria-hidden="true">
    </video>
    <img class="hero-media hero-poster" src="/demo/fs_hero_poster.jpg" alt="" aria-hidden="true" />
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="hero-copy">
      <h1 class="vt">FabricatorStudio</h1>
      <p class="hero-tagline">\\ For Artists, By Artists \\</p>
      <p class="hero-sub">Free, Artist-Friendly Game Developer Pipeline.</p>
      <p class="hero-strip">Concept • Modeling • Texturing • Rigging • Animation • Unreal</p>
      <div class="hero-ctas">
        <BracketButton kind="plasma-outline" href={LINKS.download} label="Download" />
        <BracketButton kind="soft" href="#rigs" label="Free Rigs" />
      </div>
    </div>
    <span class="hero-viewport-tag">persp | Fabricator</span>
  </section>

  <section id="tools">
    <FieldLabel text="The Artist-Friendly Toolset" />
    <h2 class="subhead">Five tools. One pipeline. Free.</h2>
    <div class="tools__grid">
      {flagshipTools.map((t) => <ToolCard name={t.name} paras={t.paras} href={t.href} image={t.image} />)}
    </div>
    <div class="tools__kit">
      <p class="tools__kit-heading">Everything else in the kit</p>
      <div class="tools__kit-rows">
        {kitModules.map((m) => <ModuleRow name={m.name} line={m.line} />)}
      </div>
    </div>
  </section>

  <section id="features">
    <FieldLabel text="Key Features" />
    <h2 class="subhead">Why teams pick this kit.</h2>
    <div class="features__grid">
      {features.map((f) => (
        <div class="feature-tile">
          <span class="feature-tile__glyph" aria-hidden="true">▪</span>
          <h3 class="feature-tile__name">{f.name}</h3>
          <p class="feature-tile__line">{f.line}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="download" class="download-v2">
    <!-- Interim background: reusing the hero poster until Adrian delivers dedicated media for this banner. -->
    <img class="download-media" src="/demo/fs_hero_poster.jpg" alt="" aria-hidden="true" />
    <div class="download-scrim" aria-hidden="true"></div>
    <div class="download-copy">
      <p class="download-line">The whole kit. Free for commercial work.</p>
      <BracketButton kind="plasma-outline" href={LINKS.download} label="Download" />
    </div>
  </section>

  {TUTORIALS.length > 0 && (
    <section id="tutorials">
      <FieldLabel text="Tutorials" />
      <h2 class="subhead">Learn the kit.</h2>
      <div class="tutorials__grid">
        {TUTORIALS.map((t) => (
          <a class="tutorial-card" href={t.href}>
            {t.thumb && <img class="tutorial-card__thumb" src={t.thumb} alt="" />}
            <span class="tutorial-card__title">{t.title}</span>
          </a>
        ))}
      </div>
      <BracketButton kind="soft" href={CHANNEL} label="All Tutorials" />
    </section>
  )}

  <section id="rigs">
    <FieldLabel text="Free Rigs" />
    <h2 class="subhead">Free rigs, built with Fabricator.</h2>
    <p class="prose">Production-quality rigs for animators, students, and demo reels, free to download and animate. The first rig is in production now. Follow the devlog or watch the GitHub releases to catch it the day it lands.</p>
    <div class="rigs__ctas">
      <BracketButton kind="soft" href="/blog/" label="Devlog" />
      <BracketButton kind="soft" href={LINKS.download} label="Releases" />
    </div>
  </section>

  <section id="services">
    <FieldLabel text="Services" />
    <h2 class="subhead">The toolset is free. The TA behind it is for hire.</h2>
    <p class="prose">Fixed-scope packages, priced up front. Every engagement is delivered by the person who built the tools, not a team you have never met.</p>
    <div class="services__grid">
      <div class="service">
        <h3>Pipeline Health Audit</h3>
        <p>One week. Rigs, skinning, export path, naming, versioning. You get a findings doc, a prioritized fix list, and a quote. The fee credits 100% toward the first fix package signed within 30 days.</p>
        <p class="service__price">from $1,500</p>
      </div>
      <div class="service">
        <h3>Export Contract Fix</h3>
        <p>Two to three days. One named character exporting clean into Unreal, end to end.</p>
        <p class="service__price">from $1,500</p>
      </div>
      <div class="service">
        <h3>Character Rig and Export Setup</h3>
        <p>Hero characters rigged with Fabricator and wired into your Maya-to-Unreal export contract. Scoped by roster size.</p>
        <p class="service__price">from $2,500</p>
      </div>
      <div class="service">
        <h3>Custom Tool Sprint</h3>
        <p>One scoped Maya tool built to spec in two to three weeks, docs included.</p>
        <p class="service__price">from $5,000</p>
      </div>
    </div>
    <p class="prose">Ongoing support runs as a monthly retainer, from $2,500 a month. Embedded contract work and advisory are quoted per engagement.</p>
    <BracketButton kind="soft" href="mailto:adrianmelian123@gmail.com?subject=FabricatorStudio%20discovery%20call" label="Book a discovery call" />
  </section>

  <section id="about">
    <FieldLabel text="About Me" />
    <div class={`about__grid${aboutPhoto ? ' about__grid--photo' : ''}`}>
      {aboutPhoto && (
        <img class="about__photo" src={(aboutPhoto as any).default.src} alt="Adrian Melian" />
      )}
      <div class="prose about__body">
        <p>Hello, my name is Adrian Melian and I've been in AAA Game Development for over 15 years. As a Technical Artist, I've worked on games like Call of Duty: MW3, South Park: Fractured but Whole, Broken Age and others, with great studios like Double Fine, Ubisoft, Sledgehammer, Camouflaj, Meta, and more.</p>
        <p>With a quickly changing game dev environment I thought I would share my toolbox, so other developers in the community can build faster and at a higher quality. The pipeline is built for easy AI integration and to speed up the parts inbetween. At FabricatorStudio we know AI is the future and are embracing it, but a human touch is what brings the extra layer of personalization to your art. FabricatorStudio tools are the best, easy to use, artist-friendly, and most powerful AAA quality pipeline around. And it's free.</p>
      </div>
    </div>
  </section>

  <section id="devlog">
    <FieldLabel text="Devlog" />
    <h2 class="subhead">Built in the open. The log is public.</h2>
    <div class="devlog__rows">
      {latest.map((p) => <a class="devlog-link" href={`/blog/${p.id}/`}><ModuleRow name={p.data.date.toISOString().slice(0, 10)} line={p.data.title} /></a>)}
    </div>
    <BracketButton kind="soft" href="/blog/" label="All posts" />
  </section>

  <Footer />
</BaseLayout>
<style>
  .hero-v2 {
    position: relative;
    overflow: hidden;
    width: 100vw;
    max-width: 100vw;
    margin: 0 0 0 calc(50% - 50vw);
    padding: 0 1.5rem 3.5rem;
    min-height: 78vh;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-direction: column;
  }
  .hero-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .hero-v2 video.hero-media { display: block; }
  .hero-v2 img.hero-poster { display: none; }
  @media (prefers-reduced-motion: reduce) {
    .hero-v2 video.hero-media { display: none; }
    .hero-v2 img.hero-poster { display: block; }
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to top, rgba(11, 14, 16, 0.92) 0%, rgba(11, 14, 16, 0.55) 40%, rgba(11, 14, 16, 0) 65%);
  }
  .hero-copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-align: center;
    max-width: 44rem;
  }
  .hero-tagline { font-family: var(--font-body); font-weight: 700; font-size: 1.5rem; color: var(--bone); }
  .hero-sub { font-family: var(--font-body); font-size: 1.0625rem; color: var(--bone); }
  .hero-strip { font-family: var(--font-body); font-size: 0.9375rem; color: var(--bone-dim); letter-spacing: 0.06em; }
  .hero-ctas { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; margin-top: 0.75rem; }
  .hero-viewport-tag {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    z-index: 2;
    color: var(--bone-faint);
    font-size: 0.8125rem;
  }

  #tools { text-align: center; }
  #tools .subhead { margin-inline: auto; }
  .tools__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr)); gap: 1rem; margin: 2rem 0; text-align: left; }
  .tools__kit { margin-top: 1rem; text-align: left; }
  .tools__kit-heading { font-weight: 700; font-size: 0.9375rem; color: var(--bone-dim); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 0.75rem; }
  .tools__kit-rows { display: flex; flex-direction: column; gap: 0.5rem; }

  #features { text-align: center; }
  #features .subhead { margin-inline: auto; }
  .features__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 0.75rem; margin: 2rem 0; text-align: left; }
  .feature-tile { border: 1px solid var(--iron-2); border-radius: var(--radius); background: var(--iron); padding: 1.25rem; display: flex; flex-direction: column; gap: 0.5rem; }
  .feature-tile__glyph { color: var(--bone-faint); }
  .feature-tile__name { font-family: var(--font-body); font-weight: 700; font-size: 1rem; }
  .feature-tile__line { color: var(--bone-dim); font-size: 0.9375rem; }

  .download-v2 {
    position: relative;
    overflow: hidden;
    width: 100vw;
    max-width: 100vw;
    margin: 0 0 0 calc(50% - 50vw);
    padding: 1.5rem;
    min-height: 40vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .download-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .download-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to bottom, rgba(11, 14, 16, 0) 0%, rgba(11, 14, 16, 0.72) 45%, rgba(11, 14, 16, 0) 100%);
  }
  .download-copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
  }
  .download-line { font-family: var(--font-body); font-weight: 700; font-size: 1.5rem; color: var(--bone); }

  #tutorials { text-align: center; }
  #tutorials .subhead { margin-inline: auto; }
  .tutorials__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 0.75rem; margin: 2rem 0; text-align: left; }
  .tutorial-card { display: flex; flex-direction: column; border: 1px solid var(--iron-2); border-radius: var(--radius); background: var(--iron); overflow: hidden; text-decoration: none; color: inherit; }
  .tutorial-card__thumb { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .tutorial-card__title { font-family: var(--font-body); font-weight: 700; font-size: 1rem; color: var(--bone); padding: 1.25rem; }

  #rigs { text-align: center; }
  #rigs .prose { margin-inline: auto; }
  .rigs__ctas { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; margin-top: 1.5rem; }

  #services { text-align: center; }
  #services .prose { margin-inline: auto; }
  .services__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 0.75rem; margin: 1.5rem 0; text-align: left; }
  .service { border: 1px solid var(--iron-2); border-radius: var(--radius); background: var(--iron); padding: 1.25rem; display: flex; flex-direction: column; gap: 0.625rem; }
  .service h3 { font-size: 1rem; }
  .service p { color: var(--bone-dim); font-size: 0.9375rem; }
  .service__price { margin-top: auto; color: var(--bone); font-weight: 700; }

  #about { text-align: center; }
  #about .about__grid {
    margin-inline: auto;
    max-width: 56rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    text-align: left;
  }
  #about .about__grid--photo { grid-template-columns: 240px 1fr; align-items: start; }
  #about .about__photo {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--iron-3);
    border-radius: var(--radius);
  }
  #about .about__body { display: flex; flex-direction: column; gap: 1rem; }
  @media (max-width: 720px) {
    #about .about__grid--photo { grid-template-columns: 1fr; }
  }

  #devlog { text-align: center; }
  .devlog__rows { display: flex; flex-direction: column; gap: 0.5rem; margin: 1.5rem 0 2rem; text-align: left; }
  .devlog-link { text-decoration: none; color: inherit; }
</style>
