---
// THE NEW HOMEPAGE, built at its own route (Adrian, 2026-09-04).
//
// WHY NOT ON index.astro. The live homepage carries uncommitted work, and an experiment
// that may replace it wholesale should not share a file with the page that is currently
// shipping. This moves over when it earns the slot.
//
// This is the scroll-craft build. Its brief, plan, feeling curve and fingerprint row live
// in the depot at Projects/FabricatorStudio/Website/scrollcraft/builds/fabricatorstudio-home/.
//
// GRAMMAR: continuous world (uniqueness.md 2.4), which forces four things and this page
// obeys all four -- nothing in document flow but the spacer, copy arriving inside the world
// rather than scrolling over it, a nav that is a clickable MAP rather than a bar, and a
// close that is arrival at a place whose call to action is an object standing in it.
//
// THE SCROLL IS THE WHOLE TIMELINE (Adrian, 2026-09-05: "remove the button, let's turn it
// back to a scrolling effect, all the way through joints and building the control rig").
// The BRING TO LIFE press that drove her build on 2026-09-04 is gone; the wheel runs the
// entire pipeline, and the un-creation runs in reverse because every beat is a pure
// function of q. BringToLife.astro stays in the tree, unused, in case he wants it back.
import BaseLayout from '../layouts/BaseLayout.astro';
import ArmatureStage from '../components/ArmatureStage.astro';
import NavBar from '../components/NavBar.astro';
import Wordmark from '../components/Wordmark.astro';
// his cleaned-up portrait (Adrian, 2026-09-05); the older adrian.png stays for the live homepage
import adrian from '../assets/about/portrait.png';
import markCG from '../assets/press/cgchannel.png';
import markAW from '../assets/press/animworks.png';
import { Image } from 'astro:assets';
import { LINKS } from '../data/links';
import fsLogo from '../assets/fs-logo.png';
import mayaLogo from '../assets/logos/maya.png';
import unrealLogo from '../assets/logos/unreal.png';
import wnSupport from '../assets/whatsnew/notice_support.png';
import wnMesh from '../assets/whatsnew/notice_mesh_editing.png';
import wnOverhaul from '../assets/whatsnew/notice_ui_overhaul.png';
import wnUnreal from '../assets/whatsnew/notice_controlrig_unreal.png';
import wnMaya from '../assets/whatsnew/notice_auto_skeleton_fit.png';

// THE SCORE. Six waypoints, his names and his sequence (2026-09-05). Weights are viewport
// heights and they are the only dial on this page. Automation holds the most by far: it is
// the whole build, seven and a third seconds of clock that the wheel now scrubs.
//
// Each waypoint owns a range of q, ArmatureStage's clock, and scroll maps linearly across
// it. Where the range is empty (Iteration) she holds still and posable.
//   Ideation           the mark becomes his points                 q 0.00 - 0.62
//   Integration        the hologram wipes up through him           q 0.62 - 1.05
//   Creation           her points gather in front of him           q 1.05 - 1.95
//   Automation         the camera turns to face her, then the      q 1.95 - 9.30
//                      wipe, the skeleton, the skin, the controls
//   Iteration          the controls fade in; drag her             q 9.30 - 9.80
//   Realization        the camera pulls back and the doors open    q 9.80 - 10.80
// THE EXTRA BEAT ON THE QUOTE (Adrian, 2026-09-05, the final polish: "let the same sit in
// the push position for an extra beat, leave the davinci quote up, then during that extra
// beat as I scroll down the transition out of the quote happens then we pull the camera
// out to fit"). `hold` is the tail of a waypoint's span over which the clock sits at q1:
// Ideation's push lands at 1.2vh as before, the camera then holds there for 0.6vh with
// the quote up, the quote fades over the end of that hold, and Integration's move to fit
// begins where it always did, at q 0.62.
const WAYPOINTS = [
  { id: 'ideation', label: 'Ideation', w: 1.8, q0: 0.0, q1: 0.62, hold: 0.6 },
  // the same beat at the top of fit (Adrian, 2026-09-05): the move lands at 1.0vh, holds 0.6
  { id: 'integration', label: 'Integration', w: 1.6, q0: 0.62, q1: 1.05, hold: 0.6 },
  { id: 'creation', label: 'Creation', w: 1.2, q0: 1.05, q1: 1.95 },
  // the ROM breathes (Adrian, 2026-09-05): the build lands at 4.0vh, the routine runs on for 0.6
  { id: 'automation', label: 'Automation', w: 4.6, q0: 1.95, q1: 9.3, hold: 0.6 },
  // the clock walks 9.3 -> 9.8 here so the controls can fade in over the scroll
  { id: 'iteration', label: 'Iteration', w: 1.6, q0: 9.3, q1: 9.8 },
  { id: 'realization', label: 'Realization', w: 1.4, q0: 9.8, q1: 10.8 },
  // THE LAST SCREEN (Adrian, 2026-09-05: "as an overlay to the 3D scene let's add the Meet
  // the Team screen, it should take over the entire screen... the bottom most screen").
  // The world holds its closing frame underneath; the layer covers it.
  { id: 'team', label: 'Meet the Team', w: 1.4, q0: 10.8, q1: 10.8 },
];
const TOTAL = WAYPOINTS.reduce((a, b) => a + b.w, 0);   // 13.6, inside the 8-14 budget
let acc = 0;
const CUM = WAYPOINTS.map((wp) => { const s = acc; acc += wp.w; return s; });

// THE THREE ROWS (his revised concept, 2026-09-05: the opening and the close both carry
// the three products as a list of rows with their marks, in place of the plates that
// stood in the world). The opening's first row is the download itself.
// THE ACCOLADES (Adrian, 2026-09-05: "include the accolades we've gotten from anim.works
// and cgchannel"). Their words, not ours: CG Channel's own headline and byline, and the
// title Animworks gave the listing when they stocked it. Both URLs verified 2026-09-05.
const PRESS = [
  {
    href: 'https://www.cgchannel.com/2026/08/armature-is-a-free-ai-assisted-standalone-character-rigging-tool/',
    source: 'CG Channel',
    mark: markCG,
    quote: 'Armature is a free AI-assisted standalone character rigging tool',
    by: 'Jim Thacker, 6 August 2026',
  },
  {
    href: 'https://anim.works/product/armature-artist-ai-rigging-adrian-melian/',
    source: 'Animworks',
    mark: markAW,
    quote: 'Armature: Artist+AI Rigging by Adrian Melian',
    by: 'Harvey Newman, 12 August 2026',
  },
];
// THE RECORD, from his About concept (2026-09-05), his words
const RECORD = [
  { where: 'Sledgehammer Games', what: 'Lead, Character and Weapons Tech Art. Two Call of Duty titles.' },
  { where: 'Camouflaj', what: 'Expert Technical Artist' },
  { where: 'Meta, Double Fine', what: 'Technical Art' },
  { where: 'Ubisoft, NCSoft', what: 'Technical Art' },
];

const ROWS = [
  { href: '/armature/', label: 'Armature', tag: 'Free', icon: fsLogo, cls: '' },
  { href: '/tools/', label: 'Maya pipeline tools', tag: '', icon: mayaLogo, cls: 'row__icon--maya' },
  { href: '/control-rig/', label: 'Unreal Control Rig', tag: '', icon: unrealLogo, cls: 'row__icon--unreal' },
];

// WHAT'S NEW (Adrian, 2026-09-05: "that exact window with everything in it, thumbnails and
// all"). Armature 2.3.0's own launch notice, the card the app opens with, then trimmed at
// his word the same evening: the Unreal Control Rig section flipped to Released and moved
// to the top with a button to its page, the support ask shortened and its pill gone, the
// flat release notes gone ("they are in the full release notes page anyway"), the footer's
// coffee button gone. The section bodies are the app's changelog.ts verbatim; the ask is
// his shortened line. The 'Topic: sentence' headlines are split at render as the app
// splits them, so the topic word takes its colour.
const WN = {
  version: '2.3.0',
  date: 'Released 1 September 2026',
  banner: {
    title: 'Support: We can’t do this without you',
    body: 'Please consider donating to the cause. FabricatorStudio is a one person studio and could use your support!',
    shot: wnSupport,
  },
  sections: [
    { tag: 'Released', tone: 'plasma', scope: 'Unreal', title: 'Unreal: FS Control Rig Builder',
      body: 'Build a character rig in Unreal in one click, using FS Control Rig Modules. Packed with the latest UE 5.8 features. The rig features auto IK/FK match on the switch, an IK/FK spine, twist joints integration, and much more.',
      shot: wnUnreal, href: '/control-rig/', cta: 'See the Control Rig' },
    { tag: 'New', tone: 'plasma', scope: 'Armature', title: 'Armature: Multi-mesh support',
      body: 'A character can be made of more than one mesh. Import, rename, group, separate, combine and hide them in the Meshes panel, with weights kept per mesh and an export that writes one file, one per group, or one per mesh.',
      shot: wnMesh },
    { tag: 'New', tone: 'plasma', scope: 'Armature', title: 'Armature: Full UI/UX Overhaul',
      body: 'To make the workflow even more Artist-Friendly I have done a full overhaul on the interface, I hope you enjoy it!',
      shot: wnOverhaul },
    { tag: 'Coming soon', tone: 'cobalt', scope: 'Maya', title: 'Maya: Auto skeleton placement',
      body: 'It builds a skeleton and fits it to your character automatically. The final step in full FS rig automation.',
      shot: wnMaya },
  ],
};
function wnTopic(title) {
  const i = title.indexOf(':');
  if (i <= 0 || i > 24) return null;
  const topic = title.slice(0, i);
  return { topic, slug: topic.toLowerCase().replace(/[^a-z0-9]+/g, '-'), rest: title.slice(i + 1) };
}
const WN_SUMMARY = `${WN.sections.length} highlight${WN.sections.length === 1 ? '' : 's'}`;
const WN_BANNER_TOPIC = wnTopic(WN.banner.title);
---
<BaseLayout
  title="FabricatorStudio"
  description="Scroll a character through the whole rigging pipeline: skeleton, skinning, materials, control rig. Then move her yourself."
>
  {/* THE BAR, AS A DRAWER (Adrian, 2026-09-05: "if the user starts scrolling down it goes
      away, but if they scroll up it comes back... in the closed state if they hover over
      it unravels"). The site's own NavBar, untouched; the page drives html[data-nav] from
      the scroll direction and the styles below do the rest. */}
  <NavBar />
  <div class="nav-lip" data-nav-lip aria-hidden="true"></div>

  {/* WHAT'S NEW (Adrian, 2026-09-05): Armature's launch notice as a panel over the world,
      on the right; the top of the screen on a phone. It leaves when the page scrolls
      down and does not return until the page is back at the very top. The close retires
      it for the visit. Same title bar, version strip, support banner, sections, notes
      box and footer as the app's card; the coffee button is the site's own self-hosted
      one, opening the same panel the bar's button opens. */}
  {/* THE PANEL IS A DRAWER (Adrian, 2026-09-05: "give it a drawer 'What's new' and it
      closes in mobile view but if the user clicks it it opens up but full height", then
      "make it a drawer on the right, just like how it is on the top in mobile mode, and if
      I X it out, then it goes back into the drawer, but I can still open it again"). This
      strip is the closed drawer, top right on desktop and under the bar on a phone; a
      press opens the panel, the close folds it back to the strip. */}
  <button type="button" class="wn__tab" data-wn-tab aria-controls="wn-panel" aria-expanded="false">
    <span class="wn__tab-label">What’s new</span>
    <span class="wn__tab-ver">{WN.version}</span>
    <span class="wn__spacer"></span>
    <span class="wn__tab-chev" aria-hidden="true">&#8964;</span>
  </button>
  <aside class="wn" id="wn-panel" data-wn-panel aria-label="What’s new in Armature">
    <div class="wn__titlebar">
      <span class="wn__heading">What’s new</span>
      <span class="wn__version">{WN.version}</span>
      <span class="wn__spacer"></span>
      <button type="button" class="wn__close" data-wn-close aria-label="Close">&#10005;</button>
    </div>
    <div class="wn__strip">
      <span class="wn__pill"><span class="wn__dot" aria-hidden="true"></span>{WN.version}</span>
      <span class="wn__spacer"></span>
      <span class="wn__date">{WN.date}</span>
    </div>
    <div class="wn__banner">
      <div class="wn__banner-shot">
        <Image src={WN.banner.shot} alt="" widths={[360, 720]} sizes="180px" loading="eager" />
      </div>
      <div class="wn__banner-col">
        <div class="wn__banner-line">
          <span class="wn__banner-title">
            {WN_BANNER_TOPIC ? (<><span class={`wn__topic wn__topic--${WN_BANNER_TOPIC.slug}`}>{WN_BANNER_TOPIC.topic}:</span>{WN_BANNER_TOPIC.rest}</>) : WN.banner.title}
          </span>
        </div>
        <div class="wn__banner-copy">{WN.banner.body}</div>
        {/* a plain link out: the bar's facade panel left with the bar's coffee button */}
        <a class="wn__coffee" href={LINKS.coffee} target="_blank" rel="noopener" data-goatcounter-click="coffee-whatsnew">
          <img src="/bmc-button.svg" alt="Buy me a coffee" width="235" height="50" />
        </a>
      </div>
    </div>
    <div class="wn__body" data-wn-body>
      <div class="wn__kicker wn__kicker--head">What’s new:</div>
      {WN.sections.map((h) => { const tp = wnTopic(h.title); return (
        <div class="wn__section">
          <div class="wn__shot">
            <Image src={h.shot} alt="" widths={[520, 1040]} sizes="(max-width: 700px) 100vw, 520px" loading="lazy" />
          </div>
          <div class="wn__col">
            <div class="wn__tags">
              <span class={`wn__tag wn__tag--${h.tone}`}>{h.tag.toUpperCase()}</span>
              <span class="wn__scope">{h.scope}</span>
            </div>
            <div class="wn__title">
              {tp ? (<><span class={`wn__topic wn__topic--${tp.slug}`}>{tp.topic}:</span>{tp.rest}</>) : h.title}
            </div>
            <div class="wn__copy">{h.body}</div>
            {h.href && <a class="wn__cta" href={h.href}>{h.cta}<span class="wn__cta-arrow" aria-hidden="true">&rarr;</span></a>}
          </div>
        </div>
      ); })}
    </div>
    <div class="wn__footer">
      <span class="wn__summary">{WN_SUMMARY}</span>
      <span class="wn__spacer"></span>
      <a class="wn__notes-link" href="/changelog/">Full release notes</a>
    </div>
  </aside>

  {/* THE WORLD. One canvas, fixed, and nothing is ever drawn over it that is not copy. */}
  <div class="world" data-world>
    <ArmatureStage variant="page" skin="/mesh/zumi.skin" tex="/mesh/zumi" />
    <div class="world__scan" aria-hidden="true"></div>
  </div>

  {/* THE MAP. The grammar's nav: not a bar, a diagram of where you are in the one place,
      and every stop is reachable by click and by keyboard. */}
  <nav class="map" data-map aria-label="Where you are">
    <ol>
      {WAYPOINTS.map((wp, i) => (
        <li>
          <button type="button" data-goto={CUM[i] + wp.w * 0.22} data-wp={wp.id} aria-label={wp.label}>
            <span class="map__dot" aria-hidden="true"></span>
            <span class="map__n" aria-hidden="true">{wp.label}</span>
          </button>
        </li>
      ))}
    </ol>
  </nav>

  {/* THE COPY LAYER. Windowed against the whole track, never scrolling over the world.
      Adrian's copy, 2026-09-05, as written; the anchor changes every window so the page
      never settles into one centred column, and no window sits on her. */}
  {/* THE COPY LAYER, in the treatment he designed (his "FabricatorStudio Homepage" concept
      page, 2026-09-05): an open left column, no box, a rule and label for an eyebrow, a big
      serif headline whose last phrase turns italic, an Archivo sub, the pill download with
      a small plasma "Free.", and a scrim from the left so the words read over the world.
      His words verbatim (2026-09-05), split across the slots. */}
  <div class="copy" data-copy>
    <div class="copy__scrim" data-scrim aria-hidden="true"></div>
    <div class="cw" data-cw="top">
      <p class="cw__eyebrow">Technical art studio</p>
      <h1 class="cw__h cw__h--xl">Tech Art <em>Re-imagined.</em></h1>
      <p class="cw__sub">Artist + AI Pipelines and Software.<br>From a 14 year AAA vet.</p>
      <div class="rows">
        <a class="row row--lead" href={LINKS.installer} data-installer data-goatcounter-click="next-download-armature-top">
          <Image class="row__icon" src={fsLogo} alt="" width={26} height={26} loading="eager" />
          <span class="row__label row__label--bold">Download Armature</span>
          <span class="row__tag">Free</span>
          <span class="row__arrow" aria-hidden="true">&rarr;</span>
        </a>
        {ROWS.slice(1).map((r) => (
          <a class="row" href={r.href}>
            <Image class={'row__icon ' + r.cls} src={r.icon} alt="" width={26} height={26} loading="eager" />
            <span class="row__label">{r.label}</span>
            <span class="row__arrow" aria-hidden="true">&rarr;</span>
          </a>
        ))}
      </div>
    </div>
    <div class="cw" data-cw="ideation">
      <p class="cw__eyebrow">Ideation</p>
      <figure class="cw__quote">
        <span class="cw__qmark" aria-hidden="true">&ldquo;</span>
        <blockquote class="cw__q">Where the spirit does not work with the hand, there is no art.</blockquote>
        <figcaption class="cw__cite">Leonardo da Vinci</figcaption>
      </figure>
    </div>
    <div class="cw" data-cw="integration">
      <p class="cw__eyebrow">Integration</p>
      <Wordmark class="cw__mark" decorative height="clamp(2rem, 3.2vw, 3.6rem)" />
      <h2 class="cw__h">Artistic AI Tooling. <em>Built with refinement in mind.</em></h2>
    </div>
    <div class="cw" data-cw="creation">
      <p class="cw__eyebrow">Creation</p>
      <h2 class="cw__h">Tools to drive assets to production level standards. <em class="cw__em--breathe">Fast.</em></h2>
    </div>
    <div class="cw" data-cw="automation">
      <p class="cw__eyebrow">Automation</p>
      <h2 class="cw__h">Turn slow technical precision <em>into artistic intent.</em></h2>
    </div>
    <div class="cw" data-cw="iteration">
      <p class="cw__eyebrow">Iteration</p>
      <h2 class="cw__h">Stream imagination <em>into existence.</em></h2>
    </div>
    <div class="cw" data-cw="realization">
      <p class="cw__eyebrow">Realization</p>
      {/* FLIPPED (Adrian, 2026-09-05): the line leads, "FabricatorStudio. Optimize creativity." is the sub. The
          second half italic, the way every other headline on the page turns. */}
      <h2 class="cw__h cw__h--close">Realize your ideas <em>at the speed of thought.</em></h2>
      <p class="cw__sub">FabricatorStudio. Optimize creativity.</p>
      {/* THE SAME THREE DOORS AS THE TOP (Adrian, 2026-09-05: "the same exact door as the
          top with hover and everything"): the download itself leads, then the two pages. */}
      <div class="rows">
        <a class="row row--lead" href={LINKS.installer} data-installer data-goatcounter-click="next-download-armature-close">
          <Image class="row__icon" src={fsLogo} alt="" width={26} height={26} loading="lazy" />
          <span class="row__label row__label--bold">Download Armature</span>
          <span class="row__tag">Free</span>
          <span class="row__arrow" aria-hidden="true">&rarr;</span>
        </a>
        {ROWS.slice(1).map((r) => (
          <a class="row" href={r.href}>
            <Image class={'row__icon ' + r.cls} src={r.icon} alt="" width={26} height={26} loading="lazy" />
            <span class="row__label">{r.label}</span>
            <span class="row__arrow" aria-hidden="true">&rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </div>

  {/* MEET THE TEAM. The page's last screen, a layer that covers the world outright rather
      than a window inside it. The introduction video and the engagements ask carry the
      copy the live homepage's close already carries, verbatim; the paragraphs he said he
      would write with me are not here yet. The accolades close the screen. */}
  <section class="team" data-team aria-label="Meet the Team">
    <div class="team__inner">
      <p class="cw__eyebrow">Who builds it</p>
      <h2 class="team__title">Adrian <em>Melian.</em></h2>
      <p class="team__lede">Technical Artist. Fourteen years in AAA character rigging, skinning and tools.</p>
      <div class="team__grid">
        <figure class="team__fig">
          <Image class="team__photo" src={adrian} alt="Adrian Melian" widths={[540, 1080]} sizes="(max-width: 900px) 92vw, 34vw" loading="lazy" />
          <figcaption class="team__cap"><span>Founder, FabricatorStudio</span><span>2026</span></figcaption>
        </figure>
        <div class="team__col">
          <div class="team__bio">
            <p class="team__p">Hi, I am a Technical Artist with fourteen years in AAA character rigging, skinning and tools. I led the Character and Weapons Tech Art teams across two Call of Duty titles, then joined Camouflaj as an Expert Technical Artist.</p>
            <p class="team__p team__p--bone">I founded FabricatorStudio in 2026 to help teams meet their pipeline needs.</p>
          </div>
          <div class="team__record">
            <span class="team__label">The record</span>
            <div class="team__rows">
              {RECORD.map((r) => (
                <div class="team__row"><span class="team__where">{r.where}</span><span class="team__what">{r.what}</span></div>
              ))}
              <div class="team__rule"></div>
            </div>
          </div>
          <div class="team__ctas">
            <a class="team__mailbtn" href="mailto:adrian@fabricator.studio">adrian@fabricator.studio<span aria-hidden="true">&rarr;</span></a>
            <a class="team__link" href="/tools/">See the toolset</a>
          </div>
        </div>
      </div>
      <div class="team__pressblock">
        <span class="team__label">Press</span>
        <div class="team__press">
          {PRESS.map((pr) => (
            <a class="press" href={pr.href} target="_blank" rel="noopener">
              <Image class="press__mark" src={pr.mark} alt={pr.source} width={208} height={73} loading="lazy" />
              <span class="press__q">&ldquo;{pr.quote}&rdquo;</span>
              <span class="press__by">{pr.by}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* THE CAMERA PANEL (Adrian, 2026-09-05). His dials for the four camera marks, shown
      only at /?cam and never to a visitor. The script builds the sliders; the stage
      reads the marks off the window every frame. */}
  <div class="cam" data-cam hidden aria-hidden="true"></div>

  <div class="track" data-track aria-hidden="true"></div>

  {/* REDUCED MOTION GETS A PAGE, NOT A BLANK CANVAS. The stage does not boot at all under
      that setting, so without this the world would be an empty black rectangle. Same words,
      same doors, in document flow. */}
  <div class="still">
    <h1>Tech Art Re-imagined.</h1>
    <p>Artist + AI Pipelines and Software. From a 14 year AAA vet.</p>
    <p><a href={LINKS.installer} data-installer>Download Armature</a> Free.</p>
    <blockquote>&ldquo;Where the spirit does not work with the hand, there is no art.&rdquo; Leonardo da Vinci</blockquote>
    <p>Artistic AI Tooling. Built with refinement in mind.</p>
    <p>Tools to drive assets to production level standards. Fast.</p>
    <p>Turn slow technical precision into artistic intent.</p>
    <p>Stream imagination into existence.</p>
    <p>Optimize creation. Realize your ideas at the speed of thought.</p>
    <h2>Adrian Melian.</h2>
    <p>Technical Artist. Fourteen years in AAA character rigging, skinning and tools.</p>
    <p>Hi, I am a Technical Artist with fourteen years in AAA character rigging, skinning and tools. I led the Character and Weapons Tech Art teams across two Call of Duty titles, then joined Camouflaj as an Expert Technical Artist.</p>
    <p>I founded FabricatorStudio in 2026 to help teams meet their pipeline needs. <a href="mailto:adrian@fabricator.studio">adrian@fabricator.studio</a>, or <a href="/tools/">see the toolset</a>.</p>
    <ul>
      {RECORD.map((r) => <li>{r.where}: {r.what}</li>)}
    </ul>
    <ul>
      {PRESS.map((pr) => <li><a href={pr.href}>{pr.source}</a>: {pr.quote} ({pr.by})</li>)}
    </ul>
    <ul>
      {ROWS.map((r) => <li><a href={r.href}>{r.label}</a>{r.tag ? ': ' + r.tag : ''}</li>)}
    </ul>
  </div>
</BaseLayout>

<style>
  /* ---- the world -------------------------------------------------------------------- */
  .world {
    position: fixed;
    inset: 0;
    background: var(--carbon);
    z-index: 0;
  }
  .world :global(.ast-canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  /* The PS2 half of his reference set, and the ONLY place it touches the world: a scanline
     interference so faint it reads as the projection being a projection. Everything else
     retro on this page is typographic, because retro in the world AND in the type at once
     reads as a filter laid over a photograph rather than as a designed page. */
  .world__scan {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      0deg, rgba(232, 224, 208, 0.030) 0 1px, rgba(11, 14, 16, 0) 1px 3px);
    mix-blend-mode: overlay;
    opacity: 0.55;
  }

  /* The scroll track. The only thing in document flow, which is the grammar's one
     structural rule: 13.6 viewport heights of travel, and no sections anywhere. */
  .track { height: 1360svh; }

  /* ---- the map ---------------------------------------------------------------------- */
  /* THE DOTS ARE BACK (Adrian, 2026-09-05: "go back to the original dots, BUT if the user
     mouses over the dots, it expands the dots and shows the name"). The rail the live
     homepage runs: six pixel dots, a dim trail behind the lit one. Each stop is still a
     real button that jumps there; its name rides out beside the dot on hover or focus. */
  .map {
    position: fixed;
    left: clamp(0.65rem, 1.6vw, 1.5rem);
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
  }
  .map ol { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(0.45rem, 1.1vh, 0.7rem); }
  .map button {
    position: relative;
    display: flex;
    align-items: center;
    /* the hit area is the dot plus a quiet margin, so the rail is easy to catch */
    padding: 0.3rem;
    margin: -0.3rem;
    background: none;
    border: 0;
    cursor: pointer;
    color: var(--bone-faint);
  }
  .map__dot {
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(11, 14, 16, 0);
    border: 1px solid var(--iron-3);
    transition: background 0.4s var(--ease-out), border-color 0.4s var(--ease-out),
      transform 0.4s var(--ease-out), box-shadow 0.4s var(--ease-out);
  }
  /* passed: filled, but quiet. The trail is what shows how far in you are. */
  .map button[data-passed] .map__dot {
    background: rgba(124, 255, 178, 0.42);
    border-color: rgba(124, 255, 178, 0.42);
  }
  /* here: the one that lights up */
  .map button[data-at] .map__dot {
    background: var(--plasma);
    border-color: var(--plasma);
    transform: scale(1.55);
    box-shadow: 0 0 10px rgba(124, 255, 178, 0.55);
  }
  .map__n {
    position: absolute;
    left: calc(100% + 0.35rem);
    top: 50%;
    transform: translate(-6px, -50%);
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--bone-dim);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--t-fast) var(--ease-out), transform var(--t-base) var(--ease-out);
  }
  .map button:hover .map__dot,
  .map button:focus-visible .map__dot {
    transform: scale(2.2);
    border-color: var(--bone-dim);
  }
  .map button[data-at]:hover .map__dot,
  .map button[data-at]:focus-visible .map__dot { transform: scale(2.2); border-color: var(--plasma); }
  .map button:hover .map__n,
  .map button:focus-visible .map__n { opacity: 1; transform: translate(0, -50%); }
  .map button[data-at] .map__n { color: var(--plasma); }
  .map button:focus-visible { outline: 2px solid var(--plasma); outline-offset: 3px; border-radius: var(--radius-pill); }
  /* Tighter, and off the thumb's edge of the screen. */
  @media (max-width: 700px) {
    .map { left: 0.5rem; }
    .map ol { gap: 0.4rem; }
    .map__dot { width: 5px; height: 5px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .map__dot, .map__n { transition: none; }
  }

  /* ---- the copy layer --------------------------------------------------------------- */
  .copy {
    position: fixed;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }
  /* the concept's left scrim, up only while a window is */
  .copy__scrim {
    position: absolute;
    inset: 0;
    opacity: 0;
    background: linear-gradient(97deg, rgba(11, 14, 16, 0.82) 0%, rgba(11, 14, 16, 0.66) 26%,
      rgba(11, 14, 16, 0.38) 44%, rgba(11, 14, 16, 0.06) 64%, rgba(11, 14, 16, 0) 78%);
  }
  .cw {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
    padding: 0 clamp(20px, 4vw, 68px) 0 clamp(48px, 7vw, 132px);
    opacity: 0;
    /* opacity and the 34px rise are set per frame by the script; no transition, the wheel is the clock */
  }
  .cw > * { max-width: min(100%, 54vw); }
  .cw__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 clamp(18px, 2vw, 28px);
    font-family: var(--font-body);
    font-size: clamp(10px, 0.78vw, 12px);
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--plasma);
  }
  .cw__eyebrow::before { content: ""; flex: 0 0 auto; width: 24px; height: 1px; background: var(--plasma); }
  .cw__h {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(44px, 5.6vw, 110px);
    line-height: 0.9;
    letter-spacing: -0.025em;
    color: var(--bone);
    text-wrap: balance;
  }
  .cw__h--xl { font-size: clamp(52px, 7.6vw, 146px); line-height: 0.86; letter-spacing: -0.028em; }
  .cw__h em { display: block; font-style: italic; }
  /* AN OPTICAL NUDGE (Adrian, 2026-09-05: "the space between the second line and 'Fast.'
     is too close, even it out"). Measured, the three line pitches are identical; the eye
     reads the tall italic F under a line with no descenders as crowded. 0.1em down. */
  .cw__h .cw__em--breathe { margin-top: 0.1em; }
  .cw__h .cw__free { display: inline-block; vertical-align: middle; margin-left: 0.4em; }
  /* the quote (his concept's second beat): an ember opening mark, the line in italic
     serif, a rule and the name */
  .cw__quote { margin: 0; max-width: min(100%, 50vw); }
  .cw__qmark {
    display: block;
    /* the glyph sits above its half-height line box; this keeps it off the eyebrow */
    margin-top: 0.42em;
    font-family: var(--font-display);
    font-size: clamp(64px, 7vw, 130px);
    line-height: 0.5;
    color: var(--ember);
  }
  .cw__q {
    margin: clamp(6px, 0.8vw, 12px) 0 0;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(32px, 4.3vw, 80px);
    line-height: 1.03;
    letter-spacing: -0.018em;
    color: var(--bone);
    text-wrap: balance;
  }
  .cw__cite {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: clamp(22px, 2.4vw, 38px);
    font-family: var(--font-body);
    font-size: clamp(11px, 0.82vw, 13px);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--bone-dim);
  }
  .cw__cite::before { content: ""; flex: 0 0 auto; width: 28px; height: 1px; background: var(--ember); }
  /* the full wordmark over Integration's line (Adrian, 2026-09-05) */
  .cw :global(.cw__mark) { margin: 0 0 clamp(18px, 2vw, 28px); }
  .cw__sub {
    margin: clamp(22px, 2.4vw, 36px) 0 0;
    max-width: 31ch;
    font-family: var(--font-body);
    font-size: clamp(15px, 1.15vw, 20px);
    line-height: 1.5;
    color: var(--bone-dim);
    text-wrap: pretty;
  }
  .cw__cta {
    display: flex;
    align-items: center;
    gap: clamp(14px, 1.4vw, 22px);
    margin: clamp(26px, 3vw, 44px) 0 0;
  }
  /* the download: a real link inside a layer that otherwise lets the pointer through */
  .cw__cta :global(.btn) { pointer-events: auto; }
  .cw:not([data-up]) .cw__cta :global(.btn) { pointer-events: none; }
  .cw__free {
    font-family: var(--font-body);
    font-size: clamp(11px, 0.85vw, 13px);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--plasma);
    white-space: nowrap;
  }
  @media (max-width: 700px) {
    .cw { padding: 0 1.25rem 14svh 2.25rem; align-content: end; }
    .cw > * { max-width: 100%; }
    .cw__h { font-size: clamp(36px, 11vw, 52px); }
    .cw__h--xl { font-size: clamp(44px, 13vw, 64px); }
    .cw__quote { max-width: 100%; }
    .cw__q { font-size: clamp(26px, 8vw, 40px); }
    .copy__scrim { background: linear-gradient(180deg, rgba(11, 14, 16, 0) 30%, rgba(11, 14, 16, 0.72) 100%); }
  }

  /* ---- meet the team ------------------------------------------------------------------ */
  /* His About concept (2026-09-05), fitted to one screen: the eyebrow, the name as the
     headline, a lede, his photo with a caption beside the bio and the record, the mail as
     the button, then the press with the outlets' own marks. Where the screen is shorter
     than the design, the layer scrolls inside itself once it is fully up. */
  .team {
    position: fixed;
    inset: 0;
    /* a section, so the site's container width would otherwise apply and leave the world
       showing at both edges (caught 2026-09-05: 144px of stars either side) */
    width: auto;
    max-width: none;
    margin: 0;
    z-index: 5;
    display: grid;
    align-content: center;
    padding: calc(var(--header-h) + 1.5svh) clamp(20px, 4vw, 68px) 2.5svh clamp(48px, 7vw, 132px);
    background: var(--carbon);
    color: var(--bone);
    opacity: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .team[data-in] { pointer-events: auto; overflow-y: auto; overscroll-behavior: auto; }
  .team__inner { display: grid; gap: clamp(12px, 1.4vw, 20px); max-width: 1320px; }
  .team__title {
    margin: 0;
    max-width: 14em;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(40px, 5vw, 84px);
    line-height: 0.88;
    letter-spacing: -0.028em;
  }
  .team__title em { font-style: italic; }
  .team__lede {
    margin: 0;
    max-width: 26ch;
    font-family: var(--font-body);
    font-size: clamp(15px, 1.25vw, 22px);
    font-weight: 500;
    line-height: 1.32;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }
  .team__grid {
    display: grid;
    grid-template-columns: minmax(0, 34fr) minmax(0, 56fr);
    gap: clamp(24px, 3.4vw, 56px);
    align-items: start;
    margin-top: clamp(8px, 1.4vw, 22px);
  }
  .team__fig { margin: 0; display: grid; gap: clamp(8px, 0.9vw, 12px); }
  .team__fig :global(.team__photo) {
    display: block;
    width: 100%;
    max-height: 44vh;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    /* a square source in the concept's 4/5 frame: the face sits at the upper third */
    object-position: 50% 28%;
    border-radius: var(--radius-sm);
    background: var(--iron);
  }
  .team__cap {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    font-family: var(--font-body);
    font-size: clamp(11px, 0.82vw, 13px);
    letter-spacing: 0.04em;
    color: var(--bone-dim);
  }
  .team__col { display: grid; gap: clamp(16px, 2vw, 30px); min-width: 0; }
  .team__bio { display: grid; gap: clamp(10px, 1.1vw, 16px); max-width: 46ch; }
  .team__p {
    margin: 0;
    font-family: var(--font-body);
    font-size: clamp(14px, 1.05vw, 17px);
    line-height: 1.55;
    color: var(--bone-dim);
    text-wrap: pretty;
  }
  .team__p--bone { color: var(--bone); }
  .team__label {
    display: block;
    margin-bottom: clamp(8px, 0.9vw, 12px);
    font-family: var(--font-body);
    font-size: clamp(10px, 0.78vw, 12px);
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--bone-dim);
  }
  .team__rows { display: grid; }
  .team__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: clamp(16px, 2vw, 40px);
    padding: clamp(8px, 0.9vw, 12px) 0;
    border-top: 1px solid var(--iron-2);
  }
  .team__rule { border-top: 1px solid var(--iron-2); }
  .team__where { flex: 0 0 auto; font-family: var(--font-body); font-size: clamp(13px, 1vw, 16px); font-weight: 600; letter-spacing: -0.005em; }
  .team__what { flex: 1 1 auto; text-align: right; font-family: var(--font-body); font-size: clamp(11px, 0.85vw, 13px); line-height: 1.4; color: var(--bone-dim); }
  .team__ctas { display: flex; align-items: center; flex-wrap: wrap; gap: clamp(14px, 1.6vw, 24px); }
  .team__mailbtn {
    display: inline-flex;
    align-items: center;
    gap: clamp(12px, 1.3vw, 20px);
    height: clamp(42px, 3.2vw, 52px);
    padding: 0 clamp(18px, 1.7vw, 26px);
    border-radius: var(--radius-sm);
    background: var(--plasma);
    color: var(--carbon);
    font-family: var(--font-body);
    font-size: clamp(13px, 0.98vw, 16px);
    font-weight: 700;
    white-space: nowrap;
    text-decoration: none;
    transition: background var(--t-fast) var(--ease-out);
  }
  .team__mailbtn span { font-weight: 400; font-size: 1.05em; }
  .team__mailbtn:hover { background: var(--plasma-dim); }
  .team__link {
    font-family: var(--font-body);
    font-size: clamp(12px, 0.9vw, 14px);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--bone-dim);
    text-decoration: none;
  }
  .team__link:hover { color: var(--bone); }
  .team__mailbtn:focus-visible, .team__link:focus-visible, .press:focus-visible { outline: 2px solid var(--plasma); outline-offset: 2px; }
  .team__pressblock { margin-top: clamp(10px, 1.6vw, 26px); }
  .team__press {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 56px);
    border-top: 1px solid var(--iron-2);
    padding-top: clamp(14px, 1.6vw, 22px);
  }
  .press {
    display: grid;
    gap: clamp(8px, 0.9vw, 12px);
    align-content: start;
    color: var(--bone);
    text-decoration: none;
  }
  .press :global(.press__mark) { display: block; width: auto; height: clamp(26px, 2.4vw, 38px); opacity: 0.9; border-radius: var(--radius-sm); }
  .press__q {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(18px, 1.6vw, 26px);
    line-height: 1.16;
    letter-spacing: -0.012em;
    text-wrap: pretty;
  }
  .press__by {
    font-family: var(--font-body);
    font-size: clamp(11px, 0.84vw, 13px);
    letter-spacing: 0.03em;
    color: var(--bone-dim);
  }
  @media (max-width: 900px) {
    .team { padding: calc(var(--header-h) + 1svh) 1.25rem 3svh 1.25rem; align-content: start; }
    .team__grid { grid-template-columns: 1fr; gap: 1.2rem; }
    .team__fig :global(.team__photo) { max-height: 48vh; }
    .team__title { font-size: clamp(36px, 11vw, 52px); }
    .team__bio { max-width: none; }
    .team__press { grid-template-columns: 1fr; }
  }

  /* ---- the rows ---------------------------------------------------------------------- */
  /* His revised concept's product list: hairline-ruled rows, a mark, the name, a plasma
     tag where there is one, and an arrow. The opening's first row is the download and
     wears a plasma rule; the rest light their rule on hover. */
  .cw .rows {
    display: grid;
    gap: clamp(2px, 0.4vw, 6px);
    margin-top: clamp(28px, 3.2vw, 48px);
    max-width: min(100%, 320px);
  }
  .row {
    display: flex;
    align-items: center;
    gap: clamp(11px, 1.05vw, 15px);
    padding: clamp(13px, 1.3vw, 18px) clamp(6px, 0.8vw, 12px);
    border-top: 1px solid var(--iron-2);
    color: var(--bone);
    text-decoration: none;
    pointer-events: auto;
    transition: border-color var(--t-fast) var(--ease-out), background var(--t-fast) var(--ease-out);
  }
  .row:last-child { border-bottom: 1px solid var(--iron-2); }
  /* every row lights the way the download row does (Adrian, 2026-09-05) */
  .row:hover, .row:focus-visible { border-top-color: var(--plasma); background: rgba(124, 255, 178, 0.06); }
  .row--lead { border-top-color: var(--plasma); }
  .row:focus-visible { outline: 2px solid var(--plasma); outline-offset: 2px; }
  /* LIVE WHILE UP (2026-09-05): the old gate matched the style text "opacity: 0", which
     is also "opacity: 0.97", so a row was dead anywhere on its fade; at the close, where a
     reader stops wherever the wheel leaves them, that was most of the window. */
  .cw:not([data-up]) .row { pointer-events: none; }
  .rows :global(.row__icon) { flex: 0 0 auto; display: block; width: clamp(22px, 1.7vw, 26px); height: auto; }
  .rows :global(.row__icon--maya) { filter: grayscale(1) brightness(1.55) contrast(0.82); opacity: 0.72; }
  .rows :global(.row__icon--unreal) { opacity: 0.72; }
  .row__label {
    flex: 1 1 auto;
    font-family: var(--font-body);
    font-size: clamp(14px, 1.02vw, 17px);
    font-weight: 600;
    letter-spacing: -0.005em;
    white-space: nowrap;
  }
  .row__label--bold { font-weight: 700; }
  .row__tag {
    flex: 0 0 auto;
    font-family: var(--font-body);
    font-size: clamp(10px, 0.78vw, 12px);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--plasma);
  }
  .row__arrow { flex: 0 0 auto; width: 13px; font-size: clamp(13px, 0.95vw, 16px); color: var(--bone-faint); }
  .row--lead .row__arrow { color: var(--plasma); }
  .cw__h--close { font-size: clamp(50px, 7vw, 132px); line-height: 0.88; letter-spacing: -0.028em; }
  @media (max-width: 700px) {
    .cw__h--close { font-size: clamp(44px, 13vw, 64px); }
    .cw .rows { max-width: 100%; }
  }

  /* ---- the camera panel (dev only, ?cam) ------------------------------------------- */
  .cam {
    position: fixed;
    left: 50%;
    bottom: 1rem;
    transform: translateX(-50%);
    z-index: 6;
    width: min(64rem, calc(100vw - 2rem));
    padding: 0.7rem 0.9rem;
    display: grid;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--bone-dim);
    background: rgba(11, 14, 16, 0.88);
    border: 1px solid rgba(124, 255, 178, 0.25);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-md);
  }
  /* Built by script, so every inner rule is global: Astro's scope only reaches markup. */
  .cam[hidden] { display: none; }
  .cam[data-min] :global(.cam__sliders), .cam[data-min] :global(textarea) { display: none; }
  .cam :global(.cam__set) { color: var(--plasma); text-transform: uppercase; white-space: nowrap; }
  .cam :global(button[hidden]) { display: none; }
  .cam :global(.cam__row) { display: flex; flex-wrap: wrap; gap: 0.4rem 0.8rem; align-items: center; }
  .cam :global(.cam__marks) { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .cam :global(button) {
    font: inherit;
    letter-spacing: inherit;
    text-transform: uppercase;
    color: var(--bone-faint);
    background: none;
    border: 1px solid rgba(232, 224, 208, 0.18);
    border-radius: var(--radius-sm);
    padding: 0.25rem 0.55rem;
    cursor: pointer;
  }
  .cam :global(button[data-on]) { color: var(--plasma); border-color: var(--plasma); }
  .cam :global(button:focus-visible) { outline: 2px solid var(--plasma); outline-offset: 2px; }
  .cam :global(.cam__q) { margin-left: auto; color: var(--bone-faint); white-space: nowrap; }
  .cam :global(.cam__sliders) { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.3rem 1rem; }
  .cam :global(.cam__s) { display: grid; grid-template-columns: 3.2rem 1fr 4.4rem; gap: 0.5rem; align-items: center; }
  .cam :global(.cam__s label) { text-transform: uppercase; color: var(--bone-faint); }
  .cam :global(.cam__s input[type="range"]) { width: 100%; accent-color: var(--plasma); margin: 0; }
  .cam :global(.cam__s input[type="number"]) {
    font: inherit;
    color: var(--bone);
    background: rgba(232, 224, 208, 0.06);
    border: 1px solid rgba(232, 224, 208, 0.18);
    border-radius: var(--radius-sm);
    padding: 0.15rem 0.3rem;
    width: 100%;
  }
  .cam :global(textarea) {
    font: inherit;
    font-size: 0.625rem;
    color: var(--bone-dim);
    background: rgba(232, 224, 208, 0.04);
    border: 1px solid rgba(232, 224, 208, 0.12);
    border-radius: var(--radius-sm);
    width: 100%;
    height: 4.4rem;
    resize: vertical;
    white-space: pre;
  }
  @media (max-width: 900px) { .cam :global(.cam__sliders) { grid-template-columns: 1fr; } }

  /* ---- the bar as a drawer ---------------------------------------------------------- */
  /* Away: the bar rides up out of the frame and leaves a lip the height of its bottom
     edge plus a few pixels, which is what the pointer catches. Hovering the lip (or
     tabbing into the bar) brings the whole bar back for as long as the pointer stays. */
  :global(.navbar) {
