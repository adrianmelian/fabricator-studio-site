---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FieldLabel from '../../components/FieldLabel.astro';
import Footer from '../../components/Footer.astro';
import NavBar from '../../components/NavBar.astro';
import ContactForm from '../../components/ContactForm.astro';

const values = [
  {
    name: 'Transparency',
    body: 'Every engagement starts as a written proposal. You see the plan, the code, and the reasoning before anything touches your pipeline. No black boxes.',
  },
  {
    name: 'No lock-in',
    body: 'Open source, pure Python, no DRM and no license checks. Read it, change it, maintain it yourself. You are never renting access to something you cannot open.',
  },
  {
    name: 'Agile and versatile',
    body: 'No two productions are the same, so Fabricator is built to be extended and customized. It bends to your pipeline instead of making you bend to it.',
  },
  {
    name: 'Knowledge transfer',
    body: 'I document what I build and leave your team able to run it without me. The point is your independence, not a retainer you cannot get out of.',
  },
  {
    name: 'Production quality',
    body: 'Industry standard tools that come with 14 years experience building pipelines for AAA games.',
  },
];

const help = [
  {
    name: 'Rig and export setup',
    body: 'Characters rigged with Fabricator and wired clean into your Maya-to-Unreal export contract. Scoped to your roster.',
  },
  {
    name: 'Custom tools',
    body: 'A Maya tool built to spec, documented, and handed over readable, so your team owns it long after I am gone.',
  },
  {
    name: 'Ongoing support',
    body: 'Retainers and fractional TA work, from a couple of days a month to owning a slice of your pipeline, at whatever cadence the production needs.',
  },
];
---
<BaseLayout
  title="Services | FabricatorStudio"
  description="Rigging and pipeline help from the technical artist behind Fabricator. Open, documented, and yours to keep. No black boxes, no lock-in."
>
  <NavBar />

  <section class="svc-hero">
    <FieldLabel text="Services" />
    <h1 class="vt">Custom pipelines you own.</h1>
    <p class="prose svc-hero__sub">The tools are free and open source. The work I take on for hire runs the same way: agile, readable, documented, and yours to keep. Every engagement is delivered by the technical artist who built Fabricator, not a team you have never met, and you are never dependent on me to keep moving.</p>
  </section>

  <section class="svc-values">
    <FieldLabel text="How I Work" />
    <div class="svc-grid">
      {values.map((v) => (
        <div class="svc-card">
          <h3>{v.name}</h3>
          <p>{v.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="svc-help">
    <FieldLabel text="Ways I Can Help" />
    <p class="prose svc-help__intro">Scope and pricing depend on your team, your characters, and your deadline, so everything is quoted after a short call. The usual starting point is an audit.</p>

    <div class="svc-lead">
      <h3>Pipeline Health Audit</h3>
      <p>About a week. I go through your rigs, skinning, export path, naming, and versioning, then hand you a findings document, a prioritized fix list, and a quote for the fixes. Sign a fix package within thirty days and the audit fee credits toward it in full, so the first step costs you almost nothing to try.</p>
    </div>

    <div class="svc-grid">
      {help.map((h) => (
        <div class="svc-card">
          <h3>{h.name}</h3>
          <p>{h.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="svc-process">
    <FieldLabel text="How It Works" />
    <ol class="svc-steps">
      <li>A short discovery call: your team, your characters, your pain points.</li>
      <li>A written scope with clear deliverables and a quote. Nothing starts until you have it in hand.</li>
      <li>Delivery in a focused burst, everything documented, readable, and handed over as yours.</li>
    </ol>
  </section>

  <section class="svc-cta">
    <FieldLabel text="Get In Touch" />
    <p class="prose">Tell me what is slowing your pipeline down. I will tell you honestly whether I am the right person to fix it, and what it would take.</p>
    <ContactForm />
    <p class="svc-cta__alt">Prefer email? <a href="mailto:adrian@fabricator.studio?subject=FabricatorStudio%20inquiry">adrian@fabricator.studio</a></p>
  </section>

  <Footer />
</BaseLayout>
<style>
  section { max-width: 60rem; }

  .svc-hero { text-align: center; }
  .svc-hero .vt { margin-top: 0.25rem; }
  .svc-hero__sub { margin: 1rem auto 0; }

  .svc-values, .svc-help, .svc-process { text-align: center; }
  .svc-values :global(.field-label),
  .svc-help :global(.field-label),
  .svc-process :global(.field-label) { margin-bottom: 1rem; }

  .svc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 0.75rem;
    margin-top: 1rem;
    text-align: left;
  }
  .svc-card {
    border: 1px solid var(--iron-2);
    border-radius: var(--radius);
    background: var(--iron);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .svc-card h3 { font-size: 1rem; color: var(--bone); }
  .svc-card p { color: var(--bone-dim); font-size: 0.9375rem; }

  .svc-help__intro { margin: 0 auto 1.5rem; }
  .svc-lead {
    max-width: 40rem;
    margin: 0 auto 0.75rem;
    text-align: left;
    border: 1px solid var(--iron-3);
    border-radius: var(--radius);
    background: var(--iron);
    padding: 1.5rem;
  }
  .svc-lead h3 { font-size: 1.0625rem; color: var(--ember); }
  .svc-lead p { color: var(--bone); font-size: 0.9375rem; margin-top: 0.5rem; }

  .svc-steps {
    max-width: var(--measure);
    margin: 1.5rem auto 0;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-left: 1.25rem;
    color: var(--bone-dim);
  }
  .svc-steps li { padding-left: 0.25rem; line-height: 1.5; }

  .svc-cta { text-align: center; }
  .svc-cta :global(.field-label) { margin-bottom: 1rem; }
  .svc-cta .prose { margin: 0 auto; }
  .svc-cta__alt {
    margin: 1.25rem auto 0;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--bone-dim);
  }
  .svc-cta__alt a { color: var(--plasma); text-decoration: none; }
  .svc-cta__alt a:hover { color: var(--plasma-dim); }
</style>
