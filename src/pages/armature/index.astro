---
// The Armature page, STRIPPED for the story-pass rebuild (Adrian, 2026-08-19): like the
// homepage's first pass, beats return one at a time from here. What survives the strip is
// his list -- the x-ray man landing shot, the FS+Armature lockup (centred now), the
// Download for Windows / Read the docs doors, and the reassure line -- plus the licence
// picker dialog those doors need (copy verbatim per COPY-LAUNCH.md, ruling 2026-07-28b)
// and the page's own footer (it carries the Kubold credit).
//
// EVERYTHING REMOVED IS IN GIT (this branch, commit 1320656 and earlier): the workflow
// stages, walkthroughs, verified panel, spine rail, reveals, teaser reel and its dialog.
// Copy law unchanged: wording comes from the depot task folders, layout bends around it.
//
// The act itself now lives in src/components/ArmatureAct.astro so the homepage can mount the
// same one after the tool wall wipe. This page is the route, the <head> and the chrome.
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArmatureAct from '../../components/ArmatureAct.astro';
import NavBar from '../../components/NavBar.astro';
import ScrollHint from '../../components/ScrollHint.astro';
import Wordmark from '../../components/Wordmark.astro';

const TITLE = 'Armature, by FabricatorStudio';
const DESCRIPTION =
  'Speed for the Devs. Depth for the Artists. AI rigging and skinning with tools to make production-ready rigs. Free for everyone.';
---
<BaseLayout title={TITLE} description={DESCRIPTION}>
  <NavBar />
  <ScrollHint />

  <main>
    <ArmatureAct />
  </main>

  <footer class="footer">
    <div class="footer__inner">
      {/* The signature treatment, not plain bold type (brand DNA section 4). */}
      <p class="footer__wordmark"><Wordmark /></p>
      <div class="footer__meta">
        <nav class="footer__links" aria-label="Footer">
          <a href="https://fabricator.studio">fabricator.studio</a>
          <a href="/privacy/">Privacy</a>
          <a href="/armature/eula/">EULA</a>
        </nav>
        {/* This page keeps its own footer so the Kubold credit ships here, where the
            animations actually play. */}
        <p class="footer__legal">&copy; 2026 FabricatorStudio LLC &middot; Animations by <a href="https://www.kubold.com" target="_blank" rel="noopener">Kubold</a></p>
      </div>
    </div>
  </footer>
</BaseLayout>

<style>
  /* The page keeps its own footer (it carries the Kubold credit), so it keeps the footer
     rules. They travelled with the act extraction on 2026-08-22 and came straight back:
     Astro scopes a style block to the component that owns the markup, so left in
     ArmatureAct they styled nothing at all. */
  .footer {
    position: relative;
    z-index: 2;
    padding: 34px var(--gutter) 44px var(--rail);
    border-top: 1px solid var(--iron-2);
  }
  .footer__inner {
    max-width: 1180px;
    margin: 0 auto;
    padding-left: 12px;
    display: grid;
    gap: 18px;
  }
  .footer__wordmark {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.01em;
  }
  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    font-size: 13px;
  }
  .footer__links a {
    color: var(--bone);
    text-underline-offset: 4px;
  }
  .footer__links a:hover {
    color: var(--bone);
  }
  .footer__legal {
    font-size: 12px;
    color: var(--bone-faint);
  }
  .footer__legal a {
    color: var(--bone-faint);
    text-decoration: none;
    border-bottom: 1px solid var(--iron-3);
  }
  .footer__legal a:hover {
    color: var(--bone);
    border-color: var(--ember);
  }
    .footer__inner {
      grid-template-columns: auto 1fr;
      align-items: center;
      gap: 32px;
    }
    .footer__meta {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 26px;
      flex-wrap: wrap;
    }
</style>
