      });
      // Covers every close path: the button, the backdrop and Escape. The iframe is destroyed
      // rather than paused, because there is no way to pause someone else's player from here
      // and a hidden dialog would otherwise keep talking.
      teaserDialog.addEventListener('close', function () {
        var frame = trailerMount.querySelector('iframe');
        if (frame) frame.remove();
        if (loop && !reduced.matches) loop.play();
      });
    }
  })();
</script>

<style>
  .shell {
    --rail: 30px;
    --gutter: 20px;
    --col: 34em;
    position: relative;
  }

  .skip-link {
    position: absolute;
