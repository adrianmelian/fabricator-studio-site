  /* ---------- the spine ---------- */

  /* The sections stay full bleed, but their inner column is capped and centred. Past about
     1330px the spine would otherwise be stranded against the viewport edge with a growing void
     between it and the copy it is supposed to be the skeleton of, so it tracks the same
     centring. Below that width the max() resolves to 0 and nothing moves. */
  .spine {
    position: absolute;
    top: 0;
    left: max(0px, calc((100vw - var(--rail) - var(--gutter) - 1180px) / 2));
    width: var(--rail);
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  .spine__track,
  .spine__draw {
    position: absolute;
    left: 50%;
    top: 0;
