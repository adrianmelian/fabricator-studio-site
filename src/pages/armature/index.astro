---
// The Armature page, STRIPPED for the story-pass rebuild (Adrian, 2026-08-19): like the
// homepage's first pass, beats return one at a time from here. What survives the strip is
// his list -- the x-ray man landing shot, the FS+Armature lockup (centred now), the
// Download for Windows / Read the docs doors, and the reassure line -- plus the licence
// picker dialog those doors need (copy verbatim per COPY-LAUNCH.md, ruling 2026-07-28b)
// and the page's own footer (it carries the Kubold credit).
//
// EVERYTHING REMOVED IS IN GIT (this branch, commit 1320656 and earlier): the workflow
// stages, walkthroughs, verified panel, spine rail, reveals, teaser reel and its dialog.
// Copy law unchanged: wording comes from the depot task folders, layout bends around it.
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArmatureStage from '../../components/ArmatureStage.astro';
import NavBar from '../../components/NavBar.astro';
import Wordmark from '../../components/Wordmark.astro';
import { Image, getImage } from 'astro:assets';

import fsMark from '../../assets/armature/fs-mark.png';
import stageFit from '../../assets/armature/stage-fit.png';
import stageSkeleton from '../../assets/armature/stage-skeleton.png';
import stageSkin from '../../assets/armature/stage-skin.png';
import heroProduct from '../../assets/armature/hero-product.png';
// The phone's backdrop is the DESKTOP LANDING SHOT itself, captured off the live
// WebGL stage at scroll 0 with every DOM layer hidden (Adrian, 2026-08-13). The
// marketing plate above carries its own burned-in lockup, which fights the h1 at
// phone widths; this one is the room the cinematic actually opens in.
import heroLandingPortrait from '../../assets/armature/hero-landing-portrait.png';

import { ARMATURE, PICKER_ROWS, INSTALLER_NAME } from '../../data/armature';
import { ARMATURE_TUTORIALS as WALKTHROUGHS } from '../../data/tutorials';

const heroPortraitSrc = (await getImage({ src: heroLandingPortrait, format: 'webp', width: 1170 })).src;

const TITLE = 'Armature, by FabricatorStudio';
const DESCRIPTION =
  'Speed for the Devs. Depth for the Artists. AI rigging and skinning with tools to make production-ready rigs. Free for indies.';
---
<BaseLayout title={TITLE} description={DESCRIPTION}>
  <NavBar />

  <main>
    {/* THE RUNWAY (Adrian, 2026-08-19): the creation story's scroll. It only grows to
        cinematic length when the stage goes live; the fallback keeps a one-screen page. */}
    <div class="ast-scroll" data-ast-scroll>
    <header class="ast-hero hero--art">
      {/* The static art is the FALLBACK: under 900px, reduced motion, or no WebGL2 the
          stage never goes live and this stays the backdrop. */}
      <picture>
        <source media="(max-width: 900px)" srcset={heroPortraitSrc} />
        <Image
          class="hero__art"
          src={heroProduct}
          {/* Decorative, and it has to be: <picture> serves a different image under
              900px (the landing plate, not the samurai) and alt cannot vary per
              source, so a description of one would lie about the other. It is a backdrop
              behind the h1 that says the same thing in text, and on desktop it is
              hidden outright the moment the live stage takes over. */}
          alt=""
          widths={[1280, 1920, 2560]}
          sizes="100vw"
          loading="eager"
        />
      </picture>
      <div class="hero__scrim" aria-hidden="true"></div>

      {/* THE LANDING SHOT: the homepage's post-scan frame, the height man solid in the
          x-ray fresnel, standing in the starred room. Elastic orbit on drag. */}
      <ArmatureStage />

      {/* The left column (Adrian, 2026-08-19): the lockup off to the left with his three
          ruled lines under it. The man holds the centre. A fourth line is HELD pending his
          call on its register. */}
      <div class="ast-hero__intro">
        {/* The colourful Armature wordmark is retired (Adrian, 2026-08-19: phasing it
            out); the mark stays and the title carries the name in type. The title is the
            page's real h1 now that it is visible. */}
        <div class="ast-hero__lockup" aria-hidden="true">
          <Image class="ast-hero__lockup-mark" src={fsMark} alt="" widths={[120, 240, 338]} sizes="8vw" />
        </div>
        <h1 class="ast-hero__tagline"><span class="ast-ember">Armature:</span> Rigging &amp; Skinning Re&#8209;imagined.</h1>
        <p class="ast-hero__line">Generative joint placement and skin binding.</p>
        <p class="ast-hero__line"><span class="ast-hero__plus">+</span> Artist-friendly tools for production quality refinement.</p>
      </div>

      <div class="ast-hero__actions">
        <div class="getblock__actions">
          <button class="btn getblock__btn" type="button" data-picker-open data-goatcounter-click="armature-picker-open">
            Download for Windows
          </button>
          <a class="btn btn--quiet" href="/docs/armature/" data-goatcounter-click="armature-docs-from-hero">
            Read the docs
          </a>
        </div>
        <p class="reassure">Free for indies. <a href="/privacy/">Privacy</a> &middot; <a href="/armature/eula/">EULA</a>.</p>
        {/* The dialog needs script to open; without it the same rows render as links. */}
        <noscript>
          <ul class="picker__rows picker__rows--inline">
            {PICKER_ROWS.map((row) => (
              <li class="picker__row">
                <div class="picker__copy">
                  <p class="picker__name"><b>{row.name}.</b> <span class="picker__price">{row.price}.</span></p>
                  <p class="picker__line">{row.line}</p>
                </div>
                {row.cta === 'download' ? (
                  <a class="btn picker__cta" href={ARMATURE.installer} data-goatcounter-click={row.event}>Download</a>
                ) : ARMATURE.stripeCommercial ? (
                  <a class="btn picker__cta" href={ARMATURE.stripeCommercial} data-goatcounter-click={row.event}>Continue to checkout</a>
                ) : (
                  <button class="btn picker__cta" type="button" disabled>Continue to checkout</button>
                )}
              </li>
            ))}
          </ul>
        </noscript>
      </div>

      {/* THE STORY'S COPY BEATS -- DRAFT except the stage names (Adrian's, 2026-08-19).
          The app's stages, told on the left flank: Fitting Room / Skeleton / Skinning /
          alive. One cell, crossfading with their scenes. */}
      <div class="ast-beats">
        <div class="ast-beat" style="opacity: var(--ab1, 0)">
          <p class="ast-beat__head"><span class="ast-ember">Fitting</span> Room</p>
          <p class="ast-beat__line">Fit your character to size so symmetry and placement behave.</p>
          <Image class="ast-beat__img" src={stageFit} alt="" widths={[420, 840]} sizes="26vw" />
        </div>
        <div class="ast-beat" style="opacity: var(--ab2, 0)">
          <p class="ast-beat__head"><span class="ast-ember">Generative</span> Skeleton Placement</p>
          <p class="ast-beat__line">Auto fit the joints to your model, automatically named and oriented correctly.</p>
          <Image class="ast-beat__img" src={stageSkeleton} alt="" widths={[420, 840]} sizes="26vw" />
        </div>
        <div class="ast-beat" style="opacity: var(--ab3, 0)">
          <p class="ast-beat__head"><span class="ast-ember">Generative</span> Skin Binding</p>
          <p class="ast-beat__line">Machine learned skinning binds any type of mesh.</p>
          <Image class="ast-beat__img" src={stageSkin} alt="" widths={[420, 840]} sizes="26vw" />
        </div>
        <div class="ast-beat" style="opacity: var(--ab4, 0)">
          <p class="ast-beat__head"><span class="ast-ember">Animation</span> Ready in Minutes</p>
          <p class="ast-beat__line">Go directly to Unreal or Maya for auto Fabricator Control Rig builds.</p>
        </div>
      </div>

      {/* THE REELS (Adrian, 2026-08-19): the live page's three walkthroughs -- three
          characters, start to finish -- as a textless strip riding up past the right
          side. Thumbnails are self-hosted stills and each card is click-to-YouTube: the
          privacy ruling (nothing reaches Google without a click) forbids autoplaying
          embeds, and no local files of these videos exist. */}
      {/* WHAT IT COSTS -- the live page's ruled pricing copy, verbatim. */}
      <div class="ast-price" data-ast-price>
        <p class="ast-beat__head"><span class="ast-ember">What</span> it costs.</p>
        <p class="ast-price__lede">
          Free for personal, learning, and portfolio work, and free for commercial work under
          $100k a year. If you qualify for Maya Indie, Armature is free. Above that it is <b>$149 per artist, once</b>, with a year of updates.
        </p>
        <p class="ast-price__note">
          Armature is a new standalone application. It is not the Armature step inside the Maya
          toolset, and it is not part of that free download.
        </p>
        <p class="ast-price__contact">
          Bringing an existing rig into Armature? <a href="mailto:adrian@fabricator.studio?subject=Armature%3A%20existing%20rig">Talk to us</a>.
        </p>
      </div>

      {/* The strip's standing title, BEHIND the cards: the first video wipes it as it
          passes, and the fade below matches that moment. */}
      <p class="ast-reels__title"><span class="ast-ember">Tutorial</span> Video<br />Series</p>

      <div class="ast-reels" data-ast-reels>
        <div class="ast-reels__strip">
          {WALKTHROUGHS.map((w) => (
            <a class="ast-reel" href={w.href} target="_blank" rel="noopener" aria-label={w.title}>
              <img src={w.thumb} alt="" loading="lazy" />
              <span class="ast-reel__play" aria-hidden="true">&#9654;</span>
            </a>
          ))}
        </div>
      </div>

      {/* THE CLOSE: the same doors as the landing. A reader who got this far without
          downloading is exactly the one who wanted to read first. */}
      <div class="ast-end" data-ast-end>
        <div class="getblock__actions">
          <button class="btn getblock__btn" type="button" data-picker-open data-goatcounter-click="armature-picker-open">
            Download for Windows
          </button>
          <a class="btn btn--quiet" href="/docs/armature/" data-goatcounter-click="armature-docs-from-close">
            Read the docs
          </a>
        </div>
        <p class="reassure">Free for indies. <a href="/privacy/">Privacy</a> &middot; <a href="/armature/eula/">EULA</a>.</p>
      </div>
    </header>
    </div>

    {/* The licence picker (COPY-LAUNCH.md §2, verbatim; ruling 2026-07-28b). Download opens
        this rather than downloading. Eligibility leads, price follows: a user reading these
        cannot pick wrongly by accident. Rows are data-driven from src/data/armature.ts so
        the education grant lands as a third row without touching this markup. The selection
        here is a default; the installer's click-through selection is the operative one
        (EULA §3.4). */}
    <dialog class="shot-dialog picker" id="picker-dialog" aria-labelledby="picker-title">
      <div class="picker__inner">
        <p class="picker__head" id="picker-title">Download Armature {ARMATURE.version}</p>
        {/* R19: the refund line does its job by reducing hesitation AT the checkout, so it
            sits inside the picker, above the Commercial button, rather than only on the
            pricing page a buyer may never revisit. */}
        <p class="picker__refund">Fourteen days, no questions. If Armature is not what you needed, email us within fourteen days of buying and we will refund you.</p>
        <ul class="picker__rows">
          {PICKER_ROWS.map((row) => (
            <li class="picker__row">
              <div class="picker__copy">
                <p class="picker__name">
                  <b>{row.name}.</b> <span class="picker__price">{row.price}.</span>
                </p>
                <p class="picker__line">{row.line}</p>
              </div>
              {row.cta === 'download' ? (
                <a class="btn picker__cta" href={ARMATURE.installer} data-goatcounter-click={row.event}>Download</a>
              ) : ARMATURE.stripeCommercial ? (
                <a class="btn picker__cta" href={ARMATURE.stripeCommercial} data-goatcounter-click={row.event}>Continue to checkout</a>
              ) : (
                <button class="btn picker__cta" type="button" disabled>Continue to checkout</button>
              )}
            </li>
          ))}
        </ul>
        {/* The SmartScreen pre-empt, at the point of download (Adrian, 2026-08-01 evening).
            The person reading this just pressed Download, so it carries only the two things
            they need: the click path past the warning, and the hash to verify against. */}
        <aside class="smartscreen smartscreen--picker" aria-labelledby="smartscreen-title">
          <h3 class="smartscreen__title" id="smartscreen-title">Windows will warn you the first time you run this</h3>
          <p>
            Armature is a new installer from a new publisher, so Windows SmartScreen shows a
            blue "Windows protected your PC" screen the first time you open it. Click <b>More info</b>, then <b>Run anyway</b>.
          </p>
          <pre class="smartscreen__code"><code>Get-FileHash .\{INSTALLER_NAME} -Algorithm SHA256</code></pre>
          {ARMATURE.sha256 ? (
            <p class="smartscreen__hash">SHA-256: <code>{ARMATURE.sha256}</code></p>
          ) : (
            <p class="smartscreen__hash">SHA-256: <code>published at release</code></p>
          )}
        </aside>
        <button class="shot-dialog__close" type="button" data-shot-close aria-label="Close">
          <span aria-hidden="true">✕</span>
        </button>
      </div>
    </dialog>
  </main>

  <footer class="footer">
    <div class="footer__inner">
      {/* The signature treatment, not plain bold type (brand DNA section 4). */}
      <p class="footer__wordmark"><Wordmark /></p>
      <div class="footer__meta">
        <nav class="footer__links" aria-label="Footer">
          <a href="https://fabricator.studio">fabricator.studio</a>
          <a href="/privacy/">Privacy</a>
          <a href="/armature/eula/">EULA</a>
        </nav>
        {/* This page keeps its own footer so the Kubold credit ships here, where the
            animations actually play. */}
        <p class="footer__legal">&copy; 2026 FabricatorStudio LLC &middot; Animations by <a href="https://www.kubold.com" target="_blank" rel="noopener">Kubold</a></p>
      </div>
    </div>
  </footer>
</BaseLayout>

<script is:inline>
  (function () {
    // The licence picker. Download opens the picker rather than downloading. With JS
    // disabled the dialog cannot open, so the hero carries a <noscript> fallback rendering
    // the same rows as plain links.
    function wireDialog(dlg) {
      if (!dlg) return;
      dlg.addEventListener('click', function (e) {
        if (e.target === dlg) dlg.close();
      });
      dlg.querySelectorAll('[data-shot-close]').forEach(function (b) {
        b.addEventListener('click', function () {
          dlg.close();
        });
      });
    }
    var pickerDialog = document.getElementById('picker-dialog');
    wireDialog(pickerDialog);
    document.querySelectorAll('[data-picker-open]').forEach(function (trigger) {
      trigger.addEventListener('click', function () {
        if (pickerDialog && pickerDialog.showModal) pickerDialog.showModal();
      });
    });
  })();
</script>

<style>
  /* ---- the stripped hero: one fullscreen stage, everything positioned against it ---- */
  .ast-hero {
    position: relative;
    min-height: calc(100svh - var(--header-h));
    overflow: hidden;
    border-bottom: 1px solid var(--iron-2);
  }
  .ast-hero :global(.hero__art) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(11, 14, 16, 0.82) 0%, rgba(11, 14, 16, 0.45) 22%, rgba(11, 14, 16, 0) 42%),
      linear-gradient(0deg, rgba(11, 14, 16, 0.8) 0%, rgba(11, 14, 16, 0) 30%);
  }
  /* The live stage replaces the art as backdrop; visibility, not display, so nothing
     reflows when it goes live. */
  .ast-hero[data-stage-live] :global(.hero__art),
  .ast-hero[data-stage-live] .hero__scrim { visibility: hidden; }

  /* The runway: one screen on the fallback; the story's length when the stage is live.
     The hero rides it sticky, so the room never leaves while the beats play. */
  .ast-scroll { position: relative; }
  .ast-scroll[data-live] { height: 880svh; }
  .ast-scroll[data-live] .ast-hero {
    position: sticky;
    top: var(--header-h);
    height: calc(100svh - var(--header-h));
  }

  /* The landing copy leaves as the story starts; visibility follows so the faded doors
     cannot be clicked (pointer-events on a parent loses to a child's explicit value). */
  .ast-hero__intro,
  .ast-hero__actions {
    opacity: calc(1 - var(--aland, 0));
    transform: translateY(calc(var(--aland, 0) * -18px));
  }
  .ast-hero[data-land-gone] .ast-hero__intro,
  .ast-hero[data-land-gone] .ast-hero__actions { visibility: hidden; }

  /* The copy beats: the LEFT FLANK the landing stanza vacates (Adrian, 2026-08-19),
     stage-header over line, one grid cell, crossfading on their vars. */
  .ast-beats {
    position: absolute;
    left: 8vw;
    top: 16%;
    width: min(34rem, 36vw);
    display: none;
    pointer-events: none;
    text-shadow: 0 1px 3px rgba(11, 14, 16, 0.65);
  }
  .ast-hero[data-stage-live] .ast-beats { display: grid; }
  .ast-beat {
    grid-area: 1 / 1;
    align-self: start;
  }
  .ast-beat__head {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.2rem, 3.2vw, 3.4rem);
    line-height: 1.05;
    color: var(--bone);
  }
  /* Every title speaks in bone with its FIRST WORD in ember (Adrian, 2026-08-19). */
  .ast-ember { color: var(--ember); }

  /* The reels' standing title, over the passing strip. Driven by --reelt from the loop. */
  .ast-reels__title {
    position: absolute;
    top: 9%;
    right: 8vw;
    text-align: right;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.4rem, 3.6vw, 3.8rem);
    line-height: 1.05;
    color: var(--bone);
    opacity: var(--reelt, 0);
    pointer-events: none;
    text-shadow: 0 1px 3px rgba(11, 14, 16, 0.65);
    display: none;
  }
  .ast-hero[data-stage-live] .ast-reels__title { display: block; }
  .ast-beat__line {
    margin-top: 0.8rem;
    font-weight: 300;
    font-size: clamp(1.15rem, 1.7vw, 1.6rem);
    line-height: 1.35;
    color: var(--bone);
  }
  .ast-beats :global(.ast-beat__img) {
    margin-top: 1.4rem;
    width: min(34rem, 36vw);
    height: auto;
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--iron-2);
  }

  /* THE REELS: a textless strip in the right column, translated past the viewport by
     --reel from the loop. Cards take clicks (out to YouTube); the layer does not. */
  .ast-reels {
    position: absolute;
    right: 7vw;
    top: 0;
    bottom: 0;
    width: min(30rem, 34vw);
    overflow: hidden;
    pointer-events: none;
    visibility: hidden;
  }
  .ast-reels[data-active] { visibility: visible; }
  .ast-reels__strip {
    display: flex;
    flex-direction: column;
    gap: 3.5vh;
    transform: translateY(calc(102vh - var(--reel, 0) * 215vh));
    will-change: transform;
  }
  .ast-reel {
    position: relative;
    display: block;
    pointer-events: auto;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--iron-2);
    box-shadow: var(--shadow-lg);
  }
  .ast-reel img { display: block; width: 100%; height: auto; }
  .ast-reel__play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.2rem;
    color: var(--bone);
    text-shadow: 0 2px 10px rgba(11, 14, 16, 0.8);
    opacity: 0.85;
  }
  .ast-reel:hover .ast-reel__play { color: var(--plasma); }

  /* WHAT IT COSTS + THE CLOSE: the right column she faces from screen left. */
  .ast-price,
  .ast-end {
    position: absolute;
    left: 48%;
    right: 7vw;
    pointer-events: none;
    visibility: hidden;
    text-shadow: 0 1px 3px rgba(11, 14, 16, 0.65);
  }
  .ast-price { top: 22%; opacity: var(--price, 0); }
  .ast-end { top: 66%; opacity: var(--endd, 0); }
  .ast-price[data-active],
  .ast-end[data-active] { visibility: visible; }
  .ast-price[data-active] a,
  .ast-end[data-active] :is(a, button) { pointer-events: auto; }
  .ast-price__lede {
    margin-top: 1.2rem;
    font-weight: 300;
    font-size: clamp(1.15rem, 1.6vw, 1.5rem);
    line-height: 1.45;
    color: var(--bone);
  }
  .ast-price__lede b { font-weight: 700; color: var(--bone); }
  .ast-price__note {
    margin-top: 1rem;
    font-weight: 300;
    font-size: clamp(0.95rem, 1.2vw, 1.1rem);
    line-height: 1.5;
    color: var(--bone-dim);
  }
  .ast-price__contact {
    margin-top: 1rem;
    font-weight: 300;
    font-size: clamp(0.95rem, 1.2vw, 1.1rem);
    color: var(--bone-dim);
  }
  .ast-price__contact a { color: var(--plasma); text-decoration: none; }
  .ast-price__contact a:hover { color: var(--plasma-dim); }

  /* The left column: lockup, then the three ruled lines. It rides the left flank the old
     hero's lede lived on, so the fallback art's scrim already guarantees its contrast. */
  .ast-hero__intro {
    position: absolute;
    left: 8vw;
    top: 24%;
    max-width: min(44rem, 42vw);
  }
  .ast-hero__lockup {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
  }
  .ast-hero__lockup :global(.ast-hero__lockup-mark) {
    width: clamp(48px, 4vw, 72px);
    height: auto;
  }
  .ast-hero__tagline {
    margin-top: 1.6rem;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.2rem, 3.4vw, 3.6rem);
    line-height: 1.05;
    color: var(--bone);
  }
  .ast-hero__line {
    margin-top: 0.4rem;
    font-weight: 300;
    font-size: clamp(1.15rem, 1.7vw, 1.6rem);
    line-height: 1.3;
    color: var(--bone);
  }
  /* The first line clears the title a touch more than the lines clear each other. */
  .ast-hero__tagline + .ast-hero__line { margin-top: 0.9rem; }
  .ast-hero__plus { color: var(--plasma); font-weight: 700; }

  .ast-hero__actions {
    position: absolute;
    left: 50%;
    bottom: 9%;
    transform: translateX(-50%);
    text-align: center;
  }

  .shot-dialog {
    /* base.css sets a global `* { margin: 0 }`, which wipes the UA stylesheet's `margin: auto`
       on <dialog> and drops every modal into the top left corner. Put it back. */
    margin: auto;
    padding: 0;
    border: 0;
    background: none;
    max-width: 96vw;
    max-height: 95vh;
    overflow: visible;
    color: var(--bone);
  }
  .shot-dialog::backdrop {
    background: rgba(0, 0, 0, 0.84);
  }
  .shot-dialog__inner {
    position: relative;
    border-radius: var(--radius);
    border: 1px solid var(--iron-3);
    background: var(--iron);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    line-height: 0;
  }
  .shot-dialog video {
    display: block;
    width: auto;
    height: auto;
    max-width: 94vw;
    max-height: 88vh;
    object-fit: contain;
  }
  .shot-dialog--video .shot-dialog__inner {
    width: min(94vw, 1400px);
    aspect-ratio: 16 / 9;
    max-height: 88vh;
  }
  .shot-dialog--video :global(.trailer-frame) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .shot-dialog__tag {
    pointer-events: none;
  }
  .shot-dialog__close {
