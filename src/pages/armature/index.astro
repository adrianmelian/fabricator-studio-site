---
// The Armature product landing page (2026-07-28). Lives at /armature, which is the URL the
// vertical teaser ends on.
//
// SOURCE OF TRUTH for every copy block: MrMiata workspace/2026-07-28_armature-landing/
// PROMPT-CLAUDE-DESIGN.md. That file carries Adrian's approved wording and the copy law that
// goes with it: the layout bends around the copy, never the other way. Edit there first.
//
// THE NAVBAR IS ON THIS PAGE (Adrian, 2026-07-28), reversing the chromeless build. The
// argument for leaving it off was that a visitor arriving cold from a 15 second video gets
// eight ways to leave before learning what the product is. The argument that won: someone who
// lands here from a video and DOES want the rest of the studio should not have to guess, and
// this page is now linked from the homepage, so it is part of the site rather than a detached
// landing page.
//
// THE EMAIL FORM IS NOT LIVE UNTIL ML_ACTION BELOW IS FILLED IN. See the note on it.
//
// COPY REVISIONS since the design prompt are listed in that task folder's PORT.md. The prompt
// is the original brief; PORT.md is what actually shipped.
import BaseLayout from '../../layouts/BaseLayout.astro';
import NavBar from '../../components/NavBar.astro';
import Wordmark from '../../components/Wordmark.astro';
import { Image } from 'astro:assets';

// The [FS monogram] + [ToolName] lockup (DNA principle 7), source Icons/fs_armature.png in
// the FabricatorStudio repo. Supersedes the bare Armature wordmark used earlier.
import wordmark from '../../assets/armature/armature-lockup.png';
import stageLoad from '../../assets/armature/stage-load.png';
import stageFit from '../../assets/armature/stage-fit.png';
import stageSkeleton from '../../assets/armature/stage-skeleton.png';
import stageSkin from '../../assets/armature/stage-skin.png';
import stageExport from '../../assets/armature/stage-export.png';
import proofUnreal from '../../assets/armature/proof-unreal.png';
import portrait from '../../assets/about/adrian.png';

// LAUNCH BLOCK (2026-08-03, R10). The early-access MailerLite signup is retired: the product
// is out, so both signup instruments became download instruments. The launch config (update
// feed, installer URL, SHA-256, the LIVE Stripe link) lives in src/data/armature.ts; the
// picker rows are data-driven there so the education grant lands as a third row without a
// page rewrite. Picker and SmartScreen copy: MrMiata
// workspace/2026-07-30_armature-launch-dispatch/COPY-LAUNCH.md, shipped verbatim.
import { ARMATURE, PICKER_ROWS, INSTALLER_NAME } from '../../data/armature';

const TITLE = 'Armature, by FabricatorStudio';
// Tracks the hero sentence. The old description quoted copy that is no longer on the page.
const DESCRIPTION =
  'High end character rigging has always lived inside expensive applications. Armature is for the indie dev who cannot justify one, and the veteran rigger who wants to move faster.';

// Seven sections, so eight joints (one per boundary, plus the closing one) and seven bones.
const SPINE_JOINTS = 8;
const SPINE_BONES = 7;

const STAGES = [
  {
    key: 'load',
    label: 'LOAD',
    // R14 version A (2026-07-30): USD import is NOT in the shipping build, and the LOAD
    // screenshot's drop target (OBJ, FBX, GLB, glTF) is the half telling the truth. Switch to
    // R14 version B ONLY if USD import lands by t01, confirmed at the Aug 2 dress rehearsal,
    // never guessed forward.
    text: 'Drop in your character. Armature reads OBJ, FBX, GLB and glTF, and everything leaves as USD.',
    img: stageLoad,
    alt: 'The Armature start screen, with recent characters and a drop target for a character mesh',
  },
  {
    key: 'fit',
    label: 'FIT',
    text: 'Orient and size the character so symmetry and placement behave.',
    img: stageFit,
    alt: 'The Fitting Room in Armature, sizing a samurai character against a height reference',
  },
  {
    key: 'skeleton',
    label: 'SKELETON',
    // "creature" cut 2026-07-28 (Adrian): the module library ships Biped, Quadruped, Root and
    // Prop, so the screenshot beside this line contradicted the word.
    text: 'Start from a biped, quadruped, or prop template, or build from nothing. Live symmetry, limb duplication, chain editing, and a finger count you state instead of the machine guessing.',
    img: stageSkeleton,
    alt: 'The Skeleton stage in Armature, with a joint chain placed through a samurai character and the module library open',
  },
  {
    key: 'skin',
    label: 'SKIN',
    text: 'Weights generated locally on your own GPU, and a full painting suite with layers and non-destructive passes for when you want to fix them by hand.',
    img: stageSkin,
    alt: 'The Skin stage in Armature, showing generated weights on a samurai character with the influence list and weight brush',
  },
  {
    key: 'export',
    label: 'EXPORT',
    text: 'One USD file carrying mesh, skeleton, orientations, and weights together.',
    img: stageExport,
    alt: 'The Export panel in Armature, writing a single USD file for a samurai character',
  },
];
---

<BaseLayout title={TITLE} description={DESCRIPTION}>
  <a class="skip-link" href="#main">Skip to content</a>

  <NavBar />

  {/* Marks the document as scripted BEFORE first paint. Every scroll reveal starts at
      opacity 0 and is switched on by IntersectionObserver, so without this flag a reader with
      JS disabled gets a hero and six blank screens. Gated in CSS on html.js. */}
  <script is:inline>
    document.documentElement.classList.add('js');
  </script>

  <div class="shell">
    {/* The page skeleton: one continuous cobalt line, a joint at every section boundary. It is
        drawn in markup rather than built by script so it still renders with JS disabled, and so
        Astro's scoped styles reach it. */}
    <div class="spine" id="spine" aria-hidden="true">
      <div class="spine__track"></div>
      <div class="spine__draw" id="spine-draw"></div>
      {Array.from({ length: SPINE_BONES }).map(() => <span class="bone"></span>)}
      {Array.from({ length: SPINE_JOINTS }).map(() => <span class="joint"></span>)}
    </div>

    <main id="main">
      {/* 1. HERO */}
      <header class="section hero" data-spine-section>
        <div class="wrap hero__inner">
          <div class="hero__lead">
            <Image
              class="hero__wordmark reveal r1"
              src={wordmark}
              alt="Armature"
              widths={[360, 720]}
              sizes="(min-width: 720px) 300px, 230px"
              loading="eager"
            />

            <p class="hero__kicker reveal r2">ARMATURE, by <b>FabricatorStudio</b></p>

            {/* The headline and the paragraph under it are ONE sentence, split across two type
                sizes. No full stop on the h1, and the paragraph opens lowercase on purpose.
                Keep them visually adjacent or the device stops reading as a sentence. */}
            <h1 class="hero__title reveal r3">High End Character Rigging</h1>

            <div class="hero__copy reveal r4">
              <p>
                has always lived inside expensive applications. Armature is for the indie dev who
                cannot justify one, and the veteran rigger who wants to move faster.
              </p>
            </div>

            <p class="hero__status reveal r5">
              {/* "Early Access" is retired from public surfaces (Adrian, 2026-07-30). */}
              <span class="pill"><span class="pill__dot"></span>Out now &middot; {ARMATURE.version}</span>
            </p>

            <div class="getblock reveal r6">
              <button class="btn getblock__btn" type="button" data-picker-open data-goatcounter-click="armature-picker-open">
                Download for Windows
              </button>
              <p class="reassure">Free for indies. <a href="/privacy/">Privacy</a> &middot; <a href="/armature/eula/">EULA</a>.</p>

              {/* The dialog needs script to open; without it the same rows render as links. */}
              <noscript>
                <ul class="picker__rows picker__rows--inline">
                  {PICKER_ROWS.map((row) => (
                    <li class="picker__row">
                      <div class="picker__copy">
                        <p class="picker__name"><b>{row.name}.</b> <span class="picker__price">{row.price}.</span></p>
                        <p class="picker__line">{row.line}</p>
                      </div>
                      {row.cta === 'download' ? (
                        <a class="btn picker__cta" href={ARMATURE.installer} data-goatcounter-click={row.event}>Download</a>
                      ) : ARMATURE.stripeCommercial ? (
                        <a class="btn picker__cta" href={ARMATURE.stripeCommercial} data-goatcounter-click={row.event}>Continue to checkout</a>
                      ) : (
                        <button class="btn picker__cta" type="button" disabled>Continue to checkout</button>
                      )}
                    </li>
                  ))}
                </ul>
              </noscript>

              {/* The SmartScreen pre-empt (COPY-LAUNCH.md §1, verbatim). Beside the download,
                  above the fold, BEFORE the click: the warning is what a first-time visitor
                  sees, and an unexplained one reads as malware. More load-bearing than the
                  certificate itself. */}
              <aside class="smartscreen" aria-labelledby="smartscreen-title">
                <h3 class="smartscreen__title" id="smartscreen-title">Windows will warn you the first time you run this</h3>
                {/* "Click <b>" stays on ONE line: Astro trims the whitespace before an inline
                    tag at the start of a wrapped line and welds the word to the tag. */}
                <p>
                  Armature is a new installer from a new publisher, so Windows SmartScreen shows a
                  blue "Windows protected your PC" screen the first time you open it. Click <b>More info</b>, then <b>Run anyway</b>.
                </p>
                <p>
                  SmartScreen is rating the installer's reputation. It trusts files that have been
                  downloaded many times, or signed with a certificate that has already built up
                  history. This one is new on both counts. An EV code signing certificate is on the
                  way. Until it lands, this is what a brand new installer looks like on Windows.
                </p>
                <p>To check the file yourself, compare it against the SHA-256 published beside the download:</p>
                <pre class="smartscreen__code"><code>Get-FileHash .\{INSTALLER_NAME} -Algorithm SHA256</code></pre>
                {ARMATURE.sha256 ? (
                  <p class="smartscreen__hash">SHA-256: <code>{ARMATURE.sha256}</code></p>
                ) : (
                  <p class="smartscreen__hash">SHA-256: <code>published at release</code></p>
                )}
              </aside>
            </div>
          </div>

          {/* The inline loop is silent because every browser requires that of an autoplay video.
              The overlay button opens the same cut full size WITH sound. The button sits OVER
              the video rather than wrapping it, so no interactive element is nested in another. */}
          <figure class="slot hero__media reveal r7">
            <video
              id="teaser-loop"
              src="/armature/teaser.mp4"
              poster="/armature/teaser-poster.jpg"
              muted
              loop
              playsinline
              autoplay
              preload="metadata"
              aria-hidden="true"></video>
            <button class="shot-open shot-open--overlay" type="button" data-teaser-open aria-label="Watch the Armature trailer">
              <span class="shot-open__badge shot-open__badge--play" aria-hidden="true">▶</span>
            </button>
          </figure>
        </div>
      </header>

      {/* 2. THE WORKFLOW */}
      <section class="section workflow" data-spine-section aria-labelledby="workflow-title">
        <div class="wrap">
          <div class="workflow__head reveal">
            <p class="eyebrow">The workflow</p>
            <h2 class="section-title" id="workflow-title">Five stages, one app.</h2>
          </div>

          <ol class="stages">
            {
              STAGES.map((stage, i) => (
                <li class="stage" data-stage>
                  <div class="stage__rail" aria-hidden="true">
                    <span class="stage__joint"></span>
                    <span class="stage__bone"></span>
                  </div>
                  <div class="stage__body">
                    <p class="stage__index">{String(i + 1).padStart(2, '0')}</p>
                    <p class="stage__text">
                      <b>{stage.label}:</b> {stage.text}
                    </p>
                  </div>
                  <figure class="slot stage__shot">
                    <button
                      class="shot-open"
                      type="button"
                      data-shot={stage.key}
                      aria-label={`Enlarge the ${stage.label} screenshot`}
                    >
                      <Image src={stage.img} alt={stage.alt} widths={[640, 1280]} sizes="(min-width: 1100px) 40vw, 92vw" />
                      <span class="shot-open__badge" aria-hidden="true">+</span>
                    </button>
                    <figcaption class="slot__tag">{stage.label}</figcaption>
                  </figure>
                </li>
              ))
            }
          </ol>

          {/* At the size these sit on the page the panels are texture, not reading material, so
              each one opens full size. Native <dialog>: Escape, focus trapping and focus return
              are the platform's job rather than hand-rolled JS. The full-size Image is lazy and
              lives inside a CLOSED dialog, so nothing downloads until a reader opens one. */}
          {
            STAGES.map((stage) => (
              <dialog class="shot-dialog" id={`shot-${stage.key}`} aria-label={`${stage.label} stage, full size`}>
                <div class="shot-dialog__inner">
                  <Image src={stage.img} alt={stage.alt} widths={[1920]} sizes="94vw" loading="lazy" />
                  <p class="slot__tag shot-dialog__tag">{stage.label}</p>
                  <button class="shot-dialog__close" type="button" data-shot-close aria-label="Close">
                    <span aria-hidden="true">✕</span>
                  </button>
                </div>
              </dialog>
            ))
          }
        </div>
      </section>

      {/* 3. BUILT FOR PRODUCTION */}
      <section class="section status" data-spine-section aria-labelledby="status-title">
        <div class="wrap">
          <div class="reveal">
            <p class="eyebrow">Status</p>
            <h2 class="section-title" id="status-title">Built for Production</h2>
          </div>

          <div class="status__grid">
            <div class="status__panels">
              <div class="panel reveal">
                <p class="panel__head"><span class="pill"><span class="pill__dot"></span>Verified</span></p>
                <p class="panel__text">
                  The exported USD imports into both Unreal and Maya with joint orientations
                  intact. The Fabricator Maya and Unreal Control Rigs are built procedurally from
                  Armature's export data.
                </p>
              </div>
            </div>

            <figure class="slot status__proof reveal">
              <Image
                src={proofUnreal}
                alt="A samurai character exported from Armature, open in Unreal Engine on a Control Rig generated from its export data"
                widths={[640, 1280]}
                sizes="(min-width: 720px) 52vw, 92vw"
              />
              <figcaption class="slot__tag">PROOF</figcaption>
            </figure>
          </div>
        </div>
      </section>

      {/* 4. THE PILLAR */}
      <section class="section pillar" data-spine-section aria-labelledby="pillar-title">
        <div class="wrap">
          <h2 class="mantra" id="pillar-title">
            <span>Design the look.</span>
            <span>Design the motion.</span>
            <span>The pipeline does the rest.</span>
          </h2>

          <div class="pillar__copy reveal">
            <p>
              A character pipeline holds two acts of authorship. The look, which is concept. The
              motion, which is where the joints go. Everything after that is execution: weights,
              rig assembly, export, engine ingest.
            </p>
            <p>
              Where a joint sits decides how a character bends, where it creases, and what
              silhouettes it can reach. The industry files that under technical setup, which is why
              it is the step that gets rushed. Armature automates everything around it so you
              focus on the part that matters.
            </p>
          </div>

          <p class="pillar__note reveal">A skeleton is the blueprint of motion.</p>
        </div>
      </section>

      {/* 5. WHO BUILT IT */}
      <section class="section studio" data-spine-section aria-labelledby="studio-title">
        <div class="wrap">
          <div class="reveal">
            <p class="eyebrow">FabricatorStudio</p>
            <h2 class="section-title" id="studio-title">Who built it.</h2>
          </div>

          <div class="studio__grid">
            <figure class="slot studio__portrait reveal">
              <Image
                src={portrait}
                alt="Adrian Melian, the technical artist behind FabricatorStudio"
                widths={[400, 800]}
                sizes="(min-width: 720px) 34vw, 280px"
              />
            </figure>

            <div class="studio__copy reveal">
              <p>
                FabricatorStudio is a one-person technical art studio. I am a technical artist with
                fourteen years in the game industry. I joined Sledgehammer Games as a Senior
                Technical Artist on Call of Duty: Vanguard and was promoted to Lead for Modern
                Warfare III, where I led the Character Tech Art team and the Weapons Tech Art team.
                Before and after that, Camouflaj, Double Fine, Ubisoft, and NCSoft.
              </p>
              {/* Keep "at" and the link on ONE line. Astro trims the whitespace at the start of
                  a wrapped line, so a newline before an inline tag welds it to the word above. */}
              <p>
                The Maya pipeline I built is already free and public at <a href="https://fabricator.studio">fabricator.studio</a>. Armature is the same
                work, done again for people who do not have Maya.
              </p>
            </div>
          </div>
        </div>
      </section>

      {/* 6. WHAT IT COSTS */}
      <section class="section pricing" data-spine-section aria-labelledby="pricing-title">
        <div class="wrap">
          <div class="reveal">
            <p class="eyebrow">Pricing</p>
            <h2 class="section-title" id="pricing-title">What it costs.</h2>
          </div>
          <p class="pricing__lede reveal">
            Free for personal, learning, and portfolio work, and free for commercial work under
            $100k a year. If you qualify for Maya Indie, Armature is free. Above that it is <b>$149 per artist, once</b>, with a year of updates.
          </p>
          <p class="pricing__note reveal">
            Armature is a new standalone application. It is not the Armature step inside the Maya
            toolset, and it is not part of that free download.
          </p>
          {/* A132. */}
          <p class="pricing__contact reveal">
            Bringing an existing rig into Armature? <a href="mailto:adrian@fabricator.studio?subject=Armature%3A%20existing%20rig">Talk to us</a>.
          </p>
        </div>
      </section>

      {/* 7. CLOSE */}
      <section class="section close" data-spine-section aria-labelledby="close-title">
        <div class="wrap">
          <h2 class="close__title reveal" id="close-title">Armature is out.</h2>

          <div class="getblock reveal">
            <button class="btn getblock__btn" type="button" data-picker-open data-goatcounter-click="armature-picker-open">
              Download for Windows
            </button>
            <p class="reassure">Free for indies. <a href="/privacy/">Privacy</a> &middot; <a href="/armature/eula/">EULA</a>.</p>
          </div>
        </div>
      </section>
      {/* The silent inline loop is the 24-second teaser, which is what it was built for. The
          click opens the 86-second VOICEOVER trailer, which is a watch asset, not a loop, and
          lives on YouTube so the channel gets the view.

          Nothing reaches Google until this dialog opens, because the iframe is created then and
          not before. That is also why Google sits in the /privacy processor table: once a
          visitor can open this, they can be tracked by it. */}
      <dialog class="shot-dialog shot-dialog--video" id="teaser-dialog" aria-label="Armature trailer">
        <div class="shot-dialog__inner shot-dialog__inner--video" id="trailer-mount">
          <button class="shot-dialog__close" type="button" data-shot-close aria-label="Close">
            <span aria-hidden="true">✕</span>
          </button>
        </div>
      </dialog>

      {/* The licence picker (COPY-LAUNCH.md §2, verbatim; ruling 2026-07-28b). Download opens
          this rather than downloading. Eligibility leads, price follows: a user reading these
          cannot pick wrongly by accident. Rows are data-driven from src/data/armature.ts so
          the education grant lands as a third row without touching this markup. The selection
          here is a default; the installer's click-through selection is the operative one
          (EULA §3.4). */}
      <dialog class="shot-dialog picker" id="picker-dialog" aria-labelledby="picker-title">
        <div class="picker__inner">
          <p class="picker__head" id="picker-title">Download Armature {ARMATURE.version}</p>
          <ul class="picker__rows">
            {PICKER_ROWS.map((row) => (
              <li class="picker__row">
                <div class="picker__copy">
                  <p class="picker__name">
                    <b>{row.name}.</b> <span class="picker__price">{row.price}.</span>
                  </p>
                  <p class="picker__line">{row.line}</p>
                </div>
                {row.cta === 'download' ? (
                  <a class="btn picker__cta" href={ARMATURE.installer} data-goatcounter-click={row.event}>Download</a>
                ) : ARMATURE.stripeCommercial ? (
                  <a class="btn picker__cta" href={ARMATURE.stripeCommercial} data-goatcounter-click={row.event}>Continue to checkout</a>
                ) : (
                  // The live payment link is seated at the cut (Aug 1). An empty config value
                  // degrades to a visibly disabled control, never a dead href.
                  <button class="btn picker__cta" type="button" disabled>Continue to checkout</button>
                )}
              </li>
            ))}
          </ul>
          <button class="shot-dialog__close" type="button" data-shot-close aria-label="Close">
            <span aria-hidden="true">✕</span>
          </button>
        </div>
      </dialog>
    </main>

    <footer class="footer">
      <div class="footer__inner">
        {/* The signature treatment, not plain bold type (brand DNA section 4). */}
        <p class="footer__wordmark"><Wordmark /></p>
        <div class="footer__meta">
          <nav class="footer__links" aria-label="Footer">
            <a href="https://fabricator.studio">fabricator.studio</a>
            <a href="/privacy/">Privacy</a>
            <a href="/armature/eula/">EULA</a>
          </nav>
          <p class="footer__legal">&copy; 2026 FabricatorStudio LLC</p>
        </div>
      </div>
    </footer>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    var spine = document.getElementById('spine');
    var draw = document.getElementById('spine-draw');
    var shell = document.querySelector('.shell');
    var sections = Array.prototype.slice.call(document.querySelectorAll('[data-spine-section]'));
    var joints = Array.prototype.slice.call(spine.querySelectorAll('.joint'));
    var bones = Array.prototype.slice.call(spine.querySelectorAll('.bone'));

    // A joint sits at every section boundary; a bone spans the gap between two joints.
    function placeSpine() {
      var shellTop = shell.getBoundingClientRect().top + window.scrollY;
      var points = sections.map(function (s) {
        return s.getBoundingClientRect().top + window.scrollY - shellTop;
      });
      var last = sections[sections.length - 1];
      points.push(last.getBoundingClientRect().bottom + window.scrollY - shellTop);

      points.forEach(function (y, i) {
        // The first boundary is the top of the document, where a centred joint would be cut in
        // half by the viewport edge. Nudge only that one down.
        var top = i === 0 ? Math.max(y, 22) : y;
        if (joints[i]) joints[i].style.top = top + 'px';
        if (bones[i] && points[i + 1] != null) {
          bones[i].style.top = top + 14 + 'px';
          bones[i].style.height = Math.max(0, points[i + 1] - top - 28) + 'px';
        }
      });
    }

    function updateDraw() {
      if (reduced.matches) return;
      var top = shell.getBoundingClientRect().top + window.scrollY;
      var progress = window.scrollY + window.innerHeight * 0.62 - top;
      draw.style.height = Math.max(0, Math.min(progress, shell.offsetHeight)) + 'px';
    }

    placeSpine();
    updateDraw();

    var ticking = false;
    window.addEventListener(
      'scroll',
      function () {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(function () {
          updateDraw();
          ticking = false;
        });
      },
      { passive: true }
    );

    var resizeTimer;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function () {
        placeSpine();
        updateDraw();
      }, 150);
    });

    // Images settle after the spine is first measured, so re-measure once everything has loaded.
    window.addEventListener('load', function () {
      placeSpine();
      updateDraw();
    });

    function lightSection(section) {
      var i = sections.indexOf(section);
      if (i > -1) {
        if (joints[i]) joints[i].classList.add('is-lit');
        if (joints[i + 1]) joints[i + 1].classList.add('is-lit');
        if (bones[i]) bones[i].classList.add('is-lit');
      }
      section.classList.add('is-in');
      Array.prototype.forEach.call(section.querySelectorAll('.reveal'), function (el, n) {
        el.style.transitionDelay = Math.min(n * 70, 350) + 'ms';
        el.classList.add('is-in');
      });
    }

    if ('IntersectionObserver' in window && !reduced.matches) {
      var sectionObserver = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (e) {
            if (!e.isIntersecting) return;
            lightSection(e.target);
            sectionObserver.unobserve(e.target);
          });
        },
        { rootMargin: '0px 0px -12% 0px', threshold: 0.08 }
      );
      sections.forEach(function (s) {
        sectionObserver.observe(s);
      });

      var stageObserver = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (e) {
            if (!e.isIntersecting) return;
            e.target.classList.add('is-in');
            stageObserver.unobserve(e.target);
          });
        },
        { rootMargin: '0px 0px -18% 0px', threshold: 0.25 }
      );
      document.querySelectorAll('[data-stage]').forEach(function (s) {
        stageObserver.observe(s);
      });
    } else {
      sections.forEach(lightSection);
      document.querySelectorAll('[data-stage]').forEach(function (s) {
        s.classList.add('is-in');
      });
    }

    // Anything already on screen at load lights immediately, observer or not.
    sections.forEach(function (s) {
      if (s.getBoundingClientRect().top < window.innerHeight * 0.9) lightSection(s);
    });

    if (reduced.matches) {
      document.querySelectorAll('video[autoplay]').forEach(function (v) {
        v.removeAttribute('autoplay');
        v.pause();
      });
    }

    /* ---- enlargeable shots and the teaser player ---- */
    var loop = document.getElementById('teaser-loop');

    function wireDialog(dlg) {
      if (!dlg) return;
      // Clicking the backdrop means clicking the dialog element itself, which only works
      // because the dialog carries no padding of its own.
      dlg.addEventListener('click', function (e) {
        if (e.target === dlg) dlg.close();
      });
      dlg.querySelectorAll('[data-shot-close]').forEach(function (b) {
        b.addEventListener('click', function () {
          dlg.close();
        });
      });
    }
    document.querySelectorAll('.shot-dialog').forEach(wireDialog);

    document.querySelectorAll('[data-shot]').forEach(function (trigger) {
      trigger.addEventListener('click', function () {
        var dlg = document.getElementById('shot-' + trigger.getAttribute('data-shot'));
        if (dlg && dlg.showModal) dlg.showModal();
      });
    });

    // The licence picker. Download opens the picker rather than downloading. With JS disabled
    // the dialog cannot open, so the hero getblock carries a <noscript> fallback rendering the
    // same rows as plain links.
    var pickerDialog = document.getElementById('picker-dialog');
    document.querySelectorAll('[data-picker-open]').forEach(function (trigger) {
      trigger.addEventListener('click', function () {
        if (pickerDialog && pickerDialog.showModal) pickerDialog.showModal();
      });
    });

    var teaserDialog = document.getElementById('teaser-dialog');
    var teaserOpen = document.querySelector('[data-teaser-open]');
    var trailerMount = document.getElementById('trailer-mount');
    var TRAILER_ID = 'PhHXmcpcGKk';
    if (teaserDialog && teaserOpen && trailerMount && teaserDialog.showModal) {
      teaserOpen.addEventListener('click', function () {
        teaserDialog.showModal();
        if (loop) loop.pause();
        if (!trailerMount.querySelector('iframe')) {
          var frame = document.createElement('iframe');
          frame.className = 'trailer-frame';
          // youtube-nocookie is YouTube's privacy-enhanced host; rel=0 keeps the end-of-video
          // suggestions inside our own channel rather than handing the viewer away from a page
          // whose only job is the download.
          frame.src =
            'https://www.youtube-nocookie.com/embed/' + TRAILER_ID +
            '?autoplay=1&rel=0&modestbranding=1&playsinline=1';
          frame.title = 'Armature | Standalone Rigging and Skinning App | Unreal';
          frame.allow =
            'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
          frame.referrerPolicy = 'strict-origin-when-cross-origin';
          frame.allowFullscreen = true;
          trailerMount.insertBefore(frame, trailerMount.firstChild);
