<script define:vars={{ WAYPOINTS, CUM, TOTAL }}>
  (function () {
    var reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // THE DRIVER, declared before anything else on the page runs. ArmatureStage reads these
    // two globals instead of a runway when the first is set, and every beat of her creation
    // is a pure function of the second. This block is inline rather than a module for
    // exactly that reason: a module is deferred and would arrive after the stage's own boot.
    //
    // Reduced motion: the stage does not boot at all under it, and the still page below
    // the fold is what that visitor gets.
    window.__armDriven = true;
    window.__armQ = 0;
    if (reduced) { window.__armDriven = false; return; }

    // A CLEAN FRAME FOR HIS SCREENSHOTS (Adrian, 2026-09-05): /next/?clean hides every
    // layer but the world. Nothing else changes; the wheel still drives her.
    if (/[?&]clean(?=&|$)/.test(location.search)) document.documentElement.setAttribute('data-clean', '');
    var copyEls = {}, mapBtns = {};
    var scrim = null, team = null;

    function trackU() {
      var max = Math.max(1, document.documentElement.scrollHeight - innerHeight);
      return Math.min(1, Math.max(0, scrollY / max)) * TOTAL;
    }

    // THE CLOCK IS THE SCROLL. Each waypoint owns a q range and the wheel walks it linearly;
    // a waypoint whose range is empty is a hold. Scrolling up runs her un-creation in
    // reverse, because the stage's beats are pure functions of q.
    function qFor(u) {
      for (var i = WAYPOINTS.length - 1; i >= 0; i--) {
        if (u >= CUM[i]) {
          var wp = WAYPOINTS[i];
          var x = Math.min(1, Math.max(0, (u - CUM[i]) / wp.w));
          return wp.q0 + (wp.q1 - wp.q0) * x;
        }
      }
      return 0;
    }

    // The window a waypoint's copy is open for: in over the first fifth of its span, out
    // over the last fifth, so no two are ever fully up at the same time.
    // THE TOP STANZA holds from the first pixel and is gone before Ideation's line arrives.
    var TOP_OUT = 0.30, TOP_LEN = 0.30;
    function topWindow(u) { return 1 - Math.min(1, Math.max(0, (u - TOP_OUT) / TOP_LEN)); }
    function windowOf(i, u) {
      var s = CUM[i], w = WAYPOINTS[i].w;
      // Ideation's own line waits for the top stanza to clear
      if (i === 0) { s += TOP_OUT + TOP_LEN; w -= TOP_OUT + TOP_LEN; }
      var x = (u - s) / w;
      if (x <= 0) return 0;
      // THE CLOSE HOLDS. Every other window fades out so no two are ever fully up at once,
      // but the last one is the last thing on the page: fading it leaves the visitor at the
      // bottom of a black frame, which is the ending the skill's hard rules forbid outright.
