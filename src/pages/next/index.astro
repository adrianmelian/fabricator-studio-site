    // stage publishes its marks on window.__armCamMarks and, each frame, which ones the
    // current q is blending. The panel follows the dominant mark unless he pins one,
    // edits the numbers live, keeps them across a reload (only with ?cam, so the plain
    // page always shows the shipped values), and prints the whole set to paste back.
    if (!/[?&]cam\b/.test(location.search)) return;
    var KEYS = ['yaw', 'pitch', 'dist', 'tx', 'ty', 'tz'];
    var RANGE = { yaw: [-1.4, 1.4, 0.005], pitch: [-0.7, 0.7, 0.005], dist: [1, 9, 0.01],
      tx: [-2.5, 2.5, 0.01], ty: [0, 2.6, 0.01], tz: [-2.5, 2.5, 0.01] };
    // two sets: the desktop marks and the phone marks; the tabs show the set for the
    // viewport that is open, the readout prints both
    var BASE = ['wide', 'push', 'fit', 'her', 'herOut', 'out'];
    var N_OF = { wide: 'nWide', push: 'nPush', fit: 'nFit', her: 'nHer', herOut: 'nHerOut', out: 'nOut' };
    var MARKS = BASE.concat(BASE.map(function (k) { return N_OF[k]; }));
    var STORE = 'armCamMarks';
    var panel = document.querySelector('[data-cam]');
    var shipped = null, pinned = null, active = 'wide', inputs = {}, tabs = {}, readout, qEl, setLabel, curSet = '';

    function marks() { return window.__armCamMarks; }
    function fmt(v) { return (Math.round(v * 1000) / 1000).toString(); }
    function dump() {
      var m = marks(), out = [];
      MARKS.forEach(function (k) {
        out.push(k + ': { ' + KEYS.map(function (p) { return p + ': ' + fmt(m[k][p]); }).join(', ') + ' }');
      });
      return out.join('\n');
    }
    function save() { try { localStorage.setItem(STORE, JSON.stringify(marks())); } catch (e) {} }
    function show(k) {
      active = k;
      MARKS.forEach(function (t) { if (t === k) tabs[t].setAttribute('data-on', ''); else tabs[t].removeAttribute('data-on'); });
      KEYS.forEach(function (p) {
        var v = marks()[k][p];
        inputs[p].range.value = v; inputs[p].num.value = fmt(v);
      });
      readout.value = dump();
    }
    function set(p, v) {
      if (!isFinite(v)) return;
      marks()[active][p] = v;
      inputs[p].range.value = v; inputs[p].num.value = fmt(v);
      readout.value = dump();
      save();
    }
    function build() {
      var m = marks();
      shipped = JSON.parse(JSON.stringify(m));
      try {
        var kept = JSON.parse(localStorage.getItem(STORE) || 'null');
        if (kept) MARKS.forEach(function (k) { if (kept[k]) KEYS.forEach(function (p) { if (isFinite(kept[k][p])) m[k][p] = kept[k][p]; }); });
      } catch (e) {}

      var row = document.createElement('div'); row.className = 'cam__row';
      var tabWrap = document.createElement('div'); tabWrap.className = 'cam__marks';
      setLabel = document.createElement('span'); setLabel.className = 'cam__set';
      row.appendChild(setLabel);
      MARKS.forEach(function (k) {
        var b = document.createElement('button'); b.type = 'button'; b.textContent = k;
        b.dataset.set = k.charAt(0) === 'n' && k !== 'none' ? 'n' : 'd';
        b.addEventListener('click', function () { pinned = k; show(k); });
        tabs[k] = b; tabWrap.appendChild(b);
      });
      row.appendChild(tabWrap);
      var hide = document.createElement('button'); hide.type = 'button'; hide.textContent = 'hide';
      hide.addEventListener('click', function () { panel.toggleAttribute('data-min'); hide.textContent = panel.hasAttribute('data-min') ? 'show' : 'hide'; });
      row.appendChild(hide);
      var follow = document.createElement('button'); follow.type = 'button'; follow.textContent = 'follow scroll';
      follow.addEventListener('click', function () { pinned = null; });
      row.appendChild(follow);
      var reset = document.createElement('button'); reset.type = 'button'; reset.textContent = 'reset mark';
      reset.addEventListener('click', function () {
        KEYS.forEach(function (p) { marks()[active][p] = shipped[active][p]; });
        save(); show(active);
      });
      row.appendChild(reset);
      var resetAll = document.createElement('button'); resetAll.type = 'button'; resetAll.textContent = 'reset all';
      resetAll.addEventListener('click', function () {
        MARKS.forEach(function (k) { KEYS.forEach(function (p) { marks()[k][p] = shipped[k][p]; }); });
        save(); show(active);
      });
      row.appendChild(resetAll);
      var copy = document.createElement('button'); copy.type = 'button'; copy.textContent = 'copy';
      copy.addEventListener('click', function () {
        readout.select();
        try { navigator.clipboard.writeText(readout.value); } catch (e) { document.execCommand('copy'); }
      });
      row.appendChild(copy);
      qEl = document.createElement('span'); qEl.className = 'cam__q'; row.appendChild(qEl);
      panel.appendChild(row);

      var grid = document.createElement('div'); grid.className = 'cam__sliders';
      KEYS.forEach(function (p) {
        var s = document.createElement('div'); s.className = 'cam__s';
        var l = document.createElement('label'); l.textContent = p; l.htmlFor = 'cam-' + p;
        var r = document.createElement('input'); r.type = 'range'; r.id = 'cam-' + p;
        r.min = RANGE[p][0]; r.max = RANGE[p][1]; r.step = RANGE[p][2];
        var n = document.createElement('input'); n.type = 'number'; n.step = RANGE[p][2];
        r.addEventListener('input', function () { set(p, Number(r.value)); });
        n.addEventListener('change', function () { set(p, Number(n.value)); });
        s.appendChild(l); s.appendChild(r); s.appendChild(n);
        grid.appendChild(s);
        inputs[p] = { range: r, num: n };
      });
      panel.appendChild(grid);
      readout = document.createElement('textarea'); readout.readOnly = true; readout.spellcheck = false;
      panel.appendChild(readout);
      panel.hidden = false;
      panel.removeAttribute('aria-hidden');
      show(active);
    }
    function camTick() {
      requestAnimationFrame(camTick);
      if (!marks()) return;
      if (!shipped) build();
      var info = window.__armCamInfo;
      if (!info) return;
      var best = 'wide', bw = -1;
      BASE.forEach(function (k) { if (info.w[k] > bw) { bw = info.w[k]; best = k; } });
      if (info.narrow) best = N_OF[best];
      var set = info.narrow ? 'n' : 'd';
      if (set !== curSet) {
        curSet = set;
        MARKS.forEach(function (k) { tabs[k].hidden = tabs[k].dataset.set !== set; });
        setLabel.textContent = info.narrow ? 'phone set' : 'desktop set';
        pinned = null;
      }
      qEl.textContent = 'q ' + info.q.toFixed(2) + '  wide ' + Math.round(info.w.wide * 100)
        + '  push ' + Math.round(info.w.push * 100) + '  fit ' + Math.round(info.w.fit * 100) + '  her ' + Math.round(info.w.her * 100) + '  herOut ' + Math.round(info.w.herOut * 100)
        + '  out ' + Math.round(info.w.out * 100);
      if (!pinned && best !== active) show(best);
    }
    requestAnimationFrame(camTick);
  })();
</script>
