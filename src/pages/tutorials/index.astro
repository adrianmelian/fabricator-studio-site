---
// Tutorials page (Adrian x Claude Design, 2026-07-17; source drop:
// MrMiata inbox/Docs/"Tutorials Docs.html"). The drop predates the uploads and used
// placeholder play-tiles; the page keeps its structure and language but fills the grid
// with the NINE REAL Quick Start videos (real thumbnails, real links) plus the real
// playlist card - the honesty rule made flesh. Shared furniture: designed-doc.css.
import BaseLayout from '../../layouts/BaseLayout.astro';
import NavBar from '../../components/NavBar.astro';
import Footer from '../../components/Footer.astro';
import { Image } from 'astro:assets';
import '../../styles/designed-doc.css';
import VideoFeature from '../../components/VideoFeature.astro';
import fsMonogram from '../../assets/docs/fs-monogram.png';
import { TUTORIALS, CHANNEL, PLAYLIST, tutorialByName } from '../../data/tutorials';

const TITLE = 'TUTORIALS';
const TRI = ['t-bone', 't-plasma', 't-ember'];
let li = 0;
const titleGlyphs = TITLE.split('').map((ch) => ({ ch, cls: ch === ' ' ? 't-gap' : TRI[li++ % 3] }));

const pad = (n: number) => String(n).padStart(2, '0');
---
<BaseLayout
  title="Tutorials | FabricatorStudio"
  description="Video tutorials for the FabricatorStudio toolset: the Quick Start series, tool walkthroughs, and the full path from concept to in-engine."
>
  <NavBar />

  <article class="dd tut">
    <header class="dd-header">
      <div class="tut-eyebrow-row">
        <Image class="tut-monogram" src={fsMonogram} alt="" aria-hidden="true" densities={[1, 2]} />
        <div class="dd-eyebrow">FABRICATORSTUDIO</div>
      </div>
      <h1 class="dd-title" aria-label={TITLE}>
        {titleGlyphs.map((g) =>
          g.cls === 't-gap' ? <span class="t-gap"></span> : <span aria-hidden="true" class={g.cls}>{g.ch}</span>
        )}
      </h1>
      <p class="tut-subtitle">Learn the kit, from install to in-engine.</p>
    </header>

    <!-- YOUTUBE FEATURE. The play-card used to open the playlist; 2026-07-21 Adrian
         repointed it at the newest upload (the full concept-to-engine biped build), so
         the panel leads with real work instead of a generic series link. The CTA still
         goes to the channel. -->
    <VideoFeature
      video={tutorialByName('AI to Game Ready')}
      eyebrow="FABRICATORSTUDIO ON YOUTUBE"
      title="Watch on YouTube"
      sub="Every tutorial lives on the channel: tool walkthroughs, pipeline deep-dives, and the full path from concept to in-engine. Subscribe to catch new ones the day they land."
      ctaLabel="Visit the channel"
      ctaHref={CHANNEL}
      strap="NEWEST · A FULL CHARACTER, START TO FINISH"
    />

    <!-- START HERE: the Quick Start series -->
    <section class="tut-rail" aria-labelledby="tut-start">
      <div class="tut-rail__head">
        <h2 id="tut-start" class="tut-rail__label">START HERE</h2>
        <div class="tut-rail__rule" aria-hidden="true"></div>
      </div>
      <div class="tut-grid">
        {TUTORIALS.map((t, i) => (
          <a class="tut-card" href={t.href} target="_blank" rel="noopener">
            <div class="tut-card__media">
              {t.thumb && <img class="tut-card__thumb" src={t.thumb} alt="" loading="lazy" />}
              <span class={`tut-card__tag tut-card__tag--${t.tone ?? 'plasma'}`}>{pad(i + 1)} &middot; {t.tag}</span>
              <span class={`tut-card__play tut-card__play--${t.tone ?? 'plasma'}`} aria-hidden="true"><span class="tut-card__triangle"></span></span>
            </div>
            <div class="tut-card__body">
              <span class="tut-card__name">{t.name ?? t.title}</span>
              {t.sub && <span class="tut-card__sub">{t.sub}</span>}
            </div>
          </a>
        ))}
        <a class="tut-card tut-card--playlist" href={PLAYLIST} target="_blank" rel="noopener">
          <span class="tut-card__playlist-eyebrow">FULL PLAYLIST</span>
          <span class="tut-card__playlist-title">Concept to in-engine, start to finish</span>
          <span class="tut-card__playlist-sub">The complete path in one sitting.</span>
          <span class="tut-card__playlist-cta">Watch the series &rarr;</span>
        </a>
      </div>
    </section>
  </article>

  <Footer />
</BaseLayout>

<style>
  /* The tutorials page in the designed language: feature panel + the real Quick Start
     grid. Shared furniture: designed-doc.css. */
  .tut { max-width: 74rem; margin: 0 auto; padding: 2.5rem 1.5rem 3.5rem; }
  .tut-eyebrow-row { display: flex; align-items: center; gap: 0.9rem; }
  .tut-monogram { height: 2.5rem; width: auto; }
  .tut-subtitle { margin: 0; font-family: var(--font-mono); font-weight: 500; font-size: clamp(1rem, 2.2vw, 1.25rem); letter-spacing: 0.08em; color: var(--bone-dim); }

  /* The feature panel and its play-card moved into components/VideoFeature.astro
     (2026-07-21) so every video card on the site is the same card. */

  .tut-rail { margin-top: 3rem; display: flex; flex-direction: column; gap: 1.5rem; }
  .tut-rail__head { display: flex; align-items: center; gap: 1rem; }
  .tut-rail__label { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: 1.5rem; letter-spacing: 0.08em; color: var(--bone); }
  .tut-rail__rule { flex: 1; height: 1px; background: linear-gradient(90deg, rgba(124, 255, 178, 0.4), rgba(124, 255, 178, 0)); }

  .tut-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.125rem; }
  .tut-card {
    display: flex;
    flex-direction: column;
    background: var(--carbon);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none;
    box-shadow: var(--shadow-md);
  }
  .tut-card__media { position: relative; aspect-ratio: 16 / 9; background: radial-gradient(120% 120% at 50% 40%, var(--iron), var(--carbon)); }
  .tut-card__thumb { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .tut-card__tag {
    position: absolute;
    left: 0.75rem;
    top: 0.6rem;
    z-index: 1;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    background: rgba(11, 14, 16, 0.75);
  }
  .tut-card__tag--plasma,
  .tut-card__tag--ember { color: var(--bone); }
  .tut-card__play {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity var(--t-fast) var(--ease-out);
    background: rgba(11, 14, 16, 0.35);
  }
  .tut-card:hover .tut-card__play { opacity: 1; }
  .tut-card__play::before {
    content: '';
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    position: absolute;
  }
  .tut-card__play--plasma::before,
  .tut-card__play--ember::before { background: rgba(255, 59, 59, 0.16); border: 2px solid rgba(255, 59, 59, 0.6); }
  .tut-card__triangle { position: relative; width: 0; height: 0; border-top: 0.8rem solid transparent; border-bottom: 0.8rem solid transparent; margin-left: 0.35rem; }
  .tut-card__play--plasma .tut-card__triangle,
  .tut-card__play--ember .tut-card__triangle { border-left: 1.3rem solid var(--magma); }
  .tut-card__body { padding: 1.125rem 1.25rem; display: flex; flex-direction: column; gap: 0.3rem; }
  .tut-card__name { font-family: var(--font-mono); font-weight: 800; font-size: 1.0625rem; color: var(--bone); }
  .tut-card__sub { font-family: var(--font-mono); font-size: 0.8125rem; color: var(--bone-faint); }

  /* Plasma-at-alpha wash over carbon (palette-legal gradient stops). */
  .tut-card--playlist {
    justify-content: center;
    gap: 0.75rem;
    background: linear-gradient(160deg, rgba(124, 255, 178, 0.1), rgba(124, 255, 178, 0)), var(--carbon);
    border-color: rgba(124, 255, 178, 0.4);
    padding: 1.75rem 1.5rem;
  }
  .tut-card__playlist-eyebrow { font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.2em; color: var(--bone); }
  .tut-card__playlist-title { font-family: var(--font-mono); font-weight: 800; font-size: 1.25rem; line-height: 1.15; color: var(--bone); }
  .tut-card__playlist-sub { font-family: var(--font-mono); font-size: 0.875rem; line-height: 1.5; color: var(--bone-dim); }
  .tut-card__playlist-cta { margin-top: 0.25rem; font-family: var(--font-mono); font-weight: 700; font-size: 0.9375rem; color: var(--bone); }

  @media (max-width: 900px) {
    .tut-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .tut-grid { grid-template-columns: 1fr; }
  }
</style>
