---
import DocsLayout from '../../layouts/DocsLayout.astro';
import Pill from '../../components/Pill.astro';
import { getCollection, render } from 'astro:content';
import { PAID_DOC_IDS, PAID_PACK_LABEL, DOC_CATEGORY_LABELS } from '../../data/docs';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const isPaid = PAID_DOC_IDS.has(entry.id);
const categoryLabel = DOC_CATEGORY_LABELS[entry.data.category] ?? entry.data.category;
---
<DocsLayout title={`${entry.data.title} | FabricatorStudio Docs`} description={entry.data.summary.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim()}>
  <article class="doc-article">
    <a class="doc-breadcrumb" href="/docs/">{'// DOCS'}</a>
    <header class="doc-article__header">
      <h1 class="subhead">{entry.data.title}</h1>
      <div class="doc-article__meta">
        <Pill text={categoryLabel} tone="bone" />
        {isPaid && <Pill text={PAID_PACK_LABEL} tone="ember" />}
      </div>
      <p class="doc-article__summary prose" set:html={entry.data.summary} />
    </header>

    {entry.data.gif && (
      <div class="doc-article__media">
        <img src={entry.data.gif} alt={`${entry.data.title} demo`} loading="lazy" />
      </div>
    )}

    <div class="doc-body prose"><Content /></div>
  </article>
</DocsLayout>
<style>
  .doc-article { max-width: var(--measure); margin: 0; text-align: left; }
  .doc-breadcrumb {
    display: inline-block;
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--ember);
    text-decoration: none;
    letter-spacing: 0.08em;
    margin-bottom: 1.25rem;
  }
  .doc-breadcrumb:hover { color: var(--ember-dim); }
  .doc-article__header { margin-bottom: 1.5rem; }
  .doc-article__meta { display: flex; gap: 0.75rem; margin: 0.75rem 0; flex-wrap: wrap; }
  .doc-article__summary { color: var(--bone-dim); }
  .doc-article__summary :global(b) { color: var(--bone); font-weight: 700; }
  .doc-article__media { margin: 1.5rem 0; border: 1px solid var(--iron-3); border-radius: var(--radius); overflow: hidden; }
  .doc-article__media img { display: block; width: 100%; height: auto; }

  .doc-body { margin-top: 1.5rem; display: flex; flex-direction: column; gap: 1rem; }
  .doc-body :global(h1) { display: none; } /* the doc's own H1 duplicates the article title above */
  .doc-body :global(h2) {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--ember);
    margin-top: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .doc-body :global(h3) {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1rem;
    color: var(--bone);
    margin-top: 0.5rem;
  }
  .doc-body :global(p) { color: var(--bone); }
  .doc-body :global(ul),
  .doc-body :global(ol) { padding-left: 1.25rem; display: flex; flex-direction: column; gap: 0.375rem; color: var(--bone); }
  .doc-body :global(li) { line-height: 1.55; }
  .doc-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--iron);
    border: 1px solid var(--iron-2);
    border-radius: var(--radius);
    padding: 0.1em 0.35em;
  }
  .doc-body :global(pre) {
    border: 1px solid var(--iron-3);
    border-radius: var(--radius);
    padding: 1rem;
    overflow-x: auto;
    font-size: 0.875rem;
  }
  .doc-body :global(pre code) { background: none; border: none; padding: 0; }
  .doc-body :global(table) {
    display: block;
    overflow-x: auto;
    max-width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }
  .doc-body :global(th),
  .doc-body :global(td) {
    border: 1px solid var(--iron-2);
    padding: 0.5rem 0.75rem;
    text-align: left;
    white-space: nowrap;
  }
  .doc-body :global(th) { color: var(--ember); background: var(--iron); }
  .doc-body :global(td) { color: var(--bone); }
  .doc-body :global(a) { color: var(--plasma); }
  .doc-body :global(blockquote) {
    border-left: 2px solid var(--iron-3);
    padding-left: 1rem;
    color: var(--bone-dim);
  }
</style>
