---
import DocsLayout from '../../layouts/DocsLayout.astro';
import FieldLabel from '../../components/FieldLabel.astro';
import { getCollection } from 'astro:content';
import { DOCS_NAV } from '../../data/docs';

const all = await getCollection('docs');
const byId = new Map(all.map((d) => [d.id, d]));

const concepts = ['concepts/components', 'concepts/limbs', 'concepts/templates']
  .map((id) => byId.get(id))
  .filter(Boolean);

const CATEGORY_BLURBS: Record<string, string> = {
  'skeleton-building': 'Author the skeleton: the armature, orientation, and skeleton IO.',
  'animation-rig': 'Build the animation rig with Fabricator and its control curves.',
  'rig-components': 'The building blocks: components, limbs, and templates.',
  skinning: 'Bind and transfer skin weights.',
  animation: 'Save and reuse poses and clips across every rig you build.',
  engine: 'Clean FBX into Unreal, with project paths set up for you.',
  utility: 'The toolbar, your AI TA, and the everyday scene helpers.',
};

const categories = DOCS_NAV.map((g) => {
  const ids = [...g.ids, ...(g.subgroups ?? []).flatMap((s) => s.ids)].filter((id) => byId.has(id));
  return { key: g.key, label: g.label, count: ids.length, first: ids[0], blurb: CATEGORY_BLURBS[g.key] };
});
---
<DocsLayout
  title="Docs | FabricatorStudio"
  description="Reference docs for every tool and rig component in the FabricatorStudio toolset."
>
  <section class="docs-landing">
    <FieldLabel text="Docs" />
    <h1 class="display">Documentation</h1>
    <p class="prose docs-landing__intro">Everything that ships with the toolset. New here? Start with the core concepts, then browse by category in the sidebar.</p>

    <FieldLabel text="Start Here" />
    <ul class="doc-cards">
      {concepts.map((entry) => (
        <li>
          <a class="doc-entry" href={`/docs/${entry!.id}/`}>
            <span class="doc-entry__title">{entry!.data.title}</span>
            <span class="doc-entry__summary prose" set:html={entry!.data.summary} />
          </a>
        </li>
      ))}
    </ul>

    <FieldLabel text="Browse" />
    <ul class="doc-cards">
      {categories.map((cat) => (
        <li>
          <a class="doc-entry" href={`/docs/${cat.first}/`}>
            <span class="doc-entry__head">
              <span class="doc-entry__title">{cat.label}</span>
              <span class="doc-entry__count">{cat.count} {cat.count === 1 ? 'doc' : 'docs'}</span>
            </span>
            <span class="doc-entry__summary">{cat.blurb}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</DocsLayout>
<style>
  .docs-landing { text-align: left; max-width: 52rem; }
  .docs-landing__intro { margin: 0.5rem 0 2rem; }
  .docs-landing :global(.field-label) { margin-bottom: 0.75rem; }
  .docs-landing :global(.field-label:not(:first-of-type)) { margin-top: 2.5rem; }

  .doc-cards {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 0.75rem;
  }
  .doc-entry {
    display: block;
    height: 100%;
    box-sizing: border-box;
    border: 1px solid var(--iron-2);
    border-radius: var(--radius);
    background: var(--iron);
    padding: 1rem 1.25rem;
    text-decoration: none;
    color: inherit;
  }
  .doc-entry:hover { border-color: var(--iron-3); }
  .doc-entry__head { display: flex; align-items: baseline; justify-content: space-between; gap: 0.75rem; }
  .doc-entry__title { font-family: var(--font-mono); font-weight: 700; color: var(--bone); }
  .doc-entry__count { font-family: var(--font-mono); font-size: 0.75rem; color: var(--bone-faint); white-space: nowrap; }
  .doc-entry__summary { display: block; margin-top: 0.375rem; color: var(--bone-dim); font-size: 0.9375rem; }
  .doc-entry__summary :global(b) { color: var(--bone); font-weight: 700; }
</style>
