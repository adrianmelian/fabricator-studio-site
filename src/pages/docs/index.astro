---
// The docs chooser (Adrian, 2026-07-30). Two products now ship from this studio, so /docs/
// stops being the Maya toolset's getting-started and becomes the door a reader picks from.
// The Maya narrative moved intact to /docs/maya/; nothing else under /docs/ changed.
//
// IMAGERY IS REAL PRODUCT, NOT GENERATED. A reader here is deciding which product they are
// in, so the useful thing to show is the actual UI of each. Both shots already existed:
// the Armature skeleton station from the landing-page port, and the Fabricator GUI from the
// docs asset library.
//
// Deliberately NOT DocsLayout: that shell hardcodes the Maya toolset sidebar, which is the
// wrong furniture for a page whose whole job is to ask which toolset you want.
import BaseLayout from '../../layouts/BaseLayout.astro';
import NavBar from '../../components/NavBar.astro';
import Footer from '../../components/Footer.astro';
import { Image } from 'astro:assets';
import '../../styles/designed-doc.css';
import fsMonogram from '../../assets/docs/fs-monogram.png';
import armatureShot from '../../assets/armature/stage-skeleton.png';
import mayaShot from '../../assets/docs/fabricator-gui.png';

const TITLE = 'DOCS';
const TRI = ['t-bone', 't-plasma', 't-ember'];
let li = 0;
const titleGlyphs = TITLE.split('').map((ch) => ({ ch, cls: ch === ' ' ? 't-gap' : TRI[li++ % 3] }));

const DOORS = [
  {
    key: 'armature',
    eyebrow: 'STANDALONE APP',
    name: 'Armature',
    line: 'The standalone joint and skin authoring app. Load a mesh, fit it, place the skeleton, skin it, and export a USD that stands up in Unreal and Maya. No Maya licence needed.',
    href: '/docs/armature/',
    cta: 'Armature docs',
    img: armatureShot,
    alt: 'The Armature app with a joint chain placed through a samurai character and the module library open',
    tone: 'plasma',
  },
  {
    key: 'maya',
    eyebrow: 'MAYA TOOLSET',
    name: 'The Maya Toolset',
    line: 'The Maya pipeline: project setup, skeleton building, modular rig authoring, AI skinning, and one-click export to your engine. Five steps, each with its own tool.',
    href: '/docs/maya/',
    cta: 'Maya Toolset docs',
    img: mayaShot,
    alt: 'The Fabricator interface in Maya, showing the rig authoring toolbar and component picker',
    tone: 'ember',
  },
];
---
<BaseLayout
  title="Docs | FabricatorStudio"
  description="Documentation for FabricatorStudio: the standalone Armature app, and the free Maya Toolset."
>
  <NavBar />

  <article class="dd dx">
    <header class="dd-header">
      <div class="dx-eyebrow-row">
        <Image class="dx-monogram" src={fsMonogram} alt="" aria-hidden="true" densities={[1, 2]} />
        <div class="dd-eyebrow">FABRICATORSTUDIO &middot; DOCS</div>
      </div>
      <h1 class="dd-title" aria-label={TITLE}>
        {titleGlyphs.map((g) => <span class={g.cls}>{g.ch}</span>)}
      </h1>
      <p class="dd-summary">Two products, two sets of docs. Pick the one you are working in.</p>
    </header>

    <div class="dx-doors">
      {DOORS.map((d) => (
        <a class={`dx-door dx-door--${d.tone}`} href={d.href}>
          <figure class="dx-door__shot">
            <Image src={d.img} alt={d.alt} widths={[560, 1120]} sizes="(min-width: 860px) 46vw, 92vw" />
          </figure>
          <div class="dx-door__body">
            <p class={`dx-door__eyebrow dx-door__eyebrow--${d.tone}`}>{d.eyebrow}</p>
            <h2 class="dx-door__name">{d.name}</h2>
            <p class="dx-door__line">{d.line}</p>
            <span class={`dx-door__cta dx-door__cta--${d.tone}`}>{d.cta} &rarr;</span>
          </div>
        </a>
      ))}
    </div>

    <aside class="dx-status" aria-labelledby="dx-status-t">
      <h2 id="dx-status-t" class="dx-status__label">PROJECT STATUS</h2>
      <p class="dx-status__para">Hit something that looks wrong? The known issues and changelog below cover the Maya Toolset. Armature reports and releases live in the Discord.</p>
      <div class="dx-status__links">
        <a class="dx-chip dx-chip--ember" href="/known-issues/">Known issues &rarr;</a>
        <a class="dx-chip dx-chip--plasma" href="/changelog/">Changelog &rarr;</a>
        <a class="dx-chip dx-chip--plasma" href="/discord/">Discord &rarr;</a>
      </div>
    </aside>
  </article>

  <Footer />
</BaseLayout>

<style>
  .dx { padding-bottom: 2rem; }
  .dx .dd-header { align-items: center; text-align: center; }
  .dx .dd-title { justify-content: center; }
  .dx .dd-summary { margin-inline: auto; }
  .dx-eyebrow-row { display: flex; align-items: center; justify-content: center; gap: 0.9rem; }
  .dx-monogram { height: 2.5rem; width: auto; }

  /* Same 72rem centred column as the header and every other doc page. Without the explicit
     width the .dd flex parent lets this grid run full bleed. */
  .dx-doors { display: grid; gap: 1.5rem; margin-top: 1rem; width: 100%; max-width: 72rem; margin-inline: auto; }
  @media (min-width: 860px) {
    .dx-doors { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .dx-door {
    display: flex;
    flex-direction: column;
    border-radius: 20px;
    overflow: hidden;
    text-decoration: none;
    background: linear-gradient(180deg, var(--iron), var(--carbon));
    box-shadow: var(--shadow-md);
    transition: transform var(--t-base) var(--ease-out), box-shadow var(--t-base) var(--ease-out), border-color var(--t-base) var(--ease-out);
  }
  .dx-door--plasma { border: 1px solid rgba(124, 255, 178, 0.22); }
  .dx-door--ember { border: 1px solid rgba(255, 122, 61, 0.22); }
  .dx-door:hover { transform: translateY(-2px); box-shadow: var(--shadow-lg); }
  .dx-door--plasma:hover { border-color: var(--plasma); }
  .dx-door--ember:hover { border-color: var(--ember); }

  .dx-door__shot { margin: 0; aspect-ratio: 16 / 10; overflow: hidden; border-bottom: 1px solid var(--iron-2); }
  .dx-door__shot :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }

  .dx-door__body { display: flex; flex-direction: column; gap: 0.55rem; padding: 1.5rem 1.75rem 1.75rem; }
  .dx-door__eyebrow { margin: 0; font-family: var(--font-mono); font-weight: 700; font-size: 0.75rem; letter-spacing: 0.22em; }
  .dx-door__eyebrow--plasma { color: var(--bone); }
  .dx-door__eyebrow--ember { color: var(--bone); }
  .dx-door__name { margin: 0; font-family: var(--font-mono); font-weight: 800; font-size: 1.5rem; color: var(--bone); }
  .dx-door__line { margin: 0; font-size: 0.9375rem; line-height: 1.6; color: var(--bone-dim); text-wrap: pretty; }
  .dx-door__cta { margin-top: 0.35rem; font-family: var(--font-mono); font-weight: 700; font-size: 0.9375rem; }
  .dx-door__cta--plasma { color: var(--bone); }
  .dx-door__cta--ember { color: var(--bone); }

  .dx-status { width: 100%; max-width: 72rem; margin: 3rem auto 0; padding-top: 2rem; border-top: 1px solid var(--iron-2); text-align: center; }
  .dx-status__label { font-family: var(--font-mono); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em; color: var(--bone-faint); margin: 0 0 0.75rem; }
  .dx-status__para { margin: 0 auto 1.25rem; max-width: 42rem; font-size: 0.9375rem; line-height: 1.6; color: var(--bone-dim); text-wrap: pretty; }
  .dx-status__links { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; }
  .dx-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.25rem;
    border-radius: 10px;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.9375rem;
    text-decoration: none;
  }
  .dx-chip--plasma { background: rgba(124, 255, 178, 0.1); border: 1px solid rgba(124, 255, 178, 0.4); color: var(--bone); }
  .dx-chip--plasma:hover { background: var(--plasma); color: #06120B; }
  .dx-chip--ember { background: rgba(255, 122, 61, 0.1); border: 1px solid rgba(255, 122, 61, 0.4); color: var(--bone); }
  .dx-chip--ember:hover { background: var(--ember); color: #1A0A02; }
</style>
