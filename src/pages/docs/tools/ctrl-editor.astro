---
// DESIGNED docs page for tools/ctrl-editor (Adrian x Claude Design, 2026-07-17; source
// drop: MrMiata inbox/Docs/ctrl_editor/"CtrlEditor Docs.html"). Shared furniture:
// src/styles/designed-doc.css + LazyVideos. Page-specific: the six-action grid, the
// shared-library flow diagram, and the good-to-know cards.
import DocsLayout from '../../../layouts/DocsLayout.astro';
import LazyVideos from '../../../components/LazyVideos.astro';
import '../../../styles/designed-doc.css';

const SUMMARY =
  "Build, swap, recolor, and mirror control-curve shapes from a shared library that also drives every Fabricator component's ctrl-shape options.";

const TITLE = 'CTRL EDITOR';
const TRI = ['t-bone', 't-plasma', 't-ember'];
// The cycle counts letters only, continuing across word gaps (Claude Design's treatment).
let li = 0;
const titleGlyphs = TITLE.split('').map((ch) => ({ ch, cls: ch === ' ' ? 't-gap' : TRI[li++ % 3] }));

const ACTIONS = [
  { icon: '+', tone: 'plasma', name: 'Build', line: 'Fresh control from any shape' },
  { icon: '⇆', tone: 'plasma', name: 'Swap', line: 'Restyle without breaking connections' },
  { icon: '◟', tone: 'ember', name: 'Mirror', line: 'Onto the opposite side' },
  { icon: '□', tone: 'plasma', name: 'Combine', line: 'Several curves into one control' },
  { icon: '●', tone: 'ember', name: 'Recolor', line: 'From a shared palette' },
  { icon: '↓', tone: 'plasma', name: 'Save', line: 'Your own shapes into the library' },
];
---
<DocsLayout title="CtrlEditor | FabricatorStudio Docs" description={SUMMARY}>
  <article class="dd">
    <a class="dd-breadcrumb" href="/docs/">Docs</a>

    <header class="dd-header">
      <div class="dd-eyebrow">FABRICATOR &middot; RIGGING</div>
      <h1 class="dd-title" aria-label={TITLE}>
        {titleGlyphs.map((g) =>
          g.cls === 't-gap' ? <span class="t-gap"></span> : <span aria-hidden="true" class={g.cls}>{g.ch}</span>
        )}
      </h1>
      <p class="dd-summary">{SUMMARY}</p>
    </header>

    <!-- WHAT IT DOES: action grid | loop -->
    <section class="dd-panel" aria-labelledby="ce-what">
      <div class="dd-panel__head">
        <h2 id="ce-what" class="dd-label dd-label--plasma">WHAT IT DOES</h2>
        <p class="dd-lede">The control-curve shape library for rigging</p>
      </div>
      <div class="ce-what">
        <div class="ce-what__copy">
          <p class="dd-prose">Pick a shape and work with it any way you need; every shape you add shows up automatically on Fabricator's components.</p>
          <div class="ce-actions">
            {ACTIONS.map((a) => (
              <div class="ce-action">
                <span class={`ce-action__icon ce-action__icon--${a.tone}`} aria-hidden="true">{a.icon}</span>
                <div>
                  <h3 class="ce-action__name">{a.name}</h3>
                  <p class="ce-action__line">{a.line}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div class="dd-loop dd-loop--plasma ce-loop">
          <div class="dd-shot__glow dd-shot__glow--plasma" aria-hidden="true"></div>
          <video data-lazyvid src="/docs/ctrl-editor/ctrleditor-loop.mp4" muted loop playsinline preload="none" aria-label="CtrlEditor building, swapping, and recoloring controls in Maya"></video>
          <div class="dd-loop__cap" aria-hidden="true">CTRLEDITOR IN ACTION</div>
        </div>
      </div>
    </section>

    <!-- ONE SHARED LIBRARY -->
    <section class="dd-panel dd-panel--ember" aria-labelledby="ce-library">
      <div class="dd-panel__head">
        <h2 id="ce-library" class="dd-label dd-label--ember">ONE SHARED LIBRARY</h2>
        <p class="dd-lede">Add a shape once, it appears everywhere</p>
      </div>
      <div class="ce-flow">
        <div class="ce-flow__source">
          <div class="ce-flow__source-name">CtrlEditor</div>
          <div class="ce-flow__source-sub">shape library</div>
        </div>
        <div class="ce-flow__arrow" aria-hidden="true">
          <div class="ce-flow__arrow-glyph">&rarr;</div>
          <div class="ce-flow__arrow-label">DRIVES</div>
        </div>
        <div class="ce-flow__targets">
          <span class="ce-target">FK</span>
          <span class="ce-target">IK</span>
          <span class="ce-target">Spline</span>
          <span class="ce-target">Ribbon</span>
          <span class="ce-target ce-target--all">&hellip;every Fabricator component's ctrl-shape options</span>
        </div>
      </div>
    </section>

    <!-- QUICK START -->
    <section class="dd-section" aria-labelledby="ce-quickstart">
      <div class="dd-panel__head dd-panel__head--bare">
        <h2 id="ce-quickstart" class="dd-label dd-label--plasma">QUICK START</h2>
        <p class="dd-lede">Shape to control in four steps</p>
      </div>
      <div class="ce-qs">
        <ol class="dd-steps">
          <li class="dd-step dd-step--plasma"><span class="dd-step__num">1</span><p>Open CtrlEditor from the <b>Bridge toolbar</b>, the shelf, or the Rigging menu.</p></li>
          <li class="dd-step dd-step--plasma"><span class="dd-step__num">2</span><p>Choose a <b>shape</b> from the list.</p></li>
          <li class="dd-step dd-step--plasma"><span class="dd-step__num">3</span><p>Click <b class="b-plasma">Build at Origin</b> for a new control, or select existing control(s) and click <b class="b-plasma">Swap</b> to restyle in place.</p></li>
          <li class="dd-step dd-step--ember"><span class="dd-step__num">4</span><p><span class="ce-optional">Optional:</span> with control(s) selected, pick a color and click <b class="b-ember">Apply Color</b>.</p></li>
        </ol>
        <div class="dd-loop dd-loop--plasma ce-swap">
          <div class="dd-shot__glow dd-shot__glow--plasma" aria-hidden="true"></div>
          <video data-lazyvid src="/docs/ctrl-editor/swap-ctrl.mp4" muted loop playsinline preload="none" aria-label="Swapping a control's shape in place with CtrlEditor"></video>
          <div class="dd-loop__cap" aria-hidden="true">SWAP IN ACTION</div>
        </div>
      </div>
    </section>

    <!-- GOOD TO KNOW -->
    <section class="dd-section" aria-labelledby="ce-gtk">
      <div class="dd-panel__head dd-panel__head--bare">
        <h2 id="ce-gtk" class="dd-label dd-label--ember">GOOD TO KNOW</h2>
      </div>
      <div class="ce-gtk">
        <div class="ce-gtk__card ce-gtk__card--plasma">
          <div class="ce-gtk__head"><span class="ce-gtk__mark ce-gtk__mark--plasma" aria-hidden="true">&check;</span><h3 class="ce-gtk__name">Never lose work</h3></div>
          <p class="ce-gtk__line">When unbuilding a rig, the system remembers your ctrl-shape choices.</p>
        </div>
        <div class="ce-gtk__card ce-gtk__card--ember">
          <div class="ce-gtk__head"><span class="ce-gtk__mark ce-gtk__mark--ember" aria-hidden="true">!</span><h3 class="ce-gtk__name">Mirror needs a side token</h3></div>
          <p class="ce-gtk__line">Mirror needs a recognized side token (<b>L/R</b>, <b>left/right</b>, etc) in the name, and the opposite control must already exist.</p>
        </div>
      </div>
    </section>
    <LazyVideos />
  </article>
</DocsLayout>

<style>
  /* Page-specific: the six-action grid, the shared-library flow, and the good-to-know
     cards. Shared furniture: designed-doc.css. */
  .ce-what { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr); gap: 2rem; align-items: center; }
  .ce-what__copy { display: flex; flex-direction: column; gap: 1rem; }
  .ce-loop { aspect-ratio: 16 / 10; }

  .ce-actions { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.6rem; }
  .ce-action {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    background: var(--carbon);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    padding: 0.8rem 0.9rem;
  }
  .ce-action__icon { font-size: 1.05rem; font-weight: 800; line-height: 1.2; }
  .ce-action__icon--plasma { color: var(--plasma); }
  .ce-action__icon--ember { color: var(--ember); }
  .ce-action__name { margin: 0; font-family: var(--font-mono); font-weight: 700; font-size: 0.9375rem; color: var(--bone); }
  .ce-action__line { margin: 0; font-size: 0.8125rem; line-height: 1.4; color: var(--bone-faint); }

  .ce-flow { display: flex; align-items: center; gap: 1.75rem; }
  .ce-flow__source {
    flex: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    background: var(--carbon);
    border: 1px solid rgba(255, 122, 61, 0.4);
    border-radius: 12px;
    padding: 1.375rem 1.75rem;
  }
  .ce-flow__source-name { font-family: var(--font-mono); font-weight: 800; font-size: 1.0625rem; color: var(--ember); letter-spacing: 0.04em; }
  .ce-flow__source-sub { font-family: var(--font-mono); font-size: 0.75rem; color: var(--bone-faint); }
  .ce-flow__arrow { flex: none; display: flex; flex-direction: column; align-items: center; gap: 0.15rem; }
  .ce-flow__arrow-glyph { color: var(--plasma); font-size: 1.5rem; font-weight: 800; }
  .ce-flow__arrow-label { font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.18em; color: var(--bone-faint); }
  .ce-flow__targets { flex: 1; display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.6rem; min-width: 0; }
  .ce-target {
    text-align: center;
    background: var(--carbon);
    border: 1px solid rgba(124, 255, 178, 0.25);
    border-radius: 10px;
    padding: 0.8rem 0.5rem;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.875rem;
    color: var(--bone);
  }
  .ce-target--all { grid-column: 1 / -1; border-style: dashed; border-color: rgba(255, 255, 255, 0.14); color: var(--bone-faint); font-size: 0.8125rem; }

  .ce-optional { color: var(--bone-faint); }

  /* Quick start: steps beside the swap demo (swap IS step 3). The video is 800x600 source,
     shown 4:3. */
  .ce-qs { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 1.75rem; align-items: center; }
  .ce-swap { aspect-ratio: 4 / 3; }

  .ce-gtk { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .ce-gtk__card {
    background: linear-gradient(180deg, var(--iron), var(--carbon));
    border-radius: 12px;
    padding: 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .ce-gtk__card--plasma { border: 1px solid rgba(124, 255, 178, 0.18); }
  .ce-gtk__card--ember { border: 1px solid rgba(255, 122, 61, 0.22); }
  .ce-gtk__head { display: flex; align-items: center; gap: 0.6rem; }
  .ce-gtk__mark { font-size: 1.125rem; font-weight: 800; }
  .ce-gtk__mark--plasma { color: var(--plasma); }
  .ce-gtk__mark--ember { color: var(--ember); }
  .ce-gtk__name { margin: 0; font-family: var(--font-mono); font-weight: 700; font-size: 1rem; color: var(--bone); }
  .ce-gtk__line { margin: 0; font-size: 0.875rem; line-height: 1.55; color: var(--bone-dim); }
  .ce-gtk__line b { color: var(--bone); }

  @media (max-width: 820px) {
    .ce-what { grid-template-columns: 1fr; }
    .ce-qs { grid-template-columns: 1fr; }
    .ce-flow { flex-direction: column; align-items: stretch; gap: 1rem; }
    .ce-flow__source { align-self: center; }
    .ce-flow__arrow { flex-direction: row; gap: 0.5rem; align-self: center; }
    .ce-flow__arrow-glyph { transform: rotate(90deg); }
    .ce-flow__targets { grid-template-columns: repeat(2, 1fr); }
    .ce-gtk { grid-template-columns: 1fr; }
  }
</style>
