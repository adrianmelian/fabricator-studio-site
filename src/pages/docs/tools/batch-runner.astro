---
// DESIGNED docs page for tools/batch-runner (docs-thread relay R2, 2026-07-17; copy
// source: MrMiata workspace/2026-07-17_component-docs/for-humans/batch-runner.md).
// Shared furniture: designed-doc.css (incl. dd-gets + dd-fact rows). Free tool.
import DocsLayout from '../../../layouts/DocsLayout.astro';
import '../../../styles/designed-doc.css';

const SUMMARY =
  'Run the same job across a whole list of Maya scenes, hands-off. Open, script, export, save - one scene at a time, safely.';

const TITLE = 'BATCH RUNNER';
const TRI = ['t-bone', 't-plasma', 't-ember'];
// The cycle counts glyphs only, continuing across word gaps (Claude Design's treatment).
let li = 0;
const titleGlyphs = TITLE.split('').map((ch) => ({ ch, cls: ch === ' ' ? 't-gap' : TRI[li++ % 3] }));
---
<DocsLayout title="Batch Runner | FabricatorStudio Docs" description={SUMMARY}>
  <article class="dd">
    <a class="dd-breadcrumb" href="/docs/">Docs</a>

    <header class="dd-header">
      <div class="dd-eyebrow">FABRICATOR &middot; PIPELINE TOOL</div>
      <h1 class="dd-title" aria-label={TITLE}>
        {titleGlyphs.map((g) =>
          g.cls === 't-gap' ? <span class="t-gap"></span> : <span aria-hidden="true" class={g.cls}>{g.ch}</span>
        )}
      </h1>
      <p class="dd-summary">{SUMMARY}</p>
    </header>

    <!-- WHAT IT DOES -->
    <section class="dd-panel" aria-labelledby="bt-what">
      <div class="dd-panel__head">
        <h2 id="bt-what" class="dd-label dd-label--plasma">WHAT IT DOES</h2>
        <p class="dd-lede">A whole show's worth of scenes, one Run button</p>
      </div>
      <p class="dd-prose bt-lede">Batch Runner runs the same steps across a list of Maya scenes for you, without you opening any of them. For each scene it opens the file, runs a script if you give it one, and then exports and/or saves. Every scene runs on its own, so a <b>broken scene cannot crash your Maya</b> or stop the rest of the batch.</p>
      <div class="bt-flow" aria-label="For every scene: open, script, export, save">
        <span class="bt-flow__step">open</span>
        <span class="bt-flow__arrow" aria-hidden="true">&rarr;</span>
        <span class="bt-flow__step bt-flow__step--plasma">your script</span>
        <span class="bt-flow__arrow" aria-hidden="true">&rarr;</span>
        <span class="bt-flow__step bt-flow__step--ember">export</span>
        <span class="bt-flow__arrow" aria-hidden="true">&rarr;</span>
        <span class="bt-flow__step">save</span>
      </div>
      <div class="bt-you-get">
        <p class="bt-you-get__lede">You get:</p>
        <div class="dd-gets">
          <div class="dd-get"><span class="dd-get__glyph dd-get__glyph--circle" aria-hidden="true"></span><p>Point it at a <b>list of scenes</b> and walk away</p></div>
          <div class="dd-get"><span class="dd-get__glyph dd-get__glyph--diamond" aria-hidden="true"></span><p>An optional <b>script step</b> that runs inside every scene - great for a fix-up across a whole show</p></div>
          <div class="dd-get"><span class="dd-get__glyph dd-get__glyph--square" aria-hidden="true"></span><p><b>Export and Save toggles</b>, per scene</p></div>
          <div class="dd-get"><span class="dd-get__glyph dd-get__glyph--pill" aria-hidden="true"></span><p>A <b>live log</b> of what happened to each scene, and a Cancel that stops cleanly</p></div>
          <div class="dd-get"><span class="dd-get__glyph dd-get__glyph--dot" aria-hidden="true"></span><p>Your scene list and script <b>remembered</b> the next time you open it</p></div>
        </div>
      </div>
    </section>

    <!-- GET STARTED -->
    <section class="dd-section" aria-labelledby="bt-start">
      <div class="dd-panel__head dd-panel__head--bare">
        <h2 id="bt-start" class="dd-label dd-label--plasma">GET STARTED</h2>
        <p class="dd-lede">List, script, toggles, Run</p>
      </div>
      <ol class="dd-steps">
        <li class="dd-step dd-step--plasma"><span class="dd-step__num">1</span><p>Add your files with <b class="b-plasma">+ Add Scenes</b> (Remove Selected and Clear All manage the list).</p></li>
        <li class="dd-step dd-step--plasma"><span class="dd-step__num">2</span><p>Optionally type a Python script - it runs after each scene opens, before export and save.</p></li>
        <li class="dd-step dd-step--plasma"><span class="dd-step__num">3</span><p>Tick <b>Export</b> and/or <b>Save</b>. Export is on to start with, Save is off.</p></li>
        <li class="dd-step dd-step--ember bt-step--run"><span class="dd-step__num">4</span><p>Press <b class="b-ember">Run</b> and watch the log. You can Cancel (or press Esc) any time; it finishes the scene it is on, then stops.</p></li>
      </ol>
    </section>

    <!-- GOOD TO KNOW -->
    <section class="dd-section" aria-labelledby="bt-gtk">
      <div class="dd-panel__head dd-panel__head--bare">
        <h2 id="bt-gtk" class="dd-label dd-label--ember">GOOD TO KNOW</h2>
      </div>
      <div class="dd-facts bt-facts">
        <div class="dd-fact dd-fact--ember">
          <span class="dd-fact__num">1</span>
          <div>
            <h3 class="dd-fact__name">Headless, maya.cmds only</h3>
            <p class="dd-fact__line">Each scene runs headless, with no Maya window, so your script uses maya.cmds and cannot use anything GUI-only. Load any plugins it needs at the top of your script (FBX is already loaded).</p>
          </div>
        </div>
        <div class="dd-fact dd-fact--plasma">
          <span class="dd-fact__num">2</span>
          <div>
            <h3 class="dd-fact__name">The order never changes</h3>
            <p class="dd-fact__line">The order is always the same: open, then your script, then export, then save.</p>
          </div>
        </div>
        <div class="dd-fact dd-fact--plasma">
          <span class="dd-fact__num">3</span>
          <div>
            <h3 class="dd-fact__name">Cancel is gentle</h3>
            <p class="dd-fact__line">It lets the current scene finish instead of killing it partway, so no scene is ever left half-done.</p>
          </div>
        </div>
        <div class="dd-fact dd-fact--plasma">
          <span class="dd-fact__num">4</span>
          <div>
            <h3 class="dd-fact__name">Fix in place</h3>
            <p class="dd-fact__line">To fix scenes in place instead of exporting them, turn <b>Save on and Export off</b>.</p>
          </div>
        </div>
      </div>
    </section>
  </article>
</DocsLayout>

<style>
  /* Page-specific: the open-script-export-save flow strip. Shared furniture:
     designed-doc.css. */
  .bt-lede { max-width: 58rem; }
  .bt-flow { display: flex; align-items: center; gap: 0.7rem; flex-wrap: wrap; }
  .bt-flow__step {
    padding: 0.55rem 1.1rem;
    border-radius: 9px;
    background: var(--carbon);
    border: 1px solid rgba(255, 255, 255, 0.1);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--bone);
  }
  .bt-flow__step--plasma { border-color: rgba(124, 255, 178, 0.35); color: var(--plasma); }
  .bt-flow__step--ember { border-color: rgba(255, 122, 61, 0.35); color: var(--ember); }
  .bt-flow__arrow { color: var(--bone-faint); font-size: 1.125rem; font-weight: 800; }
  .bt-you-get { display: flex; flex-direction: column; gap: 0.75rem; }
  .bt-you-get__lede { margin: 0; font-size: 0.875rem; color: var(--bone-faint); }
  .bt-step--run { background: var(--carbon); }
  .bt-facts { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  @media (max-width: 820px) {
    .bt-facts { grid-template-columns: 1fr; }
  }
</style>
