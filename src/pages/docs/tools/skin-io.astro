---
// DESIGNED docs page for tools/skin-io (Adrian x Claude Design, 2026-07-17; source drop:
// MrMiata inbox/Docs/"Skin IO Docs.html"; the embedded UI shot is byte-identical to
// inbox/FSWindows/skin_io.png). Shared furniture: designed-doc.css (incl. dd-fact rows).
// Page-specific: the Direct/Transfer mode cards and the steps-beside-window grid. The
// drop's step-1 gradient stop #131802 was an off-palette typo; standard step treatment.
import DocsLayout from '../../../layouts/DocsLayout.astro';
import { Image } from 'astro:assets';
import '../../../styles/designed-doc.css';
import DocsWatchCard from '../../../components/DocsWatchCard.astro';
import { tutorialByName } from '../../../data/tutorials';
import skinIoUi from '../../../assets/docs/skin-io/skin-io-ui.png';

const SUMMARY =
  'Saves skin weights to a portable JSON file and loads them back: in place, or transferred by closest point onto a rebuilt mesh.';

const TITLE = 'SKIN IO';
const TRI = ['t-bone', 't-plasma', 't-ember'];
// The cycle counts letters only, continuing across word gaps (Claude Design's treatment).
let li = 0;
const titleGlyphs = TITLE.split('').map((ch) => ({ ch, cls: ch === ' ' ? 't-gap' : TRI[li++ % 3] }));
---
<DocsLayout title="Skin IO | FabricatorStudio Docs" description={SUMMARY}>
  <article class="dd">
    <a class="dd-breadcrumb" href="/docs/">Docs</a>

    <header class="dd-header">
      <div class="dd-eyebrow">FABRICATOR &middot; SKINNING</div>
      <h1 class="dd-title" aria-label={TITLE}>
        {titleGlyphs.map((g) =>
          g.cls === 't-gap' ? <span class="t-gap"></span> : <span aria-hidden="true" class={g.cls}>{g.ch}</span>
        )}
      </h1>
      <p class="dd-summary">{SUMMARY}</p>
    </header>

    <DocsWatchCard video={tutorialByName('Skin IO')} />

    <!-- WHAT IT DOES -->
    <section class="dd-panel" aria-labelledby="sio-what">
      <div class="dd-panel__head">
        <h2 id="sio-what" class="dd-label dd-label--plasma">WHAT IT DOES</h2>
        <p class="dd-lede">Weights to JSON, back two ways</p>
      </div>
      <p class="dd-prose sio-lede">Skin IO saves a mesh's skin weights to a JSON file and loads them back. A load can be <b>scoped to selected vertices</b> to patch one area. It ships as popover shortcuts on a fixed temp file, plus a full window with Save and Load tabs.</p>
      <div class="sio-modes">
        <div class="sio-mode sio-mode--direct">
          <div class="sio-mode__head"><span class="sio-mode__badge sio-mode__badge--plasma">DIRECT</span><span class="sio-mode__sub sio-mode__sub--plasma">same mesh</span></div>
          <p class="sio-mode__line">Loads weights straight back onto the <b>same mesh</b>, vertex for vertex.</p>
          <div class="sio-fig" aria-hidden="true">
            <span class="sio-fig__json sio-fig__json--plasma">&lbrace; &rbrace;</span>
            <span class="sio-fig__arrow sio-fig__arrow--plasma">&rarr;</span>
            <span class="sio-fig__mesh"><span class="sio-fig__circle"></span></span>
          </div>
        </div>
        <div class="sio-mode sio-mode--transfer">
          <div class="sio-mode__head"><span class="sio-mode__badge sio-mode__badge--ember">TRANSFER</span><span class="sio-mode__sub sio-mode__sub--ember">closest point</span></div>
          <p class="sio-mode__line">Transfers weights by <b>closest point</b> onto a rebuilt mesh; different topology is fine.</p>
          <div class="sio-fig" aria-hidden="true">
            <span class="sio-fig__json sio-fig__json--ember">&lbrace; &rbrace;</span>
            <span class="sio-fig__arrow sio-fig__arrow--ember">&rarr;</span>
            <span class="sio-fig__mesh"><span class="sio-fig__square"></span></span>
          </div>
        </div>
      </div>
    </section>

    <!-- QUICK START + THE WINDOW -->
    <section class="dd-panel dd-panel--ember" aria-labelledby="sio-quickstart">
      <div class="dd-panel__head">
        <h2 id="sio-quickstart" class="dd-label dd-label--ember">QUICK START</h2>
        <p class="dd-lede">Save, then load, Direct or Transfer</p>
      </div>
      <div class="sio-qs">
        <ol class="dd-steps">
          <li class="dd-step dd-step--plasma"><span class="dd-step__num">1</span><p>Open the Skin popover on the Bridge toolbar and click <b>"Skin IO Window&hellip;"</b> (or the Maya menu entry).</p></li>
          <li class="dd-step dd-step--plasma"><span class="dd-step__num">2</span><p>On <b class="b-plasma">SAVE</b>, select your mesh, click Use Selected, confirm the output path, and click <b class="b-plasma">Save Skin Weights</b>.</p></li>
          <li class="dd-step dd-step--ember"><span class="dd-step__num">3</span><p>On <b class="b-ember">LOAD</b>, select the target mesh, click Use Selected, and set Skin File to the saved JSON.</p></li>
          <li class="dd-step dd-step--ember"><span class="dd-step__num">4</span><p>Pick <b>Direct</b> or <b>Transfer</b>, then click <b class="b-ember">Load Skin Weights</b>.</p></li>
        </ol>
        <div class="dd-gui__shot sio-window">
          <div class="dd-gui__edge" aria-hidden="true"></div>
          <Image src={skinIoUi} alt="The Skin IO window: Save and Load tabs with mesh, skin file, and mode options" densities={[1, 2]} />
        </div>
      </div>
    </section>

    <!-- GOOD TO KNOW -->
    <section class="dd-section" aria-labelledby="sio-gtk">
      <div class="dd-panel__head dd-panel__head--bare">
        <h2 id="sio-gtk" class="dd-label dd-label--plasma">GOOD TO KNOW</h2>
      </div>
      <div class="dd-facts">
        <div class="dd-fact dd-fact--ember">
          <span class="dd-fact__num">1</span>
          <div>
            <h3 class="dd-fact__name">Direct checks count, not order</h3>
            <p class="dd-fact__line">Direct mode only checks vertex count, not order. Use <b class="b-ember">Transfer</b> whenever the mesh was rebuilt, even if the count matches.</p>
          </div>
        </div>
        <div class="dd-fact dd-fact--plasma">
          <span class="dd-fact__num">2</span>
          <div>
            <h3 class="dd-fact__name">Single target for Direct &amp; scoped</h3>
            <p class="dd-fact__line">Direct mode and vertex-scoped loads need a single target mesh; use <b class="b-plasma">Transfer</b> for multiple meshes.</p>
          </div>
        </div>
        <div class="dd-fact dd-fact--ember">
          <span class="dd-fact__num">3</span>
          <div>
            <h3 class="dd-fact__name">Missing influences skipped by default</h3>
            <p class="dd-fact__line">"Create missing influences" is off by default, so missing joints are silently skipped unless you turn it on.</p>
          </div>
        </div>
      </div>
    </section>
  </article>
</DocsLayout>

<style>
  /* Page-specific: the Direct/Transfer mode cards and the steps-beside-window grid.
     Shared furniture: designed-doc.css. */
  .sio-lede { max-width: 58rem; }

  .sio-modes { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .sio-mode { border-radius: 12px; padding: 1.5rem 1.5rem; display: flex; flex-direction: column; gap: 0.75rem; }
  /* Plasma-at-alpha wash over carbon (palette-legal gradient stops). */
  .sio-mode--direct {
    background: linear-gradient(160deg, rgba(124, 255, 178, 0.1), rgba(124, 255, 178, 0)), var(--carbon);
    border: 1px solid rgba(124, 255, 178, 0.4);
  }
  .sio-mode--transfer { background: var(--carbon); border: 1px solid rgba(255, 122, 61, 0.35); }
  .sio-mode__head { display: flex; align-items: center; gap: 0.7rem; }
  .sio-mode__badge { padding: 0.25rem 0.7rem; border-radius: 7px; font-family: var(--font-mono); font-weight: 800; font-size: 0.75rem; letter-spacing: 0.08em; }
  .sio-mode__badge--plasma { background: var(--plasma); color: #06120B; }
  .sio-mode__badge--ember { background: var(--ember); color: #1A0A02; }
  .sio-mode__sub { font-family: var(--font-mono); font-size: 0.8125rem; }
  .sio-mode__sub--plasma { color: var(--plasma-dim); }
  .sio-mode__sub--ember { color: var(--ember-dim); }
  .sio-mode__line { margin: 0; font-size: 0.875rem; line-height: 1.55; color: var(--bone-dim); }
  .sio-mode__line b { color: var(--bone); }
  .sio-fig { display: flex; align-items: center; gap: 0.7rem; margin-top: 0.25rem; }
  .sio-fig__json {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 10px;
    background: var(--iron);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-weight: 800;
    font-size: 0.9375rem;
  }
  .sio-fig__json--plasma { border: 1px solid rgba(124, 255, 178, 0.3); color: var(--plasma); }
  .sio-fig__json--ember { border: 1px solid rgba(255, 122, 61, 0.3); color: var(--ember); }
  .sio-fig__arrow { font-size: 1.125rem; font-weight: 800; }
  .sio-fig__arrow--plasma { color: var(--plasma); }
  .sio-fig__arrow--ember { color: var(--ember); }
  .sio-fig__mesh {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 10px;
    background: var(--iron);
    border: 1px solid rgba(232, 224, 208, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .sio-fig__circle { width: 1.125rem; height: 1.125rem; border: 2px solid var(--bone); border-radius: 50%; }
  .sio-fig__square { width: 1.125rem; height: 1.125rem; border: 2px solid var(--bone); border-radius: 4px; transform: rotate(12deg); }

  .sio-qs { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 1.75rem; align-items: start; }
  .sio-window { max-width: 27rem; }

  @media (max-width: 820px) {
    .sio-modes { grid-template-columns: 1fr; }
    .sio-qs { grid-template-columns: 1fr; }
    .sio-window { margin: 0 auto; width: 100%; }
  }
</style>
