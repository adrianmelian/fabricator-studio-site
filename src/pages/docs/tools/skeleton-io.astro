---
// DESIGNED docs page for tools/skeleton-io (Adrian x Claude Design, 2026-07-17; source
// drop: MrMiata inbox/Docs/"Skeleton IO Docs.html"; UI capture added per Adrian from
// inbox/FSWindows/skeleton_io.png). Shared furniture: designed-doc.css (incl. dd-fact
// rows). Page-specific: the export-to-JSON-to-import triptych and the tool-window figure.
import DocsLayout from '../../../layouts/DocsLayout.astro';
import { Image } from 'astro:assets';
import '../../../styles/designed-doc.css';
import ToolbarLocator from '../../../components/ToolbarLocator.astro';
import skeletonIoUi from '../../../assets/docs/skeleton-io/skeleton-io-ui.png';
import toolbarIcon from '../../../assets/docs/toolbar/icons/skeleton-io.png';

const SUMMARY =
  'Save a joint hierarchy to portable JSON and rebuild it in any scene, with options to strip scale offsets and control how rotation splits between rotate and joint orient.';

const TITLE = 'SKELETON IO';
const TRI = ['t-bone', 't-plasma', 't-ember'];
// The cycle counts letters only, continuing across word gaps (Claude Design's treatment).
let li = 0;
const titleGlyphs = TITLE.split('').map((ch) => ({ ch, cls: ch === ' ' ? 't-gap' : TRI[li++ % 3] }));
---
<DocsLayout title="Skeleton IO | FabricatorStudio Docs" description={SUMMARY}>
  <article class="dd">
    <a class="dd-breadcrumb" href="/docs/">Docs</a>

    <header class="dd-header">
      <div class="dd-eyebrow">FABRICATOR &middot; RIGGING</div>
      <h1 class="dd-title" aria-label={TITLE}>
        {titleGlyphs.map((g) =>
          g.cls === 't-gap' ? <span class="t-gap"></span> : <span aria-hidden="true" class={g.cls}>{g.ch}</span>
        )}
      </h1>
      <p class="dd-summary">{SUMMARY}</p>
    </header>

    <ToolbarLocator icon={toolbarIcon} name="Skeleton IO" button="skeleton" x={838} y={28} />

    <!-- WHAT IT DOES -->
    <section class="dd-panel" aria-labelledby="sk-what">
      <div class="dd-panel__head">
        <h2 id="sk-what" class="dd-label dd-label--plasma">What it does</h2>
        <p class="dd-lede">Joint hierarchy in, JSON out, and back</p>
      </div>
      <div class="sk-trip" aria-label="Export a joint hierarchy to a portable JSON file, import it to rebuild anywhere">
        <div class="sk-stage">
          <div class="sk-tile">
            <svg class="sk-skel" viewBox="0 0 160 150" aria-hidden="true">
              <line x1="80" y1="20" x2="80" y2="70" stroke="#E8E0D0" stroke-width="4" />
              <line x1="80" y1="70" x2="45" y2="130" stroke="#E8E0D0" stroke-width="4" />
              <line x1="80" y1="70" x2="120" y2="120" stroke="#E8E0D0" stroke-width="4" />
              <circle cx="80" cy="20" r="9" fill="none" stroke="#7CFFB2" stroke-width="4" />
              <circle cx="80" cy="70" r="7" fill="#E8E0D0" />
              <circle cx="45" cy="130" r="7" fill="#E8E0D0" />
              <circle cx="120" cy="120" r="7" fill="#E8E0D0" />
            </svg>
          </div>
          <div class="sk-stage__name">Joint hierarchy</div>
        </div>
        <div class="sk-arrow" aria-hidden="true"><span class="sk-arrow__glyph sk-arrow__glyph--plasma">&rarr;</span><span class="sk-arrow__label">EXPORT</span></div>
        <div class="sk-stage">
          <div class="sk-tile sk-tile--json">
            <div class="sk-json"><span class="sk-json__braces">&lbrace;&nbsp;&rbrace;</span><span class="sk-json__label">JSON</span></div>
          </div>
          <div class="sk-stage__name">Portable file</div>
        </div>
        <div class="sk-arrow" aria-hidden="true"><span class="sk-arrow__glyph sk-arrow__glyph--ember">&rarr;</span><span class="sk-arrow__label">IMPORT</span></div>
        <div class="sk-stage">
          <div class="sk-tile sk-tile--ember">
            <svg class="sk-skel" viewBox="0 0 160 150" aria-hidden="true">
              <line x1="80" y1="20" x2="80" y2="70" stroke="#E8E0D0" stroke-width="4" />
              <line x1="80" y1="70" x2="45" y2="130" stroke="#E8E0D0" stroke-width="4" />
              <line x1="80" y1="70" x2="120" y2="120" stroke="#E8E0D0" stroke-width="4" />
              <circle cx="80" cy="20" r="9" fill="none" stroke="#FF7A3D" stroke-width="4" />
              <circle cx="80" cy="70" r="7" fill="#E8E0D0" />
              <circle cx="45" cy="130" r="7" fill="#E8E0D0" />
              <circle cx="120" cy="120" r="7" fill="#E8E0D0" />
            </svg>
          </div>
          <div class="sk-stage__name">Rebuilt in any scene</div>
        </div>
      </div>
      <div class="sk-cards">
        <div class="sk-card">
          <h3 class="sk-card__name">Captures everything</h3>
          <p class="sk-card__line">Each joint's position, orientation, rotate order, limits, and lock states, and rebuilds accurately regardless of the original rotate order.</p>
        </div>
        <div class="sk-card">
          <h3 class="sk-card__name">Import options</h3>
          <p class="sk-card__line">Strip unwanted scale, and choose whether rotation folds into <b class="b-plasma">joint orient</b> or stays split as it was.</p>
        </div>
      </div>
    </section>

    <!-- THE WINDOW -->
    <section class="dd-panel" aria-labelledby="sk-window">
      <div class="dd-panel__head">
        <h2 id="sk-window" class="dd-label dd-label--plasma">The window</h2>
        <p class="dd-lede">Export and Import, one panel each</p>
      </div>
      <div class="dd-gui__shot sk-window">
        <div class="dd-gui__edge" aria-hidden="true"></div>
        <Image src={skeletonIoUi} alt="The Skeleton IO window: Export and Import tabs with path, selection, and scale options" densities={[1, 2]} />
      </div>
    </section>

    <!-- QUICK START -->
    <section class="dd-section" aria-labelledby="sk-quickstart">
      <div class="dd-panel__head dd-panel__head--bare">
        <h2 id="sk-quickstart" class="dd-label dd-label--plasma">Quick start</h2>
        <p class="dd-lede">Export once, rebuild anywhere</p>
      </div>
      <ol class="dd-steps">
        <li class="dd-step dd-step--plasma"><span class="dd-step__num">1</span><p>Select the <b>root joint</b> of the hierarchy you want to save.</p></li>
        <li class="dd-step dd-step--plasma"><span class="dd-step__num">2</span><p>Open Skeleton IO from the <b>Bridge toolbar's Skeleton popover</b>, Maya's Skeleton menu, or the fsAnim shelf.</p></li>
        <li class="dd-step dd-step--plasma"><span class="dd-step__num">3</span><p>On <b class="b-plasma">Export</b>, click Use Selected, confirm the output path, and click <b class="b-plasma">Export Skeleton</b>.</p></li>
        <li class="dd-step dd-step--ember"><span class="dd-step__num">4</span><p>To rebuild, switch to <b class="b-ember">Import</b>, browse to the JSON file, and click <b class="b-ember">Import Skeleton</b>. Leave the scale checkboxes on unless you have a reason to keep scale.</p></li>
      </ol>
    </section>

    <!-- GOOD TO KNOW -->
    <section class="dd-section" aria-labelledby="sk-gtk">
      <div class="dd-panel__head dd-panel__head--bare">
        <h2 id="sk-gtk" class="dd-label dd-label--ember">Good to know</h2>
      </div>
      <div class="dd-facts">
        <div class="dd-fact dd-fact--ember">
          <span class="dd-fact__num">1</span>
          <div>
            <h3 class="dd-fact__name">Names must be unique</h3>
            <p class="dd-fact__line">Joint names must be unique within the hierarchy; duplicates aren't handled.</p>
          </div>
        </div>
        <div class="dd-fact dd-fact--plasma">
          <span class="dd-fact__num">2</span>
          <div>
            <h3 class="dd-fact__name">Custom attrs round-trip, connections don't</h3>
            <p class="dd-fact__line">Custom attribute values round-trip, but connections and driven keys on them do not.</p>
          </div>
        </div>
        <div class="dd-fact dd-fact--plasma">
          <span class="dd-fact__num">3</span>
          <div>
            <h3 class="dd-fact__name">Bake to joint orient</h3>
            <p class="dd-fact__line">"Bake to joint orient" folds rotation into joint orient and zeroes rotate; leaving it off keeps the original split.</p>
          </div>
        </div>
      </div>
    </section>
  </article>
</DocsLayout>

<style>
  /* Page-specific: the export/import triptych, the info cards, and the tool-window
     figure. Shared furniture: designed-doc.css. */
  .sk-trip { display: grid; grid-template-columns: 1fr 3.25rem 1fr 3.25rem 1fr; align-items: center; }
  .sk-stage { display: flex; flex-direction: column; align-items: center; gap: 0.7rem; min-width: 0; }
  .sk-stage__name { font-family: var(--font-mono); font-weight: 700; font-size: 0.875rem; color: var(--bone); text-align: center; }
  .sk-tile {
    width: 100%;
    aspect-ratio: 1 / 0.9;
    border-radius: 12px;
    background: radial-gradient(120% 120% at 50% 45%, var(--iron), var(--carbon));
    border: 1px solid rgba(124, 255, 178, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .sk-tile--ember { border-color: rgba(255, 122, 61, 0.35); }
  /* Plasma-at-alpha wash over carbon (palette-legal gradient stops), plus the halo. */
  .sk-tile--json {
    background: linear-gradient(160deg, rgba(124, 255, 178, 0.1), rgba(124, 255, 178, 0)), var(--carbon);
    border-color: rgba(124, 255, 178, 0.5);
    box-shadow: 0 0 30px -12px rgba(124, 255, 178, 0.4);
  }
  .sk-skel { width: 60%; height: auto; overflow: visible; }
  .sk-json { text-align: center; display: flex; flex-direction: column; gap: 0.25rem; }
  .sk-json__braces { font-family: var(--font-mono); font-size: 2rem; font-weight: 800; color: var(--plasma); letter-spacing: 0.05em; }
  .sk-json__label { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.2em; color: var(--plasma-dim); }
  .sk-arrow { display: flex; flex-direction: column; align-items: center; gap: 0.1rem; padding-bottom: 1.5rem; }
  .sk-arrow__glyph { font-size: 1.375rem; font-weight: 800; }
  .sk-arrow__glyph--plasma { color: var(--plasma); }
  .sk-arrow__glyph--ember { color: var(--ember); }
  .sk-arrow__label { font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: 0.15em; color: var(--bone-faint); }

  .sk-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; padding-top: 0.25rem; }
  .sk-card {
    background: var(--carbon);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    padding: 1.25rem 1.375rem;
  }
  .sk-card__name { margin: 0 0 0.5rem; font-family: var(--font-mono); font-weight: 700; font-size: 0.9860rem; color: var(--bone); }
  .sk-card__line { margin: 0; font-size: 0.875rem; line-height: 1.55; color: var(--bone-dim); }

  /* The tool window at a hair under its native 459px, centered. */
  .sk-window { max-width: 27rem; margin: 0 auto; width: 100%; }

  @media (max-width: 820px) {
    .sk-trip { grid-template-columns: 1fr; gap: 0.75rem; }
    .sk-arrow { flex-direction: row; padding: 0; gap: 0.5rem; }
    .sk-arrow__glyph { transform: rotate(90deg); }
    .sk-cards { grid-template-columns: 1fr; }
  }
</style>
