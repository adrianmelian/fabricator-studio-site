---
// DESIGNED docs page for tools/project-setup (Adrian x Claude Design, 2026-07-19; source
// drop: MrMiata inbox/Docs/"Project Setup.html"). REWRITTEN FOR v2 of the tool: the old
// single Project Root is replaced by Source Art Root + Content Root, and the config is now
// machine-path-free so a team can share one. Supersedes the 2026-07-17 port.
// Shared furniture: designed-doc.css. Page-specific: the two-settings-files cards, the
// READ BY bar, the shareable-config panel, and the window walkthrough.
import DocsLayout from '../../../layouts/DocsLayout.astro';
import { Image } from 'astro:assets';
import '../../../styles/designed-doc.css';
import DocsWatchCard from '../../../components/DocsWatchCard.astro';
import ToolbarLocator from '../../../components/ToolbarLocator.astro';
import { tutorialByName } from '../../../data/tutorials';
import mindmeldWindow from '../../../assets/docs/project-setup/mindmeld-window.png';
import toolbarIcon from '../../../assets/docs/toolbar/icons/project-setup.png';

const SUMMARY =
  "Creates and manages your project configs. Author session and export settings from engine templates with live validation. Your machine's folder locations bind separately, so teams stay in sync across different drives.";

const TITLE = 'PROJECT SETUP';
const TRI = ['t-bone', 't-plasma', 't-ember'];
// The cycle counts glyphs only, continuing across word gaps (Claude Design's treatment).
let li = 0;
const titleGlyphs = TITLE.split('').map((ch) => ({ ch, cls: ch === ' ' ? 't-gap' : TRI[li++ % 3] }));

const WINDOW_ROWS = [
  {
    n: '01',
    tone: 'plasma',
    name: 'Name & Engine',
    body: 'Name the project and pick its engine template. Locks once created.',
  },
  {
    n: '02',
    tone: 'ember',
    name: 'Source Art & Content Roots',
    body: 'Per-machine paths, never shared: the source art tree and the engine content tree on this computer.',
  },
  {
    n: '03',
    tone: 'plasma',
    name: 'Session settings',
    body: 'Units, frame rate, playback range, undo depth, camera clip, plus an optional grid.',
  },
  {
    n: '04',
    tone: 'plasma',
    name: 'Asset Classes',
    body: 'The export table: ID, label, export types, source and dest dirs per asset type.',
  },
  {
    n: '05',
    tone: 'plasma',
    name: 'Library roots & blueprints',
    body: 'Pose and Animation Studio roots default under Source Art Root; Blueprints blank means factory only.',
  },
  {
    n: '06',
    tone: 'bone',
    name: 'Advanced & Validation',
    body: 'FBX presets and prefixes come from the engine template; Save stays disabled while an error is listed.',
  },
];

const STEPS = [
  {
    tone: 'plasma',
    body: 'Open Project Setup from the <b>FabricatorStudio toolbar or menu</b>.',
  },
  {
    tone: 'plasma',
    body: 'Click <b class="b-plasma">New</b>, pick an engine template (Unreal5 vetted; Unity and Godot experimental; Generic empty), and name your project.',
  },
  {
    tone: 'plasma',
    body: "Browse to your <b>Source Art Root</b> (working files on this machine) and <b>Content Root</b> (where exports land, like your engine's content folder).",
  },
  {
    tone: 'plasma',
    body: 'Fill in <b>Asset Classes</b> and watch the validation panel. Save stays disabled while an error is listed.',
  },
  {
    tone: 'ember',
    body: 'Save, optionally check off which <b>folders to create</b> on disk, then select the project and click <b class="b-ember">Apply &amp; Activate</b> to apply it to your current session.',
  },
];

const FACTS = [
  {
    tone: 'plasma',
    name: 'Two roots replaced the old single Project Root',
    body: 'Older projects keep working untouched: the old root fills in <b class="b-plasma">both</b> automatically, and the config upgrades on your first save. Exports resolve identically before and after.',
  },
  {
    tone: 'plasma',
    name: 'Your roots are yours',
    body: 'A teammate opening the same project binds their own paths; nothing you save forces your drive letters on anyone.',
  },
  {
    tone: 'plasma',
    name: 'Bind a machine without touching the config',
    body: 'The quickest way is the <a href="/docs/tools/settings/">Settings tool</a> (left-click the toolbar gear). Handy when the shared config folder is read-only.',
  },
  {
    tone: 'ember',
    name: 'Engine template locks once created',
    body: 'To switch, <b class="b-plasma">Duplicate</b> under a new template, then delete the old one.',
  },
  {
    tone: 'ember',
    name: 'Rename-that-moves-the-folder is blocked',
    body: 'Renaming a project so its folder would change is blocked. <b class="b-plasma">Duplicate</b> under the new name instead.',
  },
  {
    tone: 'ember',
    name: 'Export target follows file path',
    body: "Apply and Activate doesn't change which project a scene exports to. That is always based on file path.",
  },
];
---
<DocsLayout title="Project Setup | FabricatorStudio Docs" description={SUMMARY}>
  <article class="dd">
    <a class="dd-breadcrumb" href="/docs/">Docs</a>

    <header class="dd-header">
      <div class="ps-eyebrow-row">
        <div class="dd-eyebrow">FABRICATOR &middot; FRAMEWORK</div>
        <span class="ps-badge">WINDOW: MINDMELD</span>
      </div>
      <h1 class="dd-title" aria-label={TITLE}>
        {titleGlyphs.map((g) =>
          g.cls === 't-gap' ? <span class="t-gap"></span> : <span aria-hidden="true" class={g.cls}>{g.ch}</span>
        )}
      </h1>
      <p class="dd-summary">{SUMMARY}</p>
    </header>

    <DocsWatchCard video={tutorialByName('Mindmeld')} />

    <ToolbarLocator icon={toolbarIcon} name="MindMeld" sub="Project Setup" button="light bulb" x={238} />

    <!-- WHAT IT DOES -->
    <section class="dd-panel" aria-labelledby="ps-what">
      <div class="dd-panel__head">
        <h2 id="ps-what" class="dd-label dd-label--plasma">WHAT IT DOES</h2>
        <p class="dd-lede">Two settings files, one source of truth</p>
      </div>
      <p class="dd-prose ps-lede">Project Setup (window title: <b>Mindmeld</b>) authors the two settings files every project runs on. Save once, and the exporters, libraries, and your Maya session all read from that same source.</p>
      <div class="ps-files">
        <div class="ps-file ps-file--plasma">
          <div class="ps-file__top"><span class="ps-file__glyph ps-file__glyph--plasma" aria-hidden="true">&#123; &#125;</span><h3 class="ps-file__name">Session settings</h3></div>
          <div class="ps-chips">
            {['units', 'frame rate', 'playback range'].map((c) => <span class="ps-chip">{c}</span>)}
          </div>
        </div>
        <div class="ps-file ps-file--ember">
          <div class="ps-file__top"><span class="ps-file__glyph ps-file__glyph--ember" aria-hidden="true">&#123; &#125;</span><h3 class="ps-file__name">Export settings</h3></div>
          <div class="ps-chips">
            {['output folders', 'prefixes', 'FBX presets'].map((c) => <span class="ps-chip">{c}</span>)}
          </div>
        </div>
      </div>
      <div class="ps-readby">
        <span class="ps-readby__label">READ BY</span>
        {['Exporters', 'Libraries', 'Maya session'].map((r) => <span class="ps-readby__pill">{r}</span>)}
      </div>
    </section>

    <!-- NEW THIS RELEASE: SHAREABLE CONFIG -->
    <section class="ps-share" aria-labelledby="ps-share-t">
      <div class="ps-share__head">
        <span class="ps-share__flag">NEW THIS RELEASE</span>
        <h2 id="ps-share-t" class="ps-share__title">A config you can share</h2>
      </div>
      <p class="dd-prose">A project config now carries <b class="b-plasma">no machine-specific paths</b>. Where the project lives on each computer is a separate per-machine binding, so teammates on different drive letters share one config without stepping on each other.</p>
      <div class="ps-split">
        <div class="ps-split__card ps-split__card--plasma">
          <div class="ps-split__tag ps-split__tag--plasma">SHARED &middot; IN THE CONFIG</div>
          <h3 class="ps-split__name">The project</h3>
          <p class="ps-split__body">Engine template, session and export settings, asset classes, subpaths. Committed and shared with the whole team.</p>
        </div>
        <div class="ps-split__card ps-split__card--ember">
          <div class="ps-split__tag ps-split__tag--ember">PER-MACHINE &middot; BOUND LOCALLY</div>
          <h3 class="ps-split__name">Source Art Root + Content Root</h3>
          <p class="ps-split__body">Where THIS machine keeps the working files and where exports land. Never shared, yours alone.</p>
        </div>
      </div>
    </section>

    <!-- THE WINDOW -->
    <section class="dd-panel" aria-labelledby="ps-gui">
      <div class="dd-panel__head">
        <h2 id="ps-gui" class="dd-label dd-label--plasma">THE WINDOW</h2>
        <p class="dd-lede">Name, two roots, session, asset classes, export</p>
      </div>
      <div class="ps-gui">
        <div class="ps-shot">
          <span class="ps-shot__edge" aria-hidden="true"></span>
          <Image src={mindmeldWindow} alt="The Mindmeld Project Setup window: name and engine, source art and content roots, session settings, asset classes, and export options" widths={[640, 1280]} sizes="(max-width: 980px) 92vw, 640px" />
        </div>
        <ol class="ps-rows">
          {WINDOW_ROWS.map((w) => (
            <li class={`ps-row ps-row--${w.tone}`}>
              <span class={`ps-row__num ps-row__num--${w.tone}`}>{w.n}</span>
              <div>
                <h3 class="ps-row__name">{w.name}</h3>
                <p class="ps-row__body">{w.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- QUICK START -->
    <section class="dd-section" aria-labelledby="ps-start">
      <div class="dd-panel__head dd-panel__head--bare">
        <h2 id="ps-start" class="dd-label dd-label--ember">QUICK START</h2>
        <p class="dd-lede">New project, roots, validate, activate</p>
      </div>
      <ol class="dd-steps">
        {STEPS.map((s, i) => (
          <li class={`dd-step dd-step--${s.tone}`}>
            <span class="dd-step__num">{i + 1}</span>
            <p set:html={s.body} />
          </li>
        ))}
      </ol>
    </section>

    <!-- GOOD TO KNOW -->
    <section class="dd-section" aria-labelledby="ps-gtk">
      <div class="dd-panel__head dd-panel__head--bare">
        <h2 id="ps-gtk" class="dd-label dd-label--plasma">GOOD TO KNOW</h2>
      </div>
      <div class="dd-facts">
        {FACTS.map((f, i) => (
          <div class={`dd-fact dd-fact--${f.tone}`}>
            <span class="dd-fact__num">{i + 1}</span>
            <div>
              <h3 class="dd-fact__name">{f.name}</h3>
              <p class="dd-fact__line" set:html={f.body} />
            </div>
          </div>
        ))}
      </div>
      <div class="ps-star">
        <span class="ps-star__badge" aria-hidden="true">&starf;</span>
        <div>
          <h3 class="ps-star__name">Studio setup is supported</h3>
          <p class="ps-star__line">One shared configs folder for the whole team: point <b class="b-plasma">Shared Configs Root</b> at it in <a href="/docs/tools/settings/">Settings</a>, and contact FabricatorStudio for team setup help.</p>
        </div>
      </div>
    </section>
  </article>
</DocsLayout>

<style>
  /* Page-specific: the window badge, the two settings-file cards, the READ BY bar, the
     shareable-config panel, the window walkthrough, and the closing star note.
     Shared furniture: designed-doc.css. */
  .ps-eyebrow-row { display: flex; align-items: center; gap: 0.9rem; flex-wrap: wrap; }
  .ps-badge {
    padding: 0.3rem 0.8rem;
    border-radius: 7px;
    background: rgba(124, 255, 178, 0.12);
    border: 1px solid rgba(124, 255, 178, 0.45);
    color: var(--plasma);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
  }
  .ps-lede { max-width: 62rem; }
  .ps-lede b { color: var(--bone); }

  .ps-files { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
  .ps-file { background: var(--carbon); border-radius: 14px; padding: 1.5rem 1.625rem; display: flex; flex-direction: column; gap: 0.9rem; }
  .ps-file--plasma { border: 1px solid rgba(124, 255, 178, 0.25); }
  .ps-file--ember { border: 1px solid rgba(255, 122, 61, 0.25); }
  .ps-file__top { display: flex; align-items: center; gap: 0.7rem; }
  .ps-file__glyph { font-family: var(--font-mono); font-size: 1.125rem; font-weight: 800; }
  .ps-file__glyph--plasma { color: var(--plasma); }
  .ps-file__glyph--ember { color: var(--ember); }
  .ps-file__name { margin: 0; font-family: var(--font-mono); font-weight: 800; font-size: 1.125rem; color: var(--bone); }
  .ps-chips { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  .ps-chip {
    padding: 0.4rem 0.85rem;
    border-radius: 8px;
    background: var(--iron);
    border: 1px solid rgba(255, 255, 255, 0.08);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--bone-dim);
  }

  .ps-readby {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    flex-wrap: wrap;
    background: var(--carbon);
    border: 1px solid rgba(124, 255, 178, 0.2);
    border-radius: 14px;
    padding: 1.125rem 1.5rem;
  }
  .ps-readby__label { font-family: var(--font-mono); font-size: 0.8125rem; letter-spacing: 0.12em; color: var(--bone-faint); }
  .ps-readby__pill {
    padding: 0.4rem 0.85rem;
    border-radius: 8px;
    background: var(--iron);
    border: 1px solid rgba(124, 255, 178, 0.3);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.875rem;
    color: var(--plasma);
  }

  /* NEW THIS RELEASE: the shareable-config pull-quote, plasma spine. */
  .ps-share {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    background: linear-gradient(120deg, rgba(124, 255, 178, 0.1), rgba(124, 255, 178, 0)), var(--carbon);
    border: 1px solid rgba(124, 255, 178, 0.22);
    border-left: 3px solid var(--plasma);
    border-radius: 0 22px 22px 0;
    padding: 2.25rem 2.5rem 2.5rem;
    box-shadow: var(--shadow-lg);
  }
  .ps-share__head { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .ps-share__flag {
    padding: 0.35rem 0.8rem;
    border-radius: 7px;
    background: rgba(124, 255, 178, 0.14);
    border: 1px solid rgba(124, 255, 178, 0.45);
    color: var(--plasma);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
  }
  .ps-share__title { margin: 0; font-family: var(--font-mono); font-weight: 800; font-size: clamp(1.25rem, 2.6vw, 1.625rem); color: var(--bone); }
  .ps-split { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
  .ps-split__card { background: var(--iron); border-radius: 14px; padding: 1.625rem 1.75rem; display: flex; flex-direction: column; gap: 0.7rem; }
  .ps-split__card--plasma { border: 1px solid rgba(124, 255, 178, 0.25); }
  .ps-split__card--ember { border: 1px solid rgba(255, 122, 61, 0.28); }
  .ps-split__tag { font-family: var(--font-mono); font-weight: 700; font-size: 0.75rem; letter-spacing: 0.2em; }
  .ps-split__tag--plasma { color: var(--plasma); }
  .ps-split__tag--ember { color: var(--ember); }
  .ps-split__name { margin: 0; font-family: var(--font-mono); font-weight: 800; font-size: 1.1875rem; color: var(--bone); }
  .ps-split__body { margin: 0; font-size: 0.9375rem; line-height: 1.55; color: var(--bone-dim); }

  .ps-gui { display: grid; grid-template-columns: minmax(0, 640px) minmax(0, 1fr); gap: 2.25rem; align-items: start; }
  .ps-shot {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: var(--shadow-lg), 0 0 0 1px rgba(124, 255, 178, 0.12);
  }
  .ps-shot :global(img) { display: block; width: 100%; height: auto; }
  .ps-shot__edge {
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: 0;
    width: 3px;
    z-index: 3;
    background: linear-gradient(180deg, rgba(124, 255, 178, 0), rgba(124, 255, 178, 0.85), rgba(124, 255, 178, 0));
  }
  .ps-rows { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.7rem; position: sticky; top: 2rem; }
  .ps-row { display: flex; gap: 1rem; align-items: flex-start; background: var(--carbon); border-radius: 12px; padding: 1.125rem 1.25rem; }
  .ps-row--plasma { border: 1px solid rgba(124, 255, 178, 0.2); }
  .ps-row--ember { border: 1px solid rgba(255, 122, 61, 0.2); }
  .ps-row--bone { border: 1px solid rgba(255, 255, 255, 0.08); }
  .ps-row__num { flex: none; font-family: var(--font-mono); font-weight: 800; font-size: 0.8125rem; letter-spacing: 0.06em; padding-top: 0.15rem; }
  .ps-row__num--plasma { color: var(--plasma); }
  .ps-row__num--ember { color: var(--ember); }
  .ps-row__num--bone { color: var(--bone-faint); }
  .ps-row__name { margin: 0 0 0.2rem; font-family: var(--font-mono); font-weight: 700; font-size: 1rem; color: var(--bone); }
  .ps-row__body { margin: 0; font-size: 0.9375rem; line-height: 1.5; color: var(--bone-dim); }

  .ps-star {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    background: linear-gradient(90deg, rgba(124, 255, 178, 0.08), rgba(124, 255, 178, 0)), var(--carbon);
    border: 1px solid rgba(124, 255, 178, 0.25);
    border-radius: 14px;
    padding: 1.5rem 1.75rem;
  }
  .ps-star__badge {
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 10px;
    background: rgba(124, 255, 178, 0.14);
    color: var(--plasma);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
  }
  .ps-star__name { margin: 0 0 0.35rem; font-family: var(--font-mono); font-weight: 700; font-size: 1.0625rem; color: var(--bone); }
  .ps-star__line { margin: 0; font-size: 0.9375rem; line-height: 1.55; color: var(--bone-dim); }
  .ps-star__line :global(a) { color: var(--plasma); text-decoration: none; }
  .ps-star__line :global(a:hover) { color: var(--plasma-dim); }
  .dd-fact__line :global(a) { color: var(--plasma); text-decoration: none; }
  .dd-fact__line :global(a:hover) { color: var(--plasma-dim); }

  @media (max-width: 980px) {
    .ps-files, .ps-split, .ps-gui { grid-template-columns: 1fr; }
    .ps-rows { position: static; }
  }
</style>
