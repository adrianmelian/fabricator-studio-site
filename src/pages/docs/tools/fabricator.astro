---
// DESIGNED docs page for tools/fabricator, the flagship (Adrian x Claude Design,
// 2026-07-17; source drop: MrMiata inbox/Docs/"Fabricator Docs.html"). Shared furniture:
// src/styles/designed-doc.css. Page-specific: trait pills, the component palette, the
// two-state diptych, the 4-up loop gallery, and the lazy-video loader (seven loops ride
// this page; preload="none" + IntersectionObserver means only what scrolls into view
// downloads, and nothing plays under prefers-reduced-motion). The aimer loop and the GUI
// screenshot are byte-identical to Joint Aimer's and are reused from there, not duplicated.
import DocsLayout from '../../../layouts/DocsLayout.astro';
import LazyVideos from '../../../components/LazyVideos.astro';
import { Image } from 'astro:assets';
import '../../../styles/designed-doc.css';
import VideoFeature from '../../../components/VideoFeature.astro';
import ToolbarLocator from '../../../components/ToolbarLocator.astro';
import { tutorialByName } from '../../../data/tutorials';
import toolbarIcon from '../../../assets/docs/toolbar/icons/fabricator.png';
import fabricatorGui from '../../../assets/docs/fabricator-gui.png';

const SUMMARY =
  "Assemble an Animation Rig from reusable parts, then edit it until it's animation-ready.";

const TITLE = 'FABRICATOR';
const TRI = ['t-bone', 't-plasma', 't-ember'];
// The cycle counts letters only, continuing across word gaps (Claude Design's treatment).
let li = 0;
const titleGlyphs = TITLE.split('').map((ch) => ({ ch, cls: ch === ' ' ? 't-gap' : TRI[li++ % 3] }));
---
<DocsLayout title="Fabricator | FabricatorStudio Docs" description={SUMMARY}>
  <article class="dd">
    <a class="dd-breadcrumb" href="/docs/">Docs</a>

    <header class="dd-header">
      <div class="dd-eyebrow">FABRICATOR &middot; RIGGING &middot; FLAGSHIP</div>
      <h1 class="dd-title" aria-label={TITLE}>
        {titleGlyphs.map((g) =>
          g.cls === 't-gap' ? <span class="t-gap"></span> : <span aria-hidden="true" class={g.cls}>{g.ch}</span>
        )}
      </h1>
      <p class="dd-summary">{SUMMARY}</p>
    </header>

    <VideoFeature video={tutorialByName('Fabricator')} compact />


    <ToolbarLocator icon={toolbarIcon} name="Fabricator" button="fabricator mark" x={908} y={28} />
    <!-- WHAT IT DOES -->
    <section class="dd-panel" aria-labelledby="fb-what">
      <div class="dd-panel__head">
        <h2 id="fb-what" class="dd-label dd-label--plasma">What it does</h2>
        <p class="dd-lede">A networked, modular, non-linear rigging tool</p>
      </div>
      <div class="fb-what">
        <div class="fb-what__copy">
          <div class="fb-traits">
            <span class="fb-trait fb-trait--plasma">NETWORKED</span>
            <span class="fb-trait fb-trait--ember">MODULAR</span>
            <span class="fb-trait fb-trait--plasma">NON-LINEAR</span>
          </div>
          <p class="dd-prose">Assemble a rig from reusable <b>components</b> (FK, IK, spline, ribbon, and more) onto any skeleton, then click <b class="b-plasma">Build Rig</b> to bake them into an animator-friendly rig.</p>
          <p class="dd-prose">Rig state lives in the scene as connected nodes, so renaming joints or controls <b>never breaks it</b>.</p>
          <div class="fb-comps" aria-label="Component palette">
            <span class="fb-comp">FK</span>
            <span class="fb-comp">IK</span>
            <span class="fb-comp">Spline</span>
            <span class="fb-comp">Ribbon</span>
            <span class="fb-comp fb-comp--more">+ more</span>
          </div>
        </div>
        <div class="fb-loop fb-loop--plasma">
          <div class="dd-shot__glow dd-shot__glow--plasma" aria-hidden="true"></div>
          <video data-lazyvid src="/docs/fabricator/what-loop.mp4" muted loop playsinline preload="none" aria-label="Dropping rig components onto a skeleton in Fabricator"></video>
        </div>
      </div>
    </section>

    <!-- TWO STATES -->
    <section class="dd-panel dd-panel--ember" aria-labelledby="fb-states">
      <div class="dd-panel__head">
        <h2 id="fb-states" class="dd-label dd-label--ember">Two states</h2>
        <p class="dd-lede">One button toggles between them; unbuild restores everything</p>
      </div>
      <div class="fb-states">
        <div class="fb-state">
          <div class="fb-loop fb-loop--ember fb-loop--state">
            <div class="dd-shot__glow dd-shot__glow--ember" aria-hidden="true"></div>
            <video data-lazyvid src="/docs/fabricator/armature-state.mp4" muted loop playsinline preload="none" aria-label="The skeleton stage: placing joints and components"></video>
          </div>
          <div class="fb-state__title">
            <h3 class="fb-state__name fb-state__name--ember">ARMATURE STATE</h3>
            <span class="fb-state__pill fb-state__pill--ember">EDIT MODE</span>
          </div>
          <p class="fb-state__cap">Place &amp; orient joints, attach rig components, and do all major edits to the rig.</p>
        </div>
        <div class="fb-states__toggle" aria-hidden="true">
          <div class="fb-states__arrows">&#8644;</div>
          <div class="fb-states__label">BUILD /<br />UNBUILD</div>
        </div>
        <div class="fb-state">
          <div class="fb-loop fb-loop--plasma fb-loop--state fb-loop--lit">
            <div class="dd-shot__glow dd-shot__glow--plasma" aria-hidden="true"></div>
            <video data-lazyvid src="/docs/fabricator/animation-state.mp4" muted loop playsinline preload="none" aria-label="The Animation state: the built rig being posed"></video>
          </div>
          <div class="fb-state__title">
            <h3 class="fb-state__name fb-state__name--plasma">ANIMATION STATE</h3>
            <span class="fb-state__pill fb-state__pill--plasma">BUILD MODE</span>
          </div>
          <p class="fb-state__cap">Ready for animation. Only control-curve shapes and colors change here, no rig editing.</p>
        </div>
      </div>
    </section>

    <!-- THE WINDOW -->
    <section class="dd-panel" aria-labelledby="fb-window">
      <div class="dd-panel__head">
        <h2 id="fb-window" class="dd-label dd-label--plasma">The window</h2>
        <p class="dd-lede">Components, outliner, and properties in one place</p>
      </div>
      <div class="dd-gui__shot fb-window">
        <div class="dd-gui__edge" aria-hidden="true"></div>
        <Image src={fabricatorGui} alt="The Fabricator window: component palette, rig outliner, and properties" widths={[940, 1880]} sizes="(max-width: 820px) 92vw, 760px" />
      </div>
    </section>

    <!-- IN ACTION -->
    <section class="dd-section" aria-labelledby="fb-action">
      <div class="dd-panel__head dd-panel__head--bare">
        <h2 id="fb-action" class="dd-label dd-label--ember">In action</h2>
        <p class="dd-lede">A few of the moving parts</p>
      </div>
      <div class="fb-gallery">
        <figure class="fb-cell">
          <div class="fb-loop fb-loop--square"><video data-lazyvid src="/docs/fabricator/live-symmetry.mp4" muted loop playsinline preload="none" aria-label="Live symmetry mirroring edits to the other side"></video></div>
          <figcaption class="fb-cell__cap">Live symmetry</figcaption>
        </figure>
        <figure class="fb-cell">
          <div class="fb-loop fb-loop--square"><video data-lazyvid src="/docs/joint-aimer/aimer-loop.mp4" muted loop playsinline preload="none" aria-label="A joint aimer rotating live"></video></div>
          <figcaption class="fb-cell__cap">Joint aimers</figcaption>
        </figure>
        <figure class="fb-cell">
          <div class="fb-loop fb-loop--square"><video data-lazyvid src="/docs/fabricator/joint-editing.mp4" muted loop playsinline preload="none" aria-label="Editing joints in the skeleton stage"></video></div>
          <figcaption class="fb-cell__cap">Joint editing</figcaption>
        </figure>
        <figure class="fb-cell">
          <div class="fb-loop fb-loop--square fb-loop--lit"><video data-lazyvid src="/docs/fabricator/after-build.mp4" muted loop playsinline preload="none" aria-label="After-build features on the finished rig"></video></div>
          <figcaption class="fb-cell__cap">After-build features</figcaption>
        </figure>
      </div>
    </section>

    <!-- QUICK START -->
    <section class="dd-section" aria-labelledby="fb-quickstart">
      <div class="dd-panel__head dd-panel__head--bare">
        <h2 id="fb-quickstart" class="dd-label dd-label--plasma">Quick start</h2>
        <p class="dd-lede">Four ways in, one button out</p>
      </div>
      <ol class="dd-steps">
        <li class="dd-step dd-step--plasma"><span class="dd-step__num">1</span><p>Launch Fabricator and choose <b>File &rsaquo; New Rig</b> to adopt the scene's skeleton.</p></li>
        <li class="dd-step dd-step--plasma"><span class="dd-step__num">2</span><p>Or choose a <b>template</b> from the Components section.</p></li>
        <li class="dd-step dd-step--ember"><span class="dd-step__num">3</span><p>Have your own skeleton? <b class="b-ember">Name the rig</b>: that attaches a World component and you start building.</p></li>
        <li class="dd-step dd-step--ember"><span class="dd-step__num">4</span><p>Starting fresh? Naming the rig creates a <b class="b-ember">root joint with a World module</b>. Build anything from there.</p></li>
        <li class="dd-step dd-step--plasma fb-step--final"><span class="dd-step__num">5</span><p class="fb-step__click">Click <span class="dd-chip">BUILD RIG</span></p></li>
      </ol>
    </section>
    <LazyVideos />
  </article>
</DocsLayout>

<style>
  /* Page-specific: trait pills, component palette, the two-state diptych, video frames,
     and the 4-up gallery. Shared furniture: designed-doc.css. */
  .fb-what { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr); gap: 2rem; align-items: center; }
  .fb-what__copy { display: flex; flex-direction: column; gap: 1rem; }

  .fb-traits { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  .fb-trait {
    padding: 0.4rem 0.85rem;
    border-radius: 8px;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
  }
  .fb-trait--plasma { background: rgba(124, 255, 178, 0.1); border: 1px solid rgba(124, 255, 178, 0.4); color: var(--plasma); }
  .fb-trait--ember { background: rgba(255, 122, 61, 0.1); border: 1px solid rgba(255, 122, 61, 0.4); color: var(--ember); }

  .fb-comps { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.25rem; }
  .fb-comp {
    padding: 0.5rem 0.8rem;
    border-radius: 8px;
    background: var(--carbon);
    border: 1px solid rgba(255, 255, 255, 0.08);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.8125rem;
    color: var(--bone);
  }
  .fb-comp--more { border-style: dashed; border-color: rgba(255, 255, 255, 0.14); color: var(--bone-faint); }

  /* Video frames. --lit adds the plasma halo the design gives "finished" states. */
  .fb-loop {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    background: var(--carbon);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: var(--shadow-lg);
    aspect-ratio: 16 / 10;
  }
  .fb-loop video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .fb-loop--plasma { border-color: rgba(124, 255, 178, 0.35); }
  .fb-loop--ember { border-color: rgba(255, 122, 61, 0.4); }
  .fb-loop--state { aspect-ratio: 16 / 11; }
  .fb-loop--square { aspect-ratio: 1 / 1; box-shadow: var(--shadow-md); }
  .fb-loop--lit { box-shadow: var(--shadow-lg), 0 0 40px -16px rgba(124, 255, 178, 0.35); border-color: rgba(124, 255, 178, 0.5); }

  .fb-states { display: grid; grid-template-columns: minmax(0, 1fr) 5.5rem minmax(0, 1fr); align-items: center; }
  .fb-state { display: flex; flex-direction: column; gap: 0.75rem; min-width: 0; }
  .fb-states__toggle { display: flex; flex-direction: column; align-items: center; gap: 0.5rem; padding-bottom: 4.5rem; }
  .fb-states__arrows { color: var(--plasma); font-size: 1.375rem; font-weight: 800; }
  .fb-states__label { text-align: center; font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.18em; color: var(--bone-faint); line-height: 1.5; }
  .fb-state__title { display: flex; align-items: center; gap: 0.7rem; flex-wrap: wrap; }
  .fb-state__name { margin: 0; font-family: var(--font-mono); font-weight: 800; font-size: 1.0625rem; }
  .fb-state__name--ember { color: var(--ember); }
  .fb-state__name--plasma { color: var(--plasma); }
  .fb-state__pill { padding: 0.2rem 0.6rem; border-radius: 6px; font-family: var(--font-mono); font-weight: 700; font-size: 0.6875rem; letter-spacing: 0.08em; }
  .fb-state__pill--ember { background: rgba(255, 122, 61, 0.14); color: var(--ember); }
  .fb-state__pill--plasma { background: rgba(124, 255, 178, 0.14); color: var(--plasma); }
  .fb-state__cap { margin: 0; font-size: 0.875rem; line-height: 1.5; color: var(--bone-dim); }

  .fb-window { max-width: 47.5rem; margin: 0 auto; width: 100%; }

  .fb-gallery { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .fb-cell { margin: 0; display: flex; flex-direction: column; gap: 0.6rem; }
  .fb-cell__cap { font-family: var(--font-mono); font-weight: 700; font-size: 0.875rem; color: var(--bone); }

  .fb-step--final { background: linear-gradient(90deg, var(--iron), var(--carbon)); }
  .fb-step__click { display: flex; align-items: center; gap: 1rem; }

  @media (max-width: 820px) {
    .fb-what { grid-template-columns: 1fr; }
    .fb-states { grid-template-columns: 1fr; gap: 1rem; }
    .fb-states__toggle { flex-direction: row; padding: 0; justify-content: center; }
    .fb-states__label br { display: none; }
    .fb-gallery { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .fb-gallery { grid-template-columns: 1fr; }
  }
</style>

