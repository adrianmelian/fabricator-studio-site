---
// DESIGNED docs page for tools/your-ai-ta (Adrian x Claude Design, 2026-07-17; source
// drop: MrMiata inbox/Docs/"AI TA Docs.html"; the embedded panel shot is byte-identical
// to inbox/FSWindows/Reggie.png). Shared furniture: designed-doc.css (incl. dd-fact
// rows). Page-specific: the two-ways cards, the read-only banner, the why rows, the
// principle cards, and the first TROUBLESHOOTING block of the designed set. The
// READ-ONLY badge stays PLASMA deliberately: it is a correctness guarantee (plasma =
// correct), not a commercial label like the ember pack badges.
import DocsLayout from '../../../layouts/DocsLayout.astro';
import { Image } from 'astro:assets';
import '../../../styles/designed-doc.css';
import ToolbarLocator from '../../../components/ToolbarLocator.astro';
import VideoFeature from '../../../components/VideoFeature.astro';
import { tutorialByName } from '../../../data/tutorials';
import reggiePanel from '../../../assets/docs/your-ai-ta/reggie-panel.png';
import toolbarIcon from '../../../assets/docs/toolbar/icons/your-ai-ta.png';

const SUMMARY =
  'A read-only AI technical artist that lives in Maya, sees your scene and your Fabricator rig, and hands you paste-ready fixes. Use the built-in assistant, or connect your own AI client.';

const TITLE = 'YOUR AI TA';
const TRI = ['t-bone', 't-plasma', 't-ember'];
// The cycle counts glyphs only, continuing across word gaps (Claude Design's treatment).
let li = 0;
const titleGlyphs = TITLE.split('').map((ch) => ({ ch, cls: ch === ' ' ? 't-gap' : TRI[li++ % 3] }));
---
<DocsLayout title="Your AI TA | FabricatorStudio Docs" description={SUMMARY}>
  <article class="dd">
    <a class="dd-breadcrumb" href="/docs/">Docs</a>

    <header class="dd-header">
      <div class="at-eyebrow-row">
        <div class="dd-eyebrow">FABRICATOR &middot; FRAMEWORK</div>
        <span class="at-badge">READ-ONLY</span>
      </div>
      <h1 class="dd-title" aria-label={TITLE}>
        {titleGlyphs.map((g) =>
          g.cls === 't-gap' ? <span class="t-gap"></span> : <span aria-hidden="true" class={g.cls}>{g.ch}</span>
        )}
      </h1>
      <p class="dd-summary">{SUMMARY}</p>
    </header>

    <VideoFeature video={tutorialByName('Reggie')} compact />


    <ToolbarLocator icon={toolbarIcon} name="AI Technical Artist" sub="Reggie" button="[AI.TA] badge" x={1383} y={28} w={96} h={40} />
    <!-- WHAT -->
    <section class="dd-panel" aria-labelledby="at-what">
      <div class="dd-panel__head">
        <h2 id="at-what" class="dd-label dd-label--plasma">What</h2>
        <p class="dd-lede">Reads your real scene, hands you the fix</p>
      </div>
      <div class="at-what">
        <div class="at-what__copy">
          <p class="dd-prose">FabricatorStudio ships with an AI technical artist that can actually read your open Maya scene and the Fabricator rig in it. Ask it why a build failed, where a rig went weird, or how a tool works; it answers from <b>real scene facts</b> instead of guessing, then hands you a script to paste and run yourself.</p>
          <p class="at-ways__lede">It comes two ways, over the same read-only bridge:</p>
          <div class="at-ways">
            <div class="at-way at-way--plasma">
              <div class="at-way__head"><span class="at-way__tag at-way__tag--plasma">BUILT-IN</span><h3 class="at-way__name">Reggie</h3></div>
              <p class="at-way__line">The assistant built into the Bridge toolbar, docked and ready in the AI.TA panel, no setup.</p>
            </div>
            <div class="at-way at-way--ember">
              <div class="at-way__head"><span class="at-way__tag at-way__tag--ember">BYO CLIENT</span><h3 class="at-way__name">Connect Your AI</h3></div>
              <p class="at-way__line">Points your own client (Claude Code, Claude Desktop, Cursor, or any MCP client) at the same bridge: your model, your key.</p>
            </div>
          </div>
        </div>
        <div class="at-shot">
          <div class="at-shot__edge" aria-hidden="true"></div>
          <Image src={reggiePanel} alt="Reggie, the AI TA, answering in the docked AI.TA panel" densities={[1, 2]} />
        </div>
      </div>
      <div class="at-banner">
        <div class="at-banner__seal" aria-hidden="true"><span class="at-banner__dot"></span></div>
        <div class="at-banner__copy">
          <h3 class="at-banner__name">Sees everything, touches nothing</h3>
          <p class="at-banner__line">Read-only by construction. When something needs changing it gives you the fix to run, so every edit to your scene stays in your hands. <b>Your model, your key, your machine.</b></p>
        </div>
      </div>
    </section>

    <!-- WHY -->
    <section class="dd-panel dd-panel--ember" aria-labelledby="at-why">
      <div class="dd-panel__head">
        <h2 id="at-why" class="dd-label dd-label--ember">Why</h2>
        <p class="dd-lede">A second pair of eyes that can read the node graph</p>
      </div>
      <div class="at-whys">
        <div class="at-why"><span class="at-why__chev" aria-hidden="true">&rsaquo;</span><p>A <b>Build Rig or Unbuild failed</b> and you want to know why, in plain language.</p></div>
        <div class="at-why"><span class="at-why__chev" aria-hidden="true">&rsaquo;</span><p>Something in the rig <b>looks wrong</b> and you want eyes that can actually read the node graph.</p></div>
        <div class="at-why"><span class="at-why__chev" aria-hidden="true">&rsaquo;</span><p>You forgot <b>how a tool or component works</b> and want the answer without leaving Maya.</p></div>
        <div class="at-why"><span class="at-why__chev" aria-hidden="true">&rsaquo;</span><p>An <b>export is behaving oddly</b> and you want to diagnose it before Skeleton IO, Skin IO, or the exporters.</p></div>
      </div>
      <p class="at-note at-note--plasma">It reads scene summaries, build reports, component details, and node state through a <b class="b-plasma">read-only operation registry</b>, so it grounds every answer in what's really in your file.</p>
    </section>

    <!-- HOW -->
    <section class="dd-panel" aria-labelledby="at-how">
      <div class="dd-panel__head">
        <h2 id="at-how" class="dd-label dd-label--plasma">How</h2>
        <p class="dd-lede">Reggie needs no setup, or connect your own</p>
      </div>
      <p class="at-reggie"><b class="b-plasma">Reggie:</b> open the Bridge toolbar and use the AI.TA panel. That's it.</p>
      <p class="dd-prose at-lede">To connect your own client, use <b>Connect AI</b> under Settings on the toolbar strip. It starts a small local bridge that listens on <b class="b-plasma">loopback only</b> (127.0.0.1, default port 6292) and never talks to any server but the one on your own machine.</p>
      <ol class="dd-steps">
        <li class="dd-step dd-step--plasma"><span class="dd-step__num">1</span><p>In Maya, open the Bridge toolbar's <b>Settings zone</b> and click <b class="b-plasma">Connect AI</b> to open its popover.</p></li>
        <li class="dd-step dd-step--plasma"><span class="dd-step__num">2</span><p>Click <b class="b-plasma">Start</b>. The status pill switches from <span class="at-dim">STOPPED</span> to <span class="b-plasma">LISTENING ON &lt;port&gt;</span>.</p></li>
        <li class="dd-step dd-step--plasma"><span class="dd-step__num">3</span><p>Pick your client (<b>claude-code, claude-desktop, cursor</b>) and click <b class="b-plasma">Copy</b> to grab that client's config snippet.</p></li>
        <li class="dd-step dd-step--plasma"><span class="dd-step__num">4</span><p>Set up your client: for Claude Code, run <code class="at-code">claude mcp add fabricator -- uvx fabricator-mcp</code>; for Claude Desktop or Cursor, paste the copied <b>mcpServers</b> block into that client's MCP config file.</p></li>
        <li class="dd-step dd-step--ember at-step--verify"><span class="dd-step__num">5</span><p>In your client, ask it to <b class="b-ember">check your Fabricator rig's status</b>. If it answers with real details about your open scene, the connection is working.</p></li>
      </ol>
      <p class="at-note at-note--dim">Your client reaches the bridge through a small package, <b>fabricator-mcp</b> (installed and run via uvx), which relays each read-only call to the bridge over a local connection.</p>
    </section>

    <!-- HOW IT WORKS -->
    <section class="dd-panel" aria-labelledby="at-hiw">
      <div class="dd-panel__head">
        <h2 id="at-hiw" class="dd-label dd-label--plasma">How it works</h2>
        <p class="dd-lede">Evidence first, smallest fix, always in your hands</p>
      </div>
      <div class="at-principles">
        <div class="at-principle at-principle--plasma">
          <h3 class="at-principle__name">Gathers evidence first</h3>
          <p class="at-principle__line">Scene and rig status, pre-build checks, the last build report, the scene report, a viewport screenshot if the problem is visual, before proposing anything.</p>
        </div>
        <div class="at-principle at-principle--plasma">
          <h3 class="at-principle__name">Proposes the smallest fix</h3>
          <p class="at-principle__line">A plain <b class="b-plasma">maya.cmds</b> script for you to paste and run, or a pointer to an existing Fabricator button. It never claims it performed a change itself.</p>
        </div>
        <div class="at-principle at-principle--ember">
          <h3 class="at-principle__name">Undo before diagnosing</h3>
          <p class="at-principle__line">On a build/unbuild failure, it has you press <b class="b-ember">Ctrl+Z once</b> before scanning, so it reads the pre-failure state rather than the wreckage.</p>
        </div>
        <div class="at-principle">
          <h3 class="at-principle__name">You file the bug, not it</h3>
          <p class="at-principle__line">Only after a real fix has failed does it offer a <b>pre-filled GitHub issue URL</b> with diagnostics, which you review and submit under your own account. Nothing is auto-posted.</p>
        </div>
      </div>
    </section>

    <!-- GOTCHAS -->
    <section class="dd-section" aria-labelledby="at-gotchas">
      <div class="dd-panel__head dd-panel__head--bare">
        <h2 id="at-gotchas" class="dd-label dd-label--ember">Gotchas</h2>
      </div>
      <div class="dd-facts">
        <div class="dd-fact dd-fact--plasma">
          <span class="dd-fact__num">1</span>
          <div>
            <h3 class="dd-fact__name">Off by default, off across restarts</h3>
            <p class="dd-fact__line">The bridge stays off across Maya restarts unless <b class="b-plasma">Start with Maya</b> is checked. If your AI can't reach Maya, it most likely just isn't started yet.</p>
          </div>
        </div>
        <div class="dd-fact dd-fact--ember">
          <span class="dd-fact__num">2</span>
          <div>
            <h3 class="dd-fact__name">No auth, loopback only</h3>
            <p class="dd-fact__line">Any process on your machine can connect while it's running, a stated trust boundary (the posture other local DCC bridges use), worth knowing on a shared machine.</p>
          </div>
        </div>
        <div class="dd-fact dd-fact--ember">
          <span class="dd-fact__num">3</span>
          <div>
            <h3 class="dd-fact__name">Reading attributes evaluates the graph</h3>
            <p class="dd-fact__line">Reading a node forces Maya to evaluate its dependency graph; in a scene with a malicious expression or plug-in, that can run arbitrary code. Inherent to touching such a scene at all; only connect it to scenes you <b class="b-ember">trust</b>.</p>
          </div>
        </div>
        <div class="dd-fact dd-fact--plasma">
          <span class="dd-fact__num">4</span>
          <div>
            <h3 class="dd-fact__name">Screenshot is a throwaway temp PNG</h3>
            <p class="dd-fact__line">The viewport screenshot writes one PNG to your OS temp dir and deletes it after reading the bytes. Interactive sessions only, not batch or standalone Maya.</p>
          </div>
        </div>
        <div class="dd-fact dd-fact--plasma">
          <span class="dd-fact__num">5</span>
          <div>
            <h3 class="dd-fact__name">Request bursts are capped</h3>
            <p class="dd-fact__line">A burst of many requests is capped so a heavy session doesn't stall Maya's main thread; anything past the cap waits for the next tick rather than failing.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- TROUBLESHOOTING -->
    <section class="dd-panel dd-panel--ember at-ts" aria-labelledby="at-troubleshooting">
      <div class="dd-panel__head">
        <h2 id="at-troubleshooting" class="dd-label dd-label--ember">Troubleshooting</h2>
      </div>
      <div class="at-ts__list">
        <div class="at-ts__item">
          <h3 class="at-ts__q">"Maya isn't listening&hellip;"</h3>
          <p class="at-ts__a">The bridge isn't started, or it's on a different port than your client. Open Connect AI and click Start; if you changed the port, pass <b>--port &lt;n&gt;</b> on both sides.</p>
        </div>
        <div class="at-ts__item">
          <h3 class="at-ts__q">Status pill reads ERROR</h3>
          <p class="at-ts__a">Hover it; the tooltip carries the actual failure (e.g. port already in use). Click Stop, then Start again, or set a different port.</p>
        </div>
        <div class="at-ts__item">
          <h3 class="at-ts__q">Every call fails with "unknown_op" / "Protocol mismatch"</h3>
          <p class="at-ts__a">Your fabricator-mcp package and the running Maya-side bridge have drifted. Update whichever side is behind so both agree on the same operations.</p>
        </div>
        <div class="at-ts__item">
          <h3 class="at-ts__q">A call comes back "maya_busy"</h3>
          <p class="at-ts__a">Maya's main thread didn't answer in time, usually a long-running op or an open modal dialog. Let Maya go idle, then try again.</p>
        </div>
        <div class="at-ts__item">
          <h3 class="at-ts__q">"No viewport in batch/standalone mode"</h3>
          <p class="at-ts__a">Maya is headless, no viewport to capture. The screenshot tool only works in an interactive session.</p>
        </div>
        <div class="at-ts__item">
          <h3 class="at-ts__q">Rig tools return "not_found" / "no build report"</h3>
          <p class="at-ts__a">No Fabricator rig built in the current scene yet, or no build this session. Load or build a rig first, then ask again.</p>
        </div>
      </div>
    </section>
  </article>
</DocsLayout>

<style>
  /* Page-specific: the READ-ONLY badge, two-ways cards, read-only banner, why rows,
     principle cards, and the troubleshooting list. Shared furniture: designed-doc.css. */
  .at-eyebrow-row { display: flex; align-items: center; gap: 0.9rem; flex-wrap: wrap; }
  /* Plasma deliberately: READ-ONLY is a correctness guarantee (plasma = correct), not a
     commercial label like the ember pack badges. */
  .at-badge {
    padding: 0.3rem 0.8rem;
    border-radius: 7px;
    background: rgba(124, 255, 178, 0.12);
    border: 1px solid rgba(124, 255, 178, 0.45);
    color: var(--bone);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
  }

  .at-what { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 2rem; align-items: start; }
  .at-what__copy { display: flex; flex-direction: column; gap: 1rem; }
  .at-ways__lede { margin: 0; font-size: 0.875rem; color: var(--bone-faint); }
  .at-ways { display: flex; flex-direction: column; gap: 0.75rem; }
  .at-way { background: var(--carbon); border-radius: 12px; padding: 1.125rem 1.375rem; display: flex; flex-direction: column; gap: 0.4rem; }
  .at-way--plasma { border: 1px solid rgba(124, 255, 178, 0.3); }
  .at-way--ember { border: 1px solid rgba(255, 122, 61, 0.3); }
  .at-way__head { display: flex; align-items: center; gap: 0.7rem; }
  .at-way__tag { padding: 0.2rem 0.6rem; border-radius: 6px; font-family: var(--font-mono); font-weight: 700; font-size: 0.6875rem; letter-spacing: 0.08em; }
  .at-way__tag--plasma { background: rgba(124, 255, 178, 0.14); color: var(--bone); }
  .at-way__tag--ember { background: rgba(255, 122, 61, 0.14); color: var(--bone); }
  .at-way__name { margin: 0; font-family: var(--font-mono); font-weight: 800; font-size: 1.0625rem; color: var(--bone); }
  .at-way__line { margin: 0; font-size: 0.875rem; line-height: 1.5; color: var(--bone-dim); }

  .at-shot {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: var(--shadow-lg), 0 0 0 1px rgba(255, 122, 61, 0.14);
    align-self: start;
  }
  .at-shot :global(img) { width: 100%; height: auto; display: block; }
  .at-shot__edge { position: absolute; top: 8px; bottom: 8px; left: -2px; width: 3px; z-index: 1; background: linear-gradient(180deg, rgba(255, 122, 61, 0), rgba(255, 122, 61, 0.85), rgba(255, 122, 61, 0)); }

  /* Plasma-at-alpha wash over carbon (palette-legal gradient stops), plus the halo. */
  .at-banner {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    background: linear-gradient(90deg, rgba(124, 255, 178, 0.1), rgba(124, 255, 178, 0)), var(--carbon);
    border: 1px solid rgba(124, 255, 178, 0.4);
    border-radius: 12px;
    padding: 1.375rem 1.625rem;
    box-shadow: 0 0 40px -20px rgba(124, 255, 178, 0.4);
  }
  .at-banner__seal {
    flex: none;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 3px solid var(--plasma);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 20px rgba(124, 255, 178, 0.4);
  }
  .at-banner__dot { width: 0.9rem; height: 0.9rem; border-radius: 50%; background: var(--plasma); }
  .at-banner__copy { display: flex; flex-direction: column; gap: 0.3rem; }
  .at-banner__name { margin: 0; font-family: var(--font-mono); font-weight: 800; font-size: 1.125rem; color: var(--bone); }
  .at-banner__line { margin: 0; font-size: 0.9375rem; line-height: 1.55; color: var(--bone-dim); }
  .at-banner__line b { color: var(--bone); }

  .at-whys { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  .at-why {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    background: var(--carbon);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    padding: 1rem 1.25rem;
  }
  .at-why__chev { color: var(--bone); font-size: 1.125rem; font-weight: 800; line-height: 1.3; }
  .at-why p { margin: 0; font-size: 0.9375rem; line-height: 1.5; color: var(--bone-dim); }
  .at-why b { color: var(--bone); }

  .at-note {
    margin: 0;
    background: radial-gradient(120% 120% at 50% 45%, var(--iron), var(--carbon));
    border-radius: 12px;
    padding: 1.125rem 1.375rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--bone-dim);
  }
  .at-note--plasma { border: 1px solid rgba(124, 255, 178, 0.2); }
  .at-note--dim { border: 1px solid rgba(255, 255, 255, 0.07); color: var(--bone-faint); }
  .at-note--dim b { color: var(--bone-dim); }

  /* Plasma-at-alpha wash over carbon (palette-legal gradient stops). */
  .at-reggie {
    margin: 0;
    background: linear-gradient(160deg, rgba(124, 255, 178, 0.1), rgba(124, 255, 178, 0)), var(--carbon);
    border: 1px solid rgba(124, 255, 178, 0.35);
    border-radius: 12px;
    padding: 1.125rem 1.375rem;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--bone-dim);
  }
  .at-lede { max-width: 60rem; }
  .at-dim { color: var(--bone-faint); }
  .at-code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--carbon);
    border: 1px solid rgba(124, 255, 178, 0.25);
    border-radius: 6px;
    padding: 0.1em 0.4em;
    color: var(--bone);
  }
  .at-step--verify { background: var(--carbon); }

  .at-principles { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .at-principle {
    background: var(--carbon);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 12px;
    padding: 1.375rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .at-principle--plasma { border-color: rgba(124, 255, 178, 0.2); }
  .at-principle--ember { border-color: rgba(255, 122, 61, 0.2); }
  .at-principle__name { margin: 0; font-family: var(--font-mono); font-weight: 800; font-size: 1rem; color: var(--bone); }
  .at-principle__line { margin: 0; font-size: 0.875rem; line-height: 1.55; color: var(--bone-dim); }

  .at-ts__list { display: flex; flex-direction: column; gap: 0.75rem; }
  .at-ts__item {
    background: var(--iron);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 12px;
    padding: 1.125rem 1.375rem;
  }
  .at-ts__q { margin: 0 0 0.4rem; font-family: var(--font-mono); font-weight: 700; font-size: 0.9375rem; color: var(--bone); }
  .at-ts__a { margin: 0; font-size: 0.875rem; line-height: 1.55; color: var(--bone-dim); }
  .at-ts__a b { color: var(--bone); }

  @media (max-width: 820px) {
    .at-what { grid-template-columns: 1fr; }
    .at-whys { grid-template-columns: 1fr; }
    .at-principles { grid-template-columns: 1fr; }
    .at-banner { flex-direction: column; align-items: flex-start; }
  }
</style>
