---
// DESIGNED docs page for tools/pose-anim-studio (Adrian x Claude Design, 2026-07-17;
// source drop: MrMiata inbox/Docs/"Pose & Animation Studios Docs.html"; both embedded UI
// shots are byte-identical to inbox/FSWindows/PoseStudio.png + AnimStudio.png). Shared
// furniture: designed-doc.css (incl. dd-fact rows). Page-specific: the cross-rig identity
// diagram, the two-studio screenshot pair, and the long-title size override.
import DocsLayout from '../../../layouts/DocsLayout.astro';
import { Image } from 'astro:assets';
import '../../../styles/designed-doc.css';
import DocsWatchCard from '../../../components/DocsWatchCard.astro';
import { tutorialByName } from '../../../data/tutorials';
import poseStudio from '../../../assets/docs/pose-anim-studio/pose-studio.png';
import animationStudio from '../../../assets/docs/pose-anim-studio/animation-studio.png';

const SUMMARY =
  'Save and reuse full-rig poses and animation clips across every rig built with Fabricator; poses and clips travel cross-rig by component identity, not node names.';

const TITLE = 'POSE & ANIMATION STUDIOS';
const TRI = ['t-bone', 't-plasma', 't-ember'];
// The cycle counts glyphs only, continuing across word gaps (Claude Design's treatment).
let li = 0;
const titleGlyphs = TITLE.split('').map((ch) => ({ ch, cls: ch === ' ' ? 't-gap' : TRI[li++ % 3] }));
---
<DocsLayout title="Pose & Animation Studios | FabricatorStudio Docs" description={SUMMARY}>
  <article class="dd">
    <a class="dd-breadcrumb" href="/docs/">Docs</a>

    <header class="dd-header">
      <div class="dd-eyebrow">FABRICATOR &middot; ANIMATION</div>
      <h1 class="dd-title pa-title" aria-label={TITLE}>
        {titleGlyphs.map((g) =>
          g.cls === 't-gap' ? <span class="t-gap"></span> : <span aria-hidden="true" class={g.cls}>{g.ch}</span>
        )}
      </h1>
      <p class="dd-summary">{SUMMARY}</p>
    </header>

    <DocsWatchCard video={tutorialByName('Pose & Anim Studio')} />

    <!-- WHAT IT DOES -->
    <section class="dd-panel" aria-labelledby="pa-what">
      <div class="dd-panel__head">
        <h2 id="pa-what" class="dd-label dd-label--plasma">WHAT IT DOES</h2>
        <p class="dd-lede">One popover, two tabs, any rig</p>
      </div>
      <p class="dd-prose pa-lede">One popover with two tabs, <b class="b-ember">POSE</b> and <b class="b-plasma">ANIM</b>, launching Pose Studio and Animation Studio. Both save and load onto any rig built with Fabricator.</p>
      <div class="pa-identity" aria-label="A pose saved on character A loads correctly on character B by component identity">
        <div class="pa-char">
          <div class="pa-char__tile pa-char__tile--ember"><span class="pa-char__fig pa-char__fig--tall" aria-hidden="true"></span></div>
          <div class="pa-char__name">Character A</div>
          <div class="pa-char__sub">save pose / clip</div>
        </div>
        <div class="pa-bridge" aria-hidden="true">
          <div class="pa-bridge__arrow">&rarr;</div>
          <div class="pa-bridge__label">BY COMPONENT<br />IDENTITY</div>
          <div class="pa-bridge__sub">type &middot; side &middot; role</div>
        </div>
        <div class="pa-char">
          <div class="pa-char__tile pa-char__tile--plasma"><span class="pa-char__fig pa-char__fig--wide" aria-hidden="true"></span></div>
          <div class="pa-char__name">Character B</div>
          <div class="pa-char__sub">loads correctly</div>
        </div>
      </div>
      <p class="dd-prose pa-lede">Controls are addressed by <b>component identity</b> (type, side, role), not by node name. Thumbnails are framed in an embedded viewport; search and user-authored sets keep large libraries usable; <b class="b-plasma">selection sets</b> mask a pose down to just the controls you choose.</p>
    </section>

    <!-- THE TWO STUDIOS -->
    <section class="dd-panel dd-panel--ember" aria-labelledby="pa-studios">
      <div class="dd-panel__head">
        <h2 id="pa-studios" class="dd-label dd-label--ember">THE TWO STUDIOS</h2>
        <p class="dd-lede">Each embedded in its own tab</p>
      </div>
      <div class="pa-studios">
        <div class="pa-studio">
          <div class="pa-studio__head"><span class="pa-studio__badge pa-studio__badge--ember">POSE</span><span class="pa-studio__name">Pose Studio</span></div>
          <div class="pa-shot pa-shot--ember">
            <div class="pa-shot__edge pa-shot__edge--ember" aria-hidden="true"></div>
            <Image src={poseStudio} alt="Pose Studio: a searchable pose library with viewport thumbnails" widths={[700, 1400]} sizes="(max-width: 820px) 92vw, 430px" />
          </div>
        </div>
        <div class="pa-studio">
          <div class="pa-studio__head"><span class="pa-studio__badge pa-studio__badge--plasma">ANIM</span><span class="pa-studio__name">Animation Studio</span></div>
          <div class="pa-shot pa-shot--plasma">
            <div class="pa-shot__edge pa-shot__edge--plasma" aria-hidden="true"></div>
            <Image src={animationStudio} alt="Animation Studio: a clip library with timeline placement options" widths={[700, 1400]} sizes="(max-width: 820px) 92vw, 430px" />
          </div>
        </div>
      </div>
      <p class="pa-note">Both resolve their library location <b class="b-plasma">per project</b>, so a team shares one place.</p>
    </section>

    <!-- QUICK START -->
    <section class="dd-section" aria-labelledby="pa-quickstart">
      <div class="dd-panel__head dd-panel__head--bare">
        <h2 id="pa-quickstart" class="dd-label dd-label--plasma">QUICK START</h2>
        <p class="dd-lede">Capture on one rig, load on another</p>
      </div>
      <ol class="dd-steps">
        <li class="dd-step dd-step--plasma"><span class="dd-step__num">1</span><p>Open the <b>Library</b> button on the Bridge toolbar and pick the <b class="b-ember">POSE</b> or <b class="b-plasma">ANIM</b> tab.</p></li>
        <li class="dd-step dd-step--plasma"><span class="dd-step__num">2</span><p>Select the rig controls (or the <b>whole rig</b>) you want to capture.</p></li>
        <li class="dd-step dd-step--plasma"><span class="dd-step__num">3</span><p>Save, frame the thumbnail, and name it into a <b>set</b>.</p></li>
        <li class="dd-step dd-step--ember pa-step--load"><span class="dd-step__num">4</span><p>On another rig, select it and <b class="b-ember">load</b>; the library maps controls by identity.</p></li>
      </ol>
    </section>

    <!-- GOTCHAS -->
    <section class="dd-section" aria-labelledby="pa-gotchas">
      <div class="dd-panel__head dd-panel__head--bare">
        <h2 id="pa-gotchas" class="dd-label dd-label--ember">GOTCHAS</h2>
      </div>
      <div class="dd-facts pa-facts">
        <div class="dd-fact dd-fact--plasma">
          <span class="dd-fact__num">1</span>
          <div>
            <h3 class="dd-fact__name">Unmatched controls are skipped</h3>
            <p class="dd-fact__line">Cross-rig load maps by component identity; a control with no matching identity on the target rig is <b class="b-plasma">skipped</b> rather than mis-applied.</p>
          </div>
        </div>
        <div class="dd-fact dd-fact--ember">
          <span class="dd-fact__num">2</span>
          <div>
            <h3 class="dd-fact__name">Pose mirroring on the shelf</h3>
            <p class="dd-fact__line">Pose mirroring currently lives on the shelf, not inside the Pose Studio UI <span class="pa-roadmap">(roadmap)</span>.</p>
          </div>
        </div>
      </div>
    </section>
  </article>
</DocsLayout>

<style>
  /* Page-specific: the long-title size, the cross-rig identity diagram, and the studio
     screenshot pair. Shared furniture: designed-doc.css. */
  .pa-title { font-size: clamp(1.6rem, 4vw, 2.7rem); white-space: normal; }
  .pa-lede { max-width: 60rem; }

  .pa-identity {
    display: grid;
    grid-template-columns: 1fr 6rem 1fr;
    align-items: center;
    background: radial-gradient(120% 120% at 50% 45%, var(--iron), var(--carbon));
    border: 1px solid rgba(124, 255, 178, 0.2);
    border-radius: 12px;
    padding: 1.5rem 1.75rem;
  }
  .pa-char { display: flex; flex-direction: column; align-items: center; gap: 0.5rem; }
  .pa-char__tile {
    width: 5.25rem;
    height: 5.25rem;
    border-radius: 12px;
    background: var(--carbon);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pa-char__tile--ember { border: 1px solid rgba(255, 122, 61, 0.4); }
  .pa-char__tile--plasma { border: 1px solid rgba(124, 255, 178, 0.5); box-shadow: 0 0 26px -12px rgba(124, 255, 178, 0.4); }
  .pa-char__fig { display: block; border-radius: 8px; }
  .pa-char__fig--tall { width: 1.5rem; height: 2.5rem; border: 3px solid var(--ember); }
  .pa-char__fig--wide { width: 2.25rem; height: 1.9rem; border: 3px solid var(--plasma); }
  .pa-char__name { font-family: var(--font-mono); font-weight: 700; font-size: 0.875rem; color: var(--bone); }
  .pa-char__sub { font-family: var(--font-mono); font-size: 0.75rem; color: var(--bone-faint); }
  .pa-bridge { display: flex; flex-direction: column; align-items: center; gap: 0.3rem; }
  .pa-bridge__arrow { color: var(--plasma); font-size: 1.375rem; font-weight: 800; }
  .pa-bridge__label { text-align: center; font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.08em; color: var(--plasma-dim); line-height: 1.4; }
  .pa-bridge__sub { font-family: var(--font-mono); font-size: 0.625rem; color: var(--bone-faint); }

  .pa-studios { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .pa-studio { display: flex; flex-direction: column; gap: 0.75rem; min-width: 0; }
  .pa-studio__head { display: flex; align-items: center; gap: 0.7rem; }
  .pa-studio__badge { padding: 0.25rem 0.7rem; border-radius: 7px; font-family: var(--font-mono); font-weight: 800; font-size: 0.75rem; letter-spacing: 0.08em; }
  .pa-studio__badge--ember { background: var(--ember); color: #1A0A02; }
  .pa-studio__badge--plasma { background: var(--plasma); color: #06120B; }
  .pa-studio__name { font-family: var(--font-mono); font-weight: 700; font-size: 0.9375rem; color: var(--bone); }
  .pa-shot { position: relative; border-radius: 12px; overflow: hidden; border: 1px solid rgba(255, 255, 255, 0.08); box-shadow: var(--shadow-md); }
  .pa-shot--ember { box-shadow: var(--shadow-md), 0 0 0 1px rgba(255, 122, 61, 0.12); }
  .pa-shot--plasma { box-shadow: var(--shadow-md), 0 0 0 1px rgba(124, 255, 178, 0.12); }
  .pa-shot :global(img) { width: 100%; height: auto; display: block; }
  .pa-shot__edge { position: absolute; top: 8px; bottom: 8px; left: -2px; width: 3px; z-index: 1; }
  .pa-shot__edge--ember { background: linear-gradient(180deg, rgba(255, 122, 61, 0), rgba(255, 122, 61, 0.85), rgba(255, 122, 61, 0)); }
  .pa-shot__edge--plasma { background: linear-gradient(180deg, rgba(124, 255, 178, 0), rgba(124, 255, 178, 0.85), rgba(124, 255, 178, 0)); }
  .pa-note {
    margin: 0;
    background: var(--carbon);
    border: 1px solid rgba(124, 255, 178, 0.2);
    border-radius: 12px;
    padding: 1.125rem 1.375rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--bone-dim);
  }

  .pa-step--load { background: var(--carbon); }
  .pa-roadmap { color: var(--bone-faint); }
  .pa-facts { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }

  @media (max-width: 820px) {
    .pa-identity { grid-template-columns: 1fr; gap: 1rem; }
    .pa-bridge__arrow { transform: rotate(90deg); }
    .pa-studios { grid-template-columns: 1fr; }
    .pa-facts { grid-template-columns: 1fr; }
  }
</style>
