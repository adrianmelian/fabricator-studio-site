---
// DESIGNED docs page for components/simple-fk (Adrian x Claude Design, 2026-07-17; source
// drop: MrMiata inbox/Docs/"SimpleFK Docs.html"). Shared furniture: designed-doc.css
// (incl. the dd-fact rows). Page-specific: the control-drives-joint diagram, the use-case
// chips, and the pick-the-right-FK decision cards. No media on this page.
import DocsLayout from '../../../layouts/DocsLayout.astro';
import '../../../styles/designed-doc.css';

const SUMMARY =
  "A single FK control on one joint: the basic block for anything posable that doesn't need a chain or IK.";

const TITLE = 'FK SIMPLE';
const TRI = ['t-bone', 't-plasma', 't-ember'];
// The cycle counts letters only, continuing across word gaps (Claude Design's treatment).
let li = 0;
const titleGlyphs = TITLE.split('').map((ch) => ({ ch, cls: ch === ' ' ? 't-gap' : TRI[li++ % 3] }));
---
<DocsLayout title="FK Simple | FabricatorStudio Docs" description={SUMMARY}>
  <article class="dd">
    <a class="dd-breadcrumb" href="/docs/">Docs</a>

    <header class="dd-header">
      <div class="dd-eyebrow">FABRICATOR &middot; COMPONENT &middot; RIG MODULE</div>
      <h1 class="dd-title" aria-label="FK SIMPLE">
        {titleGlyphs.map((g) =>
          g.cls === 't-gap' ? <span class="t-gap"></span> : <span aria-hidden="true" class={g.cls}>{g.ch}</span>
        )}
      </h1>
      <p class="dd-summary">{SUMMARY}</p>
    </header>

    <!-- WHAT IT DOES -->
    <section class="dd-panel" aria-labelledby="sf-what">
      <div class="dd-panel__head">
        <h2 id="sf-what" class="dd-label dd-label--plasma">What it does</h2>
        <p class="dd-lede">One control, one joint, nothing underneath</p>
      </div>
      <div class="sf-what">
        <div class="sf-what__copy">
          <p class="dd-prose">SimpleFK builds <b>one control for one joint</b>, parented under whatever it's attached to, driving that joint directly.</p>
          <p class="dd-prose">Nothing fancier underneath: <b class="b-plasma">no duplicate chains, no blending</b>.</p>
        </div>
        <div class="sf-diagram" role="img" aria-label="An FK control wired straight down to the one joint it drives">
          <div class="dd-shot__glow dd-shot__glow--plasma" aria-hidden="true"></div>
          <div class="sf-scene">
            <div class="sf-ctrl"></div>
            <div class="sf-wire"></div>
            <div class="sf-joint"></div>
            <div class="sf-caps">
              <div class="sf-cap">FK CONTROL</div>
              <div class="sf-cap sf-cap--dim">DRIVES ONE JOINT</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- WHEN TO USE IT -->
    <section class="dd-panel dd-panel--ember" aria-labelledby="sf-when">
      <div class="dd-panel__head">
        <h2 id="sf-when" class="dd-label dd-label--ember">When to use it</h2>
        <p class="dd-lede">A single joint that just needs a plain control</p>
      </div>
      <div class="sf-uses">
        <p class="dd-prose">Reach for it on a single joint that just needs a plain, posable control:</p>
        <div class="sf-chips">
          <span class="sf-chip">clavicle</span>
          <span class="sf-chip">jaw</span>
          <span class="sf-chip">individual finger</span>
          <span class="sf-chip">unchained spine joint</span>
        </div>
      </div>
      <div class="sf-pick">
        <div class="sf-pick__card sf-pick__card--this">
          <div class="sf-pick__tag sf-pick__tag--plasma">THIS ONE</div>
          <h3 class="sf-pick__name">SimpleFK</h3>
          <p class="sf-pick__line">One joint, one plain control.</p>
        </div>
        <div class="sf-pick__card">
          <div class="sf-pick__tag">SPACE SWITCH / IK-FK</div>
          <h3 class="sf-pick__name">AdvancedFK</h3>
          <p class="sf-pick__line">Space switching or IK/FK matching lives here, not in SimpleFK.</p>
        </div>
      </div>
    </section>

    <!-- GOOD TO KNOW -->
    <section class="dd-section" aria-labelledby="sf-gtk">
      <div class="dd-panel__head dd-panel__head--bare">
        <h2 id="sf-gtk" class="dd-label dd-label--plasma">Good to know</h2>
      </div>
      <div class="dd-facts">
        <div class="dd-fact dd-fact--ember">
          <span class="dd-fact__num">1</span>
          <div>
            <h3 class="dd-fact__name">Exactly one joint per instance</h3>
            <p class="dd-fact__line">Selecting zero or more than one won't build.</p>
          </div>
        </div>
        <div class="dd-fact dd-fact--plasma">
          <span class="dd-fact__num">2</span>
          <div>
            <h3 class="dd-fact__name">Shape edits persist</h3>
            <p class="dd-fact__line">Hand-edited control shapes survive a rebuild, keyed to the control's shape option.</p>
          </div>
        </div>
        <div class="dd-fact dd-fact--plasma">
          <span class="dd-fact__num">3</span>
          <div>
            <h3 class="dd-fact__name">Safe attach to joints</h3>
            <p class="dd-fact__line">If the parent turns out to be a joint rather than a control, SimpleFK <b class="b-plasma">attaches safely</b> instead of nesting into the skeleton.</p>
          </div>
        </div>
      </div>
    </section>
  </article>
</DocsLayout>

<style>
  /* Page-specific: the control-drives-joint diagram, use-case chips, and the decision
     cards. Shared furniture: designed-doc.css. */
  .sf-what { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr); gap: 2rem; align-items: center; }
  .sf-what__copy { display: flex; flex-direction: column; gap: 1rem; }

  .sf-diagram {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    background: radial-gradient(120% 120% at 50% 45%, var(--iron), var(--carbon));
    border: 1px solid rgba(124, 255, 178, 0.35);
    box-shadow: var(--shadow-lg), 0 0 40px -14px rgba(124, 255, 178, 0.3);
    aspect-ratio: 16 / 11;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .sf-scene { display: flex; flex-direction: column; align-items: center; gap: 0.9rem; padding: 1rem 0; }
  .sf-ctrl { width: 5rem; height: 5rem; border: 4px solid var(--plasma); border-radius: 50%; box-shadow: 0 0 24px rgba(124, 255, 178, 0.5); }
  .sf-wire { width: 3px; height: 2.25rem; background: linear-gradient(var(--plasma), var(--bone-dim)); }
  .sf-joint { width: 1.375rem; height: 1.375rem; border-radius: 50%; background: var(--bone); box-shadow: 0 0 0 0.5rem rgba(232, 224, 208, 0.12); }
  .sf-caps { display: flex; flex-direction: column; align-items: center; gap: 0.15rem; margin-top: 0.25rem; }
  .sf-cap { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.15em; color: var(--bone-dim); }
  .sf-cap--dim { color: var(--bone-faint); font-size: 0.6875rem; }

  .sf-uses { display: flex; flex-direction: column; gap: 0.9rem; }
  .sf-chips { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  .sf-chip {
    padding: 0.55rem 1rem;
    border-radius: 9px;
    background: var(--carbon);
    border: 1px solid rgba(124, 255, 178, 0.3);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--bone);
  }

  .sf-pick { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; padding-top: 0.25rem; }
  .sf-pick__card {
    background: var(--carbon);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 1.375rem 1.375rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  /* Plasma-at-alpha wash over carbon (palette-legal gradient stops), plus the halo. */
  .sf-pick__card--this {
    background: linear-gradient(160deg, rgba(124, 255, 178, 0.1), rgba(124, 255, 178, 0)), var(--carbon);
    border-color: rgba(124, 255, 178, 0.5);
    box-shadow: 0 0 30px -14px rgba(124, 255, 178, 0.4);
  }
  .sf-pick__tag { font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.15em; color: var(--bone-faint); }
  .sf-pick__tag--plasma { color: var(--bone); }
  .sf-pick__name { margin: 0; font-family: var(--font-mono); font-weight: 800; font-size: 1.125rem; color: var(--bone); }
  .sf-pick__line { margin: 0; font-size: 0.875rem; line-height: 1.5; color: var(--bone-dim); }

  @media (max-width: 820px) {
    .sf-what { grid-template-columns: 1fr; }
    .sf-pick { grid-template-columns: 1fr; }
  }
</style>
