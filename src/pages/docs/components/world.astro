---
// DESIGNED docs page for components/world (Adrian x Claude Design, 2026-07-17; source
// drop: MrMiata inbox/Docs/"World Docs.html"). Shared furniture: designed-doc.css.
// Page-specific: the world-aligned root diagram (pure CSS, no media on this page). The
// axis bars use the palette's own red/green/blue: magma X, plasma Y, cobalt Z — the first
// page where the tertiary accents make an axis diagram fully on-palette.
import DocsLayout from '../../../layouts/DocsLayout.astro';
import '../../../styles/designed-doc.css';

const SUMMARY =
  "The rig's root control and joint: the first component every rig needs before anything else can attach.";

const TITLE = 'WORLD';
const TRI = ['t-bone', 't-plasma', 't-ember'];
// The cycle counts letters only, continuing across word gaps (Claude Design's treatment).
let li = 0;
const titleGlyphs = TITLE.split('').map((ch) => ({ ch, cls: ch === ' ' ? 't-gap' : TRI[li++ % 3] }));
---
<DocsLayout title="World | FabricatorStudio Docs" description={SUMMARY}>
  <article class="dd">
    <a class="dd-breadcrumb" href="/docs/">Docs</a>

    <header class="dd-header">
      <div class="dd-eyebrow">FABRICATOR &middot; COMPONENT &middot; RIG MODULE</div>
      <h1 class="dd-title" aria-label={TITLE}>
        {titleGlyphs.map((g) =>
          g.cls === 't-gap' ? <span class="t-gap"></span> : <span aria-hidden="true" class={g.cls}>{g.ch}</span>
        )}
      </h1>
      <p class="dd-summary">{SUMMARY}</p>
    </header>

    <!-- WHAT IT DOES -->
    <section class="dd-panel" aria-labelledby="wd-what">
      <div class="dd-panel__head">
        <h2 id="wd-what" class="dd-label dd-label--plasma">WHAT IT DOES</h2>
        <p class="dd-lede">The anchor everything traces back to</p>
      </div>
      <div class="wd-what">
        <div class="wd-what__copy">
          <p class="dd-prose">World builds the single <b>root joint and control</b> that every other component ultimately attaches to.</p>
          <p class="dd-prose">The control sits at the root but stays <b class="b-plasma">aligned to world space</b> (even if the root joint itself is rotated), so its axes are always predictable.</p>
        </div>
        <div class="wd-diagram" role="img" aria-label="The root control, world-aligned, at the center of the world axes">
          <div class="dd-shot__glow dd-shot__glow--plasma" aria-hidden="true"></div>
          <div class="wd-scene">
            <div class="wd-ring"></div>
            <div class="wd-axis wd-axis--x"></div>
            <div class="wd-axis wd-axis--y"></div>
            <div class="wd-axis wd-axis--z"></div>
            <div class="wd-ctrl"></div>
            <div class="wd-cap">ROOT &middot; WORLD-ALIGNED</div>
          </div>
        </div>
      </div>
    </section>

    <!-- WHEN TO USE IT -->
    <section class="dd-panel dd-panel--ember" aria-labelledby="wd-when">
      <div class="dd-panel__head">
        <h2 id="wd-when" class="dd-label dd-label--ember">WHEN TO USE IT</h2>
        <p class="dd-lede">First, once, at the very root</p>
      </div>
      <div class="wd-cards">
        <div class="wd-card wd-card--plasma">
          <h3 class="wd-card__name wd-card__name--plasma">Add it first</h3>
          <p class="wd-card__line">Add World before anything else, so downstream components have a root to attach to.</p>
        </div>
        <div class="wd-card">
          <h3 class="wd-card__name">No parent</h3>
          <p class="wd-card__line">It has no parent of its own; it's the anchor everything downstream traces back to.</p>
        </div>
        <div class="wd-card wd-card--ember">
          <h3 class="wd-card__name wd-card__name--ember">Exactly once</h3>
          <p class="wd-card__line">Use it exactly once per rig.</p>
        </div>
      </div>
    </section>

    <!-- GOOD TO KNOW -->
    <section class="dd-section" aria-labelledby="wd-gtk">
      <div class="dd-panel__head dd-panel__head--bare">
        <h2 id="wd-gtk" class="dd-label dd-label--plasma">GOOD TO KNOW</h2>
      </div>
      <div class="wd-gtk">
        <div class="wd-row wd-row--ember">
          <span class="wd-row__num wd-row__num--ember">1</span>
          <div>
            <h3 class="wd-row__name">Treat it as a singleton</h3>
            <p class="wd-row__line">The rig assumes exactly one World; a second instance would confuse anything that looks up the root control by name.</p>
          </div>
        </div>
        <div class="wd-row">
          <span class="wd-row__num">2</span>
          <div>
            <h3 class="wd-row__name">Never mirrored</h3>
            <p class="wd-row__line">There's no left/right version of World.</p>
          </div>
        </div>
        <div class="wd-row wd-row--plasma">
          <span class="wd-row__num wd-row__num--plasma">3</span>
          <div>
            <h3 class="wd-row__name">"World" as a space &ne; this control</h3>
            <p class="wd-row__line">Selecting "World" as a space elsewhere means a <b>fixed reference pose</b>, not this control's live animation. To follow the live control, <b class="b-plasma">target it directly</b>.</p>
          </div>
        </div>
      </div>
    </section>
  </article>
</DocsLayout>

<style>
  /* Page-specific: the world-aligned root diagram, the when-cards, and the numbered rows.
     Shared furniture: designed-doc.css. */
  .wd-what { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr); gap: 2rem; align-items: center; }
  .wd-what__copy { display: flex; flex-direction: column; gap: 1rem; }

  .wd-diagram {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    background: radial-gradient(120% 120% at 50% 40%, var(--iron), var(--carbon));
    border: 1px solid rgba(124, 255, 178, 0.35);
    box-shadow: var(--shadow-lg), 0 0 40px -14px rgba(124, 255, 178, 0.3);
    aspect-ratio: 16 / 11;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .wd-scene { position: relative; width: 15rem; height: 15rem; }
  .wd-ring {
    position: absolute;
    left: 50%;
    top: 58%;
    transform: translate(-50%, -50%);
    width: 14rem;
    height: 6rem;
    border: 2px solid rgba(232, 224, 208, 0.25);
    border-radius: 50%;
  }
  /* The world axes in the palette's own trio: X magma, Y plasma, Z cobalt. */
  .wd-axis { position: absolute; left: 50%; top: 58%; border-radius: var(--radius-pill); }
  .wd-axis--x { width: 6rem; height: 4px; background: var(--magma); transform-origin: left center; transform: translateY(-50%) rotate(-8deg); }
  .wd-axis--y { width: 4px; height: 6.5rem; background: var(--plasma); transform-origin: top center; transform: translate(-50%, -100%); }
  .wd-axis--z { width: 5.25rem; height: 4px; background: var(--cobalt); transform-origin: left center; transform: translateY(-50%) rotate(196deg); }
  .wd-ctrl {
    position: absolute;
    left: 50%;
    top: 58%;
    transform: translate(-50%, -50%);
    width: 2rem;
    height: 2rem;
    border: 3px solid var(--plasma);
    border-radius: 50%;
    box-shadow: 0 0 22px rgba(124, 255, 178, 0.5);
  }
  .wd-cap {
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    color: var(--plasma-dim);
    white-space: nowrap;
  }

  .wd-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .wd-card {
    background: var(--carbon);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 1.375rem 1.375rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .wd-card--plasma { border-color: rgba(124, 255, 178, 0.2); }
  .wd-card--ember { border-color: rgba(255, 122, 61, 0.22); }
  .wd-card__name { margin: 0; font-family: var(--font-mono); font-weight: 800; font-size: 1rem; color: var(--bone); }
  .wd-card__name--plasma { color: var(--plasma); }
  .wd-card__name--ember { color: var(--ember); }
  .wd-card__line { margin: 0; font-size: 0.875rem; line-height: 1.55; color: var(--bone-dim); }

  .wd-gtk { display: flex; flex-direction: column; gap: 0.75rem; }
  .wd-row {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    background: linear-gradient(90deg, var(--iron), var(--carbon));
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 12px;
    padding: 1.125rem 1.375rem;
  }
  .wd-row--ember { border-color: rgba(255, 122, 61, 0.2); }
  .wd-row--plasma { border-color: rgba(124, 255, 178, 0.18); }
  .wd-row__num {
    flex: none;
    width: 1.875rem;
    height: 1.875rem;
    border-radius: 8px;
    background: rgba(232, 224, 208, 0.1);
    color: var(--bone);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-weight: 800;
    font-size: 0.9375rem;
  }
  .wd-row__num--ember { background: rgba(255, 122, 61, 0.14); color: var(--ember); }
  .wd-row__num--plasma { background: rgba(124, 255, 178, 0.12); color: var(--plasma); }
  .wd-row__name { margin: 0 0 0.25rem; font-family: var(--font-mono); font-weight: 700; font-size: 0.9860rem; color: var(--bone); }
  .wd-row__line { margin: 0; font-size: 0.875rem; line-height: 1.55; color: var(--bone-dim); }

  @media (max-width: 820px) {
    .wd-what { grid-template-columns: 1fr; }
    .wd-cards { grid-template-columns: 1fr; }
  }
</style>
