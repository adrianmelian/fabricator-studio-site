---
// DESIGNED docs page for components/fk-aim (Adrian x Claude Design, 2026-07-17; source
// drop: MrMiata inbox/Docs/"FKAim Docs.html"). Shared furniture: designed-doc.css (incl.
// dd-fact rows). Page-specific: the joint-to-aim-control diagram and the converging-eyes
// SVG. No media on this page.
import DocsLayout from '../../../layouts/DocsLayout.astro';
import '../../../styles/designed-doc.css';

const SUMMARY =
  'A single joint that rotates to face a separate, draggable aim control, built for eyes and anything else that needs to look at a target.';

const TITLE = 'FK AIM';
const TRI = ['t-bone', 't-plasma', 't-ember'];
// The cycle counts letters only, continuing across word gaps (Claude Design's treatment).
let li = 0;
const titleGlyphs = TITLE.split('').map((ch) => ({ ch, cls: ch === ' ' ? 't-gap' : TRI[li++ % 3] }));
---
<DocsLayout title="FK Aim | FabricatorStudio Docs" description={SUMMARY}>
  <article class="dd">
    <a class="dd-breadcrumb" href="/docs/">Docs</a>

    <header class="dd-header">
      <div class="dd-eyebrow">FABRICATOR &middot; COMPONENT &middot; RIG MODULE</div>
      <h1 class="dd-title" aria-label="FK AIM">
        {titleGlyphs.map((g) =>
          g.cls === 't-gap' ? <span class="t-gap"></span> : <span aria-hidden="true" class={g.cls}>{g.ch}</span>
        )}
      </h1>
      <p class="dd-summary">{SUMMARY}</p>
    </header>

    <!-- WHAT IT DOES -->
    <section class="dd-panel" aria-labelledby="fa-what">
      <div class="dd-panel__head">
        <h2 id="fa-what" class="dd-label dd-label--plasma">What it does</h2>
        <p class="dd-lede">Drag the target, the joint turns to face it</p>
      </div>
      <div class="fa-what">
        <div class="fa-what__copy">
          <p class="dd-prose">FKAim gives one joint a control plus a second <b class="b-ember">"aim" control</b> placed out in front of it.</p>
          <p class="dd-prose">The joint's rotation follows an <b class="b-plasma">aim constraint</b> pointed at that second control, so dragging the aim control turns the joint toward it instead of rotating it directly.</p>
        </div>
        <div class="fa-diagram" role="img" aria-label="A joint aimed along a dashed line at a draggable aim control">
          <div class="dd-shot__glow dd-shot__glow--plasma" aria-hidden="true"></div>
          <div class="fa-scene">
            <div class="fa-node">
              <span class="fa-joint"></span>
              <span class="fa-node__cap">JOINT</span>
            </div>
            <div class="fa-beam" aria-hidden="true"></div>
            <div class="fa-node">
              <span class="fa-aim"></span>
              <span class="fa-node__cap fa-node__cap--ember">AIM CONTROL</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- WHEN TO USE IT -->
    <section class="dd-panel dd-panel--ember" aria-labelledby="fa-when">
      <div class="dd-panel__head">
        <h2 id="fa-when" class="dd-label dd-label--ember">When to use it</h2>
        <p class="dd-lede">The eye-rig block, and any look-at target</p>
      </div>
      <div class="fa-cards">
        <div class="fa-card fa-card--this">
          <h3 class="fa-card__name">Eyes that converge</h3>
          <p class="fa-card__line">Built as the eye-rig block: two FKAim instances sharing a <b class="b-plasma">link_group</b> get a shared look-at control, so both eyes converge on one point.</p>
          <svg class="fa-eyes" viewBox="0 0 320 90" role="img" aria-label="Two eyes converging on one aim control">
            <line x1="26" y1="20" x2="272" y2="45" stroke="#7CFFB2" stroke-width="3" />
            <line x1="26" y1="70" x2="272" y2="45" stroke="#7CFFB2" stroke-width="3" />
            <circle cx="26" cy="20" r="13" fill="#E8E0D0" />
            <circle cx="26" cy="70" r="13" fill="#E8E0D0" />
            <rect x="272" y="27" width="36" height="36" fill="none" stroke="#FF7A3D" stroke-width="4" transform="rotate(45 290 45)" />
          </svg>
        </div>
        <div class="fa-card">
          <h3 class="fa-card__name">Or solo look-at</h3>
          <p class="fa-card__line">Works alone for anything that should face a draggable target rather than being rotated by hand:</p>
          <div class="fa-chips">
            <span class="fa-chip">a turret</span>
            <span class="fa-chip">a camera prop</span>
          </div>
        </div>
      </div>
    </section>

    <!-- GOOD TO KNOW -->
    <section class="dd-section" aria-labelledby="fa-gtk">
      <div class="dd-panel__head dd-panel__head--bare">
        <h2 id="fa-gtk" class="dd-label dd-label--plasma">Good to know</h2>
      </div>
      <div class="dd-facts">
        <div class="dd-fact dd-fact--plasma">
          <span class="dd-fact__num">1</span>
          <div>
            <h3 class="dd-fact__name">Tune the aim setup</h3>
            <p class="dd-fact__line"><b class="b-plasma">aim_distance</b> and <b class="b-plasma">aim_axis</b> set how far in front of the joint the aim control sits and which axis points at the target.</p>
          </div>
        </div>
        <div class="dd-fact dd-fact--plasma">
          <span class="dd-fact__num">2</span>
          <div>
            <h3 class="dd-fact__name">link_group is opt-in</h3>
            <p class="dd-fact__line">Leave <b class="b-plasma">link_group</b> empty for a single, independent aim target; only set it when two or more instances should share one control.</p>
          </div>
        </div>
        <div class="dd-fact dd-fact--ember">
          <span class="dd-fact__num">3</span>
          <div>
            <h3 class="dd-fact__name">Target joint must exist</h3>
            <p class="dd-fact__line">The target joint has to already exist in the scene when you build.</p>
          </div>
        </div>
      </div>
    </section>
  </article>
</DocsLayout>

<style>
  /* Page-specific: the aim diagram and the eye-rig cards. Shared furniture:
     designed-doc.css. */
  .fa-what { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr); gap: 2rem; align-items: center; }
  .fa-what__copy { display: flex; flex-direction: column; gap: 1rem; }

  .fa-diagram {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    background: radial-gradient(120% 120% at 40% 50%, var(--iron), var(--carbon));
    border: 1px solid rgba(124, 255, 178, 0.35);
    box-shadow: var(--shadow-lg), 0 0 40px -14px rgba(124, 255, 178, 0.3);
    aspect-ratio: 16 / 11;
    display: flex;
    align-items: center;
    padding: 1.5rem;
  }
  .fa-scene { display: flex; align-items: center; width: 100%; gap: 0.25rem; }
  .fa-node { display: flex; flex-direction: column; align-items: center; gap: 0.6rem; }
  .fa-node__cap { font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.15em; color: var(--bone-faint); white-space: nowrap; }
  .fa-node__cap--ember { color: var(--bone); }
  .fa-joint { width: 1.5rem; height: 1.5rem; border-radius: 50%; background: var(--bone); box-shadow: 0 0 0 0.5rem rgba(232, 224, 208, 0.12); }
  /* Dashed aim beam: palette hue at full and zero alpha, never the transparent keyword. */
  .fa-beam {
    flex: 1;
    height: 4px;
    margin-bottom: 1.4rem;
    background: repeating-linear-gradient(90deg, #7CFFB2 0 10px, rgba(124, 255, 178, 0) 10px 20px);
  }
  .fa-aim { width: 2.75rem; height: 2.75rem; border: 4px solid var(--ember); transform: rotate(45deg); box-shadow: 0 0 24px rgba(255, 122, 61, 0.5); }

  .fa-cards { display: grid; grid-template-columns: 1.15fr 1fr; gap: 1rem; }
  .fa-card {
    background: var(--carbon);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  /* Plasma-at-alpha wash over carbon (palette-legal gradient stops), plus the halo. */
  .fa-card--this {
    background: linear-gradient(160deg, rgba(124, 255, 178, 0.1), rgba(124, 255, 178, 0)), var(--carbon);
    border-color: rgba(124, 255, 178, 0.4);
    box-shadow: 0 0 30px -14px rgba(124, 255, 178, 0.35);
  }
  .fa-card__name { margin: 0; font-family: var(--font-mono); font-weight: 800; font-size: 1.125rem; color: var(--bone); }
  .fa-card__line { margin: 0; font-size: 0.875rem; line-height: 1.55; color: var(--bone-dim); }
  .fa-eyes { width: 100%; height: auto; display: block; overflow: visible; margin-top: 0.25rem; }
  .fa-chips { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  .fa-chip {
    padding: 0.5rem 0.9rem;
    border-radius: 8px;
    background: var(--iron);
    border: 1px solid rgba(255, 122, 61, 0.3);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.875rem;
    color: var(--bone);
  }

  @media (max-width: 820px) {
    .fa-what { grid-template-columns: 1fr; }
    .fa-cards { grid-template-columns: 1fr; }
  }
</style>
