---
// /store/ — the studio's download hub (Adrian, 2026-08-19: every download door on the
// site now leads HERE), with the Advanced Ribbon Modules' full pitch below as the paid
// product's detail. DRAFT COPY on the hub cards, awaiting Adrian's pass.
//
// New 2026-07-22 (website overhaul). Structure follows the frozen store spec verbatim
// (MrMiata: workspace/2026-07-22_website-posture-pass/STORE-PAGE.md, nine blocks): show the
// thing before describing it, clarify the two paid axes high on the page, state what stays
// free generously, and never use Pro / Premium / tier language.
//
// LIVE 2026-07-24. Both former gates cleared: the platform call went to Stripe Managed
// Payments (MoR; decision + fee math in MrMiata workspace/2026-07-23_ribbon-pack-first-cut/)
// and the pack artifact exists (built from the v1.1.0 tag, field-proven). The link is a
// Stripe payment link; after payment it redirects to /store/thank-you/, which IS the
// delivery (unlisted R2 key lives there and nowhere else).
// DELISTED AT THE 2.0 SWITCH. The Advanced Ribbon Modules are part of the subscription
// now, not a separate $199 purchase, so the buy door closes and the pitch below stays as
// the description of what a subscription includes. Copies bought at $199 stay owned.
// Base Freelancer does NOT carry them; every tier from Freelancer + Animation up does.
//
// null renders the CTA absent rather than dead, which the page already handles.
const BUY_HREF: string | null = null;

import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NavBar from '../../components/NavBar.astro';
import Footer from '../../components/Footer.astro';
import SectionHead from '../../components/SectionHead.astro';
import BracketButton from '../../components/BracketButton.astro';
import ribbonHero from '../../assets/store/ribbonpack-hero.jpg';
import { ARMATURE } from '../../data/armature';

// PLACEHOLDER COPY, ADRIAN'S TO RULE. The page had a number in three places and a
// number with no way to pay it is worse than either state, so it reads as inclusion.
// These are not his words.
const PRICE = 'Included';

const PARTS = [
  {
    name: 'Ribbon Spine',
    line: 'A continuous surface through the torso, so a heavy bend keeps its volume instead of creasing at one joint.',
  },
  {
    name: 'Ribbon Arm',
    line: 'Elbows and shoulders that hold their shape through the full range, including the twist that normally collapses a bicep.',
  },
  {
    name: 'Ribbon Leg',
    line: 'Hips and knees that stay round under deep flexion, where a standard limb chain pinches.',
  },
];

const FAQ = [
  {
    q: 'Can I use these on client work?',
    a: 'Yes. Same as the rest of the toolset. Use it on anything you like, including paid client work.',
  },
  {
    q: 'Do my animators need to buy this?',
    a: 'No. Ribbon rigs animate for everyone with nothing installed. You need the modules to build and edit ribbon components, not to animate a rig that already has them.',
  },
  {
    q: 'Which Maya versions are supported?',
    a: 'The latest two Maya releases, best effort, no SLA. The same support promise the rest of the toolset carries.',
  },
  {
    q: 'What exactly do I download?',
    a: 'A small add-on pack: drag its installer into a Maya viewport with the 1.x toolset already installed (v1.1.0 or newer), and the ribbon components appear in the picker.',
  },
  {
    q: 'What is the refund policy?',
    a: 'Fourteen days, no questions. If the modules are not what you needed, reply to your receipt email within 14 days and you get your money back.',
  },
];
---
<BaseLayout
  title="Store | FabricatorStudio"
  description="Every FabricatorStudio download in one place: the Studio Pipeline, the Armature app, and the Advanced Ribbon Modules."
>
  <NavBar />

  {/* THE HUB (Adrian, 2026-08-19): one place for every download. The site's Download
      doors all lead here. Only links that exist ship (the honesty rule): Unreal tools
      carry no door until there is one. */}
  <section id="store-hub">
    <SectionHead
      eyebrow="STORE"
      title="DOWNLOADS"
      sub="Everything the studio ships, in one place."
    />
    <div class="hub">
      {/* THE FREE DOWNLOAD IS GONE (Adrian, 2026-09-02): "remove the free download from the
          FS website. We'll make a freebie after we ship the paid version." The 1.x installer
          zip still exists on R2 and LINKS.installer still points at it - nothing on the site
          links it any more, which is the removal. 1.x copies already downloaded keep their
          BSL grant permanently; that is why the door closing is a real act and not cosmetic.

          BADGE AND BUTTON LABEL ARE PLACEHOLDERS, ADRIAN'S TO RULE. A card with no door
          reads as broken, so it points at the tiers rather than at nothing. These are not
          his words. */}
      <div class="hub__card">
        <p class="hub__badge">Subscription</p>
        <p class="hub__name">Studio Pipeline</p>
        <p class="hub__line">The Maya suite: modular rigging, control shapes, skinning and export, in one installer.</p>
        <div class="hub__cta">
          <BracketButton kind="hard" href="/pricing/" label="See the plans" event="store-toolset" />
          <a class="hub__more" href="/tools/">About the pipeline</a>
        </div>
      </div>
      <div class="hub__card">
        <p class="hub__badge hub__badge--free">Free</p>
        <p class="hub__name">Armature</p>
        <p class="hub__line">The standalone rigging app: generative skeleton and skinning, with artist-friendly tools for refinement.</p>
        <div class="hub__cta">
          <BracketButton kind="hard" href={ARMATURE.installer} label="Download" event="store-armature" />
          <a class="hub__more" href="/armature/">About Armature</a>
        </div>
        <p class="hub__meta">v{ARMATURE.version} · Windows</p>
      </div>
      <div class="hub__card">
        <p class="hub__badge">{PRICE}</p>
        <p class="hub__name">Advanced Ribbon Modules</p>
        <p class="hub__line">Ribbon-tech spine, arm and leg on top of the base limbs: the deformation layer for close-up work.</p>
        <div class="hub__cta">
          <BracketButton kind="plasma-outline" href="#store-head" label="See the modules" event="store-ribbon" />
        </div>
        {/* "one payment, perpetual" removed 2026-09-03 on his word. The modules are
            part of the subscription now, not a purchase. Removed, not reworded. */}
      </div>
      <div class="hub__card hub__card--soon">
        <p class="hub__badge">Coming soon</p>
        <p class="hub__name">Unreal Tools</p>
        <p class="hub__line">Rig in Maya, land in Unreal: the engine-side half of the pipeline, in development at the studio now.</p>
      </div>
    </div>
  </section>

  <section id="store-head">
    <SectionHead
      eyebrow="STORE"
      title="ADVANCED RIBBON MODULES"
      sub="Ribbon-tech spine, arm, and leg. The deformation layer that sits on top of the base limbs, for the shoulders, hips, and spines that have to hold up in close-up."
    />
    <div class="st-price">
      <span class="st-price__num">{PRICE}</span>
      {/* The "one payment, perpetual, no renewal" terms line went with the $199, on his
          word. Removed, not reworded: the price reads Included and says enough. */}
    </div>
  </section>

  {/* BLOCK 2 — the hero (landed 2026-07-24: RibbonPack hero render, MrMiata
      workspace/2026-07-23_ribbon-pack-shot). The slot's LONG-TERM reservation is still the
      comparison loop from the shot list (standard limb bend against ribbon limb bend, same
      character, same pose, same light) — that loop carries the page's argument and replaces
      this hero when Adrian cuts it. Its caption line ("this is the whole argument") is
      retired until then; it belongs to the comparison, not to a wordmark hero. */}
  <section id="store-proof">
    <div class="st-proof">
      <Image src={ribbonHero} alt="The FS Ribbon Pack: a glowing ribbon surface strung with joint and twist controls, above the module names Ribbon Spine, Ribbon IK Arm, and Ribbon IK Leg." widths={[1104, 2208]} sizes="(max-width: 820px) 92vw, 1104px" />
    </div>
  </section>

  {/* BLOCK 3 — the two-axis clarifier. High on the page, small, and load-bearing: it exists
      to stop a small studio concluding that ribbons are locked behind a corporate license.
      (MrMiata: workspace/2026-07-18_licensing-decision/DECISION.md.) */}
  <section id="store-axes">
    <div class="st-axes">
      {/* REWRITTEN 2026-09-03. Both lines were the 1.x two-axis story: a $199 purchase on
          one axis and a $2M revenue threshold on the other. 2.0 has neither. */}
      <p>The Advanced Modules come with the subscription, from the Animation band up. The base Freelance Tech Art band does not carry them.</p>
      <p>Modules bought on 1.x stay yours, at any studio size, with nothing to renew. Prices for 2.0 are on the <a href="/pricing/">pricing page</a>.</p>
    </div>
  </section>

  <section id="store-parts">
    <SectionHead eyebrow="WHAT YOU GET" title="THREE MODULES" />
    <div class="st-parts">
      {PARTS.map((p) => (
        <div class="st-part">
          <h3 class="st-part__name">{p.name}</h3>
          <p class="st-part__line">{p.line}</p>
        </div>
      ))}
    </div>
  </section>

  {/* BLOCK 5 — what stays free. The most trust-building block on the page, and it is true.
      It says the paid product is not a hostage situation, which is a real differentiator
      against a field of node-locked encrypted binaries. */}
  <section id="store-free">
    <div class="st-free">
      <h2 class="st-free__head">Ribbon rigs animate for everyone.</h2>
      <p>If someone hands your animators a character built with these modules, it works, with nothing installed and nothing to buy. The deformation is baked Maya nodes.</p>
      <p>You need the modules to build and edit ribbon components. You do not need them to use a rig that has them.</p>
    </div>
  </section>

  <section id="store-buy">
    <div class="st-buy">
      <div class="st-buy__top">
        <span class="st-buy__num">{PRICE}</span>
        <span class="st-buy__terms">One payment. Yours to keep. No renewal.</span>
      </div>
      {BUY_HREF ? (
        <>
          <BracketButton kind="hard" href={BUY_HREF} label="Buy the modules" event="store-buy" />
          <p class="st-buy__next">Checkout hands you straight to your download. Receipt arrives by email. 14-day refund, no questions.</p>
        </>
      ) : (
        <>
          <span class="st-buy__soon">Ships with the next release</span>
          <p class="st-buy__next">The modules go on sale when the next build is cut. If you want the link the day it lands, mail <a href="mailto:adrian@fabricator.studio">adrian@fabricator.studio</a> and I will tell you.</p>
        </>
      )}
    </div>
  </section>

  {/* "OPEN PYTHON, NO DRM - source available, nothing compiled" WAS REMOVED 2026-09-03 on
      Adrian's word. The shipped 2.0.1 payload is compiled in full: 280 cp311 and 280 cp313
      extensions, and the only .py a customer receives is a vendored YAML library. The claim
      was true of 1.x and had been live since. The support commitment beside it is unchanged
      and now stands on its own, so the two-up grid goes with the card it lost. */}
  <section id="store-commit">
    <div class="st-note">
      <h3 class="st-note__head">What buying commits me to</h3>
      <p>Updates and Maya compatibility for the latest two Maya releases, best effort, no SLA. Selling this is a support commitment, and saying so out loud is what makes it worth anything.</p>
    </div>
  </section>

  <section id="store-faq">
    <SectionHead eyebrow="QUESTIONS" title="FAQ" />
    <div class="st-faq">
      {FAQ.map((f) => (
        <details class="st-faq__item">
          <summary class="st-faq__q">{f.q}</summary>
          <p class="st-faq__a">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  #store-hub .hub {
    max-width: 1080px;
    margin: 2.5rem auto 4.5rem;
    padding: 0 1.5rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }
  @media (max-width: 760px) {
    #store-hub .hub { grid-template-columns: 1fr; }
  }
  .hub__card {
    position: relative;
    background: var(--iron);
    border: 1px solid var(--iron-3);
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
    padding: 1.6rem 1.75rem 1.5rem;
  }
  .hub__card--soon { opacity: 0.62; }
  .hub__badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bone-dim);
  }
  .hub__badge--free { color: var(--bone); }
  .hub__name {
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.9rem;
    color: var(--bone);
  }
  .hub__line {
    margin-top: 0.6rem;
    font-weight: 300;
    font-size: 1.02rem;
    line-height: 1.5;
    color: var(--bone-dim);
    max-width: 46ch;
  }
  .hub__cta {
    margin-top: 1.3rem;
    display: flex;
    align-items: center;
    gap: 1.2rem;
    font-size: 0.9rem;
  }
  .hub__more {
    font-weight: 300;
    color: var(--bone);
    text-decoration: none;
  }
  .hub__more:hover { color: var(--bone-dim); }
  .hub__meta {
    margin-top: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--bone-faint, var(--bone-dim));
  }
</style>

<style>
  .st-price { display: flex; align-items: baseline; gap: 1rem; flex-wrap: wrap; margin-top: 1.5rem; }
  .st-price__num { font-family: var(--font-mono); font-weight: 800; font-size: clamp(2rem, 4vw, 2.75rem); color: var(--bone); letter-spacing: -0.02em; }
  .st-price__terms { font-family: var(--font-mono); font-size: 0.9375rem; letter-spacing: 0.06em; color: var(--bone-dim); }

  #store-proof { padding-top: 0; }
  .st-proof {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    /* Solid now: the dashed ember frame was the deliberate "unfinished" signal for the
       pending plate, and it retired with the plate. */
    border: 1px solid var(--iron-3);
    background: var(--carbon);
    box-shadow: var(--shadow-lg);
  }
  .st-proof :global(img) { display: block; width: 100%; height: auto; }

  #store-axes { padding-top: 0; }
  .st-axes {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    border-left: 3px solid var(--ember);
    border-radius: 0 14px 14px 0;
    background: linear-gradient(90deg, rgba(255, 122, 61, 0.09), rgba(255, 122, 61, 0));
    padding: 1.25rem 1.5rem;
  }
  .st-axes p { margin: 0; font-size: 0.9375rem; line-height: 1.65; color: var(--bone-dim); text-wrap: pretty; }

  .st-parts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.125rem; }
  @media (max-width: 900px) { .st-parts { grid-template-columns: 1fr; } }
  .st-part {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: 1.75rem 1.625rem;
    border-radius: 16px;
    background: linear-gradient(180deg, var(--iron), var(--carbon));
    border: 1px solid rgba(255, 122, 61, 0.16);
    box-shadow: var(--shadow-md);
  }
  .st-part__name { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: 1.25rem; color: var(--bone); }
  .st-part__line { margin: 0; font-size: 0.9375rem; line-height: 1.6; color: var(--bone-dim); text-wrap: pretty; }

  .st-free {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 2.25rem 2.5rem;
    border-radius: 20px;
    background: linear-gradient(120deg, rgba(124, 255, 178, 0.1), rgba(124, 255, 178, 0)), var(--carbon);
    border: 1px solid rgba(124, 255, 178, 0.35);
    border-left: 3px solid var(--plasma);
    box-shadow: var(--shadow-lg);
  }
  .st-free__head { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: clamp(1.5rem, 3vw, 2rem); color: var(--bone); line-height: 1.1; }
  .st-free p { margin: 0; font-size: 1rem; line-height: 1.65; color: var(--bone); text-wrap: pretty; }
  @media (max-width: 640px) { .st-free { padding: 1.75rem 1.5rem; } }

  .st-buy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    padding: 2.25rem 2.5rem;
    border-radius: 20px;
    background: linear-gradient(180deg, var(--iron), var(--carbon));
    border: 1px solid rgba(255, 122, 61, 0.35);
    box-shadow: var(--shadow-lg);
  }
  .st-buy__top { display: flex; align-items: baseline; gap: 1rem; flex-wrap: wrap; }
  .st-buy__num { font-family: var(--font-mono); font-weight: 800; font-size: clamp(1.75rem, 3.4vw, 2.25rem); color: var(--bone); }
  .st-buy__terms { font-size: 0.9375rem; color: var(--bone-dim); }
  .st-buy__soon {
    font-family: var(--font-mono);
    font-weight: 800;
    font-size: 0.9375rem;
    letter-spacing: 0.12em;
    color: var(--bone);
    border: 1px solid var(--iron-3);
    background: var(--iron);
    border-radius: var(--radius-pill);
    padding: 0.75em 1.5em;
  }
  .st-buy__next { margin: 0; font-size: 0.9375rem; line-height: 1.6; color: var(--bone-dim); }

  .st-two { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.125rem; }
  @media (max-width: 800px) { .st-two { grid-template-columns: 1fr; } }
  .st-note {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: 1.75rem 1.625rem;
    border-radius: 16px;
    background: var(--iron);
    border: 1px solid var(--iron-3);
    box-shadow: var(--shadow-md);
  }
  .st-note__head { margin: 0; font-family: var(--font-mono); font-weight: 700; font-size: 1.0625rem; color: var(--bone); }
  .st-note p { margin: 0; font-size: 0.9375rem; line-height: 1.65; color: var(--bone-dim); text-wrap: pretty; }

  .st-faq { display: flex; flex-direction: column; gap: 0.75rem; }
  .st-faq__item {
    border: 1px solid var(--iron-3);
    border-radius: 14px;
    background: var(--iron);
    padding: 1rem 1.25rem;
  }
  .st-faq__q {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1rem;
    color: var(--bone);
    cursor: pointer;
    list-style: none;
  }
  .st-faq__q::-webkit-details-marker { display: none; }
  .st-faq__q::before { content: '+'; color: var(--bone); margin-right: 0.75rem; font-weight: 800; }
  .st-faq__item[open] .st-faq__q::before { content: '\2212'; color: var(--bone); }
  .st-faq__a { margin: 0.75rem 0 0.25rem; font-size: 0.9375rem; line-height: 1.65; color: var(--bone-dim); text-wrap: pretty; }
</style>
