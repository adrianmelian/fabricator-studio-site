---
// /account/ — the passwordless account page (2026-09-02). Fully client-side against
// https://api.fabricator.studio; this is a static Astro page (GitHub Pages, no SSR, no
// server routes), so every state below is plain DOM toggling driven by a <script> at the
// bottom, exactly like ContactForm.astro and NewsletterPop.astro already do on this site.
//
// FOUR STATES, only one visible at a time:
//   (a) signed out            -> #acct-signedout
//   (b) signed in, no sub     -> #acct-signedin with #acct-unsubscribed shown
//   (c) signed in, subscribed -> #acct-signedin with #acct-subscribed shown
//   (d) sign out              -> an action, not a panel; it just returns to (a)
//
// The session token lives in localStorage under `fs_session`, read/written nowhere else
// in the codebase except SubscriptionTiers.astro's buy-button wiring, which reads the same
// key to decide whether a buy button can reach checkout directly.
import BaseLayout from '../../layouts/BaseLayout.astro';
import NavBar from '../../components/NavBar.astro';
import Footer from '../../components/Footer.astro';
import SectionHead from '../../components/SectionHead.astro';
import SubscriptionTiers from '../../components/SubscriptionTiers.astro';
import { PRICE_SWITCH_THROWN } from '../../data/launch';
---
<BaseLayout
  title="Your account | FabricatorStudio"
  description="Sign in to manage your FabricatorStudio subscription, downloads and devices."
>
  <NavBar />

  <section id="account" class="acct">
    <SectionHead eyebrow="ACCOUNT" title="YOUR ACCOUNT" sub="No password. We email you a one-time code." />

    <p class="acct-offline" id="acct-offline" role="status" hidden>Could not reach the licensing service. Try again in a moment.</p>

    <!-- (a) SIGNED OUT -->
    <div id="acct-signedout" class="acct-panel">
      <div class="acct-card">
        <h2 class="acct-card__head">Sign in</h2>
        <form id="acct-request-form" class="acct-form">
          <label class="acct-sronly" for="acct-email">Email</label>
          <input class="acct-input" id="acct-email" type="email" name="email" placeholder="you@studio.com" autocomplete="email" required />
          <button class="acct-btn" type="submit" id="acct-request-btn">Email me a sign in link</button>
        </form>
        <p class="acct-msg" id="acct-request-msg" hidden></p>

        <form id="acct-redeem-form" class="acct-form" hidden>
          <label class="acct-sronly" for="acct-code">Sign in code</label>
          <input class="acct-input" id="acct-code" type="text" name="code" placeholder="Paste the code from your email" autocomplete="one-time-code" required />
          <button class="acct-btn" type="submit" id="acct-redeem-btn">Sign in</button>
        </form>
        <p class="acct-msg acct-msg--error" id="acct-redeem-msg" hidden></p>
      </div>
    </div>

    <!-- (b) / (c) SIGNED IN -->
    <div id="acct-signedin" class="acct-panel" hidden>
      <div class="acct-topbar">
        <p class="acct-topbar__email" id="acct-email-display"></p>
        <div class="acct-topbar__actions">
          <button class="acct-linkbtn" id="acct-signout" type="button">Sign out</button>
          <button class="acct-linkbtn" id="acct-signout-all" type="button">Sign out on every machine</button>
        </div>
      </div>

      <!-- (c) subscribed -->
      <div id="acct-subscribed" class="acct-block" hidden>
        <div class="acct-tier">
          <p class="acct-tier__name" id="acct-tier-name"></p>
          <ul class="acct-opens" id="acct-opens"></ul>
        </div>

        <div class="acct-status-line" id="acct-status-line"></div>

        <div class="acct-manage" id="acct-manage" hidden>
          <a class="acct-btn acct-btn--soft" id="acct-manage-link" href="#" target="_blank" rel="noopener">Manage billing</a>
        </div>

        <div class="acct-section">
          <p class="acct-settling" id="acct-settling" hidden>Your purchase is going through. This page will fill in on its own, usually within a few seconds.</p>
          <h3 class="acct-section__head">Downloads</h3>
          <div class="acct-downloads" id="acct-downloads"></div>
        </div>

        <div class="acct-section">
          <h3 class="acct-section__head">Devices</h3>
          <p class="acct-devicelimit" id="acct-devicelimit-sub"></p>
          <div class="acct-devices" id="acct-devices-sub"></div>
        </div>
      </div>

      <!-- (b) no subscription -->
      <div id="acct-unsubscribed" class="acct-block" hidden>
        {PRICE_SWITCH_THROWN ? (
          <SubscriptionTiers />
        ) : (
          /* Before the switch, the 2.0 tiers do not exist as far as a visitor is
             concerned. Showing them here would publish a price nothing can charge.
             The account still does its other job: it holds the device seats. */
          <div class="acct-section">
            <h3 class="acct-section__head">Subscriptions</h3>
            <p class="acct-devicelimit">Subscriptions open with 2.0.</p>
          </div>
        )}

        <div class="acct-section">
          <h3 class="acct-section__head">Devices</h3>
          <p class="acct-devicelimit" id="acct-devicelimit-free"></p>
          <div class="acct-devices" id="acct-devices-free"></div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<script>
  // Vanilla JS, no framework: the site's static-output rule (GitHub Pages, no SSR) means
  // every bit of behaviour here has to be plain DOM against a REST API, same shape as
  // ContactForm.astro and NewsletterPop.astro.
  (function () {
    var API = 'https://api.fabricator.studio';
    var SESSION_KEY = 'fs_session';

    function getSession() {
      try { return localStorage.getItem(SESSION_KEY); } catch (e) { return null; }
    }
    function setSession(v) {
      try { localStorage.setItem(SESSION_KEY, v); } catch (e) {}
    }
    function clearSession() {
      try { localStorage.removeItem(SESSION_KEY); } catch (e) {}
    }

    function esc(s) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }
    function fmtDate(ms) {
      if (!ms && ms !== 0) return '';
      try { return new Date(ms).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' }); }
      catch (e) { return ''; }
    }

    var elOffline = document.getElementById('acct-offline');
    var elSignedOut = document.getElementById('acct-signedout');
    var elSignedIn = document.getElementById('acct-signedin');
    var elSubscribed = document.getElementById('acct-subscribed');
    var elUnsubscribed = document.getElementById('acct-unsubscribed');
    var elEmailDisplay = document.getElementById('acct-email-display');

    var requestForm = document.getElementById('acct-request-form');
    var requestBtn = document.getElementById('acct-request-btn');
    var requestMsg = document.getElementById('acct-request-msg');
    var redeemForm = document.getElementById('acct-redeem-form');
    var redeemBtn = document.getElementById('acct-redeem-btn');
    var redeemMsg = document.getElementById('acct-redeem-msg');

    function showMsg(el, text, isErr) {
      if (!el) return;
      el.hidden = false;
      el.textContent = text;
      el.classList.toggle('acct-msg--error', !!isErr);
    }
    function hideMsg(el) { if (el) { el.hidden = true; el.textContent = ''; } }

    function showOffline(show) { if (elOffline) elOffline.hidden = !show; }

    function showState(state) {
      // state: 'signedout' | 'signedin'
      if (elSignedOut) elSignedOut.hidden = state !== 'signedout';
      if (elSignedIn) elSignedIn.hidden = state !== 'signedin';
    }

    // ---------- (a) SIGNED OUT: request link, then redeem code ----------
    if (requestForm) {
      requestForm.addEventListener('submit', function (e) {
        e.preventDefault();
        var email = (document.getElementById('acct-email').value || '').trim();
        if (!email) return;
        hideMsg(requestMsg);
        showOffline(false);
        var original = requestBtn.textContent;
        requestBtn.disabled = true;
        requestBtn.textContent = 'Sending...';
        fetch(API + '/v1/auth/request-link', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email }),
        })
          .then(function (r) { return r.json(); })
          .then(function () {
            // The service never confirms or denies an account exists, by design. The UI
            // must say exactly this, whatever the reply, so it never leaks enumeration.
            showMsg(requestMsg, 'If that address has an account, a sign in code is on its way. Paste it below.', false);
            if (redeemForm) redeemForm.hidden = false;
          })
          .catch(function () { showOffline(true); })
          .finally(function () {
            requestBtn.disabled = false;
            requestBtn.textContent = original;
          });
      });
    }

    if (redeemForm) {
      redeemForm.addEventListener('submit', function (e) {
        e.preventDefault();
        var code = (document.getElementById('acct-code').value || '').trim();
        if (!code) return;
        hideMsg(redeemMsg);
        showOffline(false);
        var original = redeemBtn.textContent;
        redeemBtn.disabled = true;
        redeemBtn.textContent = 'Signing in...';
        fetch(API + '/v1/auth/redeem', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token: code }),
        })
          .then(function (r) { return r.json(); })
          .then(function (data) {
            if (data && data.ok && data.value) {
              setSession(data.value);
              loadAccount();
            } else {
              showMsg(redeemMsg, (data && data.error) || 'That code did not work. Check it and try again.', true);
            }
          })
          .catch(function () { showOffline(true); })
          .finally(function () {
            redeemBtn.disabled = false;
            redeemBtn.textContent = original;
          });
      });
    }

    // ---------- sign out (d) ----------
    var signoutBtn = document.getElementById('acct-signout');
    if (signoutBtn) {
      signoutBtn.addEventListener('click', function () {
        clearSession();
        resetSignedOutUi();
        showState('signedout');
      });
    }
    var signoutAllBtn = document.getElementById('acct-signout-all');
    if (signoutAllBtn) {
      signoutAllBtn.addEventListener('click', function () {
        var session = getSession();
        if (!session) return;
        var original = signoutAllBtn.textContent;
        signoutAllBtn.disabled = true;
        fetch(API + '/v1/auth/signout-all', {
          method: 'POST',
          headers: { Authorization: 'Bearer ' + session },
        })
          .then(function (r) { return r.json(); })
          .then(function (data) {
            if (data && data.ok) {
              clearSession();
              resetSignedOutUi();
              showState('signedout');
            }
          })
          .catch(function () { showOffline(true); })
          .finally(function () {
            signoutAllBtn.disabled = false;
            signoutAllBtn.textContent = original;
          });
      });
    }

    function resetSignedOutUi() {
      if (requestForm) requestForm.reset();
      if (redeemForm) { redeemForm.reset(); redeemForm.hidden = true; }
      hideMsg(requestMsg);
      hideMsg(redeemMsg);
    }

    // ---------- devices (shared by both signed-in states) ----------
    function renderDevices(container, devices, session) {
      if (!container) return;
      container.innerHTML = '';
      if (!devices || !devices.length) {
        var p = document.createElement('p');
        p.className = 'acct-devices__empty';
        p.textContent = 'No devices activated on this seat yet.';
        container.appendChild(p);
        return;
      }
      devices.forEach(function (d) {
        var row = document.createElement('div');
        row.className = 'acct-device';
        row.innerHTML =
          '<div class="acct-device__info">' +
            '<p class="acct-device__name">' + esc(d.deviceName) + '</p>' +
            '<p class="acct-device__meta">Activated ' + esc(fmtDate(d.activatedAt)) + '</p>' +
          '</div>' +
          '<button type="button" class="acct-linkbtn acct-device__remove" data-device-id="' + esc(d.deviceId) + '">Remove</button>';
        container.appendChild(row);
        var removeBtn = row.querySelector('.acct-device__remove');
        removeBtn.addEventListener('click', function () {
          removeBtn.disabled = true;
          removeBtn.textContent = 'Removing...';
          fetch(API + '/v1/deactivate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + session },
            body: JSON.stringify({ deviceId: d.deviceId }),
          })
            .then(function (r) { return r.json(); })
            .then(function () { loadAccount(); })
            .catch(function () { showOffline(true); });
        });
      });
    }

    function renderDownloads(container, downloads) {
      if (!container) return;
      container.innerHTML = '';
      if (!downloads || !downloads.length) {
        var p = document.createElement('p');
        p.className = 'acct-downloads__empty';
        p.textContent = 'No downloads on this seat yet.';
        container.appendChild(p);
        return;
      }
      downloads.forEach(function (dl) {
        var card = document.createElement('div');
        card.className = 'acct-download';
        card.innerHTML =
          '<p class="acct-download__name">' + esc(dl.name) + '</p>' +
          '<p class="acct-download__note">' + esc(dl.note) + '</p>' +
          '<a class="acct-download__link" href="' + esc(dl.href) + '">Download &rarr;</a>';
        container.appendChild(card);
      });
    }

    // The date means a DIFFERENT THING per status, so the label owns the wording for
    // it rather than every line ending in "Next charge". A cancelling subscription has
    // no next charge - Stripe's own portal says "No charges scheduled" - and telling
    // someone who just cancelled that they will be charged again is the one wrong
    // sentence on this page that would actually cost a support email.
    var STATUS_LABEL = {
      active: { label: 'Active', date: 'Next charge ' },
      past_due: { label: 'Past due', date: 'Retrying until ' },
      cancelling: { label: 'Cancelled', date: 'Access ends ' },
      lapsed: { label: 'Lapsed', date: '' },
      none: { label: '', date: '' },
    };

    // ---------- the one call that drives everything ----------
    // JUST PAID? Stripe's Payment Links redirect here with ?purchase=<checkout session id>,
    // and THE SEAT MAY NOT EXIST YET when the buyer arrives. The seat is created by a
    // webhook, not by the redirect, and Stripe does not order its events: the first live
    // purchase saw customer.subscription.created arrive BEFORE the checkout.session.completed
    // that says whose subscription it is (2026-09-02, four bugs, all in the licensing
    // RESULTS.md). Without this, someone who has just handed over money is told "no downloads
    // on this seat yet", which is the single worst sentence this page can show.
    //
    // So on that one marker, and only then, poll for the seat instead of believing the first
    // answer. Backs off, gives up after ~20s and renders the normal page rather than spinning
    // forever, and drops the parameter from the URL as soon as the seat appears so a refresh
    // or a shared link never re-enters this path.
    var justPaid = /[?&]purchase=/.test(location.search);
    var waitedMs = 0;
    var WAIT_STEPS = [800, 1200, 2000, 3000, 4000, 4000, 5000];

    function clearPurchaseFlag() {
      justPaid = false;
      if (window.history && history.replaceState) {
        history.replaceState(null, '', location.pathname + location.hash);
      }
    }

    function loadAccount() {
      var session = getSession();
      if (!session) { showState('signedout'); return; }
      showOffline(false);
      fetch(API + '/v1/account', { headers: { Authorization: 'Bearer ' + session } })
        .then(function (r) {
          if (r.status === 401) { clearSession(); showState('signedout'); return null; }
          return r.json();
        })
        .then(function (data) {
          if (!data) return; // already handled (401)
          if (!data.ok) { clearSession(); showState('signedout'); return; }
          var seated = !!(data.value && data.value.tier && data.value.tier.length);
          if (justPaid && !seated && WAIT_STEPS.length) {
            var wait = WAIT_STEPS.shift();
            waitedMs += wait;
            showSettling(true);
            setTimeout(loadAccount, wait);
            return;
          }
          if (justPaid) clearPurchaseFlag();
          showSettling(false);
          renderSignedIn(data.value, session);
        })
        .catch(function () { showOffline(true); });
    }

    // One line, only ever seen in the seconds after a purchase. It says what is happening
    // rather than showing an empty account, and it never appears on an ordinary visit.
    function showSettling(on) {
      var el = document.getElementById('acct-settling');
      if (!el) return;
      el.hidden = !on;
    }

    function renderSignedIn(account, session) {
      showState('signedin');
      if (elEmailDisplay) elEmailDisplay.textContent = account.email || '';

      var hasSub = !!(account.tier && account.tier.length);
      if (elSubscribed) elSubscribed.hidden = !hasSub;
      if (elUnsubscribed) elUnsubscribed.hidden = hasSub;

      if (hasSub) {
        var nameEl = document.getElementById('acct-tier-name');
        if (nameEl) nameEl.textContent = account.tier;

        var opensEl = document.getElementById('acct-opens');
        if (opensEl) {
          opensEl.innerHTML = '';
          (account.opens || []).forEach(function (line) {
            var li = document.createElement('li');
            li.textContent = line;
            opensEl.appendChild(li);
          });
        }

        var statusEl = document.getElementById('acct-status-line');
        if (statusEl) {
          var s = STATUS_LABEL[account.status] || { label: account.status || '', date: '' };
          var when = s.date && account.renewsAt ? s.date + fmtDate(account.renewsAt) : '';
          statusEl.textContent = [s.label, when].filter(Boolean).join(' · ');
        }

        var manageWrap = document.getElementById('acct-manage');
        var manageLink = document.getElementById('acct-manage-link');
        if (manageWrap && manageLink) {
          if (account.manageUrl) {
            manageWrap.hidden = false;
            manageLink.setAttribute('href', account.manageUrl);
          } else {
            manageWrap.hidden = true;
          }
        }

        renderDownloads(document.getElementById('acct-downloads'), account.downloads);

        var limitSub = document.getElementById('acct-devicelimit-sub');
        if (limitSub) limitSub.textContent = (account.devices || []).length + ' of ' + account.deviceLimit + ' machines in use';
        renderDevices(document.getElementById('acct-devices-sub'), account.devices, session);
      } else {
        var limitFree = document.getElementById('acct-devicelimit-free');
        if (limitFree) limitFree.textContent = (account.devices || []).length + ' of ' + account.deviceLimit + ' machines in use';
        renderDevices(document.getElementById('acct-devices-free'), account.devices, session);
      }
    }

    loadAccount();
  })();
</script>

<style>
  .acct { max-width: 46rem; margin: 0 auto; }

  .acct-offline { margin: 0 0 1.5rem; padding: 1rem 1.25rem; border-radius: var(--radius); background: var(--iron); border: 1px solid rgba(255, 122, 61, 0.35); color: var(--bone); font-size: 0.9375rem; }

  .acct-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 2rem 2.25rem;
    border-radius: 20px;
    background: linear-gradient(180deg, var(--iron), var(--carbon));
    border: 1px solid var(--iron-3);
    box-shadow: var(--shadow-lg);
  }
  .acct-card__head { margin: 0; font-family: var(--font-mono); font-weight: 800; font-size: 1.375rem; color: var(--bone); }

  .acct-form { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .acct-input {
    flex: 1 1 14rem;
    box-sizing: border-box;
    background: var(--carbon);
    border: 1px solid var(--iron-3);
    border-radius: var(--radius);
    color: var(--bone);
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    padding: 0.75em 0.9em;
  }
  .acct-input::placeholder { color: var(--bone-faint); }
  .acct-input:focus { outline: none; border-color: var(--plasma-dim); }

  .acct-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--carbon);
    background: var(--plasma);
    border: 1px solid var(--plasma);
    border-radius: var(--radius-pill);
    padding: 0.75em 1.5em;
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
  }
  .acct-btn:hover { background: var(--plasma-dim); border-color: var(--plasma-dim); }
  .acct-btn:disabled { opacity: 0.6; cursor: default; }
  .acct-btn--soft { color: var(--bone); background: var(--iron); border-color: var(--iron-3); }
  .acct-btn--soft:hover { border-color: var(--bone-faint); }

  .acct-msg { margin: 0; font-size: 0.9375rem; color: var(--bone-dim); }
  .acct-msg--error { color: var(--ember); }

  .acct-sronly { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  .acct-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--iron-2);
  }
  .acct-topbar__email { margin: 0; font-family: var(--font-mono); font-size: 0.9375rem; color: var(--bone); }
  .acct-topbar__actions { display: flex; gap: 1.25rem; flex-wrap: wrap; }
  .acct-linkbtn {
    background: none;
    border: none;
    padding: 0;
    color: var(--bone-dim);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .acct-linkbtn:hover { color: var(--bone); }
  .acct-linkbtn:disabled { opacity: 0.6; cursor: default; }

  .acct-block { display: flex; flex-direction: column; gap: 2rem; }

  .acct-tier { display: flex; flex-direction: column; gap: 0.75rem; }
  .acct-tier__name { margin: 0; font-family: var(--font-mono); font-weight: 800; font-size: 1.5rem; letter-spacing: 0.02em; color: var(--bone); }
  .acct-opens { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .acct-opens li { font-size: 0.9375rem; line-height: 1.6; color: var(--bone-dim); }
  .acct-opens li::before { content: '\2013\0020'; color: var(--bone-faint); }

  .acct-status-line { font-family: var(--font-mono); font-size: 0.875rem; letter-spacing: 0.03em; color: var(--bone-dim); }

  .acct-section { display: flex; flex-direction: column; gap: 0.9rem; }
  .acct-section__head { margin: 0; font-family: var(--font-mono); font-weight: 700; font-size: 1.0625rem; color: var(--bone); }

  .acct-settling {
    margin: 0 0 1rem;
    padding: 0.75rem 1rem;
    border-radius: 10px;
    font-size: 0.9375rem;
    color: var(--bone);
    background: var(--plasma-glow);
    border: 1px solid var(--plasma-dim);
  }
  .acct-downloads { display: flex; flex-direction: column; gap: 0.75rem; }
  .acct-download {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.1rem 1.25rem;
    border-radius: 14px;
    background: var(--iron);
    border: 1px solid var(--iron-3);
  }
  .acct-download__name { margin: 0; font-family: var(--font-mono); font-weight: 700; font-size: 0.9375rem; color: var(--bone); }
  .acct-download__note { margin: 0; font-size: 0.8125rem; color: var(--bone-dim); }
  .acct-download__link { align-self: flex-start; font-family: var(--font-mono); font-size: 0.875rem; font-weight: 700; color: var(--bone); text-decoration: none; }
