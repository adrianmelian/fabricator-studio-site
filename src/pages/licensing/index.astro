---
// Licensing page (SITE-LIC-R2, 2026-07-18). Copy is Adrian-approved from
// MrMiata workspace/2026-07-18_licensing-decision/COMMERCIAL-PAGE.md (section A, the
// COMMERCIAL-LICENSE.md mirror), annual-recurring confirmed by Adrian. Pre-launch
// adjustments flagged in the session record: the "source is public" FAQ line is trimmed
// until the repo actually publishes, and the license text links the standard BSL 1.1
// (the repo LICENSE would 404 while private).
// G13 NOTE: this page is exempt from the open-source gate BY DESIGN (Adrian's Option A):
// it discusses the license as a subject, including saying what it is not.
import BaseLayout from '../../layouts/BaseLayout.astro';
import NavBar from '../../components/NavBar.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/designed-doc.css';

const TITLE = 'LICENSING';
const TRI = ['t-bone', 't-plasma', 't-ember'];
let li = 0;
const titleGlyphs = TITLE.split('').map((ch) => ({ ch, cls: ch === ' ' ? 't-gap' : TRI[li++ % 3] }));

const BANDS = [
  { rev: 'Under 2 million', fee: 'Free', free: true },
  { rev: '2 to 5 million', fee: '$1,000' },
  { rev: '5 to 15 million', fee: '$5,000' },
  { rev: '15 to 50 million', fee: '$15,000' },
  { rev: '50 to 250 million', fee: '$50,000' },
  { rev: '250 million to 1 billion', fee: '$150,000' },
  { rev: 'Over 1 billion', fee: 'From $300,000, let us talk' },
];

const FAQ = [
  {
    q: 'We are a small studio owned by a large publisher.',
    a: 'The threshold counts your parent and sibling companies. If a large company controls your studio, you are over the line.',
  },
  {
    q: 'We spun out of a big company and we are independent now.',
    a: 'Then you are independent, and only your own revenue counts. The test is who controls you today, not who used to.',
  },
  {
    q: 'I am an individual contractor working at a large studio.',
    a: 'Your own learning, portfolio, and personal work is free, always. Work you do for the large studio is use for their benefit, so they need the license, not you. Point them here.',
  },
  {
    q: 'What about the Advanced Ribbon Modules?',
    a: 'Those are a separate paid product for everyone, at any size. A commercial license covers the free toolset for a large organization; it does not include the Ribbon Modules, and buying the Ribbon Modules does not remove the need for a commercial license if you are over the threshold.',
  },
  {
    q: 'What happens to old versions?',
    a: 'Every release becomes open source under the GPL four years after it ships. That is built into the license and cannot be revoked.',
  },
  {
    q: 'Is this open source?',
    a: 'No, and we will not call it that. You can read and modify every line, but it is not an OSI approved license, because those licenses cannot ask a large company to pay.',
  },
];
---
<BaseLayout
  title="Licensing | FabricatorStudio"
  description="Free for solo developers, indies, and small teams. Above 2 million USD in annual revenue, one flat license covers your whole studio. Every version becomes open source four years after it ships."
>
  <NavBar />

  <article class="dd lc">
    <header class="dd-header lc-header">
      <div class="dd-eyebrow">FABRICATORSTUDIO &middot; LICENSING</div>
      <h1 class="dd-title" aria-label={TITLE}>
        {titleGlyphs.map((g) =>
          g.cls === 't-gap' ? <span class="t-gap"></span> : <span aria-hidden="true" class={g.cls}>{g.ch}</span>
        )}
      </h1>
      <p class="dd-summary lc-lede">FabricatorStudio is free for solo developers, indies, and small teams.</p>
    </header>

    <!-- THE FREE GRANT -->
    <section class="lc-free" aria-labelledby="lc-free-t">
      <h2 id="lc-free-t" class="lc-free__title">Under $2M a year? It is yours.</h2>
      <p class="lc-prose">If your organization made less than 2 million USD in gross revenue last tax year, you do not need a license and you do not need to contact anyone. Use it in production, ship games with it, use it on client work. It is yours, and it stays yours.</p>
      <p class="lc-prose lc-prose--always"><span class="lc-dot" aria-hidden="true"></span>Personal use, learning, and portfolio work are always free, whatever you do for a day job.</p>
    </section>

    <!-- PRICING -->
    <section id="pricing" class="lc-section" aria-labelledby="lc-pricing-t">
      <div class="lc-rule lc-rule--ember">
        <h2 id="lc-pricing-t" class="lc-rule__label lc-rule__label--ember">PRICING</h2>
      </div>
      <p class="lc-prose">Above 2 million USD in annual revenue, a commercial license is required. One flat license for your whole studio, per year. Not per seat, and never a percentage of what you make. Nothing to count, nothing to activate, no license server, no phoning home.</p>
      <div class="lc-table" role="table" aria-label="Annual license by company revenue">
        <div class="lc-table__row lc-table__row--head" role="row">
          <span role="columnheader">Your annual revenue</span>
          <span role="columnheader">Per year</span>
        </div>
        {BANDS.map((b) => (
          <div class={`lc-table__row${b.free ? ' lc-table__row--free' : ''}`} role="row">
            <span role="cell">{b.rev}</span>
            <span class={`lc-table__fee${b.free ? ' lc-table__fee--free' : ''}`} role="cell">{b.fee}</span>
          </div>
        ))}
      </div>
      <p class="lc-prose">Crossing 2 million costs you 1,000 a year, which is less than a single Maya seat. That is on purpose. You should not get punished for a good year.</p>
      <p class="lc-prose lc-prose--dim">No percentages. No per seat counting. No reporting, no audits, no license server. You look at one row, you know your number, and you can budget it a year ahead.</p>
    </section>

    <!-- WHY -->
    <section class="lc-why" aria-labelledby="lc-why-t">
      <h2 id="lc-why-t" class="lc-rule__label lc-rule__label--ember">WHY IT WORKS THIS WAY</h2>
      <!-- Adrian's own story, his words verbatim (approved 2026-07-18). -->
      <p class="lc-prose">My whole career, I built awesome tools like these at big studios. Then the industry started laying us off, and when I sat down to build my own game I realized I had none of them. Fourteen years of pipeline, and every line of it stayed behind at the companies.</p>
      <p class="lc-prose">So I built the tools again, for myself. While watching my peers get laid off one by one, I decided to release my tools. There is a growing pool of indie developers now, a lot of us fresh out of those big studios. Wishing we still had the toolset we had access to just a few months ago. This one is free for you.</p>
      <p class="lc-prose">I am not giving these tools away free to the big companies that ran the layoffs. If your organization can afford a Technical Artist, it can pay for a license, and that revenue is what keeps the toolset free for everyone else.</p>
      <p class="lc-prose lc-prose--dim">For comparison: Epic charges non-game companies over 1 million in revenue 1,850 USD per seat per year for Unreal Engine. Our line is twice that, and above it you pay once for the entire studio instead of once per person.</p>
    </section>

    <!-- THE LICENSE -->
    <section id="license" class="lc-section" aria-labelledby="lc-license-t">
      <div class="lc-rule lc-rule--plasma">
        <h2 id="lc-license-t" class="lc-rule__label lc-rule__label--plasma">THE LICENSE</h2>
      </div>
      <p class="lc-prose">The toolset ships under the <b>Business Source License 1.1</b>, with one added grant: free use for organizations under 2 million USD in annual gross revenue. Every version becomes fully open source four years after it ships, automatically. That conversion is written into the license and cannot be revoked.</p>
      <a class="lc-chip" href="https://mariadb.com/bsl11/" target="_blank" rel="noopener">Read the standard BSL 1.1 text &rarr;</a>
    </section>

    <!-- GET A LICENSE -->
    <section class="lc-contact" aria-labelledby="lc-contact-t">
      <div>
        <h2 id="lc-contact-t" class="lc-contact__title">Getting a license</h2>
        <p class="lc-prose">Email us your company name and revenue band. No sales call required unless you want one.</p>
        <p class="lc-prose lc-prose--dim lc-contact__xlink">Need hands, not just a license? <a href="/services/">See Services</a>.</p>
      </div>
      <a class="lc-cta" href="mailto:licensing@fabricator.studio?subject=Commercial%20license">licensing@fabricator.studio</a>
    </section>

    <!-- FAQ -->
    <section id="faq" class="lc-section" aria-labelledby="lc-faq-t">
      <div class="lc-rule lc-rule--plasma">
        <h2 id="lc-faq-t" class="lc-rule__label lc-rule__label--plasma">QUESTIONS</h2>
      </div>
      <div class="lc-faq">
        {FAQ.map((f) => (
          <div class="lc-faq__item">
            <h3 class="lc-faq__q">{f.q}</h3>
            <p class="lc-faq__a">{f.a}</p>
          </div>
        ))}
      </div>
    </section>
  </article>

  <Footer />
</BaseLayout>

<style>
  /* Licensing page: the free grant, the band table, and the FAQ. Shared furniture:
     designed-doc.css. */
  .lc .dd-header { align-items: center; text-align: center; }
  .lc-lede { max-width: 46rem; margin-inline: auto; font-size: 1.125rem; }

  .lc-section, .lc-why { display: flex; flex-direction: column; gap: 1.25rem; }
  .lc-rule { display: flex; align-items: center; gap: 1.1rem; }
  .lc-rule__label { margin: 0; font-family: var(--font-mono); font-weight: 800; font-size: clamp(1.25rem, 2.6vw, 1.625rem); letter-spacing: 0.04em; }
  .lc-rule__label--plasma { color: var(--plasma); }
  .lc-rule__label--ember { color: var(--ember); }
  .lc-rule::after { content: ''; flex: 1; height: 1px; }
  .lc-rule--plasma::after { background: linear-gradient(90deg, rgba(124, 255, 178, 0.4), rgba(124, 255, 178, 0)); }
  .lc-rule--ember::after { background: linear-gradient(90deg, rgba(255, 122, 61, 0.4), rgba(255, 122, 61, 0)); }

  .lc-prose { margin: 0; max-width: 56rem; font-size: 0.9375rem; line-height: 1.65; color: var(--bone-dim); text-wrap: pretty; }
  .lc-prose b { color: var(--bone); }
  .lc-prose--dim { color: var(--bone-faint); }

  /* The free grant: the guarantee card, plasma wash. */
  .lc-free {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background: linear-gradient(160deg, rgba(124, 255, 178, 0.1), rgba(124, 255, 178, 0)), var(--carbon);
    border: 1px solid rgba(124, 255, 178, 0.4);
    border-radius: 20px;
    padding: 2rem 2.25rem;
    box-shadow: 0 0 44px -22px rgba(124, 255, 178, 0.4);
  }
  .lc-free__title { margin: 0; font-family: var(--font-mono); font-weight: 800; font-size: 1.5rem; color: var(--plasma); }
  .lc-prose--always { display: flex; align-items: baseline; gap: 0.7rem; color: var(--bone); }
  .lc-dot { flex: none; width: 0.55rem; height: 0.55rem; border-radius: 50%; background: var(--plasma); }

  .lc-table { display: flex; flex-direction: column; border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 16px; overflow: hidden; max-width: 44rem; }
  .lc-table__row {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 1rem;
    padding: 0.8rem 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    color: var(--bone-dim);
    background: var(--carbon);
  }
  .lc-table__row:nth-child(odd) { background: var(--iron); }
  .lc-table__row--head { background: var(--iron-2); color: var(--bone-faint); font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; }
  .lc-table__row--free { background: linear-gradient(90deg, rgba(124, 255, 178, 0.12), rgba(124, 255, 178, 0)), var(--carbon); color: var(--bone); }
  .lc-table__fee { font-weight: 700; color: var(--bone); }
  .lc-table__fee--free { color: var(--plasma); }

  .lc-why {
    background: linear-gradient(180deg, var(--iron), var(--carbon));
    border: 1px solid rgba(255, 122, 61, 0.16);
    border-radius: 20px;
    padding: 2rem 2.25rem;
  }

  .lc-chip {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1.25rem;
    border-radius: 10px;
    background: rgba(124, 255, 178, 0.1);
    border: 1px solid rgba(124, 255, 178, 0.4);
    color: var(--plasma);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.9375rem;
    text-decoration: none;
  }
  .lc-chip:hover { background: var(--plasma); color: #06120B; }

  .lc-contact {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    background: linear-gradient(180deg, var(--iron), var(--carbon));
    border: 1px solid rgba(124, 255, 178, 0.14);
    border-radius: 20px;
    padding: 2rem 2.25rem;
  }
  .lc-contact__title { margin: 0 0 0.5rem; font-family: var(--font-mono); font-weight: 800; font-size: 1.375rem; color: var(--bone); }
  .lc-cta {
    display: inline-flex;
    padding: 1rem 1.75rem;
    border-radius: 11px;
    background: var(--ember);
    color: #1A0A02;
    font-family: var(--font-mono);
    font-weight: 800;
    font-size: 1rem;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 0 30px -12px rgba(255, 122, 61, 0.7);
  }
  .lc-cta:hover { background: var(--ember-dim); }
  .lc-contact__xlink { margin-top: 0.5rem; font-size: 0.8125rem; }
  .lc-contact__xlink a { color: var(--plasma); text-decoration: none; }
  .lc-contact__xlink a:hover { color: var(--plasma-dim); }

  .lc-faq { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
  .lc-faq__item {
    background: var(--iron);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 1.5rem 1.625rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .lc-faq__q { margin: 0; font-family: var(--font-mono); font-weight: 800; font-size: 1rem; color: var(--bone); }
  .lc-faq__a { margin: 0; font-size: 0.9375rem; line-height: 1.6; color: var(--bone-dim); }

  @media (max-width: 760px) {
    .lc-faq { grid-template-columns: 1fr; }
    .lc-contact { flex-direction: column; align-items: flex-start; }
  }
</style>
