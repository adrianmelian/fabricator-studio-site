---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FieldLabel from '../../components/FieldLabel.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<BaseLayout title={`${post.data.title} | FabricatorStudio`} description={post.data.description}>
  <article>
    <section class="post">
      <FieldLabel text="Devlog" />
      <h1 class="subhead">{post.data.title}</h1>
      <time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0, 10)}</time>
      <div class="prose post-body"><Content /></div>
    </section>
  </article>

  <Footer />
</BaseLayout>
<style>
  .post { text-align: center; }
  .post time { color: var(--bone-faint); font-size: 0.875rem; }
  .post-body { margin-inline: auto; text-align: left; margin-top: 1.5rem; display: flex; flex-direction: column; gap: 1rem; }
</style>
