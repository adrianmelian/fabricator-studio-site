---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FieldLabel from '../../components/FieldLabel.astro';
import Footer from '../../components/Footer.astro';
import NavBar from '../../components/NavBar.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title="Devlog | FabricatorStudio" description="Development log for Fabricator and the FabricatorStudio toolset.">
  <NavBar />
  <section class="devlog-index">
    <FieldLabel text="Devlog" />
    <h1 class="vt">Devlog</h1>
    <ul class="posts">
      {posts.map((p) => (
        <li>
          <a href={`/blog/${p.id}/`}>{p.data.title}</a>
          <time datetime={p.data.date.toISOString()}>{p.data.date.toISOString().slice(0, 10)}</time>
          <p class="prose">{p.data.description}</p>
        </li>
      ))}
    </ul>
  </section>

  <Footer />
</BaseLayout>
<style>
  .devlog-index { text-align: center; }
  .posts { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 1.5rem; text-align: left; max-width: var(--measure); margin: 1.5rem auto 0; }
  .posts time { color: var(--bone-faint); font-size: 0.875rem; margin-left: 0.75rem; }
  .posts p { color: var(--bone-dim); margin-top: 0.25rem; }
</style>
