---
// Licensing page (Adrian x Claude Design, 2026-07-18; source drop:
// MrMiata inbox/Docs/"Licensing Docs.html"). Copy is Adrian-approved from
// MrMiata workspace/2026-07-18_licensing-decision/COMMERCIAL-PAGE.md (section A),
// annual-recurring confirmed by Adrian.
// COPY NOTE: the WHY section is Adrian's OWN words, held VERBATIM. The design drop
// compressed his second paragraph (dropping "a lot of us fresh out of those big
// studios. Wishing we still had the toolset we had access to just a few months ago.")
// and that drift was NOT adopted, per the no-re-wording rule. The drop's em-dashes
// were not adopted either; its contractions were.
// Pre-launch adjustments: the license button links the standard BSL 1.1 text (the repo
// LICENSE would 404 while private); re-point at v1 publish.
// G13 NOTE: this page is exempt from the open-source gate BY DESIGN (Adrian's Option A):
// it discusses the license as a subject, including saying what it is not.
import BaseLayout from '../../layouts/BaseLayout.astro';
import NavBar from '../../components/NavBar.astro';
import Footer from '../../components/Footer.astro';
import SubscriptionTiers from '../../components/SubscriptionTiers.astro';
import Masthead from '../../components/Masthead.astro';
import '../../styles/designed-doc.css';


// The 1.x FAQ block (the $2M threshold questions, the GPL conversion, the source-available
// answer) was cut 2026-08-31 with the rest of the 1.x material. What remains is 2.0-only.
const FAQ = [
  {
    tone: 'ember',
    q: 'What about Armature, the standalone app?',
    a: 'Armature is free for everyone. Any paid subscription unlocks its advanced tier. <a href="/armature/">See Armature</a>.',
  },
  {
    tone: 'ember',
    q: 'What about the Advanced Ribbon Modules?',
    // Ruled 2026-08-31: base Freelancer does not carry them; every tier above does.
    a: 'They are included with every tier above base Freelance Tech Art. If you bought them for 1.x, they stay yours.',
  },
];
---
<BaseLayout
  title="Pricing | FabricatorStudio"
  description="Armature is free. The Studio Pipeline is a subscription: Freelance Animator, Freelance Tech Art, Pro and Enterprise."
>
  <NavBar />

  <article class="dd lc">
    {/* HEADER FROM HIS DESIGN DROP, 2026-09-03. It promotes "Armature is free." out of the
        lede and makes it the headline, drops the glyph-cycled PRICING title to a small
        eyebrow, and adds a second sentence to the standfirst.

        THE DROP'S LOGO IS NOT HERE, AND THAT IS DELIBERATE. Its header opens with a
        horizontal FabricatorStudio wordmark - the pencil f, plasma squares - which is not
        among this site's assets: the lockup here is the vertical extruder mark, and the
        Wordmark component is live tri-colour type. The drop is a bare canvas with no site
        chrome, so its wordmark stands where this page already has a navigation bar
        carrying the mark. Left out rather than guessed at. HIS CALL.

        Names the PRODUCT, not the studio (Adrian, 2026-07-30): the studio is not free, one
        of its products is. Lede ruled 2026-08-31, when the Maya tools stopped being free
        and Armature became the free offering. It is the Studio Pipeline and never "the
        Maya toolset" (Adrian, 2026-08-31). */}
    {/* CUT TO THE ONE WORD, 2026-09-03, on his instruction: remove "Armature is free."
        and the standfirst under it. The cards carry the whole message now, and what is
        left is the masthead, which /account/ now shares. */}
    <Masthead title="Pricing" />

    <!-- FABRICATOR 2.0: the subscription tiers (2026-08-31). The final free 1.x release's
         What's New card links here with a button labelled "What's coming in 2.0", so this
         section is what that button promises. Static by design: no accounts or checkout
         until the 2.0 campaign builds them. Prices single-sourced from the Bridge's
         PRICING.md; see the component header for the four deliberately open lines. -->
    <SubscriptionTiers />

    {/* THE ENTIRE 1.X BLOCK WAS CUT 2026-08-31 on Adrian's ruling, his words: "fuck the
        1.x people." Gone: the legacy divider, the under-$2M holder card, the commercial
        revenue bands, the BSL license section, and every 1.x FAQ. The 1.x terms travel
        with the software itself (its LICENSE and EULA); this page sells the subscription. */}

    {/* The WHY section was cut from this page by Adrian, 2026-08-31: the story explained
        a free toolset and the flat $2M license, both gone. His verbatim text stays
        canonical in src/data/licensing.ts (the homepage still renders it; that surface
        is the overhaul's). */}

    <!-- CONTACT (the 1.x BSL section that stood here was cut 2026-08-31; the door stays) -->
    <section id="license" class="lc-license" aria-labelledby="lc-license-t">
      <h2 id="lc-license-t" class="lc-head__label lc-head__label--plasma">TALK TO US</h2>
      <div class="lc-get">
        <div class="lc-get__copy">
          <h3 class="lc-get__title">Enterprise and questions</h3>
          <p class="lc-prose">Email us. No sales call required unless you want one. If you need hands as well as seats, see <a href="/services/">Services</a>.</p>
        </div>
        <a class="lc-cta" href="mailto:licensing@fabricator.studio?subject=Licensing">licensing@fabricator.studio</a>
      </div>
    </section>

    <!-- QUESTIONS -->
    <section id="faq" class="lc-section" aria-labelledby="lc-faq-t">
      <h2 id="lc-faq-t" class="lc-head__label lc-head__label--plasma">QUESTIONS</h2>
      <div class="lc-faq">
        {FAQ.map((f) => (
          <div class={`lc-q${f.tone ? ` lc-q--${f.tone}` : ''}`}>
            <h3 class="lc-q__q">{f.q}</h3>
            <p class="lc-q__a" set:html={f.a} />
          </div>
        ))}
      </div>
    </section>
  </article>

  <Footer />
</BaseLayout>

<style>
  /* The drop's header: centred, 18px gaps, a small letterspaced eyebrow over a serif
     headline, with the standfirst held to about 52 characters so it breaks in two lines. */
  /* Room above it (Adrian, 2026-09-03). The eyebrow sat hard under the navigation bar
     with nothing between them, so the page opened cramped before the headline arrived. */
  /* Licensing page in the design drop's language. Shared furniture: designed-doc.css.
     The drop's off-palette darks are snapped to tokens, and every fade ends at the hue
     at zero alpha rather than the `transparent` keyword. */
  .lc { gap: 3.5rem; }
  .lc .dd-header { align-items: center; text-align: center; }
  .lc .dd-title { justify-content: center; }
  .lc-lede { max-width: 52rem; margin-inline: auto; font-size: 1.125rem; }
  .lc-scope { max-width: 52rem; margin-inline: auto; margin-top: 0.75rem; font-size: 0.9375rem; }
  .lc-scope a { color: var(--bone); }

  .lc-section, .lc-why, .lc-license { display: flex; flex-direction: column; gap: 1.5rem; }

  /* The 1.x legacy divider: a full-width rule, then the banner. Ember on purpose: it marks
     a boundary, not a warning. */
  .lc-legacy { display: flex; flex-direction: column; gap: 1.5rem; margin-top: 1rem; }
  .lc-legacy__rule { height: 1px; background: linear-gradient(90deg, rgba(255, 122, 61, 0.5), rgba(255, 122, 61, 0)); }

  .lc-head { display: flex; align-items: baseline; gap: 1.25rem; flex-wrap: wrap; }
  .lc-head__label { margin: 0; font-family: var(--font-mono); font-weight: 800; font-size: clamp(1.25rem, 2.6vw, 1.625rem); letter-spacing: 0.04em; }
  .lc-head__label--plasma { color: var(--bone); }
  .lc-head__label--ember { color: var(--bone); }
  .lc-head__sub { margin: 0; font-size: 1rem; color: var(--bone-dim); }

  .lc-prose { margin: 0; max-width: 62rem; font-size: 0.9375rem; line-height: 1.65; color: var(--bone-dim); text-wrap: pretty; }
  .lc-prose--lg { font-size: 1.0625rem; }
  .lc-prose--dim { color: var(--bone-faint); }
  .lc-prose b { color: var(--bone); }
  .lc-prose :global(.b-plasma) { color: var(--bone); }
  /* The WHY copy is shared with the homepage quote box, which emphasises the promise
     line in cobalt; style it here too or the phrase renders unemphasised on this page. */
  .lc-prose :global(.b-cobalt) { color: var(--bone); }
  .lc-prose a { color: var(--bone); font-weight: 700; text-decoration: none; }
  .lc-prose a:hover { color: var(--bone-dim); }

  /* The free grant: iron sliding into a plasma-tinted dark (the drop's 120deg card). */
  .lc-free {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    background: linear-gradient(120deg, rgba(124, 255, 178, 0) 40%, rgba(124, 255, 178, 0.08)), linear-gradient(120deg, var(--iron), var(--carbon));
    border: 1px solid rgba(124, 255, 178, 0.4);
    border-radius: 22px;
    padding: 2.5rem 2.75rem 2.75rem;
    box-shadow: var(--shadow-lg), 0 0 44px -24px rgba(124, 255, 178, 0.3);
  }
  .lc-free__title { margin: 0; font-family: var(--font-mono); font-weight: 800; font-size: clamp(1.5rem, 3.2vw, 2.125rem); line-height: 1.05; letter-spacing: -0.02em; color: var(--bone); }
  .lc-pill {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0.9rem;
    border-radius: 9px;
    background: rgba(124, 255, 178, 0.13);
    border: 1px solid rgba(124, 255, 178, 0.45);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
    color: var(--bone);
    white-space: nowrap;
  }
  .lc-pill__dot { width: 0.55rem; height: 0.55rem; border-radius: 50%; background: var(--plasma); box-shadow: 0 0 10px rgba(124, 255, 178, 0.7); }

  /* Inset callouts: carbon panel, accent hairline. */
  .lc-callout {
    display: flex;
    align-items: center;
    gap: 1rem;
    border-radius: 14px;
    padding: 1.25rem 1.5rem;
    background: var(--carbon);
  }
  .lc-callout p { margin: 0; font-size: 1rem; line-height: 1.55; color: var(--bone-dim); text-wrap: pretty; }
  .lc-callout p b { color: var(--bone); }
  .lc-callout :global(.b-plasma) { color: var(--bone); }
  .lc-callout svg { flex: none; }
  .lc-callout--plasma { border: 1px solid rgba(124, 255, 178, 0.25); }
  .lc-callout--ember { align-items: flex-start; border: 1px solid rgba(255, 122, 61, 0.25); }
  .lc-callout--wash { border: 1px solid rgba(124, 255, 178, 0.35); background: linear-gradient(90deg, rgba(124, 255, 178, 0.08), rgba(124, 255, 178, 0)), var(--carbon); }
  .lc-callout__badge {
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 10px;
    background: rgba(255, 122, 61, 0.14);
    color: var(--bone);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 1.375rem;
  }

  /* Band table: two columns, ruled rows, the free row plasma and the top row ember. */
  .lc-table { display: flex; flex-direction: column; border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 18px; overflow: hidden; box-shadow: var(--shadow-md); }
  .lc-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 16rem);
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--bone-dim);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .lc-row:last-child { border-bottom: none; }
  .lc-row > span { padding: 1.125rem 1.75rem; }
  .lc-row > span + span { border-left: 1px solid rgba(255, 255, 255, 0.06); }
  .lc-row:nth-child(even) { background: rgba(255, 255, 255, 0.015); }
  .lc-row--head { background: var(--iron); color: var(--bone-faint); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; }
  .lc-row--free { background: rgba(124, 255, 178, 0.05); color: var(--bone); }
  .lc-row--top { background: rgba(255, 122, 61, 0.06); color: var(--bone); }
  .lc-row__fee { font-weight: 700; color: var(--bone); }
  .lc-row__fee--free { font-weight: 800; color: var(--bone); }
  .lc-row__fee--top { font-weight: 800; color: var(--bone); }

  /* The three-axis strip: same furniture as the band table, one card per product. */
  .lc-axes { display: grid; gap: 0.875rem; }
  @media (min-width: 761px) {
    .lc-axes { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .lc-axis {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.25rem 1.5rem;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: linear-gradient(90deg, var(--iron), var(--carbon));
  }
  .lc-axis__name { margin: 0; font-family: var(--font-mono); font-weight: 700; font-size: 1rem; color: var(--bone); }
  .lc-axis__line {
    margin: 0;
    align-self: flex-start;
    padding: 0.2rem 0.6rem;
    border-radius: 7px;
    background: rgba(255, 122, 61, 0.12);
    border: 1px solid rgba(255, 122, 61, 0.3);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bone);
  }
  .lc-axis__terms { margin: 0.25rem 0 0; font-size: 0.9375rem; line-height: 1.6; color: var(--bone-dim); text-wrap: pretty; }
  .lc-axis__link { margin-top: auto; padding-top: 0.5rem; font-family: var(--font-mono); font-weight: 700; font-size: 0.875rem; color: var(--bone); text-decoration: none; }
  .lc-axis__link:hover { color: var(--bone-dim); }

  .lc-why {
    box-sizing: border-box;
    background: linear-gradient(180deg, var(--iron), var(--carbon));
    border: 1px solid rgba(255, 122, 61, 0.14);
    border-radius: 22px;
    padding: 2.5rem 2.75rem 2.75rem;
    box-shadow: var(--shadow-lg);
  }
  .lc-why__body { display: flex; flex-direction: column; gap: 1.25rem; max-width: 62rem; }

  .lc-license {
    box-sizing: border-box;
    background: linear-gradient(120deg, rgba(124, 255, 178, 0) 40%, rgba(124, 255, 178, 0.06)), linear-gradient(120deg, var(--iron), var(--carbon));
    border: 1px solid rgba(124, 255, 178, 0.18);
    border-radius: 22px;
    padding: 2.5rem 2.75rem 2.75rem;
    box-shadow: var(--shadow-lg);
  }
  .lc-license__rule { height: 1px; background: linear-gradient(90deg, rgba(232, 224, 208, 0.1), rgba(232, 224, 208, 0)); }
  .lc-chip {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1.5rem;
    border-radius: 11px;
    background: rgba(124, 255, 178, 0);
    border: 1px solid rgba(124, 255, 178, 0.4);
    color: var(--bone);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.9375rem;
    text-decoration: none;
  }
  .lc-chip:hover { background: var(--plasma); color: #06120B; }

  .lc-get { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2.5rem; align-items: center; }
  .lc-get__copy { display: flex; flex-direction: column; gap: 0.6rem; }
  .lc-get__title { margin: 0; font-family: var(--font-mono); font-weight: 800; font-size: 1.375rem; color: var(--bone); }
  .lc-cta {
    justify-self: end;
    display: inline-flex;
    padding: 1rem 1.75rem;
    border-radius: 12px;
    background: var(--plasma);
    color: #06120B;
    font-family: var(--font-mono);
    font-weight: 800;
    font-size: 1rem;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 0 32px -12px rgba(124, 255, 178, 0.7);
  }
  .lc-cta:hover { background: var(--plasma-dim); }

  .lc-faq { display: flex; flex-direction: column; gap: 0.875rem; }
  .lc-q {
    background: linear-gradient(90deg, var(--iron), var(--carbon));
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 14px;
    padding: 1.5rem 1.875rem;
  }
  .lc-q--ember { border-color: rgba(255, 122, 61, 0.2); }
  .lc-q--plasma { border-color: rgba(124, 255, 178, 0.2); }
  .lc-q__q { margin: 0 0 0.5rem; font-family: var(--font-mono); font-weight: 700; font-size: 1.0625rem; color: var(--bone); }
  .lc-q__a { margin: 0; font-size: 0.9375rem; line-height: 1.6; color: var(--bone-dim); }
  .lc-q__a :global(b) { color: var(--bone); }

  @media (max-width: 760px) {
    .lc-free, .lc-why, .lc-license { padding: 1.75rem 1.5rem 2rem; }
    .lc-row { grid-template-columns: minmax(0, 1fr) minmax(0, 9rem); font-size: 0.875rem; }
    .lc-row > span { padding: 0.9rem 1.125rem; }
    .lc-get { grid-template-columns: 1fr; gap: 1.25rem; }
    .lc-cta { justify-self: start; }
    .lc-callout { align-items: flex-start; }
  }
</style>
