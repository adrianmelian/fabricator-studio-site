---
import BaseLayout from './BaseLayout.astro';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import DocsSidebar from '../components/DocsSidebar.astro';
// `section` picks which docs tree the sidebar renders. Defaults to the Maya toolset, so
// every page that already uses this layout keeps its nav without being touched.
interface Props { title: string; description: string; section?: 'maya' | 'armature' }
const { title, description, section = 'maya' } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <NavBar />
  <div class="docs-shell">
    <button class="docs-shell__toggle" id="docs-sidebar-toggle" aria-expanded="false" aria-controls="docs-sidebar">Menu</button>
    <div class="docs-shell__sidebar" id="docs-sidebar">
      <DocsSidebar section={section} />
    </div>
    <main class="docs-shell__main">
      <slot />
    </main>
  </div>
  <Footer />
</BaseLayout>
<script is:inline>
  (function () {
    var btn = document.getElementById('docs-sidebar-toggle');
    var sb = document.getElementById('docs-sidebar');
    if (!btn || !sb) return;
    btn.addEventListener('click', function () {
      var open = sb.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  })();
</script>
<style>
  .docs-shell {
    display: grid;
    grid-template-columns: 258px minmax(0, 1fr);
    gap: 2.75rem;
    max-width: 80rem;
    margin: 0 auto;
    padding: 2rem 1.5rem 3.5rem;
    align-items: start;
  }
  .docs-shell__toggle { display: none; }
  .docs-shell__sidebar {
    position: sticky;
    top: 1.5rem;
    max-height: calc(100vh - 3rem);
    overflow-y: auto;
    padding-right: 0.5rem;
  }
  .docs-shell__main { min-width: 0; }

  @media (max-width: 900px) {
    .docs-shell { grid-template-columns: 1fr; gap: 1rem; padding-top: 1.25rem; }
    .docs-shell__toggle {
      display: inline-block;
      justify-self: start;
      font-family: var(--font-mono);
      font-weight: 700;
      letter-spacing: 0.08em;
      background: var(--iron);
      color: var(--bone);
      border: 1px solid var(--iron-2);
      border-radius: var(--radius);
      padding: 0.5rem 0.9rem;
      cursor: pointer;
    }
    .docs-shell__sidebar {
      position: static;
      max-height: none;
      overflow: visible;
      display: none;
      border-bottom: 1px solid var(--iron-2);
      padding: 0 0 1.25rem;
    }
    .docs-shell__sidebar.is-open { display: block; }
  }
</style>
